---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import ResourceTabs from '../../components/ResourceTabs.astro';
import Icon from '../../components/Icon.astro';
import { glossary, glossaryCats } from '../../data/glossary';

// One list in 가나다 order; search and the category chips only hide rows, so every term keeps its /library/glossary#id link.
const ko = new Intl.Collator('ko');
const terms = [...glossary].sort((a, b) => ko.compare(a.t, b.t));
const byId = new Map(glossary.map((g) => [g.id, g]));
const catLabel = new Map<string, string>(glossaryCats.map((c) => [c.key, c.label]));
// search text: spaces and punctuation dropped on both sides, so "제로 트러스트" finds 제로트러스트 and "m tls" finds mTLS
const norm = (s: string) => s.toLowerCase().replace(/[\s·\-_/(),.「」]/g, '');
// a tg line opens with the product name ("Trust Gateway는 ..."); that name is set in bold
const lead = (tg: string) => { const m = tg.match(/^(Trust Gateway|Trust Auth)([\s\S]*)$/); return m ? [m[1], m[2]] : ['', tg]; };
const q = (g: (typeof glossary)[number]) => norm([g.t, g.en, ...(g.aka ?? []), g.s, g.b].filter(Boolean).join(' '));

const page = new URL('/library/glossary', Astro.site).href;
const ld = {
  '@context': 'https://schema.org',
  '@type': 'DefinedTermSet',
  name: '신영이노베이션 용어집',
  url: page,
  hasDefinedTerm: terms.map((g) => ({
    '@type': 'DefinedTerm', name: g.t, ...(g.en && { alternateName: g.en }), description: g.s, url: `${page}#${g.id}`,
  })),
};
---
<Base title="용어집" description="제로트러스트, 인증, 암호, 네트워크·통신, AI 보안 용어를 쉽게 풀어 쓴 신영이노베이션 용어집." tone="light">
  <PageTitle title="용어집">제로트러스트와 보안, 통신에서 자주 쓰는 용어를 쉽게 풀었습니다.<ResourceTabs slot="after" /></PageTitle>

  <section class="section gl">
    <div class="wrap narrow">
      <div class="tools">
        <label class="find">
          <span class="sr-only">용어 검색</span>
          <Icon name="search" size={20} />
          <input id="gq" type="search" placeholder="용어나 약어로 검색" autocomplete="off" spellcheck="false" />
        </label>
        <div class="chips" role="group" aria-label="분야">
          <button type="button" class="chip" data-cat="" aria-pressed="true">전체 <span>{terms.length}</span></button>
          {glossaryCats.map((c) => (
            <button type="button" class="chip" data-cat={c.key} aria-pressed="false">{c.label} <span>{terms.filter((g) => g.cat === c.key).length}</span></button>
          ))}
        </div>
      </div>

      <p class="count" aria-live="polite"><span id="gn">{terms.length}</span>개 용어</p>

      <div class="terms">
        {terms.map((g) => (
          <details class="term" id={g.id} data-cat={g.cat} data-q={q(g)}>
            <summary>
              <span class="nm"><h3>{g.t}</h3>{g.en && <span class="en">{g.en}</span>}</span>
              <span class="cat">{catLabel.get(g.cat)}</span>
              <span class="s">{g.s}</span>
            </summary>
            <div class="body">
              <p>{g.b}</p>
              {g.tg && <p class="tg"><strong>{lead(g.tg)[0]}</strong>{lead(g.tg)[1]}</p>}
              {g.rel && (
                <div class="rel">
                  <span>관련 용어</span>
                  {g.rel.map((r) => <a href={`#${r}`}>{byId.get(r)?.t}</a>)}
                </div>
              )}
            </div>
          </details>
        ))}
      </div>

      <nav class="pager" aria-label="용어 페이지" hidden></nav>

      <div class="empty" hidden>
        <p>찾는 용어가 없습니다.<br />영문 약어나 다른 표현으로 검색해 보세요.</p>
        <button type="button" class="reset">전체 용어 보기</button>
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</Base>

<style>
  .gl { padding-top: 0; }
  .tools { display: grid; gap: 16px; }
  .find { display: flex; align-items: center; gap: 12px; height: 60px; padding: 0 22px; border: 1px solid var(--line); border-radius: 999px; background: #fff; color: var(--ink-3); }
  .find:focus-within { border-color: var(--blue); box-shadow: 0 0 0 3px rgb(54 99 153 / .14); }
  .find input { flex: 1; min-width: 0; height: 100%; border: 0; outline: 0; background: none; font: inherit; font-size: 17px; color: var(--ink); }
  .find input::placeholder { color: var(--ink-3); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { height: 38px; padding: 0 15px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; font-size: 14px; font-weight: 600; color: var(--ink-2); cursor: pointer; white-space: nowrap; }
  .chip span { margin-left: 2px; color: var(--ink-3); font-weight: 500; }
  .chip:hover { border-color: var(--ink-3); }
  .chip[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: #fff; }
  .chip[aria-pressed='true'] span { color: rgb(255 255 255 / .6); }
  .count { margin: 28px 0 0; font-size: 14px; color: var(--ink-3); }

  /* one row per term: name and its one-line meaning; opening it shows the explanation */
  .terms { margin-top: 12px; border-top: 1px solid var(--ink); }
  .term { border-bottom: 1px solid var(--line); }
  .term summary { display: grid; grid-template-columns: 1fr auto 22px; column-gap: 16px; row-gap: 4px; align-items: baseline; padding: 20px 4px; list-style: none; cursor: pointer; }
  .term summary::-webkit-details-marker { display: none; }
  .term summary::after { content: ''; grid-column: 3; grid-row: 1; justify-self: end; width: 9px; height: 9px; margin-right: 4px; border-right: 2px solid var(--ink-3); border-bottom: 2px solid var(--ink-3); rotate: 45deg; translate: 0 -3px; transition: rotate .25s var(--ease); }
  .term[open] summary::after { rotate: -135deg; translate: 0 2px; }
  .nm { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 10px; }
  .nm h3 { font-size: 18px; font-weight: 700; letter-spacing: -0.01em; color: var(--ink); }
  .en { font-size: 14px; color: var(--ink-3); }
  .cat { grid-column: 2; grid-row: 1; font-size: 13px; color: var(--ink-3); white-space: nowrap; }
  .s { grid-column: 1 / 3; font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .term summary:hover h3, .term[open] h3 { color: var(--blue); }

  .body { display: grid; gap: 14px; padding: 0 42px 26px 4px; }
  .body p { font-size: 16px; line-height: 1.75; color: var(--ink); }
  .body .tg { padding: 14px 18px; border-radius: 12px; background: var(--orange-soft); font-size: 15px; line-height: 1.7; }
  .tg strong { color: var(--orange-ink); }
  .rel { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  .rel span { margin-right: 4px; font-size: 13px; color: var(--ink-3); }
  .rel a { padding: 5px 12px; border: 1px solid var(--line); border-radius: 999px; font-size: 14px; color: var(--ink-2); }
  .rel a:hover { border-color: var(--blue); color: var(--blue); }

  /* 10 terms a page; until the script has run, only the first page shows, so the long list never flashes */
  :global(.js) .terms:not(.ready) .term:nth-child(n+11) { display: none; }
  .pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 40px; }
  .pager :global(button) { display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 6px; border: 0; border-radius: 999px; background: none; font: inherit; font-size: 15px; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--ink-2); cursor: pointer; }
  .pager :global(button:hover:not(:disabled)) { background: var(--mist); color: var(--ink); }
  .pager :global(button[aria-current='page']) { background: var(--ink); color: #fff; }
  .pager :global(button:disabled) { color: var(--line); cursor: default; }
  .pager :global(.gap) { min-width: 18px; text-align: center; color: var(--ink-3); }

  .empty { padding: 56px 0 24px; text-align: center; }
  .empty p { font-size: 16px; line-height: 1.7; color: var(--ink-2); }
  .reset { margin-top: 18px; padding: 0 22px; height: 44px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; font-size: 15px; font-weight: 700; color: var(--ink); cursor: pointer; }
  .reset:hover { border-color: var(--ink); }

  @media (max-width: 767px) {
    .find { height: 52px; padding: 0 18px; }
    .find input { font-size: 16px; }
    /* chips scroll sideways on a phone instead of stacking four rows deep */
    .chips { flex-wrap: nowrap; overflow-x: auto; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 4px; scrollbar-width: none; }
    .chips::-webkit-scrollbar { display: none; }
    .term summary { grid-template-columns: 1fr 22px; padding: 18px 2px; }
    .term summary::after { grid-column: 2; }
    .cat { grid-column: 1; grid-row: 3; font-size: 12px; }
    .s { grid-column: 1; }
    .body { padding: 0 2px 22px; }
    .pager { gap: 2px; margin-top: 32px; }
    .pager :global(button) { min-width: 34px; height: 34px; padding: 0 4px; font-size: 14px; }
  }
</style>

<script>
  const norm = (s: string) => s.toLowerCase().replace(/[\s·\-_/(),.「」]/g, '');
  const input = document.querySelector<HTMLInputElement>('#gq')!;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const terms = Array.from(document.querySelectorAll<HTMLDetailsElement>('.term'));
  const count = document.querySelector('#gn')!;
  const countLine = document.querySelector<HTMLElement>('.count')!;
  const empty = document.querySelector<HTMLElement>('.empty')!;
  const list = document.querySelector<HTMLElement>('.terms')!;
  const pager = document.querySelector<HTMLElement>('.pager')!;
  const PER = 10;
  let cat = '';
  let matched = terms;
  let page = 1;

  // page buttons: all of them up to 7 pages, otherwise first, last and the ones around the current page
  const pageList = (cur: number, last: number) => {
    if (last <= 7) return Array.from({ length: last }, (_, i) => i + 1);
    const lo = Math.max(2, Math.min(cur - 1, last - 4));
    const hi = Math.min(last - 1, Math.max(cur + 1, 5));
    const out = [1];
    if (lo > 2) out.push(0);
    for (let p = lo; p <= hi; p++) out.push(p);
    if (hi < last - 1) out.push(0);
    return [...out, last];
  };
  const arrow = (d: string) => `<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;

  const render = () => {
    const last = Math.max(1, Math.ceil(matched.length / PER));
    page = Math.min(Math.max(page, 1), last);
    const shown = new Set(matched.slice((page - 1) * PER, page * PER));
    for (const t of terms) t.hidden = !shown.has(t);
    count.textContent = String(matched.length);
    countLine.hidden = matched.length === 0;
    empty.hidden = matched.length > 0;
    pager.hidden = last < 2;
    pager.innerHTML = last < 2 ? '' : [
      `<button type="button" data-page="${page - 1}" aria-label="이전 페이지"${page === 1 ? ' disabled' : ''}>${arrow('M15 6l-6 6 6 6')}</button>`,
      ...pageList(page, last).map((p) => p
        ? `<button type="button" data-page="${p}" aria-label="${p}페이지"${p === page ? ' aria-current="page"' : ''}>${p}</button>`
        : '<span class="gap" aria-hidden="true">…</span>'),
      `<button type="button" data-page="${page + 1}" aria-label="다음 페이지"${page === last ? ' disabled' : ''}>${arrow('M9 6l6 6-6 6')}</button>`,
    ].join('');
  };
  // a new search or category starts again from page 1
  const filter = () => {
    const query = norm(input.value);
    matched = terms.filter((t) => (!cat || t.dataset.cat === cat) && t.dataset.q!.includes(query));
    page = 1;
    render();
  };
  const setCat = (key: string) => {
    cat = key;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.cat === key)));
    filter();
  };
  const reset = () => { input.value = ''; setCat(''); };

  input.addEventListener('input', filter);
  chips.forEach((c) => c.addEventListener('click', () => setCat(c.dataset.cat!)));
  document.querySelector('.reset')!.addEventListener('click', () => { reset(); input.focus(); });
  // turning a page goes back to the top of the list and puts focus on its first term
  pager.addEventListener('click', (e) => {
    const b = (e.target as Element).closest('button');
    if (!b || b.disabled) return;
    page = Number(b.dataset.page);
    render();
    countLine.scrollIntoView({ block: 'start' });
    matched[(page - 1) * PER]?.querySelector('summary')!.focus({ preventScroll: true });
  });

  // open a term from the address (/library/glossary#mtls) or a 관련 용어 link: clear the filters if they hide it,
  // and turn to the page it is on
  const go = (id: string, fromLink = false) => {
    const t = document.getElementById(id);
    if (!(t instanceof HTMLDetailsElement)) return;
    if (!matched.includes(t)) reset();
    page = Math.floor(matched.indexOf(t) / PER) + 1;
    render();
    t.open = true;
    const smooth = fromLink && !matchMedia('(prefers-reduced-motion: reduce)').matches;
    t.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
    // after a 관련 용어 link, keyboard focus follows to the term it opened
    if (fromLink) t.querySelector('summary')!.focus({ preventScroll: true });
  };
  document.querySelectorAll<HTMLAnchorElement>('.rel a').forEach((a) => a.addEventListener('click', (e) => {
    e.preventDefault();
    const id = a.hash.slice(1);
    history.pushState(null, '', `#${id}`);
    go(id, true);
  }));
  // an opened term puts its own address in the bar, so it can be copied and shared
  terms.forEach((t) => t.addEventListener('toggle', () => { if (t.open) history.replaceState(null, '', `#${t.id}`); }));
  addEventListener('hashchange', () => go(decodeURIComponent(location.hash.slice(1))));
  filter();
  list.classList.add('ready');
  if (location.hash) go(decodeURIComponent(location.hash.slice(1)));
</script>

---
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import Icon from '../../components/Icon.astro';
import ResourceTabs from '../../components/ResourceTabs.astro';

// 자료실 > 영상. The first video is featured (large); the rest are small cards, PAGE at first and PAGE more per
// 영상 더보기. Every video plays on this site in one large player (YouTube, privacy-enhanced domain).
// youtube: the id from the video's link (youtube.com/watch?v=<id>), empty until the edited video is uploaded
// (the card then shows 공개 준비 중); length: running time as YouTube shows it ('12:30').
const PAGE = 6;
const videos = [
  { title: '신영이노베이션 소개', note: '신영이노베이션이 하는 일과 Trust Gateway를 소개합니다.', youtube: '', length: '' },
  { title: '결제 이상거래 탐지 시연', note: '결제 요청의 기기와 위치 신호를 대조해 평소와 다른 거래를 찾아내는 흐름입니다.', youtube: '', length: '' },
  { title: 'VPN 대체 업무 접속 시연', note: 'PC와 휴대폰 확인만으로 사내 업무 시스템에 안전하게 접속하는 흐름입니다.', youtube: '', length: '' },
];
const [featured, ...rest] = videos;
const thumb = (id: string, size: string) => `https://i.ytimg.com/vi/${id}/${size}.jpg`;
---
<Base title="자료실 영상" description="신영이노베이션과 Trust Gateway를 소개하는 영상." tone="light">
  <PageTitle title="영상">신영이노베이션과 Trust Gateway를 영상으로 소개합니다.<ResourceTabs slot="after" /></PageTitle>

  <section class="section lib">
    <div class="wrap">
      <div class="feat reveal">
        {featured.youtube
          ? <button type="button" class="vframe" data-yt={featured.youtube} data-title={featured.title} aria-label={`${featured.title} 재생`}>
              <img src={thumb(featured.youtube, 'maxresdefault')} alt="" width="1280" height="720"
                onerror="this.onerror=null;this.src=this.src.replace('maxresdefault','hqdefault')" />
              <span class="play big"><Icon name="play" size={30} /></span>
              {featured.length && <span class="len">{featured.length}</span>}
            </button>
          : <div class="vframe empty"><span class="play big"><Icon name="play" size={30} /></span><span class="soon">공개 준비 중</span></div>}
        <div class="feat-copy">
          <h2>{featured.title}</h2>
          <p>{featured.note}</p>
        </div>
      </div>

      {rest.length > 0 && (
        <ul class="vgrid reveal">
          {rest.map((v, i) => (
            <li class="vcard" hidden={i >= PAGE}>
              {v.youtube
                ? <button type="button" class="vframe" data-yt={v.youtube} data-title={v.title} aria-label={`${v.title} 재생`}>
                    <img src={thumb(v.youtube, 'hqdefault')} alt="" loading="lazy" width="480" height="360" />
                    <span class="play"><Icon name="play" size={20} /></span>
                    {v.length && <span class="len">{v.length}</span>}
                  </button>
                : <div class="vframe empty"><span class="play"><Icon name="play" size={20} /></span><span class="soon">공개 준비 중</span></div>}
              <h3>{v.title}</h3>
            </li>
          ))}
        </ul>
      )}
      {rest.length > PAGE && <button type="button" class="more" data-page={PAGE}>영상 더보기</button>}
    </div>
  </section>

  <!-- one player for every video: a large YouTube player over the page, so long videos play big on this site -->
  <dialog class="player" aria-label="영상 재생">
    <button type="button" class="player-close" aria-label="닫기">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <div class="player-box"><div class="player-frame"></div></div>
  </dialog>
</Base>

<style>
  .lib { padding-top: 0; }
  .feat { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: center; }
  .feat-copy { display: grid; gap: 10px; }
  .feat-copy h2 { font-size: clamp(20px, 1vw + 12px, 26px); font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
  .feat-copy p { font-size: 16px; line-height: 1.7; color: var(--ink-2); }
  .vframe { position: relative; display: grid; place-items: center; width: 100%; aspect-ratio: 16 / 9; padding: 0; border: 0; border-radius: 18px; overflow: hidden; background: #111a2b; font: inherit; color: inherit; cursor: pointer; }
  .vframe img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .vframe.empty { background: radial-gradient(80% 90% at 30% 20%, #23406a, #111a2b); cursor: default; }
  .play { position: relative; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: rgb(255 255 255 / .92); color: var(--ink); transition: scale .25s var(--ease); }
  .play.big { width: 72px; height: 72px; }
  .vframe.empty .play { background: rgb(255 255 255 / .14); color: rgb(255 255 255 / .7); }
  button.vframe:hover .play { scale: 1.08; }
  .len { position: absolute; right: 10px; bottom: 10px; padding: 3px 8px; border-radius: 6px; background: rgb(0 0 0 / .72); color: #fff; font-size: 12px; font-weight: 600; font-variant-numeric: tabular-nums; }
  .soon { position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 999px; background: rgb(255 255 255 / .14); font-size: 13px; font-weight: 600; color: rgb(255 255 255 / .8); }
  .vgrid { list-style: none; margin: clamp(32px, 4vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 28px 20px; }
  .vcard { display: grid; gap: 12px; align-content: start; }
  .vcard .vframe { border-radius: 14px; }
  .vcard h3 { font-size: 16px; font-weight: 700; line-height: 1.45; color: var(--ink); }

  .more { display: block; margin: 32px auto 0; padding: 0 26px; height: 48px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; font-size: 15px; font-weight: 700; color: var(--ink); cursor: pointer; }
  .more:hover { border-color: var(--ink); }

  /* the player: a 16:9 frame as large as the screen allows, over a dark backdrop, with the close button above it */
  .player { width: min(1120px, 92vw); max-width: none; max-height: none; padding: 56px 0 0; border: 0; background: transparent; overflow: visible; }
  .player::backdrop { background: rgb(8 14 26 / .84); }
  .player-box { position: relative; aspect-ratio: 16 / 9; max-height: 84vh; margin: 0 auto; border-radius: 14px; overflow: hidden; background: #000; }
  .player-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .player-close { position: absolute; top: 0; right: 0; display: grid; place-items: center; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .14); color: #fff; cursor: pointer; }
  .player-close:hover { background: rgb(255 255 255 / .26); }
  :global(html:has(.player[open])) { overflow: hidden; }

  @media (max-width: 1023px) {
    .vgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .feat { grid-template-columns: 1fr; }
    /* small videos become a list: thumbnail on the left, title on the right */
    .vgrid { grid-template-columns: 1fr; gap: 16px; }
    .vcard { grid-template-columns: 42% minmax(0, 1fr); align-items: center; gap: 14px; }
    .vcard .vframe { border-radius: 10px; }
    .vcard .play { width: 36px; height: 36px; }
    .vcard .soon { display: none; }
    .player { width: 100vw; }
    .player-box { border-radius: 0; }
    .player-close { right: 12px; }
  }
</style>

<script>
  // 영상 더보기: reveal the next PAGE hidden videos; the button goes away once all are shown
  const more = document.querySelector<HTMLButtonElement>('.more');
  more?.addEventListener('click', () => {
    const rest = Array.from(document.querySelectorAll<HTMLElement>('.vgrid .vcard[hidden]'));
    const page = Number(more.dataset.page);
    rest.slice(0, page).forEach((li) => { li.hidden = false; });
    if (rest.length <= page) more.remove();
  });

  // play on this site: open the large player and load YouTube (privacy-enhanced domain) only when asked;
  // closing it (button, backdrop or Esc) removes the player so the sound stops
  const player = document.querySelector<HTMLDialogElement>('.player')!;
  const frame = player.querySelector<HTMLElement>('.player-frame')!;
  document.querySelectorAll<HTMLButtonElement>('button.vframe[data-yt]').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.dataset.title ?? '영상';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    frame.replaceChildren(f);
    player.showModal();
  }));
  player.querySelector('.player-close')!.addEventListener('click', () => player.close());
  player.addEventListener('click', (e) => { if (e.target === player) player.close(); });
  player.addEventListener('close', () => frame.replaceChildren());
</script>

---
// 문의하기: the invitation and our contacts on the left, the form on a card on the right (stacked on small screens:
// invitation, form, contacts). Sending opens the visitor's mail app with the message filled in.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/site';

const types = [
  { v: 'poc', l: '무료 PoC' },
  { v: 'consult', l: '도입 상담' },
  { v: 'ai', l: 'AI컨설팅' },
  { v: 'partner', l: '파트너십' },
  { v: 'etc', l: '기타' },
];
const contacts = [
  { icon: 'call', k: '대표번호', v: company.phone, href: `tel:${company.phone.replaceAll('-', '')}` },
  { icon: 'mail', k: '이메일', v: company.email, href: `mailto:${company.email}` },
  { icon: 'pin', k: '오시는 길', v: company.address },
];
---
<Base title="문의하기" description="무료 PoC, 도입 상담, AI컨설팅, 파트너십 문의." tone="light">
  <section class="contact">
    <div class="wrap grid">
      <div class="intro">
        <h1 class="title">보안 고민부터 새 시스템까지,<br />담당자가 직접 답해&nbsp;드립니다</h1>
        <p class="lead-s">무료 PoC 신청, 도입 상담, AI컨설팅, 파트너십 문의를 받습니다.<br />남겨 주시면 담당자가 연락드립니다.</p>
      </div>

      <ul class="contacts">
        {contacts.map((c) => (
          <li>
            <span class="badge" aria-hidden="true"><Icon name={c.icon} size={20} /></span>
            <span class="c-txt"><span class="c-k">{c.k}</span>{c.href ? <a class="c-v" href={c.href}>{c.v}</a> : <span class="c-v">{c.v}</span>}</span>
          </li>
        ))}
      </ul>

      <form class="form" novalidate>
        <fieldset class="types">
          <legend class="label">문의 유형</legend>
          <div class="type-row">
            {types.map((t, i) => (
              <label class="type"><input type="radio" name="type" value={t.v} checked={i === 0} /><span>{t.l}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="field"><label class="label" for="f-name">이름</label><input id="f-name" name="name" autocomplete="name" placeholder="이름을 입력해 주세요" required /><p class="err" id="e-name" hidden>이름을 입력해 주세요.</p></div>
        <div class="field"><label class="label" for="f-company">회사명</label><input id="f-company" name="company" autocomplete="organization" placeholder="회사명을 입력해 주세요" required /><p class="err" id="e-company" hidden>회사명을 입력해 주세요.</p></div>
        <div class="field"><label class="label" for="f-email">회사 이메일</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required /><p class="err" id="e-email" hidden>이메일 주소를 확인해 주세요.</p></div>
        <div class="field"><label class="label" for="f-phone">연락처 <span class="opt">선택</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder="연락 받으실 번호" /></div>
        <div class="field"><label class="label" for="f-msg">문의 내용</label><textarea id="f-msg" name="message" rows="5" placeholder="필요한 내용과 원하는 일정을 적어 주시면 더 빨리 준비할 수 있습니다" required></textarea><p class="err" id="e-message" hidden>문의 내용을 입력해 주세요.</p></div>

        <label class="agree"><input type="checkbox" name="agree" required /><span>개인정보 수집과 이용에 동의합니다 <span class="opt">필수</span> <a href="/privacy" class="text-link">자세히</a></span></label>
        <p class="err" id="e-agree" hidden>개인정보 수집과 이용에 동의해 주세요.</p>

        <button class="btn primary send" type="submit">문의 보내기</button>
        <p class="note">보내기를 누르면 메일 앱에서 {company.email} 앞으로 작성된 메일이 열립니다.</p>
        <p class="done" role="status" hidden>메일 앱을 열었습니다. 메일 앱에서 보내기를 눌러야 문의가 전달됩니다.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* one quiet surface with a soft brand haze behind the invitation */
  .contact {
    padding: calc(var(--header-h) + 88px) 0 var(--section-y);
    background: radial-gradient(640px 420px at 16% 34%, rgba(54, 99, 153, .09), transparent 70%), #f4f7fb;
  }
  .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); column-gap: clamp(40px, 6vw, 96px);
    grid-template-areas: '. form' 'intro form' 'contacts form' '. form'; grid-template-rows: 1fr auto auto 1fr;
  }
  .intro { grid-area: intro; }
  .contacts { grid-area: contacts; }
  .form { grid-area: form; }

  .title { font-size: clamp(32px, 2.6vw + 10px, 48px); line-height: 1.28; letter-spacing: -0.03em; font-weight: 700; color: var(--ink); }
  .lead-s { margin-top: 24px; font-size: clamp(16px, .4vw + 13px, 19px); line-height: 1.7; color: var(--ink-2); }

  .contacts { list-style: none; margin: 48px 0 0; padding: 0; display: grid; gap: 20px; }
  .contacts li { display: flex; align-items: center; gap: 16px; }
  .badge { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--blue); color: #fff; }
  .c-txt { display: grid; gap: 2px; }
  .c-k { font-size: 14px; color: var(--ink-3); }
  .c-v { font-size: 17px; font-weight: 600; color: var(--ink); line-height: 1.5; }
  a.c-v:hover { color: var(--blue); }

  .form {
    display: grid; gap: 20px; align-content: start; padding: clamp(24px, 3vw, 40px); border-radius: 24px; background: #fff;
    border: 1px solid rgba(25, 31, 40, .06); box-shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 24px 48px rgba(16, 24, 40, .07);
  }
  .types { border: 0; margin: 0; padding: 0; min-width: 0; }
  .label { display: block; font-weight: 600; font-size: 15px; margin-bottom: 8px; color: var(--ink); }
  .opt { font-weight: 500; color: var(--ink-3); font-size: 13px; }
  .type-row { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .type { position: relative; }
  .type input { position: absolute; opacity: 0; pointer-events: none; }
  .type span {
    display: grid; place-items: center; height: 44px; padding: 0 6px; border: 1px solid var(--line); border-radius: 10px; background: #fff;
    font-size: 14px; font-weight: 600; white-space: nowrap; color: var(--ink-2); cursor: pointer; transition: background-color .2s var(--ease), border-color .2s var(--ease), color .2s var(--ease);
  }
  .type span:hover { border-color: var(--ink-3); }
  .type input:checked + span { background: var(--blue); border-color: var(--blue); color: #fff; }
  .type input:focus-visible + span { outline: 2px solid var(--orange); outline-offset: 2px; }

  input:not([type='radio']):not([type='checkbox']), textarea {
    width: 100%; font: inherit; font-size: 16px; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px;
  }
  input:not([type='radio']):not([type='checkbox']) { height: 48px; }
  textarea { resize: vertical; min-height: 128px; line-height: 1.6; }
  ::placeholder { color: #a6aeb9; }
  input:focus, textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(54, 99, 153, .15); }
  [aria-invalid='true'] { border-color: #c4361b !important; }
  .err { color: #c4361b; font-size: 14px; margin-top: 6px; }
  .agree { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--ink-2); }
  .agree input { margin-top: 4px; width: 18px; height: 18px; accent-color: var(--blue); }
  .send { width: 100%; height: 52px; border-radius: 12px; font-size: 16px; }
  .note { margin-top: -8px; font-size: 13px; line-height: 1.6; color: var(--ink-3); text-align: center; }
  .done { background: var(--mist); border-radius: var(--r-md); padding: 14px 18px; font-weight: 600; color: var(--blue); }

  @media (max-width: 1023px) {
    .contact { padding-top: calc(var(--header-h) + 64px); }
    .grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'form' 'contacts'; grid-template-rows: auto; row-gap: 40px; }
    .form { max-width: 640px; }
    .contacts { margin-top: 0; }
  }
  @media (max-width: 559px) {
    .type-row { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

<script>
  import { company } from '../data/site';
  const form = document.querySelector<HTMLFormElement>('.form')!;
  const pre = new URLSearchParams(location.search).get('type');
  const preMap: Record<string, string> = { poc: 'poc', ai: 'ai', partner: 'partner', consult: 'consult' };
  if (pre && preMap[pre]) (form.querySelector(`input[value="${preMap[pre]}"]`) as HTMLInputElement | null)?.click();

  const show = (id: string, bad: boolean, field?: HTMLElement | null) => {
    const el = document.getElementById(id); if (el) el.hidden = !bad;
    field?.setAttribute('aria-invalid', String(bad));
  };
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name && t.name !== 'type') show(`e-${t.name}`, false, t);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const val = (k: string) => String(fd.get(k) ?? '').trim();
    const checks: [string, boolean][] = [
      ['name', !val('name')],
      ['company', !val('company')],
      ['email', !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('email'))],
      ['message', !val('message')],
      ['agree', !fd.get('agree')],
    ];
    let first: HTMLElement | null = null;
    for (const [k, bad] of checks) {
      const field = form.querySelector<HTMLElement>(`[name="${k}"]`);
      show(`e-${k}`, bad, field);
      if (bad && !first) first = field;
    }
    if (first) { first.focus(); return; }
    const type = (form.querySelector('input[name="type"]:checked') as HTMLInputElement).nextElementSibling?.textContent ?? '';
    const subject = `[${type}] ${val('company')} ${val('name')}`;
    const body = [`문의 유형: ${type}`, `이름: ${val('name')}`, `회사: ${val('company')}`, `이메일: ${val('email')}`, `연락처: ${val('phone')}`, '', val('message')].join('\n');
    location.href = `mailto:${company.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    form.querySelector<HTMLElement>('.done')!.hidden = false;
  });
</script>

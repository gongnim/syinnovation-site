---
import Base from '../layouts/Base.astro';
import { company } from '../data/site';

const types = [
  { v: 'poc', l: '무료 PoC' },
  { v: 'consult', l: '도입 상담' },
  { v: 'ai', l: 'AI컨설팅' },
  { v: 'partner', l: '파트너십' },
  { v: 'etc', l: '기타' },
];
---
<Base title="문의하기" description="무료 PoC, 도입 상담, AI컨설팅, 파트너십 문의." tone="light">
  <section class="page-hero">
    <div class="wrap narrow">
      <h1 class="h1">문의하기</h1>
      <p class="lead">무료 PoC 신청부터 도입 상담, AI컨설팅, 파트너십까지. 남겨 주시면 담당자가 연락드립니다.</p>
    </div>
  </section>

  <section class="form-sec">
    <div class="wrap narrow">
      <form class="form" novalidate>
        <fieldset class="types">
          <legend class="label">문의 유형</legend>
          <div class="type-row">
            {types.map((t, i) => (
              <label class="type"><input type="radio" name="type" value={t.v} checked={i === 0} /><span>{t.l}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="grid2">
          <div class="field"><label class="label" for="f-name">이름</label><input id="f-name" name="name" autocomplete="name" required /><p class="err" id="e-name" hidden>이름을 입력해 주세요.</p></div>
          <div class="field"><label class="label" for="f-company">회사명</label><input id="f-company" name="company" autocomplete="organization" required /><p class="err" id="e-company" hidden>회사명을 입력해 주세요.</p></div>
          <div class="field"><label class="label" for="f-email">회사 이메일</label><input id="f-email" name="email" type="email" autocomplete="email" required /><p class="err" id="e-email" hidden>이메일 주소를 확인해 주세요.</p></div>
          <div class="field"><label class="label" for="f-phone">연락처 <span class="opt">선택</span></label><input id="f-phone" name="phone" type="tel" autocomplete="tel" /></div>
        </div>
        <div class="field"><label class="label" for="f-msg">문의 내용</label><textarea id="f-msg" name="message" rows="6" required></textarea><p class="err" id="e-message" hidden>문의 내용을 입력해 주세요.</p></div>

        <label class="agree"><input type="checkbox" name="agree" required /><span>개인정보 수집과 이용에 동의합니다. <a href="/privacy" class="text-link">자세히</a></span></label>
        <p class="err" id="e-agree" hidden>개인정보 수집과 이용에 동의해 주세요.</p>

        <div class="submit-row">
          <button class="btn primary" type="submit">문의 보내기</button>
          <p class="small">보내기를 누르면 메일 앱에서 {company.email} 앞으로 작성된 메일이 열립니다.</p>
        </div>
        <p class="done" role="status" hidden>메일 앱을 열었습니다. 메일 앱에서 보내기를 눌러야 문의가 전달됩니다.</p>
      </form>
    </div>
  </section>
</Base>

<style>
  .page-hero { padding-bottom: 32px; }
  .form-sec { padding-bottom: var(--section-y); }
  .form { display: grid; gap: 24px; border: 1px solid var(--line); border-radius: var(--r-xl); padding: clamp(24px, 4vw, 48px); }
  .types { border: 0; margin: 0; padding: 0; }
  .label { display: block; font-weight: 700; font-size: 15px; margin-bottom: 10px; }
  .opt { font-weight: 500; color: var(--ink-3); font-size: 13px; }
  .type-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .type input { position: absolute; opacity: 0; pointer-events: none; }
  .type span { display: inline-block; padding: 10px 20px; border: 1px solid var(--line); border-radius: 999px; font-weight: 600; cursor: pointer; color: var(--ink-2); }
  .type input:checked + span { background: var(--ink); border-color: var(--ink); color: #fff; }
  .type input:focus-visible + span { outline: 2px solid var(--orange); outline-offset: 3px; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  input:not([type='radio']):not([type='checkbox']), textarea {
    width: 100%; font: inherit; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: var(--r-md); padding: 13px 16px;
  }
  input:focus, textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(54,99,153,.15); }
  [aria-invalid='true'] { border-color: #c4361b !important; }
  .err { color: #c4361b; font-size: 14px; margin-top: 6px; }
  .agree { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--ink-2); }
  .agree input { margin-top: 5px; width: 18px; height: 18px; accent-color: var(--blue); }
  .submit-row { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .done { background: var(--mist); border-radius: var(--r-md); padding: 14px 18px; font-weight: 600; color: var(--blue); }
  @media (max-width: 767px) { .grid2 { grid-template-columns: 1fr; } }
</style>

<script>
  import { company } from '../data/site';
  const form = document.querySelector<HTMLFormElement>('.form')!;
  const pre = new URLSearchParams(location.search).get('type');
  const preMap: Record<string, string> = { poc: 'poc', ai: 'ai', partner: 'partner', consult: 'consult' };
  if (pre && preMap[pre]) (form.querySelector(`input[value="${preMap[pre]}"]`) as HTMLInputElement | null)?.click();

  const show = (id: string, bad: boolean, field?: HTMLElement | null) => {
    const el = document.getElementById(id); if (el) el.hidden = !bad;
    field?.setAttribute('aria-invalid', String(bad));
  };
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name && t.name !== 'type') show(`e-${t.name}`, false, t);
  });
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const val = (k: string) => String(fd.get(k) ?? '').trim();
    const checks: [string, boolean][] = [
      ['name', !val('name')],
      ['company', !val('company')],
      ['email', !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('email'))],
      ['message', !val('message')],
      ['agree', !fd.get('agree')],
    ];
    let first: HTMLElement | null = null;
    for (const [k, bad] of checks) {
      const field = form.querySelector<HTMLElement>(`[name="${k}"]`);
      show(`e-${k}`, bad, field);
      if (bad && !first) first = field;
    }
    if (first) { first.focus(); return; }
    const type = (form.querySelector('input[name="type"]:checked') as HTMLInputElement).nextElementSibling?.textContent ?? '';
    const subject = `[${type}] ${val('company')} ${val('name')}`;
    const body = [`문의 유형: ${type}`, `이름: ${val('name')}`, `회사: ${val('company')}`, `이메일: ${val('email')}`, `연락처: ${val('phone')}`, '', val('message')].join('\n');
    location.href = `mailto:${company.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    form.querySelector<HTMLElement>('.done')!.hidden = false;
  });
</script>

---
import { bothLangs } from '../../lib/i18n';
export const getStaticPaths = bothLangs;
// 문의하기: the invitation and our contacts on the left, the form on a card on the right (stacked on small screens:
// invitation, form, contacts). Sending posts the form to Web3Forms, which emails it to company.email (user, 2026-11-16:
// with the old mail-app link, visitors still had to send the mail themselves).
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { company } from '../../data/site';
import { langOf, href } from '../../lib/i18n';
const lang = langOf(Astro.url);
const en = lang === 'en';

// the label is also what the email says; the values (and ?type=) are the same in both languages
const types = [
  { v: 'poc', l: en ? 'Initial consultation (free)' : '사전 컨설팅(무료)' },
  { v: 'consult', l: en ? 'Adoption inquiry' : '도입 상담' },
  // the no-break space keeps "AI 프로세스" together but lets a narrow chip put 혁신 on a second line (the plain name would
  // be glued whole by sentence-breaks.js and spill out of the chip; user, 2026-11-17)
  { v: 'ai', l: en ? 'PI by AI' : 'AI 프로세스 혁신' },
  { v: 'partner', l: en ? 'Partnership' : '파트너십' },
  { v: 'etc', l: en ? 'Other' : '기타' },
];
const contacts = [
  { icon: 'mail', k: en ? 'Email' : '이메일', v: company.email, href: `mailto:${company.email}` },
  { icon: 'pin', k: en ? 'Address' : '오시는 길', v: en ? company.en.address : company.address },
];
---
<Base title={en ? 'Contact us' : '문의하기'} description={en ? 'Contact SYINNOVATION: an initial consultation (free), inquiries about adopting Trust Gateway for Zero Trust security, PI by AI, and partnerships. The person in charge will contact you.' : '신영이노베이션 문의: 사전 컨설팅(무료), 제로트러스트 보안 Trust Gateway 도입 상담, AI 프로세스 혁신, 파트너십 문의를 받습니다. 남겨 주시면 담당자가 연락드립니다.'} tone="light">
  <section class="contact">
    <div class="wrap grid">
      <div class="intro">
        <h1 class="title">{en ? <>From security concerns to new systems,<br />the person in charge answers you&nbsp;directly</> : <>보안 고민부터 새 시스템까지,<br />담당자가 직접 답해&nbsp;드립니다</>}</h1>
        <p class="lead-s">{en ? <>We take requests for an initial consultation (free), adoption inquiries, PI by AI projects, and partnership inquiries.<br />Leave a message and the person in charge will contact you.</> : <>사전 컨설팅(무료) 신청, 도입 상담, AI 프로세스 혁신, 파트너십 문의를 받습니다.<br />남겨 주시면 담당자가 연락드립니다.</>}</p>
      </div>

      <ul class="contacts">
        {contacts.map((c) => (
          <li>
            <span class="badge" aria-hidden="true"><Icon name={c.icon} size={20} /></span>
            <span class="c-txt"><span class="c-k">{c.k}</span>{c.href ? <a class="c-v" href={c.href}>{c.v}</a> : <span class="c-v">{c.v}</span>}</span>
          </li>
        ))}
      </ul>

      <form class="form" novalidate data-mail={en ? 'Inquiry type|Name|Company|Email|Phone|Message|Sent from' : undefined}>
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <fieldset class="types">
          <legend class="label">{en ? <>Inquiry type</> : <>문의 유형</>}</legend>
          <div class:list={['type-row', { en }]}>
            {types.map((t, i) => (
              <label class="type"><input type="radio" name="type" value={t.v} checked={i === 0} /><span>{t.l.split('(').map((p, k) => (k ? <><wbr />({p}</> : p))}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="field"><label class="label" for="f-name">{en ? <>Name</> : <>이름</>}</label><input id="f-name" name="name" autocomplete="name" placeholder={en ? 'Enter your name' : '이름을 입력해 주세요'} required /><p class="err" id="e-name" hidden>{en ? <>Please enter your name.</> : <>이름을 입력해 주세요.</>}</p></div>
        <div class="field"><label class="label" for="f-company">{en ? <>Company</> : <>회사명</>}</label><input id="f-company" name="company" autocomplete="organization" placeholder={en ? 'Enter your company name' : '회사명을 입력해 주세요'} required /><p class="err" id="e-company" hidden>{en ? <>Please enter your company name.</> : <>회사명을 입력해 주세요.</>}</p></div>
        <div class="field"><label class="label" for="f-email">{en ? <>Work email</> : <>회사 이메일</>}</label><input id="f-email" name="email" type="email" autocomplete="email" placeholder="name@company.com" required /><p class="err" id="e-email" hidden>{en ? <>Please check your email address.</> : <>이메일 주소를 확인해 주세요.</>}</p></div>
        <div class="field"><label class="label" for="f-phone">{en ? <>Phone <span class="opt">Optional</span></> : <>연락처 <span class="opt">선택</span></>}</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" placeholder={en ? 'A number where we can reach you' : '연락 받으실 번호'} /></div>
        <div class="field"><label class="label" for="f-msg">{en ? <>Message</> : <>문의 내용</>}</label><textarea id="f-msg" name="message" rows="5" placeholder={en ? 'Tell us what you need and your preferred timeline so we can prepare sooner' : '필요한 내용과 원하는 일정을 적어 주시면 더 빨리 준비할 수 있습니다'} required></textarea><p class="err" id="e-message" hidden>{en ? <>Please enter your message.</> : <>문의 내용을 입력해 주세요.</>}</p></div>

        <label class="agree"><input type="checkbox" name="agree" required /><span>{en ? <>I agree to the collection and use of my personal information <span class="opt">Required</span> <a href={href('/privacy', lang)} class="text-link">Details</a></> : <>개인정보 수집과 이용에 동의합니다 <span class="opt">필수</span> <a href={href('/privacy', lang)} class="text-link">자세히</a></>}</span></label>
        <p class="err" id="e-agree" hidden>{en ? <>Please agree to the collection and use of your personal information.</> : <>개인정보 수집과 이용에 동의해 주세요.</>}</p>

        <button class="btn primary send" type="submit" data-sending={en ? 'Sending...' : '보내는 중...'}>{en ? <>Send inquiry</> : <>문의 보내기</>}</button>
        <p class="note">{en ? <>Your inquiry goes to {company.email}, and the person in charge will get back to you.</> : <>보내 주신 문의는 {company.email}로 전달되며, 담당자가 확인 후 연락드립니다.</>}</p>
        <p class="done" role="status" tabindex="-1" hidden>{en ? <>Your inquiry has been sent. The person in charge will get back to you.</> : <>문의가 접수되었습니다. 담당자가 확인 후 연락드립니다.</>}</p>
        <p class="fail" role="alert" hidden>{en ? <>We could not send your inquiry. Please try again in a moment, or email us at <a href={`mailto:${company.email}`}>{company.email}</a>.</> : <>문의를 보내지 못했습니다. 잠시 후 다시 시도하시거나 <a href={`mailto:${company.email}`}>{company.email}</a>로 메일을 보내 주세요.</>}</p>
      </form>
    </div>
  </section>
</Base>

<style>
  /* one quiet surface with a soft brand haze behind the invitation */
  .contact {
    padding: calc(var(--header-h) + 88px) 0 var(--section-y);
    background: radial-gradient(640px 420px at 16% 34%, rgba(54, 99, 153, .09), transparent 70%), #f4f7fb;
  }
  .grid {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 520px); column-gap: clamp(40px, 6vw, 96px);
    grid-template-areas: '. form' 'intro form' 'contacts form' '. form'; grid-template-rows: 1fr auto auto 1fr;
  }
  .intro { grid-area: intro; }
  .contacts { grid-area: contacts; }
  .form { grid-area: form; }

  .title { font-size: clamp(32px, 2.6vw + 10px, 48px); line-height: 1.28; letter-spacing: -0.03em; font-weight: 700; color: var(--ink); }
  .lead-s { margin-top: 24px; font-size: clamp(16px, .4vw + 13px, 19px); line-height: 1.7; color: var(--ink-2); }

  .contacts { list-style: none; margin: 48px 0 0; padding: 0; display: grid; gap: 20px; }
  .contacts li { display: flex; align-items: center; gap: 16px; }
  .badge { flex: none; display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; background: var(--blue); color: #fff; }
  .c-txt { display: grid; gap: 2px; }
  .c-k { font-size: 14px; color: var(--ink-3); }
  .c-v { font-size: 17px; font-weight: 600; color: var(--ink); line-height: 1.5; }
  a.c-v:hover { color: var(--blue); }

  .form {
    display: grid; gap: 20px; align-content: start; padding: clamp(24px, 3vw, 40px); border-radius: 24px; background: #fff;
    border: 1px solid rgba(25, 31, 40, .06); box-shadow: 0 1px 2px rgba(16, 24, 40, .04), 0 24px 48px rgba(16, 24, 40, .07);
  }
  .types { border: 0; margin: 0; padding: 0; min-width: 0; }
  .label { display: block; font-weight: 600; font-size: 15px; margin-bottom: 8px; color: var(--ink); }
  .opt { font-weight: 500; color: var(--ink-3); font-size: 13px; }
  /* three chips, then two wider ones (6 columns): five in a row left 75px a chip, too narrow for AI 프로세스 혁신
     (user, 2026-11-17). A label that still does not fit wraps: "(무료)" and "혁신" go to a second line */
  .type-row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .type-row:not(.en) .type { grid-column: span 2; }
  .type-row:not(.en) .type:nth-child(n + 4) { grid-column: span 3; }
  /* English labels are longer: three columns, the first option across two (user, 2026-11-16: chips spilled over) */
  .type-row.en { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .type-row.en .type:first-child { grid-column: span 2; }
  .type { position: relative; }
  .type input { position: absolute; opacity: 0; pointer-events: none; }
  .type span {
    display: grid; place-items: center; height: 44px; padding: 0 6px; border: 1px solid var(--line); border-radius: 10px; background: #fff;
    font-size: 14px; font-weight: 600; line-height: 1.2; text-align: center; word-break: keep-all; color: var(--ink-2); cursor: pointer; transition: background-color .2s var(--ease), border-color .2s var(--ease), color .2s var(--ease);
  }
  .type span:hover { border-color: var(--ink-3); }
  .type input:checked + span { background: var(--blue); border-color: var(--blue); color: #fff; }
  .type input:focus-visible + span { outline: 2px solid var(--orange); outline-offset: 2px; }

  input:not([type='radio']):not([type='checkbox']), textarea {
    width: 100%; font: inherit; font-size: 16px; color: var(--ink); background: #fff; border: 1px solid var(--line); border-radius: 10px; padding: 12px 16px;
  }
  input:not([type='radio']):not([type='checkbox']) { height: 48px; }
  textarea { resize: vertical; min-height: 128px; line-height: 1.6; }
  ::placeholder { color: #a6aeb9; }
  input:focus, textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(54, 99, 153, .15); }
  [aria-invalid='true'] { border-color: #c4361b !important; }
  .err { color: #c4361b; font-size: 14px; margin-top: 6px; }
  .agree { display: flex; gap: 10px; align-items: flex-start; font-size: 15px; color: var(--ink-2); }
  .agree input { margin-top: 4px; width: 18px; height: 18px; accent-color: var(--blue); }
  .send { width: 100%; height: 52px; border-radius: 12px; font-size: 16px; }
  .note { margin-top: -8px; font-size: 13px; line-height: 1.6; color: var(--ink-3); text-align: center; }
  .done { background: var(--mist); border-radius: var(--r-md); padding: 14px 18px; font-weight: 600; color: var(--blue); }
  .fail { background: #fdecea; border-radius: var(--r-md); padding: 14px 18px; font-weight: 600; color: #c4361b; }
  .fail a { color: inherit; text-decoration: underline; }
  .send:disabled { opacity: .7; cursor: progress; }
  /* a box only bots fill in (Web3Forms' honeypot): anything ticked here is dropped without sending */
  .hp { display: none; }

  @media (max-width: 1023px) {
    .contact { padding-top: calc(var(--header-h) + 64px); }
    .grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'form' 'contacts'; grid-template-rows: auto; row-gap: 40px; }
    .form { max-width: 640px; }
    .contacts { margin-top: 0; }
  }
  @media (max-width: 559px) {
    .type-row.en { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  import { web3formsKey } from '../../data/site';
  const form = document.querySelector<HTMLFormElement>('.form')!;
  const pre = new URLSearchParams(location.search).get('type');
  const preMap: Record<string, string> = { poc: 'poc', ai: 'ai', partner: 'partner', consult: 'consult' };
  if (pre && preMap[pre]) (form.querySelector(`input[value="${preMap[pre]}"]`) as HTMLInputElement | null)?.click();

  const show = (id: string, bad: boolean, field?: HTMLElement | null) => {
    const el = document.getElementById(id); if (el) el.hidden = !bad;
    field?.setAttribute('aria-invalid', String(bad));
  };
  form.addEventListener('input', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name && t.name !== 'type') show(`e-${t.name}`, false, t);
  });
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(form);
    const val = (k: string) => String(fd.get(k) ?? '').trim();
    const checks: [string, boolean][] = [
      ['name', !val('name')],
      ['company', !val('company')],
      ['email', !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val('email'))],
      ['message', !val('message')],
      ['agree', !fd.get('agree')],
    ];
    let first: HTMLElement | null = null;
    for (const [k, bad] of checks) {
      const field = form.querySelector<HTMLElement>(`[name="${k}"]`);
      show(`e-${k}`, bad, field);
      if (bad && !first) first = field;
    }
    if (first) { first.focus(); return; }
    const done = form.querySelector<HTMLElement>('.done')!, fail = form.querySelector<HTMLElement>('.fail')!;
    const btn = form.querySelector<HTMLButtonElement>('.send')!, label = btn.textContent;
    done.hidden = fail.hidden = true;
    const finished = () => {
      form.reset();
      (form.querySelector('input[name="type"]') as HTMLInputElement).checked = true;
      done.hidden = false; done.focus();
    };
    if (fd.get('botcheck')) { finished(); return; } // a bot ticked the hidden box: pretend, send nothing
    // the label as shown, without the invisible word joiners the line-break middleware puts around '·'
    const type = ((form.querySelector('input[name="type"]:checked') as HTMLInputElement).nextElementSibling?.textContent ?? '').replace(/\u2060/g, '');
    // the email's field names: English pages pass theirs in data-mail, Korean pages use these
    const [lType, lName, lCompany, lEmail, lPhone, lMsg, lFrom] = form.dataset.mail?.split('|') ?? ['문의 유형', '이름', '회사명', '이메일', '연락처', '문의 내용', '보낸 페이지'];
    btn.disabled = true; btn.textContent = btn.dataset.sending ?? label;
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify({
          access_key: web3formsKey,
          subject: `[${type}] ${val('company')} ${val('name')}`,
          from_name: '신영이노베이션 홈페이지',
          replyto: val('email'),
          [lType]: type, [lName]: val('name'), [lCompany]: val('company'), [lEmail]: val('email'), [lPhone]: val('phone') || '-',
          [lMsg]: val('message'), [lFrom]: location.href,
        }),
      });
      const out = await res.json().catch(() => ({}));
      if (!res.ok || !out.success) throw new Error(out.message || String(res.status));
      finished();
    } catch {
      fail.hidden = false; // the message offers the email address instead
    } finally {
      btn.disabled = false; btn.textContent = label;
    }
  });
</script>

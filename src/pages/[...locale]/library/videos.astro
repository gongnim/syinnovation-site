---
import { bothLangs } from '../../../lib/i18n';
export const getStaticPaths = bothLangs;
import Base from '../../../layouts/Base.astro';
import PageTitle from '../../../components/PageTitle.astro';
import ResourceTabs from '../../../components/ResourceTabs.astro';
import VideoTile from '../../../components/VideoTile.astro';
import { langOf } from '../../../lib/i18n';
const lang = langOf(Astro.url);
const en = lang === 'en';

// 자료실 > 영상. Adding a video is one line in `videos`:
//   title, youtube (the id from youtube.com/watch?v=<id>; empty = 공개 준비 중), and optionally
//   length ('12:30', as YouTube shows it), date ('2026.11', newest first), cat (one of CATS), note (featured only),
//   poster ('/images/videos/<name>.jpg', the same image as the YouTube thumbnail; without one YouTube's is used),
//   featured: true (the large one; it stays put however many videos are added; without one, the first is used),
//   en: { title, note, youtube } for the English page (youtube: the English cut's id; without one the Korean video
//   plays there, so end the title with "(Korean)").
// Layout: the featured video large on the left, the SIDE newest beside it, the rest below in a 3-column grid that
// shows PAGE at first and PAGE more per 영상 더보기. From FILTER_FROM videos, category chips appear for the
// categories holding at least CAT_MIN videos; once there are CHANNEL_FROM, a link to the YouTube channel follows.
const CATS = ['회사 소개', '제품 시연', '발표·세미나', '인터뷰'];
const CATS_EN = ['About us', 'Product demos', 'Talks and seminars', 'Interviews']; // same order as CATS
const CHANNEL = 'https://www.youtube.com/@SYINNOVATION';
const PAGE = 6, SIDE = 3, FILTER_FROM = 20, CAT_MIN = 3, CHANNEL_FROM = 11;

interface Video { title: string; youtube: string; poster?: string; length?: string; date?: string; cat?: string; note?: string; featured?: boolean; en?: { title: string; note?: string; youtube?: string; poster?: string; length?: string } }
const videos: Video[] = [
  { title: 'Trust Gateway 소개', note: 'AI 시대의 보안 위협과, 인증 이후에도 매 순간 확인하는 Trust Gateway를 소개합니다.', youtube: 'r5g-txznf9k', poster: '/images/videos/tg-intro-ko.jpg', length: '3:56', date: '2026.11', cat: '회사 소개', featured: true,
    en: { title: 'Introducing Trust Gateway', note: 'The threats of the AI era, and how Trust Gateway checks at every moment, even after authentication.', youtube: 'exZ3M-YwTL8', poster: '/images/videos/tg-intro-en.jpg', length: '3:53' } },
  { title: '신영이노베이션 소개', youtube: 'Pq_ua-irnR4', poster: '/images/videos/company-intro-ko.jpg', length: '2:32', date: '2026.11', cat: '회사 소개',
    en: { title: 'About SYINNOVATION', youtube: 'qYQcWgHRlWM', poster: '/images/videos/company-intro-en.jpg', length: '2:30' } },
  { title: 'AI 프로세스 혁신, 일하는 방식부터', youtube: 'A8a3kLo4i4c', poster: '/images/videos/pi-by-ai-ko.jpg', length: '2:18', date: '2026.11', cat: '회사 소개',
    en: { title: 'PI by AI: starting with how you work', youtube: 'Hhi4CGiCdG8', poster: '/images/videos/pi-by-ai-en.jpg', length: '2:22' } },
  { title: '결제 이상거래 탐지 시연', youtube: 'pFHPBdYVce0', poster: '/images/videos/payment-fds-ko.jpg', length: '0:43', date: '2026.11', cat: '제품 시연',
    en: { title: 'Payment fraud detection demo', youtube: '98huDt6B5Q0', poster: '/images/videos/payment-fds-en.jpg' } },
  { title: '직원 업무 접속 시연', youtube: 'tIgLZ_F0RUo', poster: '/images/videos/employee-access-ko.jpg', length: '0:59', date: '2026.11', cat: '제품 시연',
    en: { title: 'Employee work access demo', youtube: 'y5iq67GGses', poster: '/images/videos/employee-access-en.jpg' } },
];
// English page: the English title, note and category in place of the Korean
if (en) for (const v of videos) { Object.assign(v, v.en); if (v.cat) v.cat = CATS_EN[CATS.indexOf(v.cat)]; }

const featured = videos.find((v) => v.featured) ?? videos[0];
// newest first; videos without a date keep their order after the dated ones
const rest = videos.filter((v) => v !== featured).sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
const side = rest.slice(0, SIDE);
const grid = rest.slice(SIDE);
const cats = (en ? CATS_EN : CATS).filter((c) => videos.filter((v) => v.cat === c).length >= CAT_MIN);
const filters = videos.length >= FILTER_FROM && cats.length >= 2;
---
<Base title={en ? 'Resources: Videos' : '자료실 영상'} description={en ? 'Videos about SYINNOVATION and Trust Gateway.' : '신영이노베이션과 Trust Gateway를 소개하는 영상.'} tone="light">
  <PageTitle title={en ? 'Videos' : '영상'}>{en ? <>SYINNOVATION and Trust Gateway on video.</> : <>신영이노베이션과 Trust Gateway를 영상으로 소개합니다.</>}<ResourceTabs slot="after" /></PageTitle>

  <section class="section lib">
    <div class="wrap">
      {filters && (
        <div class="chips" role="group" aria-label={en ? 'Video categories' : '영상 분류'}>
          <button type="button" class="chip" data-cat="" aria-pressed="true">{en ? <>All</> : <>전체</>}</button>
          {cats.map((c) => <button type="button" class="chip" data-cat={c} aria-pressed="false">{c}</button>)}
        </div>
      )}

      <div class="top reveal" data-side={side.length}>
        <VideoTile size="big" title={featured.title} youtube={featured.youtube} poster={featured.poster} length={featured.length} note={featured.note} />
        {side.length > 0 && (
          <ul class="side" style={`--n: ${side.length}`}>
            {side.map((v) => <li><VideoTile size="side" title={v.title} youtube={v.youtube} poster={v.poster} length={v.length} /></li>)}
          </ul>
        )}
      </div>

      {grid.length > 0 && (
        <ul class="vgrid reveal" data-list="latest">
          {grid.map((v, i) => <li data-cat={v.cat} hidden={i >= PAGE}><VideoTile title={v.title} youtube={v.youtube} poster={v.poster} length={v.length} /></li>)}
        </ul>
      )}
      {/* a chosen category lists all its videos here (newest first), in place of the layout above */}
      {filters && (
        <ul class="vgrid" data-list="all" hidden>
          {[featured, ...rest].map((v) => <li data-cat={v.cat}><VideoTile title={v.title} youtube={v.youtube} poster={v.poster} length={v.length} /></li>)}
        </ul>
      )}
      {(grid.length > PAGE || filters) && <button type="button" class="more" data-page={PAGE} hidden={grid.length <= PAGE}>{en ? <>More videos</> : <>영상 더보기</>}</button>}
      {CHANNEL && videos.length >= CHANNEL_FROM && (
        <a class="channel" href={CHANNEL} target="_blank" rel="noopener">{en ? <>See all on YouTube</> : <>유튜브 채널에서 전체 보기</>}</a>
      )}
    </div>
  </section>

  <!-- one player for every video: a large YouTube player over the page, so long videos play big on this site -->
  <dialog class="player" aria-label={en ? 'Video player' : '영상 재생'}>
    <button type="button" class="player-close" aria-label={en ? 'Close' : '닫기'}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <div class="player-box"><div class="player-frame"></div></div>
  </dialog>
</Base>

<style>
  .lib { padding-top: 0; }

  /* first row: the featured video and, beside it, up to three newest stacked to the same height */
  /* n side tiles stacked beside the 16:9 featured one stay close to 16:9 (no cropped thumbnails) when the columns
     are about n : 1 */
  .top { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 16px; }
  .top[data-side='2'] { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  .top[data-side='1'] { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .top[data-side='0'] { grid-template-columns: minmax(0, 1fr); }
  .side { list-style: none; margin: 0; padding: 0; display: grid; grid-template-rows: repeat(var(--n), minmax(0, 1fr)); gap: 16px; }
  .side li { min-height: 0; }

  .vgrid { list-style: none; margin: 16px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }

  .chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin-bottom: 28px; }
  .chip { flex: none; white-space: nowrap; height: 38px; padding: 0 16px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; font-size: 14px; font-weight: 600; color: var(--ink-2); cursor: pointer; }
  .chip:hover { border-color: var(--ink-3); }
  .chip[aria-pressed='true'] { border-color: var(--ink); background: var(--ink); color: #fff; }

  .more { display: block; margin: 32px auto 0; padding: 0 26px; height: 48px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font: inherit; font-size: 15px; font-weight: 700; color: var(--ink); cursor: pointer; }
  .more:hover { border-color: var(--ink); }
  .channel { display: table; margin: 20px auto 0; font-size: 15px; font-weight: 700; color: var(--blue); }
  .channel:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* the player: a 16:9 frame as large as the screen allows, over a dark backdrop, with the close button above it */
  .player { width: min(1120px, 92vw); max-width: none; max-height: none; padding: 56px 0 0; border: 0; background: transparent; overflow: visible; }
  .player::backdrop { background: rgb(8 14 26 / .84); }
  .player-box { position: relative; aspect-ratio: 16 / 9; max-height: 84vh; margin: 0 auto; border-radius: 14px; overflow: hidden; background: #000; }
  .player-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .player-close { position: absolute; top: 0; right: 0; display: grid; place-items: center; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .14); color: #fff; cursor: pointer; }
  .player-close:hover { background: rgb(255 255 255 / .26); }
  :global(html:has(.player[open])) { overflow: hidden; }

  @media (max-width: 1023px) {
    /* [data-side] too: those column rules are more specific and kept the 2 : 1 split on phones */
    .top, .top[data-side] { grid-template-columns: minmax(0, 1fr); }
    .side { grid-template-rows: none; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); } /* as many columns as side videos, no empty slot */
    .side :global(.tile.side) { height: auto; aspect-ratio: 16 / 9; }
    .vgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    /* below the featured video everything reads as one list */
    .side { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 8px; }
    .side :global(.tile.side) { aspect-ratio: auto; }
    .vgrid { grid-template-columns: minmax(0, 1fr); gap: 14px; margin-top: 14px; }
    .chips { flex-wrap: nowrap; justify-content: flex-start; overflow-x: auto; margin: 0 calc(var(--gutter) * -1) 20px; padding: 0 var(--gutter) 4px; scrollbar-width: none; }
    .chips::-webkit-scrollbar { display: none; }
    .player { width: 100vw; }
    .player-box { border-radius: 0; }
    .player-close { right: 12px; }
  }
</style>

<script>
  // which list is showing (the newest after the first row, or one category's videos), how many of it, and 더보기
  const top = document.querySelector<HTMLElement>('.top');
  const latest = document.querySelector<HTMLElement>('[data-list="latest"]');
  const all = document.querySelector<HTMLElement>('[data-list="all"]');
  const more = document.querySelector<HTMLButtonElement>('.more');
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.chip'));
  const PAGE = Number(more?.dataset.page ?? 6);
  let cat = '', limit = PAGE;
  const render = () => {
    const filtering = cat !== '';
    if (top) top.hidden = filtering;
    if (latest) latest.hidden = filtering;
    if (all) all.hidden = !filtering;
    const list = filtering ? all : latest;
    if (!list) { if (more) more.hidden = true; return; }
    const items = Array.from(list.children) as HTMLElement[];
    const shown = items.filter((li) => !filtering || li.dataset.cat === cat);
    items.forEach((li) => { li.hidden = true; });
    shown.forEach((li, i) => { li.hidden = i >= limit; });
    if (more) more.hidden = shown.length <= limit;
  };
  more?.addEventListener('click', () => { limit += PAGE; render(); });
  chips.forEach((c) => c.addEventListener('click', () => {
    cat = c.dataset.cat ?? '';
    limit = PAGE;
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === c)));
    render();
  }));

  // play on this site: open the large player and load YouTube (privacy-enhanced domain) only when asked;
  // closing it (button, backdrop or Esc) removes the player so the sound stops
  const player = document.querySelector<HTMLDialogElement>('.player')!;
  const frame = player.querySelector<HTMLElement>('.player-frame')!;
  document.querySelectorAll<HTMLButtonElement>('button.tile[data-yt]').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.dataset.title ?? '영상';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    frame.replaceChildren(f);
    player.showModal();
  }));
  player.querySelector('.player-close')!.addEventListener('click', () => player.close());
  player.addEventListener('click', (e) => { if (e.target === player) player.close(); });
  player.addEventListener('close', () => frame.replaceChildren());
</script>

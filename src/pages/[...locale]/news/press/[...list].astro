---
import { langOf, href, dateText } from '../../../../lib/i18n';
import { pageNumbers } from '../../../../lib/pager.js';
// 소식 > 언론보도: major security incidents at home and abroad, as photo cards. Every card has a picture: hand-picked
// incidents and collected articles use pictures made for us (never news photos), news videos use their YouTube
// thumbnail. Every article opens our own page (/news/press/<slug>), collected ones too, and videos play here in a
// large player. Rows come from src/data/security-news.json.
// Numbered pages of pressPage cards (user, 2026-11-17, instead of 더보기): /news/press, /news/press/page/2, … Each page
// has its own address, so going back from an article lands on the same page. 국내 and 해외 are lists of their own
// (/news/press/domestic, /news/press/overseas, each with /page/2 …), so 해외 page 2 is the next 해외 cards.
import Base from '../../../../layouts/Base.astro';
import PageTitle from '../../../../components/PageTitle.astro';
import Icon from '../../../../components/Icon.astro';
import NewChip from '../../../../components/NewChip.astro';
import ResourceTabs from '../../../../components/ResourceTabs.astro';
import { security, fmt, pressPage, newDays } from '../../../../data/news';
import { newsNav, menu } from '../../../../data/site';
import { securityNewsEn, labelEn } from '../../../../data/en';

export function getStaticPaths() {
  const lists = [{ region: '', slug: '' }, { region: '국내', slug: 'domestic' }, { region: '해외', slug: 'overseas' }]
    .map((l) => ({ ...l, rows: l.region ? security.filter((n) => n.region === l.region) : security }))
    .filter((l) => !l.region || l.rows.length > 0);
  const regions = lists.filter((l) => l.region).map(({ region, slug }) => ({ region, slug }));
  const paths = lists.flatMap((l) => {
    const pages = Math.max(1, Math.ceil(l.rows.length / pressPage));
    return Array.from({ length: pages }, (_, i) => ({
      params: { list: [l.slug, i > 0 ? `page/${i + 1}` : ''].filter(Boolean).join('/') || undefined },
      props: { region: l.region, page: i + 1, pages, rows: l.rows.slice(i * pressPage, (i + 1) * pressPage), regions },
    }));
  });
  return [undefined, 'en'].flatMap((locale) => paths.map((p) => ({ ...p, params: { ...p.params, locale } })));
}
interface Props { region: string; page: number; pages: number; rows: typeof security; regions: { region: string; slug: string }[] }
const { region, page, pages, rows, regions } = Astro.props;

const lang = langOf(Astro.url);
const en = lang === 'en';
// a list page's address; #list keeps the reader at the cards instead of the page title
const listHref = (r: string, p: number) => {
  const slug = regions.find((x) => x.region === r)?.slug;
  return href(`/news/press${slug ? `/${slug}` : ''}${p > 1 ? `/page/${p}` : ''}`, lang) + '#list';
};
const numbers: (number | '…')[] = pageNumbers(page, pages);
const pageTitle = [en ? 'In the press' : '언론보도', region && (en ? labelEn(region) : region), page > 1 && (en ? `page ${page}` : `${page}페이지`)]
  .filter(Boolean).join(' - ');
// free Pexels photos: the photographer shows on hover. The "일부 사진 제공: Pexels" line under the list was removed at the
// user's request (2026-11-17), knowing the Pexels API guidelines ask for a visible link to Pexels
// a collected article whose picture is missing borrows one made for the same kind of incident
const byType = new Map<string, string>();
for (const n of security) if (!n.auto && n.image && !byType.has(n.type)) byType.set(n.type, n.image);
const picture = (n: (typeof security)[number]) =>
  n.youtube ? `https://i.ytimg.com/vi/${n.youtube}/hqdefault.jpg` : n.image ?? byType.get(n.type) ?? [...byType.values()][0];
---
<Base title={pageTitle} description={en ? 'Major hacking and data breach incidents and security news reported in Korea and abroad. For each incident, we note where the attackers got in.' : '국내외에서 보도된 주요 해킹·정보 유출 사고와 보안 뉴스. 사고마다 어디로 들어왔는지 정리합니다.'} tone="light">
  <PageTitle title={en ? 'News' : '소식'}>{en ? <>Follow SYINNOVATION news and press coverage,<br />and security issues worth a look.</> : <>신영이노베이션의 소식과 언론 보도,<br />함께 볼 만한 보안 이슈를 놓치지 마세요.</>}<ResourceTabs slot="after" items={menu(newsNav, lang)} label={en ? 'News menu' : '소식 메뉴'} /></PageTitle>

  <section class="news" id="list">
    <div class="wrap">
      <div class="head">
        <p class="lead-s">{en ? <>Major hacking and data breach incidents and security news reported in Korea and abroad.</> : <>국내외에서 보도된 주요 해킹·정보 유출 사고와 보안 뉴스입니다.</>}</p>
        {regions.length > 1 && (
          <nav class="chips" aria-label={en ? 'Region' : '지역'}>
            <a class="chip" href={listHref('', 1)} aria-current={region ? undefined : 'page'}>{en ? 'All' : '전체'}</a>
            {regions.map((r) => <a class="chip" href={listHref(r.region, 1)} aria-current={region === r.region ? 'page' : undefined}>{en ? labelEn(r.region) : r.region}</a>)}
          </nav>
        )}
      </div>

      {rows.length > 0
        ? <ul class="cards">
            {rows.map((n) => {
              const e = en ? securityNewsEn[n.url] : undefined; // no English yet: the Korean title, marked
              const title = e?.title ?? n.title;
              const inner = (
                <>
                  <span class="media"><img src={picture(n)} alt="" loading="lazy" width="768" height="512" title={n.credit ? (en ? `Photo: ${n.credit.name} / Pexels` : `사진: ${n.credit.name} / Pexels`) : undefined} />{n.youtube && <span class="play"><Icon name="play" size={20} /></span>}</span>
                  <span class="over">
                    <span class="tags"><span class="tag">{en ? labelEn(n.region) : n.region}</span><span class="tag">{n.youtube ? (en ? 'Video' : '영상') : (en ? labelEn(n.type) : n.type)}</span></span>
                    <span class="title">{en && !e ? <><span lang="ko">{n.title}</span> <small>(Korean)</small></> : title}</span>
                    <span class="meta">{en ? labelEn(n.source) : n.source}<span class="dot" aria-hidden="true"></span>{en ? dateText(n.date, lang) : fmt(n.date)}<NewChip date={n.date} days={newDays['/news/press']} />{!n.slug && !n.youtube && <Icon name="external" size={13} label={en ? 'Open the original in a new window' : '새 창에서 원문 열기'} />}</span>
                  </span>
                </>
              );
              return (
                <li>
                  {n.youtube
                    ? <button type="button" class="pcard" data-yt={n.youtube} data-title={title} aria-label={en ? `Play video: ${title}` : `${n.title} 영상 재생`}>{inner}</button>
                    : n.slug
                      ? <a class="pcard" href={href(`/news/press/${n.slug}`, lang)}>{inner}</a>
                      : <a class="pcard" href={n.url} target="_blank" rel="noopener">{inner}</a>}
                </li>
              );
            })}
          </ul>
        : <p class="empty">{en ? <>No security news has been written up yet.</> : <>아직 정리된 보안 소식이 없습니다.</>}</p>}
      {pages > 1 && (
        <nav class="pager" aria-label={en ? 'Pages' : '페이지'}>
          {page > 1
            ? <a class="pg step" href={listHref(region, page - 1)} aria-label={en ? 'Previous page' : '이전 페이지'}><Icon name="prev" size={18} /></a>
            : <span class="pg step off" aria-hidden="true"><Icon name="prev" size={18} /></span>}
          {numbers.map((p) => p === '…'
            ? <span class="gap" aria-hidden="true">…</span>
            : <a class="pg" href={listHref(region, p)} aria-current={p === page ? 'page' : undefined}>{p}</a>)}
          {page < pages
            ? <a class="pg step" href={listHref(region, page + 1)} aria-label={en ? 'Next page' : '다음 페이지'}><Icon name="next" size={18} /></a>
            : <span class="pg step off" aria-hidden="true"><Icon name="next" size={18} /></span>}
        </nav>
      )}
    </div>
  </section>

  <!-- news videos play here, in the YouTube player (privacy-enhanced domain) -->
  <dialog class="player" aria-label={en ? 'Video player' : '영상 재생'}>
    <button type="button" class="player-close" aria-label={en ? 'Close' : '닫기'}>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
    <div class="player-box"><div class="player-frame"></div></div>
  </dialog>
</Base>

<style>
  .news { padding-bottom: var(--section-y); }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; margin-bottom: 24px; }
  .lead-s { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .chips { display: flex; gap: 8px; }
  .chip { flex: none; display: inline-flex; align-items: center; white-space: nowrap; height: 36px; padding: 0 16px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font-size: 14px; font-weight: 600; color: var(--ink-2); text-decoration: none; }
  .chip:hover { border-color: var(--ink-3); }
  .chip[aria-current] { border-color: var(--ink); background: var(--ink); color: #fff; }

  /* photo cards, the same family as 사내소식: the picture fills the card, the words sit on a dark band */
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .pcard { position: relative; display: block; width: 100%; aspect-ratio: 1 / 1; padding: 0; border: 0; border-radius: 25px; overflow: hidden; background: #16263c; color: #fff; font: inherit; text-align: left; cursor: pointer; }
  .media { position: absolute; inset: 0; display: grid; place-items: center; }
  .media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  .pcard:hover img { transform: scale(1.04); }
  .play { position: relative; top: -14%; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; background: rgb(255 255 255 / .92); color: var(--ink); }
  .over {
    position: absolute; inset: auto 0 0 0; display: grid; gap: 10px; padding: 80px 22px 22px;
    background: linear-gradient(to top, rgba(10,20,40,.92), rgba(10,20,40,.55) 55%, rgba(10,20,40,0));
  }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag { padding: 3px 9px; border-radius: 999px; background: rgb(255 255 255 / .16); font-size: 12px; font-weight: 600; color: #fff; white-space: nowrap; }
  .title { font-size: 17px; font-weight: 700; line-height: 1.45; color: #fff; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .meta { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; color: rgb(255 255 255 / .75); }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: rgb(255 255 255 / .5); }
  .empty { padding: 32px 0; color: var(--ink-3); }
  .pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 40px; }
  .pg { display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 6px; border-radius: 999px; font-size: 15px; font-weight: 600; color: var(--ink-2); text-decoration: none; font-variant-numeric: tabular-nums; }
  a.pg:hover { background: rgb(15 23 42 / .06); color: var(--ink); }
  .pg[aria-current] { background: var(--ink); color: #fff; }
  .pg.off { color: var(--line); }
  .gap { min-width: 20px; text-align: center; color: var(--ink-3); }

  .player { width: min(1120px, 92vw); max-width: none; max-height: none; padding: 56px 0 0; border: 0; background: transparent; overflow: visible; }
  .player::backdrop { background: rgb(8 14 26 / .84); }
  .player-box { position: relative; aspect-ratio: 16 / 9; max-height: 84vh; margin: 0 auto; border-radius: 14px; overflow: hidden; background: #000; }
  .player-frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .player-close { position: absolute; top: 0; right: 0; display: grid; place-items: center; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .14); color: #fff; cursor: pointer; }
  :global(html:has(.player[open])) { overflow: hidden; }

  @media (max-width: 1023px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 559px) {
    .cards { grid-template-columns: minmax(0, 1fr); gap: 14px; }
    /* 1 … 4 5 6 … 9 with both arrows still fits a 360px phone */
    .pager { gap: 2px; }
    .pg { min-width: 34px; height: 34px; padding: 0 4px; }
    .player { width: 100vw; }
    .player-box { border-radius: 0; }
    .player-close { right: 12px; }
  }
</style>

<script>
  // news videos: open the large player and load YouTube only when asked; closing it removes the player
  const player = document.querySelector<HTMLDialogElement>('.player')!;
  const frame = player.querySelector<HTMLElement>('.player-frame')!;
  document.querySelectorAll<HTMLButtonElement>('button.pcard[data-yt]').forEach((b) => b.addEventListener('click', () => {
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
    f.title = b.dataset.title ?? '영상';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    frame.replaceChildren(f);
    player.showModal();
  }));
  player.querySelector('.player-close')!.addEventListener('click', () => player.close());
  player.addEventListener('click', (e) => { if (e.target === player) player.close(); });
  player.addEventListener('close', () => frame.replaceChildren());
</script>

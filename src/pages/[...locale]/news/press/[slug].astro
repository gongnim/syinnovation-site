---
// 소식 > 보안 사고 > one hand-picked incident, written by us from the facts in several reports: overview, timeline,
// impact, what is known about the cause, the response, what any organisation can check, and the reports we used,
// each with a link to the original. No article text or photos are copied; the picture was made for this page, or
// is a free Pexels photo (credited) for an article the collector found and we wrote up later.
// The longer write-ups live in src/data/security-stories.json (keyed by slug); without one, the summary is shown.
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import { security, fmt, pressPage, type Incident } from '../../../../data/news';
import { lessonFor, type Lesson } from '../../../../data/security-lessons';
import storiesJson from '../../../../data/security-stories.json';
import { securityNewsEn, storiesEn, lessonsEn, labelEn } from '../../../../data/en';
import { langOf, href, dateText } from '../../../../lib/i18n';

interface Story {
  overview?: string[]; timeline?: { date: string; event: string }[]; impact?: string[];
  cause?: string[]; response?: string[]; sources?: { outlet: string; date?: string; url: string }[];
}
const stories = storiesJson as Record<string, Story>;

export function getStaticPaths() {
  const pages = security.filter((n) => n.slug);
  const paths = pages.map((n, i) => ({ params: { slug: n.slug }, props: { item: n, newer: pages[i - 1], older: pages[i + 1] } }));
  // every page twice: Korean at /news/press/<slug>, English at /en/news/press/<slug>
  return [undefined, 'en'].flatMap((locale) => paths.map((p) => ({ ...p, params: { ...p.params, locale } })));
}
interface Props { item: Incident; newer?: Incident; older?: Incident }
const { item: n, newer, older } = Astro.props;
const lang = langOf(Astro.url);
const en = lang === 'en';
// 목록 goes back to the page of the full list this article is on
const listPage = Math.floor(Math.max(0, security.findIndex((x) => x.slug === n.slug)) / pressPage) + 1;
const listUrl = href(`/news/press${listPage > 1 ? `/page/${listPage}` : ''}`, lang);
const e = en ? securityNewsEn[n.url] : undefined; // no English yet: the Korean text, marked
const title = e?.title ?? n.title;
const summary: string | undefined = e?.summary ?? n.summary;
const s: Story = (en ? storiesEn[n.slug!] : undefined) ?? stories[n.slug!] ?? {};
const lesson: Lesson = (en ? lessonsEn[n.type] ?? lessonsEn['기타'] : undefined) ?? lessonFor(n.type);
const day = (d: string) => (en ? dateText(d, lang) : fmt(d));
const label = (ko: string) => (en ? labelEn(ko) : ko); // region, type and outlet names
const titleOf = (x: Incident) => (en ? securityNewsEn[x.url]?.title ?? `${x.title} (Korean)` : x.title);
const sources = s.sources?.length ? s.sources : [{ outlet: n.source, date: n.date, url: n.url }];
const photoNote = en
  ? n.credit
    ? `The photo is a Pexels stock photo (${n.credit.name}), not a photo of the actual scene.`
    : n.image ? 'The image was made to help explain the story and is not a photo of the actual scene.' : ''
  : n.credit
    ? `사진은 Pexels의 자료 사진(${n.credit.name})으로, 실제 현장 사진이 아닙니다.`
    : n.image ? '이미지는 이해를 돕기 위해 만든 것으로, 실제 현장 사진이 아닙니다.' : '';
---
<Base title={title} description={summary ?? title} tone="light" type="article" published={n.date} image={n.image}>
  <article class="inc">
    <div class="wrap narrow">
      <nav class="crumb" aria-label={en ? 'Breadcrumb' : '위치'}><a href={href('/news', lang)}>{en ? 'News' : '소식'}</a><span aria-hidden="true">/</span><a href={href('/news/press', lang)}>{en ? 'Security incidents' : '보안 사고'}</a></nav>
      <div class="tags"><span class:list={['tag', n.region === '해외' ? 'abroad' : 'home']}>{label(n.region)}</span><span class="tag">{label(n.type)}</span></div>
      <h1>{en && !e ? <><span lang="ko">{n.title}</span> <small>(Korean)</small></> : title}</h1>
      <p class="meta">{day(n.date)}<span class="dot" aria-hidden="true"></span>{en ? <>Compiled from reports by {[...new Set(sources.map((x) => label(x.outlet)))].join(', ')}</> : <>{[...new Set(sources.map((x) => x.outlet))].join(', ')} 보도 정리</>}</p>
      {summary && <p class="lead-in">{summary}</p>}
      {n.image && <img class="hero" src={n.image} alt="" width="1536" height="1024" />}

      <section>
        <h2>{en ? 'Overview' : '사고 개요'}</h2>
        {(s.overview?.length ? s.overview : [summary]).map((p) => <p>{p}</p>)}
      </section>

      {s.timeline?.length ? (
        <section>
          <h2>{en ? 'Timeline' : '진행 경과'}</h2>
          <ol class="timeline">
            {s.timeline.map((t) => <li><span class="t-date">{day(t.date)}</span><span class="t-event">{t.event}</span></li>)}
          </ol>
        </section>
      ) : null}

      {s.impact?.length ? (
        <section>
          <h2>{en ? 'Impact' : '피해 규모'}</h2>
          <ul class="facts">{s.impact.map((x) => <li>{x}</li>)}</ul>
        </section>
      ) : null}

      {s.cause?.length ? (
        <section>
          <h2>{en ? 'Known cause' : '알려진 원인'}</h2>
          {s.cause.map((p) => <p>{p}</p>)}
        </section>
      ) : null}

      {s.response?.length ? (
        <section>
          <h2>{en ? 'Response from the company and authorities' : '회사와 당국의 대응'}</h2>
          {s.response.map((p) => <p>{p}</p>)}
        </section>
      ) : null}

      <section class="advice">
        <h2>{en ? 'How to reduce incidents like this' : '이런 사고를 줄이려면'}</h2>
        <p>{lesson.intro}</p>
        <ul class="checks">{lesson.checks.map((c) => <li><Icon name="check" size={18} />{c}</li>)}</ul>
      </section>

      <aside class="source">
        <h2>{en ? 'Reports we used' : '참고한 보도'}</h2>
        <ul>
          {sources.map((x) => (
            <li><a href={x.url} target="_blank" rel="noopener">{label(x.outlet)}{x.date && <span>{day(x.date)}</span>}<Icon name="external" size={14} label={en ? 'Open the original in a new window' : '새 창에서 원문 열기'} /></a></li>
          ))}
        </ul>
        <p>{en ? <>SYINNOVATION wrote this summary itself, based on the facts in the reports above. {photoNote}</> : <>이 글은 위 보도에 나온 사실을 바탕으로 신영이노베이션이 직접 정리했습니다. {photoNote}</>}</p>
      </aside>

      <nav class="pn" aria-label={en ? 'More security news' : '다른 보안 소식'}>
        {older ? <a href={href(`/news/press/${older.slug}`, lang)}><span>{en ? 'Previous' : '이전 소식'}</span>{titleOf(older)}</a> : <span />}
        <a class="list" href={listUrl}>{en ? 'Back to list' : '목록'}</a>
        {newer ? <a class="r" href={href(`/news/press/${newer.slug}`, lang)}><span>{en ? 'Next' : '다음 소식'}</span>{titleOf(newer)}</a> : <span />}
      </nav>
    </div>
  </article>

  <CtaBand
    title={en ? "Is your company's work access secure?" : '우리 회사의 업무 접속은 안전할까요?'}
    lead={en ? 'Start by checking the security risks in your current work access with a free initial consultation.' : '사전 컨설팅(무료)으로 지금 업무 접속의 보안 위험부터 확인해 보세요.'}
  />
</Base>

<style>
  .inc { padding: calc(var(--header-h) + clamp(88px, 8vw, 120px)) 0 var(--section-y); }
  .inc .wrap { max-width: calc(800px + var(--gutter) * 2); }
  .crumb { display: flex; gap: 8px; font-size: 14px; color: var(--ink-3); }
  .crumb a:hover { color: var(--blue); }
  .tags { display: flex; gap: 6px; margin-top: 22px; }
  .tag { padding: 4px 10px; border-radius: 999px; background: var(--mist); font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .tag.home { background: #e8eff8; color: var(--blue); }
  .tag.abroad { background: var(--orange-soft); color: var(--orange-ink); }
  h1 { margin-top: 14px; font-size: clamp(28px, 1.8vw + 18px, 40px); font-weight: 700; line-height: 1.3; letter-spacing: -0.03em; color: var(--ink); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 14px; font-size: 15px; color: var(--ink-3); }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-3); }
  .lead-in { margin-top: 22px; padding-left: 16px; border-left: 3px solid var(--blue); font-size: 18px; line-height: 1.7; font-weight: 500; color: var(--ink); }
  .hero { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; margin-top: 32px; border-radius: 20px; }
  section { margin-top: 44px; }
  h2 { margin-bottom: 14px; font-size: 21px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  section p { font-size: 17px; line-height: 1.8; color: var(--ink-2); }
  section p + p { margin-top: 12px; }

  /* the timeline: dates down the left, a thin line joining the events */
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--line); }
  .timeline li { position: relative; display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 16px; padding: 0 0 18px 22px; }
  .timeline li::before { content: ''; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: #fff; border: 2px solid var(--blue); }
  .timeline li:last-child { padding-bottom: 0; }
  .t-date { font-size: 14px; font-weight: 700; color: var(--blue); font-variant-numeric: tabular-nums; padding-top: 2px; }
  .t-event { font-size: 16px; line-height: 1.7; color: var(--ink); }

  .facts { margin: 0; padding-left: 20px; display: grid; gap: 8px; }
  .facts li { font-size: 16px; line-height: 1.7; color: var(--ink); }
  .advice { padding: 28px; border-radius: 20px; background: var(--paper-2); }
  .checks { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }
  .checks li { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; border-radius: 12px; background: #fff; font-size: 16px; line-height: 1.6; color: var(--ink); }
  .checks :global(svg) { flex: none; margin-top: 3px; color: var(--blue); }

  .source { margin-top: 44px; padding: 22px 24px; border-radius: 16px; border: 1px solid var(--line); }
  .source h2 { font-size: 17px; margin-bottom: 10px; }
  .source ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .source a { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: var(--blue); }
  .source a span { font-weight: 500; color: var(--ink-3); }
  .source p { margin-top: 14px; font-size: 13px; line-height: 1.7; color: var(--ink-3); }
  .pn { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; }
  .pn a { display: grid; gap: 2px; font-size: 15px; font-weight: 600; color: var(--ink); }
  .pn a span { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .pn .r { text-align: right; }
  .pn .list { padding: 8px 20px; border: 1px solid var(--line); border-radius: 999px; }
  @media (max-width: 559px) {
    .timeline li { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .advice { padding: 22px 18px; }
    .pn { grid-template-columns: 1fr; text-align: center; }
    .pn .r { text-align: center; }
    .pn .list { justify-self: center; }
  }
</style>

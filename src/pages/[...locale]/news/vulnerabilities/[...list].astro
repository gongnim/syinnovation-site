---
import { langOf, href, dateText } from '../../../../lib/i18n';
import { pageNumbers } from '../../../../lib/pager.js';
// 소식 > 보안뉴스 (was 취약점 소식, renamed by the user 2026-11-19): vulnerabilities reported in the Korean press, newest first, each with what to do about it.
// A row shows the date, the product, the severity and status as reported, and our own title, linking to the flaw's
// own page (/news/vulnerabilities/<slug>, [slug].astro; the small icon opens the article); 해결 방법 보기 opens the fix
// (src/components/VulnFix.astro): who is affected, how to check and update, fixed version, workaround, notices.
// Numbered pages like 보안사고: /news/vulnerabilities, /news/vulnerabilities/page/2, …
import Base from '../../../../layouts/Base.astro';
import PageTitle from '../../../../components/PageTitle.astro';
import Icon from '../../../../components/Icon.astro';
import NewChip from '../../../../components/NewChip.astro';
import ResourceTabs from '../../../../components/ResourceTabs.astro';
import VulnFix from '../../../../components/VulnFix.astro';
import ShortThumb from '../../../../components/ShortThumb.astro';
import ShortPlayer from '../../../../components/ShortPlayer.astro';
import { vulns, fmt, vulnPage, newDays, vulnTitle, vulnHref, howFor, howKeys, vulnStatus, sevText } from '../../../../data/news';
import { newsNav, menu } from '../../../../data/site';
import { labelEn } from '../../../../data/en';

export function getStaticPaths() {
  const pages = Math.max(1, Math.ceil(vulns.length / vulnPage));
  const paths = Array.from({ length: pages }, (_, i) => ({
    params: { list: i > 0 ? `page/${i + 1}` : undefined },
    props: { page: i + 1, pages, rows: vulns.slice(i * vulnPage, (i + 1) * vulnPage) },
  }));
  return [undefined, 'en'].flatMap((locale) => paths.map((p) => ({ ...p, params: { ...p.params, locale } })));
}
interface Props { page: number; pages: number; rows: typeof vulns }
const { page, pages, rows } = Astro.props;

const lang = langOf(Astro.url);
const en = lang === 'en';
const listHref = (p: number) => href(`/news/vulnerabilities${p > 1 ? `/page/${p}` : ''}`, lang) + '#list';
const numbers: (number | '…')[] = pageNumbers(page, pages);
// the newest Shorts as a row of posters above the list, on the first page only (user, 2026-11-20)
const shelf = page === 1 ? vulns.filter((v) => v.youtube).slice(0, 6) : [];
const label = (v: (typeof vulns)[number]) => (v.products.length ? howFor(howKeys(v)[0], lang).label : (en ? v.nameEn : v.name) ?? howFor('_default', lang).label);

---
<Base title={en ? (page > 1 ? `Security News - page ${page}` : 'Security News') : (page > 1 ? `보안뉴스 - ${page}페이지` : '보안뉴스')} description={en ? 'Software and device vulnerabilities reported in the Korean press, with who is affected and what to do: how to check your version, how to update, and the official notices.' : '국내 언론에 보도된 소프트웨어·기기 취약점과, 누가 해당되는지, 무엇을 하면 되는지. 버전 확인, 업데이트 방법, 공식 공지까지 정리합니다.'} tone="light">
  <PageTitle title={en ? 'News' : '소식'}>{en ? <>Follow SYINNOVATION news and press coverage,<br />and security issues worth a look.</> : <>신영이노베이션의 소식과 언론 보도,<br />함께 볼 만한 보안 이슈를 놓치지 마세요.</>}<ResourceTabs slot="after" items={menu(newsNav, lang)} label={en ? 'News menu' : '소식 메뉴'} /></PageTitle>

  <section class="vuln" id="list">
    <div class="wrap">
      <div class="head">
        <p class="lead-s">{en ? <>Vulnerabilities reported in the Korean press, with who is affected and what to do.<br />Click <b>How to fix it</b> on each item for the steps.</> : <>국내 언론에 보도된 취약점과, 누가 해당되고 무엇을 하면 되는지 정리합니다.<br />항목마다 <b>해결 방법 보기</b>를 누르면 확인과 업데이트 방법이 나옵니다.</>}</p>
        <p class="fine">{en ? <>Steps follow the vendors' official support pages. For company systems, check with your IT team or supplier first.</> : <>업데이트 방법은 각 제조사의 공식 안내를 따릅니다.<br />회사 업무 시스템은 담당자나 공급사와 먼저 확인하세요.</>}</p>
      </div>

      {shelf.length > 0 && (
        <div class="shelf">
          <h2 class="shelf-t">{en ? 'Latest Security News Shorts' : '최근 보안뉴스 쇼츠'}</h2>
          <ul>
            {shelf.map((v) => (
              <li>
                <ShortThumb id={v.youtube!} slug={v.slug} title={vulnTitle(v, lang)} en={en} badge={v.severity ? sevText(v.severity, lang) : undefined} />
                <p class="shelf-c"><b>{label(v)}</b>{en ? dateText(v.date, lang) : fmt(v.date)}</p>
              </li>
            ))}
          </ul>
        </div>
      )}

      {rows.length > 0
        ? <ul class="items">
            {rows.map((v) => {
              const st = v.status ? vulnStatus[v.status] : undefined;
              const more = v.sources ?? [];
              const title = vulnTitle(v, lang);
              return (
                <li class={`item${v.youtube ? ' has-short' : ''}`}>
                  {v.youtube && <div class="thumb"><ShortThumb id={v.youtube} slug={v.slug} title={title} en={en} size="sm" /></div>}
                  <div class="body">
                    <div class="row">
                      <span class="date">{en ? dateText(v.date, lang) : fmt(v.date)}<NewChip date={v.date} days={newDays['/news/vulnerabilities']} /></span>
                      <span class="chips">
                        <span class="chip prod">{label(v)}</span>
                        {v.severity && <span class="chip sev">{sevText(v.severity, lang)}</span>}
                        {st && <span class={`chip st ${st.cls}`}>{en ? st.en : v.status}</span>}
                      </span>
                    </div>
                    <h2 class="title"><a href={vulnHref(v, lang)}>{title.split(/(CVE-\d{4}-\d+)/).map((p, i) => (i % 2 ? <span class="nw">{p}</span> : p))}</a><a class="ext" href={v.url} target="_blank" rel="noopener"><Icon name="external" size={14} label={en ? 'Open the original article in a new window' : '원문 기사를 새 창에서 열기'} /></a></h2>
                    <p class="meta">{en ? labelEn(v.source) : v.source}{more.length > 0 && <span>{en ? ` and ${more.length} more` : ` 외 ${more.length}곳 보도`}</span>}{v.youtube && <button type="button" class="watch" data-short={v.youtube} data-title={title}>{en ? 'Watch the Short' : '영상 보기'}</button>}</p>
                  </div>
                  <details class="todo">
                    <summary><span class="todo-t">{en ? 'How to fix it' : '해결 방법 보기'}</span><span class="todo-hint"><span class="open">{en ? 'Click to open' : '눌러서 보기'}</span><span class="close">{en ? 'Close' : '접기'}</span><Icon name="plus" size={16} class="todo-i" /></span></summary>
                    <VulnFix v={v} />
                  </details>
                </li>
              );
            })}
          </ul>
        : <p class="empty">{en ? <>No security news yet.</> : <>아직 정리된 보안뉴스가 없습니다.</>}</p>}
      {pages > 1 && (
        <nav class="pager" aria-label={en ? 'Pages' : '페이지'}>
          {page > 1
            ? <a class="pg step" href={listHref(page - 1)} aria-label={en ? 'Previous page' : '이전 페이지'}><Icon name="prev" size={18} /></a>
            : <span class="pg step off" aria-hidden="true"><Icon name="prev" size={18} /></span>}
          {numbers.map((p) => p === '…'
            ? <span class="gap" aria-hidden="true">…</span>
            : <a class="pg" href={listHref(p)} aria-current={p === page ? 'page' : undefined}>{p}</a>)}
          {page < pages
            ? <a class="pg step" href={listHref(page + 1)} aria-label={en ? 'Next page' : '다음 페이지'}><Icon name="next" size={18} /></a>
            : <span class="pg step off" aria-hidden="true"><Icon name="next" size={18} /></span>}
        </nav>
      )}
    </div>
  </section>
  {rows.some((v) => v.youtube) && <ShortPlayer en={en} />}
</Base>

<style>
  .vuln { padding-bottom: var(--section-y); }
  .head { display: grid; gap: 8px; margin-bottom: 24px; }
  .lead-s { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .lead-s b { color: var(--ink); }
  .fine { font-size: 13px; line-height: 1.6; color: var(--ink-3); }

  /* white cards with a line border, the family of the 자주 묻는 질문 cards; 할 일 opens inside the card */
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { min-width: 0; padding: 20px 22px 6px; border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; }
  /* the newest Shorts as posters above the list: six across, a swipeable row on phones */
  .shelf { margin-bottom: 28px; }
  .shelf-t { margin-bottom: 12px; font-size: 18px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  .shelf ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 14px; }
  .shelf-c { display: flex; justify-content: space-between; gap: 6px; margin-top: 8px; font-size: 12px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .shelf-c b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 700; color: var(--ink-2); }
  /* a card with a Short: a small poster beside the text; the fix below spans the card */
  .item.has-short { display: grid; grid-template-columns: 64px minmax(0, 1fr); column-gap: 18px; }
  .item.has-short .todo { grid-column: 1 / -1; }
  .thumb { align-self: start; }
  .watch { margin-left: 10px; padding: 0; border: 0; background: none; font: inherit; font-weight: 700; color: var(--blue); cursor: pointer; }
  .watch:hover { text-decoration: underline; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .date { font-size: 13px; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; background: var(--paper-2); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--line); }
  .chip.prod { background: var(--mist); color: var(--blue-deep); box-shadow: none; }
  .chip.st.hot { background: #fdecec; color: #b42318; box-shadow: none; }
  .chip.st.ok { background: #e8f3ee; color: #1d6b48; box-shadow: none; }
  .chip.st.warn { background: var(--orange-soft); color: var(--orange-ink); box-shadow: none; }
  .title { margin-top: 10px; font-size: 18px; font-weight: 700; line-height: 1.5; letter-spacing: -0.01em; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--blue); }
  .nw { white-space: nowrap; } /* a CVE id never breaks at its hyphens */
  .title .ext { margin-left: 6px; color: var(--ink-3); }
  .title .ext:hover { color: var(--blue); }
  .title :global(svg) { display: inline; vertical-align: -1px; }
  .meta { margin-top: 4px; font-size: 13px; color: var(--ink-3); }

  .todo { margin-top: 10px; border-top: 1px solid var(--line); }
  /* the fix opens from a button-like bar that says so (user, 2026-11-19: "눌렀을 때 해결방법이 나오는 줄 몰랐어") */
  .todo summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 12px 0 14px; padding: 12px 16px; border-radius: var(--r-md, 12px); background: var(--mist); font-size: 15px; font-weight: 800; color: var(--blue); cursor: pointer; transition: background .2s var(--ease); }
  .todo summary:hover { background: #e3ebf8; }
  .todo summary::-webkit-details-marker { display: none; }
  .todo-hint { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--ink-2); }
  .todo-hint .close, .todo[open] .todo-hint .open { display: none; }
  .todo[open] .todo-hint .close { display: inline; }
  .todo summary :global(.todo-i) { flex: none; color: var(--blue); transition: rotate .25s var(--ease); }
  .todo[open] summary :global(.todo-i) { rotate: 45deg; }
  .todo summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: var(--r-sm); }
  .empty { padding: 32px 0; color: var(--ink-3); }

  .pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 40px; }
  .pg { display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 6px; border-radius: 999px; font-size: 15px; font-weight: 600; color: var(--ink-2); text-decoration: none; font-variant-numeric: tabular-nums; }
  a.pg:hover { background: rgb(15 23 42 / .06); color: var(--ink); }
  .pg[aria-current] { background: var(--ink); color: #fff; }
  .pg.off { color: var(--line); }
  .gap { min-width: 20px; text-align: center; color: var(--ink-3); }

  @media (max-width: 899px) {
    .shelf ul { grid-auto-flow: column; grid-template-columns: none; grid-auto-columns: 132px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; margin-right: calc(var(--gutter) * -1); padding-right: var(--gutter); }
    .shelf li { scroll-snap-align: start; }
  }
  @media (max-width: 559px) {
    .item { padding: 16px 16px 4px; }
    .item.has-short { grid-template-columns: 52px minmax(0, 1fr); column-gap: 14px; }
    .title { font-size: 16px; }
    .pager { gap: 2px; }
    .pg { min-width: 34px; height: 34px; padding: 0 4px; }
  }
</style>

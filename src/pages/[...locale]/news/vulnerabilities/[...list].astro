---
import { langOf, href, dateText } from '../../../../lib/i18n';
import { pageNumbers } from '../../../../lib/pager.js';
// 소식 > 취약점 소식: vulnerabilities reported in the Korean press, newest first, each with what to do about it.
// A row shows the date, the product, the severity and status as reported, and the headline (linking to the article);
// 할 일 opens who is affected, how to check and update (src/data/vuln-howto.json, from the vendors' support pages), the
// fixed version and temporary measure when the article or notice names them, and the official notices.
// Numbered pages like 언론보도: /news/vulnerabilities, /news/vulnerabilities/page/2, …
import Base from '../../../../layouts/Base.astro';
import PageTitle from '../../../../components/PageTitle.astro';
import Icon from '../../../../components/Icon.astro';
import ResourceTabs from '../../../../components/ResourceTabs.astro';
import { vulns, fmt, vulnPage, type Step } from '../../../../data/news';
import { newsNav, menu } from '../../../../data/site';
import howtoKo from '../../../../data/vuln-howto.json';
import { vulnHowtoEn, vulnNewsEn, labelEn } from '../../../../data/en';

export function getStaticPaths() {
  const pages = Math.max(1, Math.ceil(vulns.length / vulnPage));
  const paths = Array.from({ length: pages }, (_, i) => ({
    params: { list: i > 0 ? `page/${i + 1}` : undefined },
    props: { page: i + 1, pages, rows: vulns.slice(i * vulnPage, (i + 1) * vulnPage) },
  }));
  return [undefined, 'en'].flatMap((locale) => paths.map((p) => ({ ...p, params: { ...p.params, locale } })));
}
interface Props { page: number; pages: number; rows: typeof vulns }
const { page, pages, rows } = Astro.props;

const lang = langOf(Astro.url);
const en = lang === 'en';
const listHref = (p: number) => href(`/news/vulnerabilities${p > 1 ? `/page/${p}` : ''}`, lang) + '#list';
const numbers: (number | '…')[] = pageNumbers(page, pages);

type How = { label: string; who: string; steps: (string | Step)[]; note?: string; links: { label: string; url: string }[] };
const howto = howtoKo as unknown as Record<string, How>;
// one product's steps in the page's language: English text over the Korean list, commands and links kept
const how = (key: string): How => {
  const ko = howto[key] ?? howto._default;
  const e = en ? vulnHowtoEn[howto[key] ? key : '_default'] : undefined;
  if (!e) return ko;
  return {
    label: e.label ?? ko.label, who: e.who ?? ko.who, note: ko.note && (e.note ?? ko.note),
    steps: ko.steps.map((s, i) => (typeof s === 'string' ? e.steps?.[i] ?? s : { ...s, t: e.steps?.[i] ?? s.t })),
    links: ko.links.map((l, i) => ({ ...l, label: e.links?.[i] ?? l.label })),
  };
};
const STATUS: Record<string, { en: string; cls: string }> = {
  '악용 중': { en: 'Exploited', cls: 'hot' },
  '패치 나옴': { en: 'Patch out', cls: 'ok' },
  '조치 권고': { en: 'Action advised', cls: 'warn' },
};
const SEVERITY_EN: Record<string, string> = { 치명적: 'Critical', 고위험: 'High risk', 긴급: 'Urgent' };
const sev = (s: string) => (en ? SEVERITY_EN[s] ?? s : s);
const step = (s: string | Step) => (typeof s === 'string' ? { t: s } : s);
---
<Base title={en ? (page > 1 ? `Vulnerabilities - page ${page}` : 'Vulnerabilities') : (page > 1 ? `취약점 소식 - ${page}페이지` : '취약점 소식')} description={en ? 'Software and device vulnerabilities reported in the Korean press, with who is affected and what to do: how to check your version, how to update, and the official notices.' : '국내 언론에 보도된 소프트웨어·기기 취약점과, 누가 해당되는지, 무엇을 하면 되는지. 버전 확인, 업데이트 방법, 공식 공지까지 정리합니다.'} tone="light">
  <PageTitle title={en ? 'News' : '소식'}>{en ? <>Follow SYINNOVATION news and press coverage,<br />and security issues worth a look.</> : <>신영이노베이션의 소식과 언론 보도,<br />함께 볼 만한 보안 이슈를 놓치지 마세요.</>}<ResourceTabs slot="after" items={menu(newsNav, lang)} label={en ? 'News menu' : '소식 메뉴'} /></PageTitle>

  <section class="vuln" id="list">
    <div class="wrap">
      <div class="head">
        <p class="lead-s">{en ? <>Vulnerabilities reported in the Korean press, with who is affected and what to do.<br />Open <b>What to do</b> on each item for the steps.</> : <>국내 언론에 보도된 취약점과, 누가 해당되고 무엇을 하면 되는지 정리합니다.<br />항목마다 <b>할 일</b>을 열면 확인과 업데이트 방법이 나옵니다.</>}</p>
        <p class="fine">{en ? <>Steps follow the vendors' official support pages. For company systems, check with your IT team or supplier first.</> : <>업데이트 방법은 각 제조사의 공식 안내를 따릅니다.<br />회사 업무 시스템은 담당자나 공급사와 먼저 확인하세요.</>}</p>
      </div>

      {rows.length > 0
        ? <ul class="items">
            {rows.map((v) => {
              const e = en ? vulnNewsEn[v.url] : undefined; // no English yet: the Korean headline, marked
              const keys = v.products.length ? v.products.slice(0, 3) : ['_default'];
              const st = v.status ? STATUS[v.status] : undefined;
              const more = v.sources ?? [];
              const workaround = (e?.workaround ?? v.workaround ?? []) as (string | Step)[];
              return (
                <li class={`item${v.youtube ? ' has-short' : ''}`}>
                  {v.youtube && (
                    <div class="short">
                      <iframe src={`https://www.youtube-nocookie.com/embed/${v.youtube}`} title={en ? `Video: ${e?.title ?? v.title}` : `영상: ${v.title}`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
                    </div>
                  )}
                  <div class="row">
                    <span class="date">{en ? dateText(v.date, lang) : fmt(v.date)}</span>
                    <span class="chips">
                      <span class="chip prod">{how(keys[0]).label}</span>
                      {v.severity && <span class="chip sev">{sev(v.severity)}</span>}
                      {st && <span class={`chip st ${st.cls}`}>{en ? st.en : v.status}</span>}
                    </span>
                  </div>
                  <h2 class="title"><a href={v.url} target="_blank" rel="noopener">{en && !e ? <><span lang="ko">{v.title}</span> <small>(Korean)</small></> : e?.title ?? v.title}<Icon name="external" size={14} label={en ? 'Open the article in a new window' : '새 창에서 기사 열기'} /></a></h2>
                  <p class="meta">{en ? labelEn(v.source) : v.source}{more.length > 0 && <span>{en ? ` and ${more.length} more` : ` 외 ${more.length}곳 보도`}</span>}</p>
                  <details class="todo">
                    <summary>{en ? 'What to do' : '할 일'}<Icon name="plus" size={16} class="todo-i" /></summary>
                    <div class="body">
                      {(e?.note ?? v.note) && <p class="note">{e?.note ?? v.note}</p>}
                      {v.fixed && v.fixed.length > 0 && (
                        <p class="fixed">{en ? 'Fixed version (as reported): ' : '고쳐진 버전(보도·공지 기준): '}<b>{v.fixed.join(', ')}</b>{en ? '. Update if yours is older.' : '. 이보다 낮으면 업데이트하세요.'}</p>
                      )}
                      {keys.map((k) => {
                        const h = how(k);
                        return (
                          <section class="how">
                            {(keys.length > 1 || k !== '_default') && <h3>{h.label}</h3>}
                            <p class="who"><span>{en ? 'Who: ' : '해당: '}</span>{h.who}</p>
                            <ol>
                              {h.steps.map((s) => { const x = step(s); return <li>{x.t}{x.code && <pre><code>{x.code}</code></pre>}</li>; })}
                            </ol>
                            {h.note && <p class="hnote">{h.note}</p>}
                            <p class="links">{h.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}<Icon name="external" size={12} /></a>)}</p>
                          </section>
                        );
                      })}
                      {workaround.length > 0 && (
                        <section class="how">
                          <h3>{en ? 'If you cannot update right away' : '바로 업데이트할 수 없을 때'}</h3>
                          <ol>{workaround.map((s) => { const x = step(s); return <li>{x.t}{x.code && <pre><code>{x.code}</code></pre>}</li>; })}</ol>
                        </section>
                      )}
                      {(v.notice || v.cves.length > 0) && (
                        <p class="links official">
                          <span>{en ? 'Official notices' : '공식 공지'}</span>
                          {v.notice && <a href={v.notice.url} target="_blank" rel="noopener">{en ? 'KISA: ' : 'KISA 보안공지: '}{v.notice.title}<Icon name="external" size={12} /></a>}
                          {v.cves.map((c) => <a href={`https://www.cve.org/CVERecord?id=${c}`} target="_blank" rel="noopener">{c}<Icon name="external" size={12} /></a>)}
                        </p>
                      )}
                      {more.length > 0 && (
                        <p class="links others">
                          <span>{en ? 'Also reported by' : '같은 소식'}</span>
                          {more.map((m) => <a href={m.url} target="_blank" rel="noopener">{en ? labelEn(m.source) : m.source}</a>)}
                        </p>
                      )}
                    </div>
                  </details>
                </li>
              );
            })}
          </ul>
        : <p class="empty">{en ? <>No vulnerability news yet.</> : <>아직 정리된 취약점 소식이 없습니다.</>}</p>}
      {pages > 1 && (
        <nav class="pager" aria-label={en ? 'Pages' : '페이지'}>
          {page > 1
            ? <a class="pg step" href={listHref(page - 1)} aria-label={en ? 'Previous page' : '이전 페이지'}><Icon name="prev" size={18} /></a>
            : <span class="pg step off" aria-hidden="true"><Icon name="prev" size={18} /></span>}
          {numbers.map((p) => p === '…'
            ? <span class="gap" aria-hidden="true">…</span>
            : <a class="pg" href={listHref(p)} aria-current={p === page ? 'page' : undefined}>{p}</a>)}
          {page < pages
            ? <a class="pg step" href={listHref(page + 1)} aria-label={en ? 'Next page' : '다음 페이지'}><Icon name="next" size={18} /></a>
            : <span class="pg step off" aria-hidden="true"><Icon name="next" size={18} /></span>}
        </nav>
      )}
    </div>
  </section>
</Base>

<style>
  .vuln { padding-bottom: var(--section-y); }
  .head { display: grid; gap: 8px; margin-bottom: 24px; }
  .lead-s { font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .lead-s b { color: var(--ink); }
  .fine { font-size: 13px; line-height: 1.6; color: var(--ink-3); }

  /* white cards with a line border, the family of the 자주 묻는 질문 cards; 할 일 opens inside the card */
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .item { min-width: 0; padding: 20px 22px 6px; border: 1px solid var(--line); border-radius: var(--r-lg); background: #fff; }
  /* our Short on this flaw sits at the top of the card, vertical 9:16, then the text and 할 일 below */
  .short { position: relative; width: min(100%, 300px); aspect-ratio: 9 / 16; margin: 0 auto 16px; border-radius: var(--r-md, 12px); overflow: hidden; background: #0B1628; }
  .short iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  .date { font-size: 13px; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { padding: 3px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; background: var(--paper-2); color: var(--ink-2); box-shadow: inset 0 0 0 1px var(--line); }
  .chip.prod { background: var(--mist); color: var(--blue-deep); box-shadow: none; }
  .chip.st.hot { background: #fdecec; color: #b42318; box-shadow: none; }
  .chip.st.ok { background: #e8f3ee; color: #1d6b48; box-shadow: none; }
  .chip.st.warn { background: var(--orange-soft); color: var(--orange-ink); box-shadow: none; }
  .title { margin-top: 10px; font-size: 18px; font-weight: 700; line-height: 1.5; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .title a { color: var(--ink); text-decoration: none; }
  .title a:hover { color: var(--blue); }
  .title :global(svg) { display: inline; margin-left: 6px; vertical-align: -1px; color: var(--ink-3); }
  .title small { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .meta { margin-top: 4px; font-size: 13px; color: var(--ink-3); }

  .todo { margin-top: 10px; border-top: 1px solid var(--line); }
  .todo summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 0; font-size: 15px; font-weight: 700; color: var(--blue); cursor: pointer; }
  .todo summary::-webkit-details-marker { display: none; }
  .todo summary :global(.todo-i) { flex: none; color: var(--ink-3); transition: rotate .25s var(--ease); }
  .todo[open] summary :global(.todo-i) { rotate: 45deg; color: var(--blue); }
  .todo summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: var(--r-sm); }
  .body { display: grid; gap: 16px; padding-bottom: 18px; font-size: 15px; line-height: 1.65; color: var(--ink-2); }
  .note, .fixed { padding: 12px 14px; border-radius: var(--r-md); background: var(--paper-2); }
  .fixed b { color: var(--ink); }
  .how { display: grid; gap: 8px; min-width: 0; }
  .how h3 { font-size: 15px; font-weight: 700; color: var(--ink); }
  .who span { font-weight: 600; color: var(--ink); }
  .how ol { margin: 0; padding-left: 1.4em; display: grid; gap: 6px; }
  .how li { min-width: 0; }
  .how pre { margin: 6px 0 2px; padding: 10px 12px; border-radius: var(--r-sm); background: var(--night); color: var(--on-night); font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 13px; line-height: 1.5; white-space: pre-wrap; overflow-wrap: anywhere; max-width: 100%; }
  .how pre code { font: inherit; }
  .hnote { font-size: 14px; color: var(--ink-3); }
  .links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; font-size: 14px; }
  .links span { font-weight: 600; color: var(--ink); }
  .links a { color: var(--blue); text-decoration: none; overflow-wrap: anywhere; }
  .links a :global(svg) { display: inline; margin-left: 4px; vertical-align: -1px; }
  .links a:hover { text-decoration: underline; }
  .others a { color: var(--ink-2); }
  .empty { padding: 32px 0; color: var(--ink-3); }

  .pager { display: flex; justify-content: center; align-items: center; gap: 6px; margin-top: 40px; }
  .pg { display: grid; place-items: center; min-width: 40px; height: 40px; padding: 0 6px; border-radius: 999px; font-size: 15px; font-weight: 600; color: var(--ink-2); text-decoration: none; font-variant-numeric: tabular-nums; }
  a.pg:hover { background: rgb(15 23 42 / .06); color: var(--ink); }
  .pg[aria-current] { background: var(--ink); color: #fff; }
  .pg.off { color: var(--line); }
  .gap { min-width: 20px; text-align: center; color: var(--ink-3); }

  @media (max-width: 559px) {
    .item { padding: 16px 16px 4px; }
    .title { font-size: 16px; }
    .pager { gap: 2px; }
    .pg { min-width: 34px; height: 34px; padding: 0 4px; }
  }
</style>

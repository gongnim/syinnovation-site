  .tl {
    --gap: clamp(28px, 3.4vw, 48px); list-style: none; margin: 36px 0 0; padding: 0 0 8px; display: grid; grid-auto-flow: column;
    grid-auto-columns: clamp(280px, 38vw, 500px); gap: var(--gap); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;

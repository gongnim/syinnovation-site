<script>
  // Mouse drag for the sideways scrollers (fingers already swipe them natively): pull to scroll, then `settle`
  // decides where to come to rest from how far the pointer moved and where the drag started. A drag never also
  // counts as a click on what is under it.
  function mouseDrag(el: HTMLElement, settle: (dx: number, startLeft: number) => void) {
    let drag: { x: number; left: number; moved: boolean } | null = null;
    let dragged = false;
    el.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button === 0) drag = { x: e.clientX, left: el.scrollLeft, moved: false };
    });
    addEventListener('pointermove', (e) => {
      if (!drag) return;
      const dx = e.clientX - drag.x;
      if (!drag.moved && Math.abs(dx) < 6) return;
      drag.moved = true;
      el.classList.add('is-dragging');
      el.scrollLeft = drag.left - dx;
    });
    addEventListener('pointerup', (e) => {
      if (!drag) return;
      const { x, left, moved } = drag;
      drag = null;
      dragged = moved;
      setTimeout(() => { dragged = false; }, 0); // the click (if any) fires before this
      if (!moved) return;
      el.classList.remove('is-dragging');
      settle(e.clientX - x, left);
    });
    el.addEventListener('dragstart', (e) => e.preventDefault());
    el.addEventListener('click', (e) => { if (dragged) { e.stopPropagation(); e.preventDefault(); } }, true);
  }

  // team slider: arrows and arrow keys move it; the counter, bar and org chart highlight follow the scroll
  const track = document.querySelector<HTMLElement>('.crew-track');
  if (track) {
    const crew = track.closest<HTMLElement>('.crew')!;
    const n = track.children.length;
    const chips = Array.from(document.querySelectorAll<HTMLElement>('.org [data-go]'));
    const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    let cur = -1;
    const show = (i: number) => {
      if (i === cur) return;
      cur = i;
      crew.style.setProperty('--i', String(i));
      crew.querySelector('.count b')!.textContent = String(i + 1);
      chips.forEach((c) => c.setAttribute('aria-current', String(Number(c.dataset.go) === i)));
    };
    // autoplay: the next person every 5s. It holds while the slider is pointed at or keyboard-focused, off screen
    // or in a background tab, after the pause button, and never runs with reduced motion. Any move restarts the 5s.
    const autoBtn = crew.querySelector<HTMLButtonElement>('.auto')!;
    let stopped = smooth === 'auto', hold = false, focus = false, seen = false, timer = 0;
    const arm = () => {
      clearTimeout(timer);
      if (stopped || hold || focus || !seen || document.hidden) return;
      timer = window.setTimeout(() => go(cur + 1, cur === n - 1 ? 'auto' : smooth), 5000);
    };
    const syncAuto = () => {
      autoBtn.setAttribute('aria-pressed', String(stopped));
      autoBtn.setAttribute('aria-label', stopped ? '자동 넘김 켜기' : '자동 넘김 멈추기');
    };
    const go = (i: number, behavior = smooth) => { track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior }); arm(); };
    autoBtn.addEventListener('click', () => { stopped = !stopped; syncAuto(); arm(); });
    crew.addEventListener('mouseenter', () => { hold = true; arm(); });
    crew.addEventListener('mouseleave', () => { hold = false; arm(); });
    crew.addEventListener('focusin', (e) => { focus = (e.target as HTMLElement).matches(':focus-visible') && e.target !== autoBtn; arm(); });
    crew.addEventListener('focusout', () => { focus = false; arm(); });
    crew.addEventListener('pointerdown', arm);
    document.addEventListener('visibilitychange', arm);
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; arm(); }, { threshold: 0.5 }).observe(crew);
    syncAuto();
    track.addEventListener('scroll', () => show(Math.round(track.scrollLeft / track.clientWidth)), { passive: true });
    crew.querySelector('.prev')!.addEventListener('click', () => go(cur - 1));
    crew.querySelector('.next')!.addEventListener('click', () => go(cur + 1));
    track.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); go(cur + d); }
    });
    // mouse drag: past 12% of the width it moves one person, otherwise it settles back
    mouseDrag(track, (dx, startLeft) => {
      const from = Math.round(startLeft / track.clientWidth);
      const to = Math.abs(dx) > track.clientWidth * 0.12 ? from + (dx < 0 ? 1 : -1) : from;
      go(Math.max(0, Math.min(n - 1, to)));
    });
    // touch screens have no hover: a tap on the portrait switches between the photo and the sketch
    crew.querySelectorAll<HTMLElement>('.ph').forEach((ph) => ph.addEventListener('click', () => ph.classList.toggle('is-sketch')));
    show(0);
  }

  // network org chart: draw the links in once it comes into view; a pointed-at box lights its links
  const org = document.querySelector<HTMLElement>('.org');
  if (org) {
    new IntersectionObserver((entries, io) => {
      if (entries.some((e) => e.isIntersecting)) { org.classList.add('is-in'); io.disconnect(); }
    }, { threshold: 0.25 }).observe(org);
    const light = (id: string, on: boolean) =>
      org.querySelectorAll(`.link[data-a="${id}"], .link[data-b="${id}"]`).forEach((l) => l.classList.toggle('is-lit', on));
    org.querySelectorAll<HTMLElement>('.node').forEach((n) => {
      const id = n.dataset.id!;
      n.addEventListener('pointerenter', () => light(id, true));
      n.addEventListener('pointerleave', () => light(id, false));
    });
  }

  // CI: a preview click shows that version large and points the one download button at its PNG
  const stage = document.querySelector<HTMLElement>('.ci-stage');
  if (stage) {
    const dl = document.querySelector<HTMLAnchorElement>('.ci-dl')!;
    const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.ci-thumb'));
    thumbs.forEach((b) => b.addEventListener('click', () => {
      const k = b.dataset.k!;
      stage.dataset.k = k;
      stage.querySelectorAll<HTMLImageElement>('.ci-big').forEach((img) => { img.hidden = !img.classList.contains(k); });
      thumbs.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      dl.href = b.dataset.png!;
    }));
  }

  // history timeline: the arrows move one year at a time and grey out at either end
  const tl = document.querySelector<HTMLElement>('.tl');
  if (tl) {
    const prev = document.querySelector<HTMLButtonElement>('.tl-prev')!, next = document.querySelector<HTMLButtonElement>('.tl-next')!;
    const step = () => (tl.firstElementChild as HTMLElement).offsetWidth + parseFloat(getComputedStyle(tl).columnGap);
    const ends = () => { prev.disabled = tl.scrollLeft < 4; next.disabled = tl.scrollLeft + tl.clientWidth > tl.scrollWidth - 4; };
    const behavior: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    prev.addEventListener('click', () => tl.scrollBy({ left: -step(), behavior }));
    next.addEventListener('click', () => tl.scrollBy({ left: step(), behavior }));
    tl.addEventListener('scroll', ends, { passive: true });
    addEventListener('resize', ends);
    ends();
    // mouse drag: a short pull settles back; a longer one moves as many years as it covered (at least one)
    mouseDrag(tl, (dx, startLeft) => {
      const s = step(), from = Math.round(startLeft / s);
      const to = Math.abs(dx) < 40 ? from : from + (dx < 0 ? 1 : -1) * Math.max(1, Math.round(Math.abs(dx) / s));
      tl.scrollTo({ left: Math.max(0, to) * s, behavior });
    });
  }
</script>

---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { company } from '../data/site';

// The team (user-provided, 2026-11-11). Careers follow the user's own prototype company page; client names and
// year counts are left out on purpose. hi: greeting lines, still to be confirmed by each person.
// Photos: each person's original portrait re-posed into an office setting with an image model (2026-11-11);
// the originals are kept outside the repo. up: who this person reports to inside their team
// (임종세, 강민관 -> 공동현; 김재원 -> 박성수).
const people = [
  { n: '강형구', r: '대표이사', g: '', p: 'kang-hyungkoo',
    hi: '금융 현장에서 보안과 편리함이 늘 부딪히는 모습을 오래 지켜봤습니다. 둘 중 무엇도 포기하지 않는 보안, Trust Gateway로 증명하겠습니다.',
    c: ['BANKBE 베트남 대표 · TMX코리아 창업자, 대표', 'GREY MOS · IBM GBS 비즈니스 · 정보기술 컨설팅', '삼성카드 데이터베이스 마케팅', '고려대학교 학사 · 석사'] },
  { n: '박희준', r: '운영총괄', g: '경영지원', p: 'park-heejun',
    hi: '창업과 보안 신사업을 거치며 회사가 단단해지는 과정을 직접 겪었습니다. 고객과 한 약속은 끝까지 지키는 회사, 제가 책임지고 만들겠습니다.',
    c: ['BANKBE 재무총괄 · 큐바이노베이션 창업', 'KT · 소프트포럼 · 이글루시큐리티 신사업', '컴퓨터보안공학 학사 · 석사'] },
  { n: '공동현', r: '기술총괄', g: '연구개발', p: 'gong-donghyun',
    hi: '전자여권부터 모바일 결제까지, 사용자들이 매일 쓰는 보안을 만들어 왔습니다. 사용자는 느끼지 못할 만큼 자연스럽고, 공격자에게는 빈틈이 없는 기술을 만들겠습니다.',
    c: ['BANKBE · TMX코리아 연구소장', 'LG전자 · LG CNS 보안 분야', '전자여권 · 교통카드 · 모바일 결제 개발'] },
  { n: '임종세', r: '개발 엔지니어', g: '연구개발', p: 'lim-jongse', up: '공동현',
    hi: '화면부터 서버까지 직접 만들고 끝까지 책임집니다. 금융 시스템에서 익힌 꼼꼼함으로 Trust Gateway를 매일 더 단단하게 만들고 있습니다.',
    c: ['풀스택 개발 엔지니어', '금융권 시스템 구축 · 개발'] },
  { n: '강민관', r: '연구원', g: '연구개발', p: 'kang-mingwan', up: '공동현',
    hi: '공격보다 한 걸음 먼저 움직이는 것이 연구소의 일입니다. 새로운 공격 기법을 먼저 파고들어, 막아 내는 기술로 만들겠습니다.',
    c: ['기업부설연구소 연구원', '보안 개발자'] },
  { n: '박성수', r: '전략총괄', g: '비즈니스', p: 'park-sungsoo',
    hi: '좋은 보안은 일을 멈추게 하지 않습니다. 금융권 업무 혁신 현장에서 쌓은 경험으로, 고객의 업무에 꼭 맞는 보안을 설계하겠습니다.',
    c: ['IBM · PwC · KPMG · AT Kearney 컨설팅', '금융권 업무혁신 · 정보기술 기획', '상담센터 · 고객관리 시스템 개발 총괄'] },
  { n: '김재원', r: '마케팅총괄', g: '비즈니스', p: 'kim-jaewon', up: '박성수',
    hi: '좋은 기술은 제대로 알려질 때 더 큰 힘을 냅니다. 어려운 보안을 누구나 이해할 수 있는 말로 전하고, Trust Gateway를 더 많은 곳에 알리겠습니다.',
    c: ['KB증권 베트남 마케팅 총괄', '온라인 마케팅 · 콘텐츠 전략', '정보기술 기획 · 고객 커뮤니케이션'] },
];
// dot: team colour (slides, org chart status lights); tint: the team hub's soft background
const teams = [
  { t: '경영지원', d: '운영 · 사업 관리', dot: '#d9772b', tint: '#fdf3ea' },
  { t: '연구개발', d: 'Trust Gateway 연구 · 개발', dot: '#3a78bd', tint: '#ecf3fb' },
  { t: '비즈니스', d: '전략 · 컨설팅 · 마케팅', dot: '#3f8c69', tint: '#ebf5f0' },
];
// The org chart as a network diagram: CEO -> team hubs -> people, joined by right-angle links. Points are box centres in a 1000x460 canvas on desktop and a 400x790 canvas on phones; each link
// is [from, to, path] and runs centre to centre, so the boxes hide its ends.
const net = {
  desk: { w: 1000, h: 460,
    at: { 강형구: [500, 62], 경영지원: [170, 192], 연구개발: [500, 192], 비즈니스: [830, 192],
      박희준: [170, 300], 공동현: [500, 292], 임종세: [418, 402], 강민관: [582, 402], 박성수: [830, 292], 김재원: [830, 402] },
    links: [
      ['강형구', '경영지원', 'M500 62 V128 H170 V192'], ['강형구', '연구개발', 'M500 62 V192'], ['강형구', '비즈니스', 'M500 62 V128 H830 V192'],
      ['경영지원', '박희준', 'M170 192 V300'], ['연구개발', '공동현', 'M500 192 V292'],
      ['공동현', '임종세', 'M500 292 V348 H418 V402'], ['공동현', '강민관', 'M500 292 V348 H582 V402'],
      ['비즈니스', '박성수', 'M830 192 V292'], ['박성수', '김재원', 'M830 292 V402'],
    ] },
  mob: { w: 400, h: 790,
    at: { 강형구: [200, 44], 경영지원: [128, 150], 연구개발: [128, 332], 비즈니스: [128, 626],
      박희준: [252, 216], 공동현: [252, 398], 임종세: [282, 472], 강민관: [282, 544], 박성수: [252, 692], 김재원: [282, 760] },
    links: [
      ['강형구', '경영지원', 'M200 44 V94 H22 V150 H128'], ['강형구', '연구개발', 'M200 44 V94 H22 V332 H128'], ['강형구', '비즈니스', 'M200 44 V94 H22 V626 H128'],
      ['경영지원', '박희준', 'M128 150 V216 H252'], ['연구개발', '공동현', 'M128 332 V398 H252'],
      ['공동현', '임종세', 'M210 398 H170 V472 H282'], ['공동현', '강민관', 'M210 398 H170 V544 H282'],
      ['비즈니스', '박성수', 'M128 626 V692 H252'], ['박성수', '김재원', 'M210 692 H170 V760 H282'],
    ] },
} as const;
type Net = keyof typeof net;
type Spot = keyof typeof net.desk.at;
const pct = (k: Net, n: string) => {
  const [x, y] = net[k].at[n as Spot];
  return [(x / net[k].w) * 100, (y / net[k].h) * 100].map((v) => `${v.toFixed(2)}%`);
};
const posStyle = (n: string) => {
  const [x, y] = pct('desk', n), [mx, my] = pct('mob', n);
  return `--x:${x};--y:${y};--mx:${mx};--my:${my}`;
};
const teamOf = (n: string) => teams.find((t) => t.t === n) ?? teams.find((t) => t.t === people.find((m) => m.n === n)?.g);
// One continuous zigzag of diagonal pencil strokes over the portrait, from the top-left corner to the bottom-right.
// Drawn in on hover it reveals the colour-pencil sketch like someone colouring it in. Each stroke is the line
// x+y=c clipped to the picture (-8..108), so the colour spreads at an even pace.
const scribble = (() => {
  const pts: number[][] = [];
  for (let i = 0, c = -4; c <= 204; c += 11, i++) {
    const wob = ((i * 37) % 7 - 3) * 0.6;
    const xa = Math.max(-8, c - 108), xb = Math.min(108, c + 8);
    const a = [xa, c - xa + wob], b = [xb, c - xb - wob];
    pts.push(...(i % 2 ? [b, a] : [a, b]));
  }
  return 'M' + pts.map((p) => p.map((v) => v.toFixed(1)).join(' ')).join(' L');
})();
const dotOf =(g: string) => teams.find((t) => t.t === g)?.dot ?? '#366399';
const naverLink = `https://map.naver.com/p/search/${encodeURIComponent('서울 마포구 마포대로 78')}`;
const advisor = { n: '박구준', d: '퍼듀대학교 컴퓨터공학 · 아마존 프라임 서비스 근무 · 인공지능 프로그래밍 자문' };

const history: Record<string, { m: string; t: string }[]> = {
  '2026': [
    { m: '10', t: '초기창업패키지 선정 · 한경매거진 인터뷰' },
    { m: '08', t: '벤처기업 확인' },
    { m: '07', t: '제2서울핀테크랩 입주 · 기업부설연구소 설립' },
    { m: '02', t: 'Trust Gateway 출시' },
  ],
  '2025': [
    { m: '', t: '카드사 외국인 전용 앱 인증 공급' },
    { m: '', t: '여신금융협회 직승인 시스템 개발' },
  ],
  '2024': [{ m: '', t: '카드사 · 저축은행 통합 인증 서비스 운영' }],
  '2023': [{ m: '10', t: '㈜신영이노베이션 설립' }],
};
// number-like keys always come out ascending, so sort the newest year first explicitly
const years = Object.keys(history).sort((a, b) => Number(b) - Number(a));
const yearPic: Record<string, string> = {
  '2026': '창립 3주년을 맞아 함께 모인 신영이노베이션 팀',
  '2025': '공항에서 여권과 휴대폰, 카드를 든 여행객의 손, 참고 이미지',
  '2024': '카페에서 휴대폰으로 인증하는 손과 카드, 참고 이미지',
  '2023': '창업 첫날 사무실 창가의 책상과 노트북, 참고 이미지',
};
// CI versions: shown large from the vector file, downloaded as PNG
const ciKinds = [
  { id: 'white', label: '흰 배경 로고', svg: '/images/brand/syinnovation-logo-tagline.svg', png: '/downloads/ci/syinnovation-logo-on-white.png', alt: 'SYINNOVATION RE:Think innovation 로고, 흰 배경' },
  { id: 'blue', label: '브랜드 컬러 배경 로고', svg: '/images/brand/syinnovation-logo-white.svg', png: '/downloads/ci/syinnovation-logo-on-blue.png', alt: 'SYINNOVATION RE:Think innovation 로고, 브랜드 컬러 배경' },
  { id: 'symbol', label: '심볼', svg: '/images/brand/syinnovation-symbol.svg', png: '/downloads/ci/syinnovation-symbol.png', alt: 'SYINNOVATION 심볼' },
];
---
<Base title="회사소개" description="Never Trust, Always Verify. 신영이노베이션을 소개합니다." tone="light">
  <PageTitle title="회사소개">RE:Think innovation</PageTitle>

  <section class="section">
    <div class="wrap story">
      <div class="reveal">
        <h2 class="h2 sm">금융 인증 현장에서 시작한<br />제로트러스트</h2>
      </div>
      <div class="reveal">
        <p class="lead">신영이노베이션은 카드사와 저축은행의 인증 서비스를 만들고 운영해 온 사람들이 2023년에 세운 회사입니다.</p>
        <p class="lead">그 경험을 바탕으로, 로그인 이후에도 PC·태블릿과 휴대폰을 계속 확인하는 Trust Gateway를 만들었습니다.</p>
        <p class="lead">인증, 결제, 보안 기술을 직접 만들기 때문에, 외부 제품에 기대지 않고 오래 지원할 수 있습니다.</p>
      </div>
    </div>
    <!-- the second line of business: consulting, building and running business software for SMEs -->
    <div class="wrap story story-more">
      <div class="reveal">
        <h2 class="h2 sm">컨설팅부터<br />개발·운영까지</h2>
      </div>
      <div class="reveal">
        <p class="lead">중소·중견기업에 꼭 맞는 ERP와 업무 프로그램을 함께 만듭니다.</p>
        <p class="lead">업무 흐름을 진단하는 컨설팅부터 개발, 도입 이후의 운영과 개선까지 한 팀이 끝까지 책임집니다. 금융 시스템을 만들며 쌓은 꼼꼼함을 그대로 담습니다.</p>
      </div>
    </div>
  </section>

  <!-- team: one person per slide on their own backdrop with a greeting, then the org chart (names only) that
       also works as the slider's index -->
  <section class="section paper2">
    <div class="wrap">
      <div class="head-left reveal">
        <h2 class="h2 sm">현장을 아는 팀</h2>
        <p class="lead">인증 기술, 금융 시스템, 전략 컨설팅까지 각자의 현장에서 오래 일해 온 사람들이 모였습니다. 고객이 믿고 맡길 수 있는 보안을 함께 만들어 갑니다.</p>
      </div>
      <div class="crew reveal" style={`--n:${people.length}`} aria-roledescription="carousel" aria-label="팀원 소개">
        <div class="crew-track" tabindex="0" aria-label="팀원 소개, 좌우 화살표로 넘기기">
          {people.map((m, i) => (
            <article class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${people.length}, ${m.n}`} style={`--dot:${dotOf(m.g)}`}>
              <div class="ph">
                <img class="photo" src={`/images/team/${m.p}.webp`} alt={`${m.n} ${m.r}`} width="640" height="640" loading={i ? 'lazy' : 'eager'} />
                <svg class="sketch" viewBox="0 0 100 100" aria-hidden="true">
                  <defs>
                    <filter id={`rough-${m.p}`} x="-10%" y="-10%" width="120%" height="120%">
                      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" seed={i + 3} />
                      <feDisplacementMap in="SourceGraphic" scale="4" />
                    </filter>
                    <mask id={`sk-${m.p}`} maskUnits="userSpaceOnUse" x="0" y="0" width="100" height="100">
                      <path class="stroke" d={scribble} pathLength="1" filter={`url(#rough-${m.p})`} />
                    </mask>
                  </defs>
                  <image href={`/images/team/sketch/${m.p}.webp`} width="100" height="100" mask={`url(#sk-${m.p})`} />
                </svg>
              </div>
              <div class="txt">
                <p class="who">{m.g ? `${m.g} · ${m.r}` : m.r}</p>
                <h3 class="nm">{m.n}</h3>
                <p class="hi">{m.hi}</p>
                <ul class="career">{m.c.map((x) => <li>{x}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
        <div class="crew-ctl">
          <p class="count"><b>1</b> / {people.length}</p>
          <div class="bar" aria-hidden="true"><i></i></div>
          <button type="button" class="nav auto" aria-pressed="false" aria-label="자동 넘김 멈추기">
            <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
            <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8.5 5.5v13l10-6.5z" fill="currentColor" /></svg>
          </button>
          <button type="button" class="nav prev" aria-label="이전 팀원"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          <button type="button" class="nav next" aria-label="다음 팀원"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
      </div>

      <div class="org reveal">
        <div class="net">
          <h3 class="org-h">조직</h3>
          {(['desk', 'mob'] as const).map((k) => (
            <svg class={`links ${k}`} viewBox={`0 0 ${net[k].w} ${net[k].h}`} aria-hidden="true">
              {net[k].links.map(([a, b, d], i) => (
                <path class="link" data-a={a} data-b={b} d={d} pathLength="1" style={`--c:${teamOf(b)?.dot};--d:${(0.1 + i * 0.1).toFixed(2)}s`} />
              ))}
            </svg>
          ))}
          {teams.map((t) => (
            <p class="hub" style={`${posStyle(t.t)};--c:${t.dot};--tint:${t.tint}`}><b>{t.t}</b><span>{t.d}</span></p>
          ))}
          {people.map((m, i) => (
            <div class={i ? 'node' : 'node ceo'} data-go={i} data-id={m.n} style={`${posStyle(m.n)};--c:${i ? dotOf(m.g) : 'var(--orange)'}`}>
              <span class="r">{m.r}</span><b>{m.n}</b>
            </div>
          ))}
        </div>
        <p class="adv"><b>기술 자문 {advisor.n}</b> {advisor.d}</p>
      </div>
    </div>
  </section>

  <!-- CI: small previews sit on top of a big stage; a click shows that version large, and the one button downloads it -->
  <section class="section">
    <div class="wrap ci">
      <div class="ci-view reveal">
        <div class="ci-stage" data-k="white">
          {ciKinds.map((k, i) => <img class={`ci-big ${k.id}`} src={k.svg} alt={k.alt} hidden={i !== 0} />)}
        </div>
        <div class="ci-thumbs" role="group" aria-label="CI 종류 선택">
          {ciKinds.map((k, i) => (
            <button type="button" class={`ci-thumb ${k.id}`} data-k={k.id} data-png={k.png} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={k.label}>
              <img src={k.svg} alt="" />
            </button>
          ))}
        </div>
      </div>
      <div class="ci-copy reveal">
        <h2 class="h2 sm">CI</h2>
        <p class="lead">신영이노베이션의 CI는 별처럼 방향을 잃지 않고 새로운 길을 가리키는 우리의 방향성을 담고 있습니다.</p>
        <p class="lead">RE:Think innovation은 당연하게 여겨 온 것도 다시 생각해 더 나은 답을 찾겠다는 우리의 다짐입니다.</p>
        <a class="btn ci-dl" href={ciKinds[0].png} download>
          PNG 다운로드

  .ph { position: relative; width: min(100%, 420px); aspect-ratio: 1; margin-inline: auto; border-radius: 50%; overflow: hidden; background: var(--mist); }
  .ph img, .ph .sketch { position: absolute; inset: 0; display: block; width: 100%; height: 100%; }

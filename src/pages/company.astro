---
import Base from '../layouts/Base.astro';
import PageTitle from '../components/PageTitle.astro';
import { company } from '../data/site';

// The team (user-provided, 2026-11-11). Careers follow the user's own prototype company page; client names and
// year counts are left out on purpose. hi: greeting lines are drafts for each person to confirm or rewrite.
// Photos: each person's original portrait re-posed into an office setting with an image model (2026-11-11);
// the originals are kept outside the repo. up: who this person reports to inside their team.
const people = [
  { n: '강형구', r: '대표이사', g: '', p: 'kang-hyungkoo',
    hi: '금융 현장에서 일하며 보안이 왜 어려운지 오래 봐 왔습니다. 쓰기 편하면서도 안전한 보안을 만드는 것이 저희의 목표입니다.',
    c: ['BANKBE 베트남 대표 · TMX코리아 창업자, 대표', 'GREY MOS · IBM GBS 비즈니스 · 정보기술 컨설팅', '삼성카드 데이터베이스 마케팅', '고려대학교 학사 · 석사'] },
  { n: '박희준', r: '운영총괄', g: '경영지원', p: 'park-heejun',
    hi: '회사의 살림과 사업 관리를 맡고 있습니다. 고객과 한 약속이 끝까지 지켜지도록 챙기겠습니다.',
    c: ['BANKBE 재무총괄 · 큐바이노베이션 창업', 'KT · 소프트포럼 · 이글루시큐리티 신사업', '컴퓨터보안공학 학사 · 석사'] },
  { n: '공동현', r: '기술총괄', g: '연구개발', p: 'gong-donghyun',
    hi: '인증과 결제 보안을 오래 만들어 왔습니다. 눈에 띄지 않지만 빈틈없이 지키는 기술을 만듭니다.',
    c: ['BANKBE · TMX코리아 연구소장', 'LG전자 · LG CNS 보안 분야', '전자여권 · 교통카드 · 모바일 결제 개발'] },
  { n: '임종세', r: '개발 엔지니어', g: '연구개발', p: 'lim-jongse', up: '공동현',
    hi: '화면부터 서버까지 직접 만듭니다. 금융 시스템을 만들며 익힌 꼼꼼함으로 Trust Gateway를 다듬고 있습니다.',
    c: ['풀스택 개발 엔지니어', '금융권 시스템 구축 · 개발'] },
  { n: '강민관', r: '연구원', g: '연구개발', p: 'kang-mingwan', up: '공동현',
    hi: '기업부설연구소에서 보안 기능을 연구하고 개발합니다. 새로운 공격 방식을 먼저 공부하고 대비합니다.',
    c: ['기업부설연구소 연구원', '보안 개발자'] },
  { n: '박성수', r: '전략총괄', g: '비즈니스', p: 'park-sungsoo',
    hi: '고객의 업무 흐름을 먼저 이해합니다. 보안이 일을 막지 않고 자연스럽게 함께 가도록 설계합니다.',
    c: ['IBM · PwC · KPMG · AT Kearney 컨설팅', '금융권 업무혁신 · 정보기술 기획', '상담센터 · 고객관리 시스템 개발 총괄'] },
  { n: '김재원', r: '마케팅총괄', g: '비즈니스', p: 'kim-jaewon',
    hi: '어려운 보안 이야기를 쉽게 전하는 일을 합니다. 궁금한 점이 있으면 언제든 편하게 문의해 주세요.',
    c: ['KB증권 베트남 마케팅 총괄', '온라인 마케팅 · 콘텐츠 전략', '정보기술 기획 · 고객 커뮤니케이션'] },
];
const teams = [
  { t: '경영지원', d: '운영 · 사업 관리', tint: '#fcefe3', dot: '#d9772b' },
  { t: '연구개발', d: 'Trust Gateway 연구 · 개발', tint: '#e6effa', dot: '#3a78bd' },
  { t: '비즈니스', d: '전략 · 컨설팅 · 마케팅', tint: '#e5f3ec', dot: '#3f8c69' },
];
const dotOf = (g: string) => teams.find((t) => t.t === g)?.dot ?? '#366399';
const naverLink = `https://map.naver.com/p/search/${encodeURIComponent('서울 마포구 마포대로 78')}`;
const advisor = { n: '박구준', d: '퍼듀대학교 컴퓨터공학 · 아마존 프라임 서비스 근무 · 인공지능 프로그래밍 자문' };

const history: Record<string, { m: string; t: string }[]> = {
  '2026': [
    { m: '10', t: '초기창업패키지 선정 · 한경매거진 인터뷰' },
    { m: '08', t: '벤처기업 확인' },
    { m: '07', t: '제2서울핀테크랩 입주 · 기업부설연구소 설립' },
    { m: '02', t: 'Trust Gateway 출시' },
  ],
  '2025': [
    { m: '', t: '카드사 외국인 전용 앱 인증 공급' },
    { m: '', t: '여신금융협회 직승인 시스템 개발' },
  ],
  '2024': [{ m: '', t: '카드사 · 저축은행 통합 인증 서비스 운영' }],
  '2023': [{ m: '10', t: '㈜신영이노베이션 설립' }],
};
const years = Object.keys(history);
---
<Base title="회사소개" description="Never Trust, Always Verify. 신영이노베이션을 소개합니다." tone="light">
  <PageTitle title="회사소개">편리하면서도 안전한 보안을 다시 생각합니다.</PageTitle>

  <section class="section">
    <div class="wrap story">
      <div class="reveal">
        <p class="tag">RE:Think innovation</p>
        <h2 class="h2 sm">금융 인증 현장에서 시작한<br />제로트러스트</h2>
      </div>
      <div class="reveal">
        <p class="lead">신영이노베이션은 카드사와 저축은행의 인증 서비스를 만들고 운영해 온 사람들이 2023년에 세운 회사입니다.</p>
        <p class="lead">그 경험을 바탕으로, 로그인 이후에도 사람과 기기를 계속 확인하는 Trust Gateway를 만들었습니다. 회사마다 다른 요구에 맞춘 기술 개발도 함께 합니다.</p>
      </div>
    </div>
  </section>

  <!-- team: one person per slide on their own backdrop with a greeting, then the org chart (names only) that
       also works as the slider's index -->
  <section class="section paper2">
    <div class="wrap">
      <div class="head-left reveal">
        <h2 class="h2 sm">함께 만드는 사람들</h2>
        <p class="lead">2023년에 시작한 스타트업입니다. 금융, 보안, 컨설팅 현장에서 오래 일해 온 사람들이 한 팀으로 Trust Gateway를 만듭니다.</p>
      </div>
      <div class="crew reveal" style={`--n:${people.length}`} aria-roledescription="carousel" aria-label="팀원 소개">
        <div class="crew-track" tabindex="0" aria-label="팀원 소개, 좌우 화살표로 넘기기">
          {people.map((m, i) => (
            <article class="slide" role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${people.length}, ${m.n}`} style={`--dot:${dotOf(m.g)}`}>
              <div class="ph"><img src={`/images/team/${m.p}.webp`} alt={`${m.n} ${m.r}`} width="640" height="640" loading={i ? 'lazy' : 'eager'} /></div>
              <div class="txt">
                <p class="who">{m.g ? `${m.g} · ${m.r}` : m.r}</p>
                <h3 class="nm">{m.n}</h3>
                <p class="hi">{m.hi}</p>
                <ul class="career">{m.c.map((x) => <li>{x}</li>)}</ul>
              </div>
            </article>
          ))}
        </div>
        <div class="crew-ctl">
          <p class="count"><b>1</b> / {people.length}</p>
          <div class="bar" aria-hidden="true"><i></i></div>
          <button type="button" class="nav prev" aria-label="이전 팀원"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          <button type="button" class="nav next" aria-label="다음 팀원"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
      </div>

      <div class="org reveal">
        <h3 class="org-h">조직</h3>
        <div class="org-top"><button type="button" class="chip ceo" data-go="0"><span class="r">{people[0].r}</span>{people[0].n}</button></div>
        <div class="org-cols">
          {teams.map((t) => (
            <div class="team" style={`--tint:${t.tint};--dot:${t.dot}`}>
              <p class="team-n">{t.t}</p>
              <p class="team-d">{t.d}</p>
              <ul class="members">
                {people.filter((m) => m.g === t.t && !m.up).map((lead) => (
                  <li>
                    <button type="button" class="chip" data-go={people.indexOf(lead)}><span class="r">{lead.r}</span>{lead.n}</button>
                    {people.some((m) => m.up === lead.n) && (
                      <ul class="subs">
                        {people.filter((m) => m.up === lead.n).map((m) => (
                          <li><button type="button" class="chip" data-go={people.indexOf(m)}><span class="r">{m.r}</span>{m.n}</button></li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <p class="adv"><b>기술 자문 {advisor.n}</b> {advisor.d}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="ci-head reveal">
        <div>
          <h2 class="h2 sm">CI</h2>
          <p class="lead">별처럼 방향을 잃지 않고, 새로운 길을 가리키는 신영이노베이션의 로고입니다.</p>
        </div>
        <div class="btn-row">
          <a class="btn ghost" href="/images/brand/syinnovation-logo-4000.png" download="syinnovation-logo.png">PNG 내려받기</a>
          <a class="btn ghost" href="/images/brand/syinnovation-logo.svg" download="syinnovation-logo.svg">SVG 내려받기</a>
        </div>
      </div>
      <!-- vector files, so the marks stay sharp at any size -->
      <div class="ci-tiles reveal">
        <div class="ci-tile light"><img src="/images/brand/syinnovation-logo.svg" alt="SYINNOVATION 로고" width="300" height="81" /></div>
        <div class="ci-tile dark"><img src="/images/brand/syinnovation-logo-white.svg" alt="SYINNOVATION 로고, 어두운 배경용" width="303" height="87" /></div>
        <div class="ci-tile mark"><img src="/images/brand/syinnovation-symbol.svg" alt="SYINNOVATION 심볼" width="83" height="81" /></div>
      </div>
    </div>
  </section>

  <section class="section mist">
    <div class="wrap">
      <div class="head-left reveal"><h2 class="h2 sm">연혁</h2></div>
      <div class="hist reveal">
        <div class="years" role="tablist" aria-label="연도">
          {years.reverse().map((y, i) => (<button type="button" role="tab" id={`y-${y}`} aria-controls={`h-${y}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{y}</button>))}
        </div>
        {years.map((y, i) => (
          <ul class="hist-list" role="tabpanel" id={`h-${y}`} aria-labelledby={`y-${y}`} hidden={i !== 0}>
            {history[y].map((h) => (<li><span class="m">{h.m ? `${y}.${h.m}` : y}</span><span>{h.t}</span></li>))}
          </ul>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2 sm reveal">오시는 길</h2>
      <!-- Google map (needs no key; Naver blocks embedding without an API key); the address card underneath shows
           until the map loads, or if a browser blocks it -->
      <div class="map reveal">
        <div class="map-card">
          <svg viewBox="0 0 24 24" width="36" height="36" aria-hidden="true"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" fill="currentColor" /><circle cx="12" cy="10" r="2.4" fill="#fff" /></svg>
          <b>서울 마포구 마포대로 78</b>
          <span>제2서울핀테크랩 · 경찰공제회 11층</span>
        </div>
        <iframe class="nmap" title="신영이노베이션 위치 지도: 서울 마포구 마포대로 78" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen
          src="https://www.google.com/maps/embed?origin=mfe&pb=!1m3!2m1!1z7ISc7Jq47Yq567OE7IucIOuniO2PrOq1rCDrp4jtj6zrjIDroZwgNzg!6i16!3m1!1sko!5m1!1sko"></iframe>
        <a class="map-open" href={naverLink} target="_blank" rel="noopener">네이버 지도에서 보기</a>
      </div>
      <dl class="info">
        <div><dt>주소</dt><dd>{company.address}</dd></div>
        <div><dt>연락처</dt><dd><a href={`tel:${company.phone.replaceAll('-', '')}`}>{company.phone}</a></dd></div>
        <div><dt>이메일</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
      </dl>
    </div>
  </section>
</Base>

<style>
  .story { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(32px, 6vw, 80px); }
  .story .h2 { margin-top: 10px; }
  .story .lead + .lead { margin-top: 18px; }
  /* team slider: one person at a time on their own backdrop; the photo is grey until you point at it */
  .crew { margin-top: 36px; }
  .crew-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; border-radius: 28px; background: #fff; }
  .crew-track::-webkit-scrollbar { display: none; }
  .crew-track:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  .slide {
    flex: 0 0 100%; scroll-snap-align: start; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    align-items: center; gap: clamp(28px, 5vw, 80px); padding: clamp(32px, 4.5vw, 64px) clamp(24px, 5vw, 80px);
  }
  /* a big round portrait: face and upper chest */
  .ph { width: min(100%, 420px); aspect-ratio: 1; margin-inline: auto; border-radius: 50%; overflow: hidden; background: var(--mist); }
  .ph img {
    display: block; width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.04); transition: filter .6s var(--ease), transform .8s var(--ease);
  }
  .slide:hover .ph img { filter: none; transform: scale(1.025); }
  @media (hover: none) { .ph img { filter: none; } }
  .who { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 700; color: var(--ink-2); }
  .who::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--dot); }
  .nm { margin-top: 10px; font-size: clamp(32px, 2.4vw, 44px); font-weight: 800; letter-spacing: -0.03em; color: var(--ink); }
  .hi { margin-top: 22px; font-size: clamp(18px, 1.25vw, 21px); font-weight: 600; line-height: 1.65; color: var(--ink); }
  .career { list-style: none; margin: 28px 0 0; padding: 22px 0 0; border-top: 1px solid var(--line); display: grid; gap: 6px; }
  .career li { font-size: 14px; line-height: 1.6; color: var(--ink-3); }
  .crew-ctl { display: flex; align-items: center; gap: 16px; margin-top: 20px; }
  .count { min-width: 44px; font-size: 14px; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .count b { color: var(--ink); }
  .bar { flex: 1; height: 2px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; width: calc(100% / var(--n)); background: var(--blue); transform: translateX(calc(var(--i, 0) * 100%)); transition: transform .5s var(--ease); }
  .nav { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .nav:hover { background: var(--ink); border-color: var(--ink); color: #fff; }

  /* org chart without faces: soft team cards on a rounded bracket; each name jumps to that person's slide */
  .org { --wire: #c3d2e5; margin-top: clamp(64px, 8vw, 104px); }
  .org-h { text-align: center; font-size: 22px; font-weight: 800; letter-spacing: -0.02em; color: var(--ink); }
  .org-top { position: relative; display: flex; justify-content: center; margin-top: 24px; padding-bottom: 22px; }
  .org-top::after { content: ''; position: absolute; left: 50%; bottom: 0; width: 1.5px; height: 22px; background: var(--wire); }
  .org-cols { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 22px; }
  .org-cols::before { content: ''; position: absolute; top: -22px; left: calc((100% - 40px) / 6); right: calc((100% - 40px) / 6); height: 22px; border: 1.5px solid var(--wire); border-bottom: 0; border-radius: 18px 18px 0 0; }
  .team { position: relative; padding: 24px; border-radius: 22px; background: var(--tint); }
  .team:nth-child(2)::before { content: ''; position: absolute; top: -22px; left: 50%; width: 1.5px; height: 22px; background: var(--wire); }
  .team-n { display: flex; align-items: center; gap: 8px; font-size: 17px; font-weight: 800; color: var(--ink); }
  .team-n::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--dot); }
  .team-d { margin-top: 4px; font-size: 14px; color: var(--ink-2); }
  .members { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  /* people who report to a lead hang under that lead's chip on a small tree line */
  .subs { list-style: none; margin: 8px 0 0 24px; padding: 0 0 0 20px; display: grid; gap: 8px; justify-items: start; }
  .subs li { position: relative; }
  .subs li::before { content: ''; position: absolute; left: -20px; top: -8px; width: 14px; height: calc(50% + 8px); border: 1.5px solid var(--wire); border-top: 0; border-right: 0; border-bottom-left-radius: 10px; }
  .subs li:not(:last-child)::after { content: ''; position: absolute; left: -20px; top: -8px; bottom: 0; border-left: 1.5px solid var(--wire); }
  .chip {
    display: inline-flex; align-items: baseline; gap: 8px; padding: 10px 18px; border-radius: 999px; border: 1px solid rgb(25 31 40 / .08);
    background: #fff; font: inherit; font-size: 16px; font-weight: 700; color: var(--ink); cursor: pointer; transition: background .2s, color .2s, border-color .2s;
  }
  .chip .r { font-size: 13px; font-weight: 600; color: var(--ink-3); transition: color .2s; }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-current='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .chip[aria-current='true'] .r { color: rgb(255 255 255 / .7); }
  .chip.ceo { padding: 14px 28px; font-size: 18px; }
  .adv { margin-top: 28px; text-align: center; font-size: 14px; color: var(--ink-3); }
  .adv b { margin-right: 6px; font-weight: 700; color: var(--ink); }
  .ci-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .ci-head .lead { margin-top: 14px; }
  .ci-tiles { margin-top: 36px; display: grid; grid-template-columns: 2fr 2fr 1fr; gap: 20px; }
  .ci-tile { min-height: clamp(220px, 22vw, 340px); border-radius: var(--r-xl); display: grid; place-items: center; padding: 40px; }
  .ci-tile img { width: 100%; height: auto; }
  .ci-tile.light { border: 1px solid var(--line); background: #fff; }
  .ci-tile.light img { max-width: 420px; }
  .ci-tile.dark { background: #2e6da3; }
  .ci-tile.dark img { max-width: 420px; }
  .ci-tile.mark { background: var(--mist); }
  .ci-tile.mark img { max-width: 132px; }
  .hist { background: #fff; border-radius: var(--r-xl); padding: 12px; display: grid; grid-template-columns: 180px 1fr; gap: 24px; }
  .years { display: grid; gap: 4px; align-content: start; padding: 12px; }
  .years button { border: 0; background: transparent; text-align: left; padding: 10px 16px; border-radius: var(--r-sm); font-size: 22px; font-weight: 800; color: var(--ink-3); cursor: pointer; }
  .years button[aria-selected='true'] { color: var(--blue); background: var(--mist); }
  .hist-list { list-style: none; margin: 0; padding: 24px 12px 24px 0; display: grid; gap: 4px; align-content: start; }
  .hist-list li { display: grid; grid-template-columns: 100px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .hist-list .m { font-weight: 700; color: var(--blue); }
  /* 오시는 길: a full-width map, then address / phone / email in three columns */
  .map { position: relative; margin-top: 32px; height: clamp(320px, 38vw, 560px); border-radius: 16px; overflow: hidden; background: var(--mist); }
  .map-card { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 8px; padding: 24px; text-align: center; }
  .map-card svg { margin-bottom: 6px; color: var(--orange); }
  .map-card b { font-size: 20px; font-weight: 700; color: var(--ink); }
  .map-card span { font-size: 15px; color: var(--ink-3); }
  .nmap { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .map-open {
    position: absolute; z-index: 2; top: 16px; right: 16px; padding: 11px 18px; border-radius: 999px; background: #fff; color: var(--ink);
    font-size: 14px; font-weight: 700; box-shadow: 0 2px 10px rgb(25 31 40 / .12); transition: background .2s, color .2s;
  }
  .map-open:hover { background: var(--ink); color: #fff; }
  .info { margin: 48px 0 0; border-top: 1px solid var(--blue); display: grid; grid-template-columns: 1.5fr 1fr 1fr; }
  .info div { display: flex; align-items: baseline; gap: 28px; padding: 44px 40px; }
  .info div + div { border-left: 1px solid var(--line); }
  .info dt { flex: 0 0 auto; font-size: 18px; font-weight: 700; color: var(--ink); }
  .info dd { margin: 0; font-size: 18px; color: var(--ink-2); }
  .info a:hover { color: var(--blue); }
  @media (max-width: 767px) {
    .story, .hist, .ci-tiles { grid-template-columns: 1fr; }
    .slide { grid-template-columns: 1fr; gap: 24px; padding: 28px 12px 28px; align-items: start; }
    .ph { width: min(78%, 300px); }
    .txt { padding: 0 10px; }
    .hi { margin-top: 16px; }
    .career { margin-top: 20px; padding-top: 16px; }
    .org-cols { grid-template-columns: 1fr; gap: 12px; }
    .org-cols::before, .team:nth-child(2)::before { display: none; }
    .team { padding: 20px; }
    .info { grid-template-columns: 1fr; }
    .info div { padding: 20px 4px; gap: 20px; }
    .info div + div { border-left: 0; border-top: 1px solid var(--line); }
    .years { display: flex; flex-wrap: wrap; }
  }
</style>

<script>
  // team slider: arrows, arrow keys and org chart names move it; the counter, bar and org chart follow the scroll
  const track = document.querySelector<HTMLElement>('.crew-track');
  if (track) {
    const crew = track.closest<HTMLElement>('.crew')!;
    const n = track.children.length;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.org [data-go]'));
    const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    let cur = -1;
    const show = (i: number) => {
      if (i === cur) return;
      cur = i;
      crew.style.setProperty('--i', String(i));
      crew.querySelector('.count b')!.textContent = String(i + 1);
      chips.forEach((c) => c.setAttribute('aria-current', String(Number(c.dataset.go) === i)));
    };
    const go = (i: number, behavior = smooth) => track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior });
    track.addEventListener('scroll', () => show(Math.round(track.scrollLeft / track.clientWidth)), { passive: true });
    crew.querySelector('.prev')!.addEventListener('click', () => go(cur - 1));
    crew.querySelector('.next')!.addEventListener('click', () => go(cur + 1));
    track.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); go(cur + d); }
    });
    // jump straight to the person, then bring the slider into view
    chips.forEach((c) => c.addEventListener('click', () => { go(Number(c.dataset.go), 'auto'); crew.scrollIntoView({ behavior: smooth, block: 'center' }); }));
    show(0);
  }

  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.years [role="tab"]'));
  const pick = (tab: HTMLButtonElement) => tabs.forEach((t) => {
    const on = t === tab; t.setAttribute('aria-selected', String(on)); t.tabIndex = on ? 0 : -1;
    const p = document.getElementById(t.getAttribute('aria-controls')!); if (p) p.hidden = !on;
  });
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pick(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return; e.preventDefault(); const n = tabs[(i + d + tabs.length) % tabs.length]; pick(n); n.focus();
    });
  });
</script>

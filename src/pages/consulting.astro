---
// IT 컨설팅·개발: custom consulting and development. The page tells one story: the visitor's worries, the change they
// can drag to compare, what we do (with small live screens), how a project runs (scroll-driven), how AI is used, and
// proof from past work, then answers common questions. 에어레인 (AIRRANE) may be named (ERP case, owner approved
// 2026-11-13); other client names and project figures stay off the page. Hero pictures: colour-pencil scenes of the
// team made with the image model from the company page portraits (2026-11-13). Other photos are
// Pexels (no credit required): case Mumtaz Niazi 36825977, braille Eren Li 7188777,
// payment Towfiqu barbhuiya 9122014, phone I'm Zion 12376016.
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';

// hero: the five steps take turns; each brings a colour-pencil sketch of the teammate who leads it (drawn from the
// same portraits as the company page) and what happens in that step
const flow = [
  { t: '요구사항', img: 'sk-req', alt: '고객의 이야기를 들으며 메모하는 박성수 전략총괄을 그린 색연필 스케치', items: ['업무 담당자 인터뷰', '지금 업무와 문제 분석', '개선 방향 정리'] },
  { t: '기술 설계', img: 'sk-design', alt: '화이트보드에 업무 흐름을 그리는 공동현 기술총괄을 그린 색연필 스케치', items: ['업무 흐름 다시 설계', 'IT 요구사항 명세', '시스템 구조와 단계별 로드맵'] },
  { t: '개발 · QA', img: 'sk-dev', alt: '모니터 앞에서 코드를 검토하는 임종세 개발 엔지니어를 그린 색연필 스케치', items: ['AI 개발 도구로 빠르게 초안', '개발자가 코드 검토와 테스트', '짧은 주기로 시연하고 고침'] },
  { t: '배포', img: 'sk-launch', alt: '서버 옆에서 노트북으로 배포를 확인하는 강민관 연구원을 그린 색연필 스케치', items: ['운영 환경 준비', '사용자 교육', '고객과 함께 오픈'] },
  { t: '운영 · 유지보수', img: 'sk-ops', alt: '운영 현황 화면을 살펴보는 박희준 운영총괄을 그린 색연필 스케치', items: ['기능 개선과 업데이트', '장애 대응', '사용 현황을 보고 다음 개선 제안'] },
];

const pains = [
  { i: 'plan', q: '엑셀과 메일로 일합니다', a: '흩어진 업무를 하나의 시스템으로 모으고, 결재와 보고가 저절로 이어지게 합니다.' },
  { i: 'cycle', q: '같은 내용을 두 번 입력합니다', a: '업무 흐름을 다시 짜서, 한 번 입력한 내용이 필요한 곳으로 흘러가게 합니다.' },
  { i: 'server', q: '오래된 시스템을 봐 줄 곳이 없습니다', a: '지금 시스템을 분석해 유지보수를 맡거나, 단계적으로 새 시스템으로 옮깁니다.' },
  { i: 'phone', q: '앱이 필요한데 개발팀이 없습니다', a: 'Web, iOS, Android, 백엔드를 한곳에서 만들고 오픈 뒤 운영까지 맡습니다.' },
  { i: 'shield', q: '인증과 결제 기능이 필요합니다', a: '금융 현장에서 만든 인증, 결제, 보안 기술로 필요한 기능을 직접 개발합니다.' },
];

const services = [
  { k: 'pi', i: 'search', t: 'PI 컨설팅', s: '일하는 방식부터 다시 짭니다', d: '지금 일하는 방식을 함께 들여다보고, 줄일 일과 바꿀 일을 정리합니다. 개발 전에 무엇을 만들지부터 분명히 합니다.',
    pts: ['현황 분석: 인터뷰와 문서로 문제 정리', '개선 방향과 개선 과제 정의', '시스템 구축 전략과 단계별 로드맵', '구축과 운영 인계까지 연결'] },
  { k: 'dev', i: 'code', t: '맞춤 개발', s: 'Web · iOS · Android · 백엔드', d: '회사 업무에 꼭 맞는 시스템과 앱을 만듭니다. AI 개발 도구로 빠르게 만들고, 코드 검토와 테스트는 개발자가 직접 챙깁니다.',
    pts: ['업무 시스템, 관리자 화면, 모바일 앱', '짧은 주기로 만들어 보여 드리며 고침', '기존 시스템과의 연동 설계'] },
  { k: 'ops', i: 'cycle', t: '운영과 유지보수', s: '오픈한 뒤에도 함께합니다', d: '쓰는 모습을 보며 기능을 고치고, 업데이트와 장애 대응을 이어서 맡습니다.',
    pts: ['기능 개선과 업데이트', '장애 대응', '사용 현황을 보며 다음 개선 제안'] },
  { k: 'tech', i: 'shield', t: '맞춤 기술 개발', s: '인증 · 결제 · 보안', d: '회사마다 다른 요구에 맞춰 인증, 결제, 보안 기능을 직접 개발합니다. 금융 서비스를 만들고 운영하며 쌓은 기술입니다.',
    pts: ['모바일 인증과 생체 승인', '결제 모듈 개발', '보안 기능과 접근 제어'] },
];

const steps = [
  { t: '요구사항', you: '업무 담당자 인터뷰에 참여하고 자료를 나눠 주세요', we: '지금 업무를 분석하고 문제와 개선 방향을 정리합니다', left: ['현황 분석 보고서', '이슈 목록', '개선 방향'] },
  { t: '기술 설계', you: '바뀐 업무 흐름이 맞는지 확인해 주세요', we: '업무 흐름을 다시 설계하고 IT 요구사항과 시스템 구조, 단계별 로드맵을 정합니다', left: ['업무 설계서', 'IT 요구사항 명세', '단계별 로드맵'] },
  { t: '개발 · QA', you: '짧은 주기의 시연을 보고 의견을 주세요', we: 'AI 개발 도구로 빠르게 만들고, 코드 검토와 테스트는 개발자가 직접 합니다', left: ['동작하는 시스템', '시험 결과'] },
  { t: '배포', you: '사용자 교육에 참여해 주세요', we: '운영 환경을 갖추고 오픈을 준비해, 함께 오픈합니다', left: ['운영 환경', '사용자 교육'] },
  { t: '운영 · 유지보수', you: '쓰면서 불편한 점을 알려 주세요', we: '기능을 고치고 업데이트와 장애 대응을 이어 갑니다', left: ['업데이트 기록', '운영 인계 문서'] },
];

const principles = [
  { t: 'PI 먼저', d: '시스템을 정하기 전에 일하는 방식부터 바꿉니다.' },
  { t: '업무 효율 우선', d: '기술이 할 수 있는 것보다 실제로 일하는 방식을 기준으로 합니다.' },
  { t: '꼭 필요한 것만', d: '필요한 화면만 만들고, 같은 내용을 두 번 입력하지 않게 합니다.' },
  { t: '단계별 구축', d: '핵심을 먼저, 확장은 다음, 고도화는 마지막에 합니다.' },
];

const phases = [
  { t: 'PI 컨설팅', d: '현황 분석 · 업무 재설계 · IT 요구사항과 로드맵', when: '2025년 11월 ~ 2026년 3월', s: 'done' },
  { t: '1단계 ERP 핵심 구축', d: '생산 · 품질 · 프로젝트 관리 · 지식 관리 · 통합 분석', when: '2026년 4월 ~ 12월', s: 'now' },
  { t: '2단계 확대', d: '신규 사업부로 넓히기', when: '2027년 상반기 예정', s: 'next' },
  { t: '3단계 고도화', d: '대시보드 · 분석 · 운영 인계', when: '2027년 하반기 예정', s: 'next' },
];

const cases = [
  { img: 'auth', k: '금융', t: '카드사 · 저축은행 모바일 인증', d: '카드사와 저축은행 앱의 모바일 통합인증을 구축하고 운영했습니다.', tags: ['모바일 인증', '앱 통합', '구축과 운영'] },
  { img: 'nfc', k: '결제', t: '모바일 POS NFC 결제 모듈', d: '모바일 POS에 쓰는 NFC 결제 모듈을 개발하고, 해외 개발사 기술을 현장에서 검증해 EMV 국제 인증을 지원했습니다.', tags: ['NFC', 'EMV 인증', '국제 결제 규격'] },
  { img: 'braille', k: '접근성', t: '점자 변환 솔루션', d: '해외 수출용 문서 점자 변환 엔진을 직접 개발해, 지원이 끊긴 기존 해외 솔루션을 대체했습니다.', tags: ['자체 알고리즘', '이미지 점자 변환', '공공 접근성 사업'] },
];

const faq = [
  { q: '기간과 비용은 어떻게 정하나요?', a: '업무 범위, 화면과 기능의 양, 연동할 시스템에 따라 달라집니다. 상담에서 지금 상황을 듣고 단계별 일정과 견적을 드립니다.' },
  { q: '개발부터 맡길 수도 있나요?', a: '네. 요구사항이 이미 정리되어 있다면 설계와 개발부터 시작합니다. 업무 흐름부터 다시 보고 싶다면 PI 컨설팅부터 함께합니다.' },
  { q: 'AI로 만들면 품질은 괜찮나요?', a: 'AI 개발 도구는 초안을 빠르게 만드는 데 씁니다. 모든 코드는 개발자가 검토하고, 테스트를 거친 뒤 짧은 주기로 시연해 확인받습니다.' },
  { q: '지금 쓰는 시스템과 연결할 수 있나요?', a: '설계 단계에서 연결할 시스템과 데이터를 함께 정리하고, 필요한 연계를 개발합니다.' },
  { q: '오픈한 뒤에도 맡길 수 있나요?', a: '네. 기능 개선, 업데이트, 장애 대응을 이어서 맡습니다. 다른 곳에서 만든 시스템의 유지보수도 상담해 드립니다.' },
];
const at = (n: number) => `--at:${n}`;
---
<Base title="IT 컨설팅·개발" description="업무 분석(PI)부터 맞춤 개발과 운영까지 함께하는 신영이노베이션의 IT 컨설팅·개발.">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">IT 컨설팅·개발</p>
        <h1 class="title">전략부터 시스템까지, <br />회사에 맞춰 컨설팅하고 <br />개발합니다</h1>
        <p class="lead-d">코드 한 줄 쓰기 전에 일하는 방식부터 봅니다. <br />PI 컨설팅부터 맞춤 개발과 운영까지 한곳에서 맡습니다.</p>
        <div class="btn-row">
          <a class="btn primary" href="/contact?type=ai">IT 컨설팅·개발 문의</a>
          <a class="btn ghost" href="#process">진행 방식 보기</a>
        </div>
      </div>
      <div class="show">
        <figure class="photo">
          {flow.map((f, i) => (
            <img class={i === 0 ? 'on' : ''} src={`/images/consulting/${f.img}.webp`} srcset={`/images/consulting/${f.img}-800.webp 800w, /images/consulting/${f.img}.webp 1536w`}
              sizes="(max-width: 1023px) 100vw, 50vw" alt={f.alt} width="1536" height="1024" fetchpriority={i === 0 ? 'high' : undefined} loading={i === 0 ? undefined : 'lazy'} decoding="async" />
          ))}
        </figure>
        {flow.map((f, i) => (
          <div class={`cap${i === 0 ? ' on' : ''}`} hidden={i !== 0}>
            <p class="cap-k"><span>{String(i + 1).padStart(2, '0')}</span>{f.t}</p>
            <ul>{f.items.map((x, k) => <li style={`--k:${k}`}><Icon name="check" size={16} />{x}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
    <div class="wrap">
      <ol class="flow" aria-label="진행 순서">
        {flow.map((f, i) => (
          <li class={i === 0 ? 'on' : ''}>
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}><span class="flow-n">{String(i + 1).padStart(2, '0')}</span>{f.t}</button>
            <i class="bar" aria-hidden="true"></i>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 1. the visitor's worries: tap or hover to see how we solve each -->
  <section class="section">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">이런 고민이 있다면</h2>
        <p class="lead">하나라도 해당한다면 이야기를 나눠 볼 때입니다. 카드를 눌러 보세요.</p>
      </div>
      <ul class="pains">
        {pains.map((p) => (
          <li class="reveal">
            <button class="pain" type="button" aria-pressed="false">
              <span class="face front"><span class="p-ico"><Icon name={p.i} size={22} /></span><b>{p.q}</b><small>이렇게 풉니다</small></span>
              <span class="face back"><b>이렇게 풉니다</b><span>{p.a}</span></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2. before and after: drag to compare -->
  <section class="section mist">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">바뀐 뒤의 모습</h2>
        <p class="lead">가운데 손잡이를 끌어 지금과 바뀐 뒤를 비교해 보세요.</p>
      </div>
      <div class="compare reveal" style="--pos: 50%">
        <div class="pane before" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>생산현황_최종_수정(3).xlsx</span></div>
          <div class="sheet">
            {['날짜', '품목', '수량', '담당', '확인'].map((h) => <b>{h}</b>)}
            {Array.from({ length: 11 }, (_, r) => [`11/${String(r + 3).padStart(2, '0')}`, ['A-12', 'B-07', 'A-12', 'C-21', 'B-07', 'A-03', 'C-21', 'A-12', 'B-07', 'A-03', 'C-21'][r], ['120', '?', '118', '95', '다시 확인', '120', '88', '?', '102', '120', '96'][r], ['김', '이', '김', '박', '이', '최', '박', '김', '이', '최', '박'][r], ['', '메일 확인', '', '수정본?', '', '', '', '메일 확인', '', '', '수정본?'][r]]).flat().map((c) => <span class={c === '?' || c === '다시 확인' ? 'bad' : c === '메일 확인' || c === '수정본?' ? 'warn' : ''}>{c}</span>)}
          </div>
          <div class="mail m1"><Icon name="mail" size={14} />RE: RE: 수량 다시 확인 부탁드립니다</div>
          <div class="mail m2"><Icon name="mail" size={14} />FW: 결재 요청 (2차)</div>
          <div class="note">어디까지 했지?</div>
        </div>
        <div class="pane after" aria-hidden="true">
          <div class="win-bar"><i></i><i></i><i></i><span>업무 시스템</span></div>
          <div class="dash">
            <aside><b></b><b></b><b></b><b></b></aside>
            <div class="dash-main">
              <p class="dash-h">오늘의 업무</p>
              <div class="kpis"><span><small>결재 대기</small><b>3</b></span><span><small>생산 계획</small><b>확정</b></span><span><small>품질 이슈</small><b>1</b></span></div>
              <div class="bars">{[60, 75, 52, 88, 70, 94].map((h) => <i style={`height:${h}%`}></i>)}</div>
              <p class="dash-ok"><Icon name="check" size={14} />보고서는 매일 자동으로 만들어집니다</p>
            </div>
          </div>
        </div>
        <span class="divider" aria-hidden="true"><span class="knob"><Icon name="code" size={18} /></span></span>
        <span class="cmp-tag l" aria-hidden="true">지금</span><span class="cmp-tag r" aria-hidden="true">바뀐 뒤</span>
        <input class="cmp-range" type="range" min="0" max="100" value="50" aria-label="지금과 바뀐 뒤 비교: 왼쪽은 지금, 오른쪽은 바뀐 뒤" />
      </div>
      <ul class="cmp-notes">
        <li class="reveal"><Icon name="check" size={18} />같은 내용은 한 번만 입력</li>
        <li class="reveal"><Icon name="check" size={18} />결재는 휴대폰으로</li>
        <li class="reveal"><Icon name="check" size={18} />보고서는 자동으로</li>
      </ul>
    </div>
  </section>

  <!-- 3. what we do: tabs, each with a small live screen -->
  <section class="section">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">무엇을 하나요</h2>
        <p class="lead">정해진 제품을 파는 대신, 회사의 일하는 방식에 맞춰 컨설팅하고 직접 만듭니다.</p>
      </div>
      <div class="svc reveal">
        <div class="svc-list" role="tablist" aria-label="서비스">
          {services.map((s, i) => (
            <button type="button" role="tab" id={`svc-tab-${s.k}`} aria-controls={`svc-${s.k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>

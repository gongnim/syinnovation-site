  .bars i:last-child { background: var(--blue); }
  .dash-ok { display: flex; align-items: center; gap: 6px; font-size: clamp(11px, 1vw, 14px); font-weight: 600; color: #0f8a66; }
  .divider { position: absolute; top: 0; bottom: 0; left: var(--pos); width: 3px; margin-left: -1.5px; background: #fff; box-shadow: 0 0 0 1px rgba(16, 24, 40, .12); pointer-events: none; }
  .knob { position: absolute; top: 50%; left: 50%; width: 48px; height: 48px; margin: -24px 0 0 -24px; border-radius: 50%; background: #fff; color: var(--blue); display: grid; place-items: center; box-shadow: 0 6px 18px rgba(16, 24, 40, .2); }
  .cmp-tag { position: absolute; bottom: 16px; padding: 6px 14px; border-radius: 999px; font-size: 14px; font-weight: 700; pointer-events: none; }
  .cmp-tag.l { left: 16px; background: var(--ink); color: #fff; }
  .cmp-tag.r { right: 16px; background: var(--blue); color: #fff; }
  .cmp-range { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: ew-resize; touch-action: pan-y; }
  .compare:has(.cmp-range:focus-visible) .knob { outline: 3px solid var(--orange); outline-offset: 2px; }
  .cmp-notes { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; }
  .cmp-notes li { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink); }
  .cmp-notes li :global(svg) { color: var(--blue); }

  /* 3. services: tabs and small live screens */
  .svc { display: grid; grid-template-columns: minmax(0, 340px) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: start; }
  .svc-list { display: grid; gap: 10px; }
  .svc-list button {
    display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px 18px; border-radius: var(--r-lg); border: 1px solid var(--line); background: #fff; text-align: left; cursor: pointer;
    transition: border-color .2s var(--ease), background-color .2s var(--ease), box-shadow .2s var(--ease);
  }
  .svc-list button span:last-child { display: grid; gap: 2px; }
  .svc-list b { font-size: 17px; color: var(--ink); }
  .svc-list small { font-size: 14px; color: var(--ink-3); }
  .svc-list button:hover { border-color: var(--ink-3); }
  .svc-list button[aria-selected='true'] { border-color: var(--blue); background: #f3f7fd; box-shadow: inset 4px 0 0 var(--blue); }
  .svc-list button:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  .svc-ico { flex: none; display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; background: var(--mist); color: var(--blue); }
  .svc-panel { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(20px, 3vw, 40px); align-items: center; }
  .svc-copy .body { margin-top: 12px; }
  .svc-pts { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }
  .svc-pts li { display: flex; gap: 8px; align-items: flex-start; color: var(--ink-2); }
  .svc-pts li :global(svg) { flex: none; margin-top: 5px; color: var(--blue); }

  .mini { position: relative; aspect-ratio: 4 / 3; border-radius: 20px; background: var(--night); color: #e6eefc; overflow: hidden; display: grid; place-items: center; padding: 6%; font-size: clamp(12px, 1.1vw, 15px); }
  .mini .in { opacity: 1; }
  .run .mini .in { animation: m-in .45s var(--ease) calc(var(--at) * 1s) both; }
  @keyframes m-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  /* PI: today's flow, three steps struck out, then the shorter flow */
  .m-pi { width: 100%; display: grid; grid-template-columns: 1fr 2em 1fr; align-items: center; gap: .6em; }
  .m-col { list-style: none; margin: 0; padding: 0; display: grid; gap: .45em; }
  .m-col li { position: relative; padding: .5em .7em; border-radius: .6em; border: 1px solid #2a3a55; background: #121e31; text-align: center; }
  .m-col li.cut::after { content: ''; position: absolute; left: 6%; right: 6%; top: 50%; height: 2px; background: #ff6f61; transform-origin: left; transform: scaleX(1); }
  .run .m-col li.cut::after { animation: m-cut .5s var(--ease) calc((var(--at) + 1.2) * 1s) both; }
  @keyframes m-cut { from { transform: scaleX(0); } }
  .m-col li.cut span { color: #8fa3c2; }
  .m-col.new li { border-color: #63d6b4; color: #63d6b4; font-weight: 600; }
  .m-arrow { justify-self: center; width: .9em; height: .9em; border-top: 3px solid #63d6b4; border-right: 3px solid #63d6b4; transform: rotate(45deg); }
  /* development: a browser and a phone app */
  .m-dev { width: 100%; height: 100%; position: relative; }
  .m-browser { position: absolute; left: 0; top: 4%; width: 74%; height: 76%; border-radius: .8em; background: #121e31; border: 1px solid #2a3a55; overflow: hidden; }
  .m-bar { display: flex; gap: 5px; padding: .6em .8em; border-bottom: 1px solid #22304a; }
  .m-bar i { width: 7px; height: 7px; border-radius: 50%; background: #34425a; }
  .m-table { padding: .8em; display: grid; gap: .5em; }
  .m-table span { display: grid; grid-template-columns: 1fr 2fr 1fr; gap: .6em; padding: .35em; border-radius: .4em; }
  .m-table span.hl { background: rgba(99, 214, 180, .14); }
  .m-table b { display: block; height: .55em; border-radius: .3em; background: #2a3a55; }
  .m-phone { position: absolute; right: 2%; bottom: 0; width: 28%; aspect-ratio: 9 / 18; border-radius: 1.2em; background: #0b111c; border: 2px solid #2a3a55; overflow: hidden; }
  .m-screen { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: .5em; padding: 1em .7em; }
  .m-screen b { display: block; width: 100%; height: .6em; border-radius: .3em; background: #2a3a55; }
  .m-card { display: block; width: 90%; aspect-ratio: 16 / 10; border-radius: .5em; background: var(--blue); }
  .m-ok { display: grid; place-items: center; width: 2.4em; height: 2.4em; border-radius: 50%; background: rgba(99, 214, 180, .16); color: #63d6b4; }
  .m-screen small { font-size: .85em; color: #8fa3c2; }
  .m-screen.s2, .m-screen.s3 { opacity: 0; }
  .run .m-screen.s1 { animation: m-cycle 6s 1.2s infinite; }
  .run .m-screen.s2 { animation: m-cycle 6s 3.2s infinite; }
  .run .m-screen.s3 { animation: m-cycle 6s 5.2s infinite; }
  @keyframes m-cycle { 0%, 30% { opacity: 1; } 33%, 97% { opacity: 0; } 100% { opacity: 1; } }
  .m-stack { position: absolute; left: 0; bottom: 2%; color: #9fb8de; font-weight: 600; }
  /* operations: a live status and a growing log */
  .m-ops { width: 100%; display: grid; gap: 1em; }
  .m-live { display: inline-flex; align-items: center; gap: .5em; justify-self: start; padding: .35em .9em; border-radius: 999px; background: rgba(99, 214, 180, .14); color: #63d6b4; font-weight: 700; }
  .m-live i { width: .55em; height: .55em; border-radius: 50%; background: #63d6b4; animation: m-pulse 1.6s ease-in-out infinite; }
  @keyframes m-pulse { 50% { opacity: .3; } }
  .m-log { list-style: none; margin: 0; padding: 0; display: grid; gap: .55em; }
  .m-log li { display: flex; justify-content: space-between; gap: 1em; padding: .7em .9em; border-radius: .7em; background: #121e31; border: 1px solid #2a3a55; }
  .m-log em { font-style: normal; font-weight: 700; color: #63d6b4; white-space: nowrap; }
  /* custom tech: phone approval and an NFC tap */
  .m-tech { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 8%; align-items: center; }
  .m-phone2 { position: relative; justify-self: center; width: 62%; aspect-ratio: 9 / 18; border-radius: 1.2em; background: #0b111c; border: 2px solid #2a3a55; display: grid; place-items: center; }
  .m-finger { display: grid; place-items: center; width: 3em; height: 3em; border-radius: 50%; border: 2px solid #63d6b4; color: #63d6b4; }
  .run .m-finger { animation: m-pulse2 1s ease-in-out 3; }
  @keyframes m-pulse2 { 50% { transform: scale(1.1); } }
  .m-wait { position: absolute; bottom: 20%; color: #8fa3c2; }
  .m-done { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: .4em; background: #0b111c; color: #63d6b4; font-weight: 700; border-radius: 1.1em; }
  .run .m-done { animation: m-in .4s var(--ease) 3.2s both; }
  .m-pos { position: relative; display: grid; justify-items: center; gap: .6em; }
  .m-term { width: 60%; aspect-ratio: 3 / 4; border-radius: .8em; background: #121e31; border: 1px solid #2a3a55; display: grid; place-items: start center; padding-top: 18%; }
  .m-term i { width: 70%; height: 22%; border-radius: .4em; background: #22304a; }
  .m-cardx { position: absolute; top: 8%; right: 4%; width: 46%; aspect-ratio: 16 / 10; border-radius: .5em; background: var(--orange); transform: rotate(-12deg); }
  .run .m-cardx { animation: m-tapcard 2.4s var(--ease) .6s infinite; }
  @keyframes m-tapcard { 0%, 100% { transform: translate(30%, -20%) rotate(-12deg); } 40%, 60% { transform: translate(-18%, 30%) rotate(-12deg); } }
  .m-tap { position: absolute; top: 30%; left: 50%; }
  .m-tap i { position: absolute; left: -1.2em; top: -1.2em; width: 2.4em; height: 2.4em; border-radius: 50%; border: 2px solid #63d6b4; opacity: 0; }
  .run .m-tap i { animation: m-wave 2.4s ease-out 1.4s infinite; }
  .run .m-tap i:nth-child(2) { animation-delay: 1.6s; }
  .run .m-tap i:nth-child(3) { animation-delay: 1.8s; }
  @keyframes m-wave { 0% { opacity: .9; transform: scale(.4); } 30% { opacity: 0; transform: scale(1.6); } 100% { opacity: 0; } }
  .m-pos small { color: #8fa3c2; }

  /* 4. process: sticky picture, steps that light up as you scroll */
  .proc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(28px, 5vw, 72px); }
  .proc-visual { position: relative; }
  .pv-card { position: sticky; top: calc(var(--header-h) + 64px); height: 360px; border-radius: 24px; background: var(--night); color: #e6eefc; overflow: hidden; }
  .pv { position: absolute; inset: 0; padding: 36px; display: grid; align-content: start; gap: 8px; opacity: 0; transform: translateY(12px); transition: opacity .45s var(--ease), transform .45s var(--ease); }
  .pv.on { opacity: 1; transform: none; }
  .pv-n { font-size: 64px; font-weight: 800; line-height: 1; color: #2b4a7a; font-variant-numeric: tabular-nums; }
  .pv-t { font-size: 28px; font-weight: 700; }
  .pv-k { margin-top: 18px; font-size: 14px; color: #9fb8de; font-weight: 600; }
  .pv ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pv li { padding: 6px 12px; border-radius: 999px; background: rgba(99, 214, 180, .14); color: #63d6b4; font-size: 14px; font-weight: 600; }
  .pv-bar { position: absolute; left: 36px; right: 36px; bottom: 32px; height: 4px; border-radius: 2px; background: #22304a; overflow: hidden; }
  .pv-bar i { display: block; height: 100%; background: var(--orange); transform-origin: left; transform: scaleX(var(--prog)); transition: transform .3s linear; }
  .proc-steps { list-style: none; margin: 0; padding: 0; position: relative; }
  .proc-steps::before { content: ''; position: absolute; left: 19px; top: 8px; bottom: 8px; width: 2px; background: var(--line); }
  .proc-steps::after { content: ''; position: absolute; left: 19px; top: 8px; width: 2px; height: calc((100% - 16px) * var(--prog)); background: var(--blue); transition: height .3s linear; }
  .proc-steps li { position: relative; display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 20px; min-height: 42vh; padding-bottom: 32px; opacity: .45; transition: opacity .4s var(--ease); }
  .proc-steps li:last-child { min-height: 0; }
  .proc-steps li.on { opacity: 1; }
  .ps-n { position: relative; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #fff; border: 2px solid var(--line); font-weight: 700; color: var(--ink-3); transition: background-color .3s, border-color .3s, color .3s; }
  .proc-steps li.on .ps-n { background: var(--blue); border-color: var(--blue); color: #fff; }
  .proc-steps dl { margin: 14px 0 0; display: grid; gap: 12px; }
  .proc-steps dl div { padding: 14px 16px; border-radius: var(--r-md); background: #fff; }
  .proc-steps dt { font-size: 13px; font-weight: 700; color: var(--ink-3); }
  .proc-steps dd { margin: 2px 0 0; color: var(--ink); }
  .proc-steps .ps-left { background: rgba(54, 99, 153, .08); }
  .sub { margin: clamp(40px, 5vw, 64px) 0 14px; font-size: 15px; font-weight: 700; color: var(--ink-3); }
  .rules { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .rules li { padding: 22px 22px 24px; border-radius: var(--r-lg); background: #fff; }
  .rules b { font-size: 17px; }
  .rules .body { margin-top: 4px; }

  /* 5. code review card */
  .ai { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 560px); gap: clamp(32px, 6vw, 88px); align-items: center; }
  .ai .lead { margin-top: 18px; color: var(--on-night-2); }
  .ai-pts { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 12px; }
  .ai-pts li { display: flex; align-items: center; gap: 10px; color: var(--on-night); font-weight: 600; }
  .ai-pts li :global(svg) { flex: none; color: #9fb8de; }
  .review { border-radius: 16px; background: #0b1422; border: 1px solid var(--night-line); overflow: hidden; color: #c9d6ea; }
  .rv-head { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 12px 16px; border-bottom: 1px solid var(--night-line); background: #101b2c; }
  .rv-file { margin-right: auto; font-family: ui-monospace, Consolas, monospace; font-size: 14px; color: #e6eefc; }
  .rv-tag { font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: 999px; }
  .review .t-ai { background: rgba(127, 178, 255, .16); color: #9fc2ff; }
  .review .t-dev { background: rgba(246, 136, 42, .18); color: #f6b26b; }
  .rv-code { list-style: none; margin: 0; padding: 10px 0; font-family: ui-monospace, Consolas, monospace; font-size: clamp(12px, 1vw, 14px); }
  .rv-code li { display: grid; grid-template-columns: 40px minmax(0, 1fr) auto; align-items: center; padding: 3px 16px 3px 0; border-left: 3px solid transparent; }
  .rv-code i { font-style: normal; text-align: right; padding-right: 14px; color: #4d6080; }
  .rv-code code { white-space: pre; overflow: hidden; text-overflow: ellipsis; }
  .rv-code .l-cm code { color: #7f93b3; }
  .rv-code .l-ai { background: rgba(127, 178, 255, .07); border-left-color: #5d86c8; }
  .rv-code .l-del { background: rgba(255, 111, 97, .08); border-left-color: #c75b51; }
  .rv-code .l-del code { color: #c98b84; text-decoration: line-through; }
  .rv-code .l-dev { background: rgba(246, 136, 42, .1); border-left-color: var(--orange); }
  .rv-code .l-dev code { color: #f6d2b0; }
  /* the changed lines say who wrote them, so the colours need no legend */
  .rv-mark { margin-left: 8px; padding: 2px 8px; border-radius: 999px; font: 700 11px/1.4 'Pretendard Variable', Pretendard, system-ui, sans-serif; white-space: nowrap; }
  .rv-note { margin: 4px 16px 0; padding: 12px 14px; border-radius: 12px; background: #142238; display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; align-items: start; }
  .rv-who { font-size: 12px; font-weight: 700; padding: 3px 9px; border-radius: 999px; background: rgba(246, 136, 42, .18); color: #f6b26b; }
  .rv-note p { font-size: 14px; line-height: 1.6; color: #dfe7f5; }
  .rv-checks { list-style: none; margin: 0; padding: 14px 16px 16px; display: flex; flex-wrap: wrap; gap: 8px 16px; }
  .rv-checks li { display: flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: #63d6b4; }
  /* revealed once, line by line, when the card comes into view */
  :global(html.js) .review .rv-code li, :global(html.js) .review .rv-note, :global(html.js) .review .rv-checks li { opacity: 0; transform: translateY(4px); transition: opacity .4s var(--ease), transform .4s var(--ease); }
  :global(html.js) .review.is-in .rv-code li { opacity: 1; transform: none; transition-delay: calc(.2s + var(--k) * .22s); }
  :global(html.js) .review.is-in .rv-note { opacity: 1; transform: none; transition-delay: 1.7s; }
  :global(html.js) .review.is-in .rv-checks li { opacity: 1; transform: none; transition-delay: calc(2.2s + var(--k) * .25s); }

  /* 6. featured case */
  .case { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .case-photo { position: relative; margin: 0; border-radius: 20px; overflow: hidden; }
  .case-photo img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 1.2s var(--ease); }
  .case-photo:hover img { transform: scale(1.04); }
  .case-photo figcaption { position: absolute; left: 16px; bottom: 16px; padding: 8px 14px; border-radius: 999px; background: rgba(14, 26, 43, .82); color: #fff; font-size: 14px; font-weight: 600; }
  .case-sub { margin-top: 6px; color: var(--ink-3); font-weight: 600; }
  .case-dl { margin: 18px 0 0; display: grid; gap: 16px; }
  .case-dl div { display: grid; grid-template-columns: 56px minmax(0, 1fr); gap: 12px; }
  .case-dl dt { font-weight: 700; color: var(--blue); }
  .case-dl dd { margin: 0; color: var(--ink-2); }
  .phases { list-style: none; margin: clamp(32px, 4vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; position: relative; }
  .phases::before { content: ''; position: absolute; left: 0; right: 0; top: 9px; height: 2px; background: var(--line); }
  .phases::after { content: ''; position: absolute; left: 0; top: 9px; height: 2px; width: 37.5%; background: var(--blue); transform-origin: left; transform: scaleX(0); transition: transform 1.4s var(--ease) .3s; }
  .phases.is-in::after { transform: scaleX(1); }
  :global(html:not(.js)) .phases::after { transform: scaleX(1); }
  .phases li { position: relative; padding: 32px 16px 0 0; display: grid; gap: 4px; align-content: start; }
  .ph-dot { position: absolute; left: 0; top: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; border: 2px solid var(--line); }
  .done .ph-dot { background: var(--blue); border-color: var(--blue); }
  .now .ph-dot { background: var(--orange); border-color: var(--orange); }
  .now .ph-dot::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 2px solid var(--orange); animation: ph-ping 1.8s ease-out infinite; }
  @keyframes ph-ping { from { opacity: .8; transform: scale(.6); } to { opacity: 0; transform: scale(1.6); } }
  .ph-when { font-size: 14px; color: var(--ink-3); }
  .phases b { font-size: 17px; }
  .ph-d { font-size: 15px; color: var(--ink-2); }
  .ph-s { justify-self: start; margin-top: 6px; font-style: normal; font-size: 13px; font-weight: 700; padding: 3px 10px; border-radius: 999px; background: var(--mist); color: var(--ink-3); }
  .done .ph-s { background: rgba(54, 99, 153, .12); color: var(--blue); }
  .now .ph-s { background: var(--orange-soft); color: var(--orange-ink); }

  /* 7. development work */
  .cases { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .cases li { border-radius: var(--r-xl); background: #fff; overflow: hidden; display: grid; grid-template-rows: auto 1fr; transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
  .cases li:hover { transform: translateY(-4px); box-shadow: 0 18px 36px rgba(16, 24, 40, .1); }
  .c-img { overflow: hidden; }
  .c-img img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform .8s var(--ease); }
  .cases li:hover .c-img img { transform: scale(1.06); }
  .c-body { padding: 22px 24px 26px; display: grid; gap: 8px; align-content: start; }
  .c-k { font-size: 14px; font-weight: 700; color: var(--blue); }
  .c-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
  .c-tags span { font-size: 13px; padding: 3px 10px; border-radius: 999px; background: var(--mist); color: var(--ink-2); }

  /* 8. questions */
  .faq-wrap { max-width: 880px; }
  .faq { display: grid; gap: 10px; }
  .faq details { border-radius: var(--r-lg); border: 1px solid var(--line); background: #fff; }
  .faq summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 22px; font-size: 17px; font-weight: 600; cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(.faq-i) { flex: none; color: var(--ink-3); transition: rotate .25s var(--ease); }
  .faq details[open] summary :global(.faq-i) { rotate: 45deg; color: var(--blue); }
  .faq summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: var(--r-lg); }
  .faq details .body { padding: 0 22px 22px; }

  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .pains { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .svc { grid-template-columns: minmax(0, 1fr); }
    .svc-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .proc { grid-template-columns: minmax(0, 1fr); }
    .proc-visual { display: none; }
    .proc-steps li { min-height: 0; }
    .rules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ai { grid-template-columns: minmax(0, 1fr); }
    .case { grid-template-columns: minmax(0, 1fr); }
    .cases { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .flow { grid-template-columns: minmax(0, 1fr); }
    .flow button { grid-template-columns: 32px minmax(0, 1fr); justify-items: start; text-align: left; padding: 12px 16px; }
    .flow li + li { border-left: 0; border-top: 1px solid var(--night-line); }
    .cap { position: static; max-width: none; margin-top: 12px; }
    .pains { grid-template-columns: minmax(0, 1fr); }
    .pain { height: 170px; }
    .compare { aspect-ratio: 4 / 5; }
    .sheet { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .sheet > :nth-child(5n + 4), .sheet > :nth-child(5n) { display: none; }
    .note { right: 12%; top: 54%; }
    .m1 { left: 4%; bottom: 26%; } .m2 { left: 8%; bottom: 12%; }
    .dash { grid-template-columns: 1fr; }
    .dash aside { display: none; }
    .svc-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .svc-list button { padding: 12px; gap: 10px; }
    .svc-list small { display: none; }
    .svc-list b { font-size: 15px; }
    .svc-ico { width: 36px; height: 36px; }
    .svc-panel { grid-template-columns: minmax(0, 1fr); }
    .rules, .cases { grid-template-columns: minmax(0, 1fr); }
    .phases { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .phases::before { left: 7px; right: auto; top: 0; bottom: 0; width: 2px; height: auto; }
    .phases::after { display: none; }
    .phases li { padding: 0 0 0 32px; }
    .rv-code code { white-space: pre-wrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .photo img { transition: none; }
    .m-live i, .now .ph-dot::after { animation: none !important; }
    :global(html.js) .review .rv-code li, :global(html.js) .review .rv-note, :global(html.js) .review .rv-checks li { opacity: 1; transform: none; transition: none; }
    .run .mini *, .run .mini *::after { animation: none !important; }
    .face { transition: none; }
    .m-screen.s1 { opacity: 1; } .m-screen.s2, .m-screen.s3 { opacity: 0; }
  }
</style>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // hero: the five steps take turns. The current step's bar fills over --dur; when it ends, the next step comes up
  // with its own photo and list. A click picks a step; the pointer resting on it, or scrolling away, pauses it.
  const hero = document.querySelector<HTMLElement>('section.hero');
  if (hero) {
    const lis = [...hero.querySelectorAll<HTMLLIElement>('.flow li')];
    const imgs = [...hero.querySelectorAll<HTMLImageElement>('.photo img')];
    const caps = [...hero.querySelectorAll<HTMLElement>('.cap')];
    let cur = 0;
    const show = (n: number) => {
      cur = n;
      lis.forEach((li, i) => { li.classList.remove('on'); li.classList.toggle('done', i < n); li.querySelector('button')!.setAttribute('aria-pressed', String(i === n)); });
      imgs.forEach((im) => im.classList.remove('on'));
      caps.forEach((c, i) => { c.classList.remove('on'); c.hidden = i !== n; });
      void hero.offsetWidth; // so a step shown again restarts its bar and zoom
      lis[n].classList.add('on'); imgs[n].classList.add('on'); caps[n].classList.add('on');
    };
    lis.forEach((li, i) => li.querySelector('button')!.addEventListener('click', () => show(i)));
    if (!still) {
      hero.classList.add('auto');
      hero.querySelector('.flow')!.addEventListener('animationend', (e) => { if ((e.target as HTMLElement).classList.contains('bar')) show((cur + 1) % lis.length); });
      let hover = false, seen = true;
      const sync = () => hero.classList.toggle('paused', hover || !seen);
      hero.querySelectorAll('.show, .flow').forEach((el) => {
        el.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { hover = true; sync(); } });
        el.addEventListener('pointerleave', () => { hover = false; sync(); });
      });
      new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }).observe(hero);
    }
  }

  // worry cards: a tap flips one (hover flips on desktop too)
  document.querySelectorAll<HTMLButtonElement>('.pain').forEach((b) => b.addEventListener('click', () => b.setAttribute('aria-pressed', String(b.getAttribute('aria-pressed') !== 'true'))));

  // before / after: the range input drives the split; once on screen, a short nudge shows it can be dragged
  const cmp = document.querySelector<HTMLElement>('.compare');
  const range = cmp?.querySelector<HTMLInputElement>('.cmp-range');
  if (cmp && range) {
    let touched = false;
    const set = (v: number) => cmp.style.setProperty('--pos', `${v}%`);
    range.addEventListener('input', () => { touched = true; set(+range.value); });
    if (!still) new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      const t0 = performance.now(), keys = [50, 34, 66, 50];
      const step = (now: number) => {
        if (touched) return;
        const k = Math.min(1, (now - t0) / 2200), seg = Math.min(2, Math.floor(k * 3)), f = k * 3 - seg;
        const v = keys[seg] + (keys[seg + 1] - keys[seg]) * (0.5 - Math.cos(Math.PI * f) / 2);
        set(v); range.value = String(Math.round(v));
        if (k < 1) requestAnimationFrame(step);
      };
      setTimeout(() => requestAnimationFrame(step), 400);
    }, { threshold: 0.6 }).observe(cmp);
  }

  // services: tabs; showing a panel restarts its little screen
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.svc-list [role="tab"]')];
  const panels = [...document.querySelectorAll<HTMLElement>('.svc-panel')];
  const pick = (n: number) => {
    tabs.forEach((t, i) => { t.setAttribute('aria-selected', String(i === n)); t.tabIndex = i === n ? 0 : -1; });
    panels.forEach((p, i) => { p.hidden = i !== n; p.classList.remove('run'); });
    if (!still) { void panels[n].offsetWidth; panels[n].classList.add('run'); }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => pick(i));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      e.preventDefault();
      const n = (i + d + tabs.length) % tabs.length;
      tabs[n].focus(); pick(n);
    });
  });
  if (still) panels.forEach((p) => p.classList.remove('run'));
  // the first panel's screen plays when it comes into view, not on load
  else if (panels[0]) { panels[0].classList.remove('run'); new IntersectionObserver(([e], io) => { if (e.isIntersecting) { io.disconnect(); if (!panels[0].hidden) panels[0].classList.add('run'); } }, { threshold: 0.4 }).observe(panels[0]); }

  // process: the step nearest the middle of the screen is "on"; progress follows the scroll through the list
  const proc = document.querySelector<HTMLElement>('.proc');
  if (proc) {
    const items = [...proc.querySelectorAll<HTMLElement>('.proc-steps li')];
    const views = [...proc.querySelectorAll<HTMLElement>('.pv')];
    const list = proc.querySelector<HTMLElement>('.proc-steps')!;
    let ticking = false;
    const update = () => {
      ticking = false;
      const mid = innerHeight * 0.5, r = list.getBoundingClientRect();
      const prog = Math.min(1, Math.max(0, (mid - r.top) / Math.max(1, r.height - 40)));
      proc.style.setProperty('--prog', prog.toFixed(3));
      let cur = 0;
      items.forEach((li, i) => { if (li.getBoundingClientRect().top < mid) cur = i; });
      items.forEach((li, i) => li.classList.toggle('on', i <= cur));
      views.forEach((v, i) => v.classList.toggle('on', i === cur));
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>

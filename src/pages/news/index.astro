---
// 소식 > 사내소식: our own news and articles about us. Layout follows pribit.com/news: centred title, one featured story as a wide card, then a four-column
// grid of image cards with the source and title laid over the picture. Items without a picture get a brand-blue panel.
import Base from '../../layouts/Base.astro';
import PageTitle from '../../components/PageTitle.astro';
import Icon from '../../components/Icon.astro';
import ResourceTabs from '../../components/ResourceTabs.astro';
import NewsCard from '../../components/NewsCard.astro';
import { sorted, kindLabel, fmt } from '../../data/news';
import { newsNav } from '../../data/site';

// company news and articles about us, newest first (security incidents live on 언론보도)
const [featured, ...rest] = sorted;
const href = (n: (typeof sorted)[number]) => n.url ?? `/news/${n.slug}`;
const ext = (n: (typeof sorted)[number]) => (n.url ? { target: '_blank', rel: 'noopener' } : {});
---
<Base title="사내소식" description="신영이노베이션의 사내소식." tone="light">
  <PageTitle title="소식">신영이노베이션의 소식과 언론 보도,<br />함께 볼 만한 보안 이슈를 놓치지 마세요.<ResourceTabs slot="after" items={newsNav} label="소식 메뉴" /></PageTitle>

  <section class="news">
    <div class="wrap">
      {featured && (
        <a class="feat" href={href(featured)} {...ext(featured)}>
          <div class={`media ${featured.image ? '' : 'plain'}`}>
            {featured.image ? <img src={featured.image} alt="" style={featured.imagePos && `object-position: ${featured.imagePos}`} /> : <img class="mark" src="/images/brand/symbol-sy-white.svg" alt="" />}
          </div>
          <div class="feat-copy">
            <span class="src">{kindLabel[featured.kind]} · {featured.source}</span>
            <h2 class="feat-title">{featured.title}</h2>
            <span class="date">{fmt(featured.date)}{featured.url && <Icon name="external" size={15} label="새 창에서 원문 열기" />}</span>
          </div>
        </a>
      )}

      {rest.length > 0 && <ul class="grid">{rest.map((n) => <li><NewsCard item={n} /></li>)}</ul>}
    </div>
  </section>
</Base>

<style>
  .news { padding-bottom: var(--section-y); }
  .media { position: relative; overflow: hidden; background: #dfe7f4; }
  .media img { width: 100%; height: 100%; object-fit: cover; transition: transform .6s var(--ease); }
  /* no photo: a brand cover, the symbol large and cropped by the edge (the way pribit falls back to its big logo) */
  .media.plain { background: radial-gradient(120% 90% at 85% 10%, #5b86d6 0%, #2f5ca8 45%, #1d3a6e 100%); }
  .media.plain .mark { position: absolute; width: 96%; height: auto; right: -22%; top: -12%; object-fit: contain; opacity: .18; }
  .feat .media.plain .mark { width: 70%; right: -10%; top: -18%; }

  .feat { display: grid; grid-template-columns: 1.25fr 1fr; min-height: clamp(320px, 30vw, 480px); border-radius: 30px; overflow: hidden; background: var(--mist); }
  .feat .media { height: 100%; }
  .feat-copy { display: grid; align-content: center; gap: 16px; padding: clamp(28px, 4vw, 64px); }
  .src { font-size: 14px; font-weight: 600; color: var(--blue); }
  .feat-title { font-size: clamp(22px, 1.4vw + 10px, 32px); font-weight: 700; line-height: 1.4; letter-spacing: -0.02em; }
  .date { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; color: var(--ink-3); }
  .feat:hover img { transform: scale(1.04); }
  .feat:hover .feat-title { color: var(--blue); }

  .grid { list-style: none; margin: clamp(32px, 3vw, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  @media (max-width: 1023px) { .grid { grid-template-columns: repeat(2, 1fr); } .feat { grid-template-columns: 1fr; } .feat .media { aspect-ratio: 16 / 9; } }
  @media (max-width: 559px) { .grid { grid-template-columns: 1fr; } .feat { border-radius: 24px; } }
</style>

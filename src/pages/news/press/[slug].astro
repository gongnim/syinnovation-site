---
// 소식 > 언론보도 > one hand-picked incident, written by us: what happened (in our own words), what any organisation
// can check to reduce such incidents, and where it was reported, with a link to the original article. No article
// text or photos are copied; the picture was made for this page.
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { security, fmt, type Incident } from '../../../data/news';
import { lessonFor } from '../../../data/security-lessons';

export function getStaticPaths() {
  const pages = security.filter((n) => n.slug);
  return pages.map((n, i) => ({ params: { slug: n.slug }, props: { item: n, newer: pages[i - 1], older: pages[i + 1] } }));
}
interface Props { item: Incident; newer?: Incident; older?: Incident }
const { item: n, newer, older } = Astro.props;
const lesson = lessonFor(n.type);
---
<Base title={n.title} description={n.summary ?? n.title} tone="light">
  <article class="inc">
    <div class="wrap narrow">
      <nav class="crumb" aria-label="위치"><a href="/news">소식</a><span aria-hidden="true">/</span><a href="/news/press">언론보도</a></nav>
      <div class="tags"><span class:list={['tag', n.region === '해외' ? 'abroad' : 'home']}>{n.region}</span><span class="tag">{n.type}</span></div>
      <h1>{n.title}</h1>
      <p class="meta">{n.source} 보도<span class="dot" aria-hidden="true"></span>{fmt(n.date)}</p>
      {n.image && <img class="hero" src={n.image} alt="" width="1536" height="1024" />}

      <section>
        <h2>무슨 일이 있었나</h2>
        <p>{n.summary}</p>
      </section>

      <section>
        <h2>이런 사고를 줄이려면</h2>
        <p>{lesson.intro}</p>
        <ul class="checks">{lesson.checks.map((c) => <li><Icon name="check" size={18} />{c}</li>)}</ul>
      </section>

      <aside class="source">
        <p>이 글은 {n.source}의 보도({fmt(n.date)})를 바탕으로 신영이노베이션이 정리했습니다. 이미지는 이해를 돕기 위해 만든 것으로, 실제 현장 사진이 아닙니다.</p>
        <a href={n.url} target="_blank" rel="noopener">원문 기사 보기 <Icon name="external" size={15} /></a>
      </aside>

      <nav class="pn" aria-label="다른 보안 소식">
        {older ? <a href={`/news/press/${older.slug}`}><span>이전 소식</span>{older.title}</a> : <span />}
        <a class="list" href="/news/press">목록</a>
        {newer ? <a class="r" href={`/news/press/${newer.slug}`}><span>다음 소식</span>{newer.title}</a> : <span />}
      </nav>
    </div>
  </article>

  <CtaBand title="우리 회사의 업무 접속은 안전할까요?" lead="무료 PoC로 우리 환경에서 먼저 확인해 보세요." />
</Base>

<style>
  .inc { padding: calc(var(--header-h) + clamp(88px, 8vw, 120px)) 0 var(--section-y); }
  .inc .wrap { max-width: calc(800px + var(--gutter) * 2); }
  .crumb { display: flex; gap: 8px; font-size: 14px; color: var(--ink-3); }
  .crumb a:hover { color: var(--blue); }
  .tags { display: flex; gap: 6px; margin-top: 22px; }
  .tag { padding: 4px 10px; border-radius: 999px; background: var(--mist); font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .tag.home { background: #e8eff8; color: var(--blue); }
  .tag.abroad { background: var(--orange-soft); color: var(--orange-ink); }
  h1 { margin-top: 14px; font-size: clamp(28px, 1.8vw + 18px, 40px); font-weight: 700; line-height: 1.3; letter-spacing: -0.03em; color: var(--ink); }
  .meta { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 15px; color: var(--ink-3); }
  .dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-3); }
  .hero { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; margin-top: 32px; border-radius: 20px; }
  section { margin-top: 44px; }
  h2 { margin-bottom: 12px; font-size: 21px; font-weight: 700; letter-spacing: -0.02em; color: var(--ink); }
  section p { font-size: 17px; line-height: 1.8; color: var(--ink-2); }
  .checks { list-style: none; margin: 18px 0 0; padding: 0; display: grid; gap: 10px; }
  .checks li { display: flex; align-items: flex-start; gap: 10px; padding: 14px 16px; border-radius: 12px; background: var(--paper-2); font-size: 16px; line-height: 1.6; color: var(--ink); }
  .checks :global(svg) { flex: none; margin-top: 3px; color: var(--blue); }
  .source { margin-top: 44px; padding: 20px 22px; border-radius: 14px; border: 1px solid var(--line); }
  .source p { font-size: 14px; line-height: 1.7; color: var(--ink-3); }
  .source a { display: inline-flex; align-items: center; gap: 6px; margin-top: 10px; font-size: 15px; font-weight: 700; color: var(--blue); }
  .pn { margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: center; }
  .pn a { display: grid; gap: 2px; font-size: 15px; font-weight: 600; color: var(--ink); }
  .pn a span { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .pn .r { text-align: right; }
  .pn .list { padding: 8px 20px; border: 1px solid var(--line); border-radius: 999px; }
  @media (max-width: 559px) {
    .pn { grid-template-columns: 1fr; text-align: center; }
    .pn .r { text-align: center; }
    .pn .list { justify-self: center; }
  }
</style>

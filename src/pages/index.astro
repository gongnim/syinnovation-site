---
import Base from '../layouts/Base.astro';
import ShieldSphere from '../components/ShieldSphere.astro';
import CtaBand from '../components/CtaBand.astro';
import { sorted, kindLabel, fmt } from '../data/news';
import { appName, parts } from '../data/site';
import '@fontsource-variable/inter-tight/wght.css';

const latest = sorted.slice(0, 3);

const useCases = [
  { t: '재택 · 출장 접속', d: '집이나 출장지에서도 사무실과 같은 기준으로 확인한 뒤 업무 시스템을 엽니다.' },
  { t: '협력사 · 외주 인력 접속', d: '필요한 사람에게 필요한 앱만 열어 주고, 일이 끝나면 접속을 닫습니다.' },
  { t: '공용 PC 접속', d: '한 대의 회사 PC를 여러 사람이 써도, 지금 쓰는 사람을 휴대폰으로 확인하고 각자 권한에 맞는 업무 앱만 엽니다.' },
  { t: '전사 통합 로그인', d: '한 번 확인한 사람과 기기를 여러 업무 앱이 함께 믿고 씁니다.' },
  { t: '결제 이상거래 평가', d: '결제 요청의 기기와 위치 신호를 평가해 결제사에 위험도를 권고합니다. 최종 결정은 결제사가 합니다.' },
];

const easy = [
  { t: 'VPN 없이', d: '사내망 전체를 여는 VPN 대신, 허락된 앱으로 가는 길만 엽니다.' },
  { t: '휴대폰 생체 한 번', d: '비밀번호를 외우는 대신 내 휴대폰에서 지문이나 얼굴로 확인합니다.' },
  { t: '기본은 차단', d: '정책에 적힌 앱과 사람만 통과합니다. 적지 않은 것은 열리지 않습니다.' },
  { t: '관찰 모드로 먼저', d: '바로 막지 않고 결과를 지켜본 뒤, 확인한 정책부터 실제로 적용합니다.' },
  { t: '위험한 기기 차단', d: '탈옥이나 루팅된 폰, 에뮬레이터, 디버거가 붙은 앱은 막고, 정품 앱인지는 Apple과 Google의 증명으로 확인합니다.' },
  { t: '판단 근거까지 기록', d: '누가 언제 무엇에 접속했고 왜 허용하거나 막았는지, 고칠 수 없는 기록으로 남깁니다.' },
];
---
<Base title="신영이노베이션" description="휴대폰과 PC의 신호를 함께 확인하고, 로그인 이후에도 계속 검증하는 제로트러스트 보안 Trust Gateway.">

  <!-- 1. hero -->
  <section class="hero">
    <div class="hero-pin">
      <ShieldSphere />
      <div class="wrap hero-copy" data-hero-layer="a">
        <h1 class="hero-title">Never Trust,<br />Always Verify</h1>
        <p class="hero-lead">제로트러스트 기반의 Trust Gateway는 PC·태블릿과 휴대폰을 함께 확인하고, <br />접속한 뒤에도 요청마다 다시 검증하는 보안 플랫폼입니다.</p>
      </div>
      <div class="wrap hero-focus" data-hero-layer="b">
        <h2 class="hero-focus-title">AI로 공격이 정교해져도, <br />기본을 지키면 막을 수 있습니다</h2>
      </div>
    </div>
  </section>

  <!-- 2. three uses -->
  <section class="section">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">Trust Gateway,<br />세 가지 자리에서 확인합니다</h2>
        <p class="lead">금융사 앱의 인증, 직원의 업무 접속, 고객의 결제까지. 하나의 판단 엔진이 각 자리에 맞게 들어갑니다.</p>
      </div>
      <ul class="uses">
        {parts.map((p) => (
          <li class="reveal">
            <a class="use-card" href="/trust-gateway#uses">
              <p class="use-k">{p.k}<span>{p.who}</span></p>
              <h3 class="h4">{p.h}</h3>
              <p class="body">{p.short}</p>
              <ul class="use-pts">{p.pts.map((x) => <li>{x}</li>)}</ul>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. three proofs -->
  <section class="section mist">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">로그인 한 번이 아니라,<br />요청마다 확인합니다</h2>
        <p class="lead">Trust Gateway는 두 기기와 게이트웨이가 각자 다른 것을 증명하게 나눕니다. 하나가 뚫려도 나머지가 막습니다.</p>
      </div>
      <div class="proofs">
        <article class="card proof reveal">
          <div class="media pc">
            <div class="cert">
              <p class="cert-title">기기 인증서</p>
              <dl>
                <div><dt>보관</dt><dd>PC 하드웨어 보안 영역</dd></div>
                <div><dt>내보내기</dt><dd>불가</dd></div>
                <div><dt>수명</dt><dd>12시간, 다시 받을 땐 휴대폰 승인</dd></div>
              </dl>
              <p class="cert-ok"><i></i>이 PC는 등록된 업무 기기입니다</p>
            </div>
          </div>
          <h3 class="h4">PC는 기기를 증명합니다</h3>
          <p class="body">개인키가 PC의 보안 영역 밖으로 나오지 않아, 인증서를 복사해 다른 PC에서 쓸 수 없습니다.</p>
        </article>
        <article class="card proof reveal">
          <div class="media phone-wrap">
            <div class="phone">
              <div class="fp" aria-hidden="true"></div>
              <p class="ph-title">업무 PC 접속을<br />승인할까요?</p>
              <p class="ph-sub">{appName} · Face ID 또는 지문</p>
              <div class="ph-btns"><span>거절</span><span class="go">승인</span></div>
            </div>
          </div>
          <h3 class="h4">휴대폰은 사람을 증명합니다</h3>
          <p class="body">업무를 시작할 때 PC의 QR을 휴대폰으로 찍고 생체 인증을 하면, 지금 이 PC를 쓰는 사람이 정해집니다. 공용 PC도 사람 단위로 구분됩니다.</p>
        </article>
        <article class="card proof wide reveal">
          <div class="media log">
            <ul>
              <li><span class="who">재무팀 ERP</span><span class="why">등록 기기 · 평소 위치</span><b class="ok">허용</b></li>
              <li><span class="who">사내 인트라넷</span><span class="why">새로운 네트워크에서 접속</span><b class="step">휴대폰 추가 인증</b></li>
              <li><span class="who">개발 서버</span><span class="why">등록되지 않은 기기</span><b class="no">차단</b></li>
            </ul>
          </div>
          <div class="wide-copy">
            <h3 class="h4">게이트웨이는 매 요청을 확인합니다</h3>
            <p class="body">접속한 뒤에도 요청마다 정책과 위험을 다시 봅니다. 결과는 허용, 휴대폰 추가 인증, 차단 셋 중 하나입니다.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 4. features -->
  <section class="section">
    <div class="wrap narrow">
      <div class="head-center reveal">
        <h2 class="h2">하나를 속여도,<br />나머지가 알아챕니다</h2>
        <p class="lead">위치, 네트워크, 시간, 기기. 신호 하나는 속일 수 있어도 여러 신호를 동시에 계속 맞추기는 어렵습니다.</p>
      </div>

      <div class="feature reveal">
        <div class="f-copy">
          <span class="tag">다중 신호 교차 검증</span>
          <h3 class="h3">PC와 휴대폰이<br />서로의 위치를 확인합니다</h3>
          <p class="body">PC와 휴대폰의 위치, Wi-Fi, 시간대, 기기 상태와 네트워크 정보를 함께 대조합니다. VPN이나 위치 위조로 신호 하나를 꾸며도 나머지와 맞지 않으면 드러납니다.</p>
        </div>
        <div class="f-media">
          <table class="match">
            <caption class="sr-only">PC와 휴대폰 신호 대조 예시</caption>
            <thead><tr><th scope="col">신호</th><th scope="col">PC</th><th scope="col">휴대폰</th><th scope="col">결과</th></tr></thead>
            <tbody>
              <tr><th scope="row">위치</th><td>서울 마포</td><td>서울 마포</td><td class="y">일치</td></tr>
              <tr><th scope="row">네트워크</th><td>사무실 Wi-Fi</td><td>사무실 Wi-Fi</td><td class="y">일치</td></tr>
              <tr><th scope="row">시간대</th><td>KST</td><td>KST</td><td class="y">일치</td></tr>
              <tr class="bad"><th scope="row">경유</th><td>해외 VPN</td><td>국내 통신사</td><td class="n">불일치</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="feature flip reveal">
        <div class="f-copy">
          <span class="tag">지속 검증</span>
          <h3 class="h3">접속한 다음에도<br />계속 지켜봅니다</h3>
          <p class="body">세션이 이어지는 동안 네트워크와 위치 변화를 살핍니다. 위험이 올라가면 휴대폰으로 무엇이 바뀌었는지 알리고, 승인하기 전까지는 요청을 들여보내지 않습니다.</p>
        </div>
        <div class="f-media">
          <div class="timeline" role="img" aria-label="세션 중 위치가 바뀌자 휴대폰 추가 인증을 요청하는 흐름">
            <div class="tl-bar"><i style="left:6%"></i><i style="left:30%"></i><i style="left:54%"></i><i class="hot" style="left:74%"></i></div>
            <div class="tl-labels"><span>로그인</span><span>요청 확인</span><span>요청 확인</span><span class="hot">네트워크 변경 감지</span></div>
            <div class="tl-alert"><b>휴대폰으로 추가 인증 요청</b><span>Face ID로 승인하면 계속, 승인 전까지는 접속 보류</span></div>
          </div>
        </div>
      </div>

      <div class="feature reveal">
        <div class="f-copy">
          <span class="tag">숨은 사내망</span>
          <h3 class="h3">밖에서 보이지 않으면,<br />뚫을 수도 없습니다</h3>
          <p class="body">사내망에는 들어오는 포트를 열지 않습니다. 내부 에이전트가 게이트웨이로 먼저 연결을 걸어, 확인된 요청만 안으로 전달합니다.</p>
        </div>
        <div class="f-media">
          <div class="zones" role="img" aria-label="사용자, Trust Gateway, 고객 사내망 세 구역. 사내망 쪽에서만 바깥으로 연결합니다">
            <div class="zone"><b>사용자</b><span>PC + 휴대폰</span></div>
            <div class="arrow r" aria-hidden="true"></div>
            <div class="zone mid"><b>Trust Gateway</b><span>확인과 정책</span></div>
            <div class="arrow l" aria-hidden="true"></div>
            <div class="zone in"><b>고객 사내망</b><span>들어오는 포트 0</span></div>
          </div>
        </div>
      </div>

      <div class="feature flip reveal">
        <div class="f-copy">
          <span class="tag">기본 차단 정책</span>
          <h3 class="h3">적어 둔 것만 열리고,<br />나머지는 닫혀 있습니다</h3>
          <p class="body">정책은 기본이 차단입니다. 어떤 사람이 어떤 기기로 어떤 앱에 들어갈 수 있는지 적어 둔 것만 통과하고, 정책 변경 이력도 남습니다.</p>
        </div>
        <div class="f-media">
          <div class="policy" role="img" aria-label="기본은 차단, 재무팀은 등록된 기기에서 ERP만 허용하는 정책 예시">
            <p><span class="k">기본</span><span class="v no">차단</span></p>
            <p><span class="k">재무팀</span><span class="v">등록 기기 + 휴대폰 확인 → ERP 허용</span></p>
            <p><span class="k">협력사</span><span class="v">등록 기기 → 유지보수 서버만 허용</span></p>
            <p><span class="k">그 밖의 요청</span><span class="v no">차단</span></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. use cases -->
  <section class="section mist">
    <div class="wrap uc">
      <div class="uc-head reveal">
        <h2 class="h2 sm">어디서 일하든,<br />같은 기준으로</h2>
        <p class="lead">사람, 기기, 장소가 달라져도 확인하는 방법은 하나입니다.</p>
        <a class="text-link" href="/trust-gateway#use-cases">활용 사례 자세히 보기</a>
      </div>
      <ul class="uc-list">
        {useCases.map((u) => (
          <li class="uc-card reveal">
            <h3 class="h4">{u.t}</h3>
            <p class="body">{u.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. easy security -->
  <section class="section">
    <div class="wrap">
      <div class="head-left reveal">
        <h2 class="h2 sm">VPN 없이, 휴대폰 확인 한 번으로</h2>
        <p class="lead">쓰는 사람은 더 간단하게, 관리하는 사람은 더 분명하게.</p>
      </div>
      <ul class="easy">
        {easy.map((e) => (
          <li class="easy-card reveal">
            <h3 class="h4">{e.t}</h3>
            <p class="body">{e.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7. IT consulting and development band -->
  <section class="ai-band">
    <div class="wrap ai-row reveal">
      <div>
        <h2 class="h4">IT 컨설팅·개발</h2>
        <p class="body">업무 분석부터 맞춤 개발과 운영까지, 회사에 맞춘 IT 컨설팅과 개발도 함께 합니다.</p>
      </div>
      <a class="btn ghost" href="/consulting">IT 컨설팅·개발 보기</a>
    </div>
  </section>

  <!-- 8. latest news -->
  <section class="section paper2">
    <div class="wrap">
      <div class="news-head reveal">
        <h2 class="h2 sm">소식</h2>
        <a class="text-link" href="/news">전체 소식 보기</a>
      </div>
      <ul class="news-grid">
        {latest.map((n) => (
          <li class="reveal">
            <a class="news-card" href={n.url ?? `/news/${n.slug}`} target={n.url ? '_blank' : undefined} rel={n.url ? 'noopener' : undefined}>
              <span class={`kind ${n.kind}`}>{kindLabel[n.kind]}{n.kind !== 'own' && ` · ${n.source}`}</span>
              <h3 class="h4">{n.title}</h3>
              <span class="small">{fmt(n.date)}{n.url && <span class="ext"> · 원문 보기<span class="sr-only"> (새 창)</span></span>}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 9. CTA -->
  <CtaBand title="우리 회사 환경에서 먼저 확인해 보세요" lead="평가용 환경과 서비스 하나로 시작합니다. 접속 흐름과 정책을 직접 보고 결정하세요." secondary={{ href: '/trust-gateway', label: 'Trust Gateway 보기' }} />
</Base>

<style>
  /* hero */
  /* the section is tall; .hero-pin sticks while orb-hero.ts maps scroll progress to --hero-* */
  .hero { position: relative; height: 420vh; background: #fff; }
  .hero-pin {
    position: sticky; top: 0; height: 100vh; height: 100svh; min-height: 620px; overflow: hidden; color: var(--on-night);
    background: color-mix(in srgb, #050a14, #eef2f8 calc(var(--hero-day, 0) * 100%));
  }
  .hero-pin::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 22%; pointer-events: none;
    background: linear-gradient(to bottom, rgba(255,255,255,0), #fff); opacity: var(--hero-end, 0);
  }
  /* copy layers ([data-hero-layer]) get opacity/transform/visibility inline from orb-hero.ts */
  .hero-copy { position: relative; z-index: 1; text-align: center; pointer-events: none; padding-top: calc(var(--header-h) + clamp(88px, 11vh, 132px)); }
  .hero-focus { position: absolute; z-index: 1; left: 0; right: 0; top: 65%; text-align: center; color: var(--ink); }
  html.js .hero-focus { opacity: 0; visibility: hidden; }
  .hero-focus-title { font-size: clamp(26px, 3.6vw, 52px); line-height: 1.22; letter-spacing: -0.03em; font-weight: 700; word-break: keep-all; overflow-wrap: normal; text-wrap: balance; }
  .hero-focus-lead { word-break: keep-all; overflow-wrap: normal; text-wrap: balance; margin: 18px auto 0; max-width: 640px; color: var(--ink-2); font-size: clamp(16px, 1.3vw, 19px); line-height: 1.7; font-weight: 500; }
  html:not(.js) .hero { height: auto; }
  html:not(.js) .hero-focus { display: none; }
  /* type sizes follow PacketGo's main visual: Inter Tight 400 for the English headline, Pretendard 500 for the lead */
  .hero-title {
    font-family: 'Inter Tight Variable', 'Pretendard Variable', Pretendard, sans-serif; font-weight: 400; color: #fff;
    font-size: clamp(44px, 5.44vw + 23.6px, 128px); line-height: 1; letter-spacing: -0.02em;
  }
  .hero-lead {
    margin: clamp(24px, 1.04vw + 20px, 40px) auto 0; max-width: 960px; color: rgba(243,246,251,.9);
    font-size: clamp(15px, 0.58vw + 12.8px, 24px); line-height: 1.6; font-weight: 500;
  }
  /* the copy rises in once on load, like PacketGo's */
  html.js .hero-title, html.js .hero-lead { animation: hero-rise 1200ms cubic-bezier(0.22, 0.65, 0.3, 1) 160ms both; }
  html.js .hero-lead { animation-delay: 300ms; }
  @keyframes hero-rise { from { opacity: 0; transform: translate3d(0, clamp(24px, 1.55vw + 18px, 48px), 0); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { html.js .hero-title, html.js .hero-lead { animation: none; } }

  /* three uses */
  .uses { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .use-card { height: 100%; display: grid; gap: 12px; align-content: start; border: 1px solid var(--line); border-radius: var(--r-xl); padding: 30px 28px 30px; background: #fff; transition: border-color .2s var(--ease); }
  .use-card:hover { border-color: var(--blue); }
  .use-k { font-weight: 800; font-size: 20px; color: var(--blue); display: flex; align-items: baseline; gap: 10px; }
  .use-k span { font-size: 14px; font-weight: 600; color: var(--ink-3); }

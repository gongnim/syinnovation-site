---
// Trust Gateway: the page walks a buyer from "why now" to "how we start". Hero with the product screens, zero trust vs
// Trust Gateway (with the NIST mapping), recent incidents, what a leaked account opens (VPN vs Trust Gateway), attacks
// and how they stop, where it is used, what an admin sees, how light the install is, a customer, how to start, then
// questions. Facts follow tech doc v0.3 and the product's demo page; web access only (no SSH/RDP).
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import TgHero from '../components/tg/TgHero.astro';
import TgIncidents from '../components/tg/TgIncidents.astro';
import TgVpnSwitch from '../components/tg/TgVpnSwitch.astro';
import TgConsole from '../components/tg/TgConsole.astro';
import ZtBridge from '../components/tg/ZtBridge.astro';
import { appName, tgUses as uses } from '../data/site';

// from the tech doc v0.3 (ch. 2.2, 5.2, 5.4, 6.1, 6.5) and the demo page (signed identity per request)
const attacks = [
  { k: '비밀번호를 훔쳤다면', v: '비밀번호만으로는 열리지 않습니다. 등록된 PC의 기기 인증서와 본인 휴대폰의 생체 확인이 함께 필요합니다.' },
  { k: 'PC 인증서를 복사해 간다면', v: '키는 PC와 휴대폰의 보안 칩 안에서 만들어지고 밖으로 나오지 않습니다. 복사한 파일만으로는 접속할 수 없습니다.' },
  { k: '업무 PC를 통째로 훔쳤다면', v: 'PC와 휴대폰의 위치가 어긋나 추가 인증을 요청합니다. 확인 요청은 휴대폰으로만 가므로 PC만으로는 통과할 수 없습니다.' },
  { k: '통신을 가로채 다시 보낸다면', v: 'TLS 1.3 상호 인증과 서버 공개키 고정으로 연결합니다. 신원은 요청마다 새로 서명해, 가로챈 값을 다시 보내도 통하지 않습니다.' },
  { k: '퇴사자가 예전 권한을 쓴다면', v: '인사 시스템과 연동해 퇴사를 반영하고 인증서를 폐기합니다. PC 인증서는 12시간만 유효하고, 다시 받으려면 매번 승인을 거쳐야 합니다.' },
  { k: '기기를 잃어버렸다면', v: '관리 콘솔에서 인증서를 폐기하면 다음 요청부터 바로 거부됩니다.' },
];
const rules = [
  { t: '정책에 정한 것만 통과', d: '판단할 정보가 없으면 열지 않습니다. 정책의 기본값도 거부입니다.' },
  { t: '위험한 기기는 처음부터 차단', d: '탈옥되거나 루팅된 휴대폰, 에뮬레이터, 디버거가 붙은 앱은 막습니다. 정품 앱인지는 Apple과 Google의 앱 무결성 검증으로 확인합니다.' },
  { t: '들어오는 포트 없음', d: '고객 사내망은 포트를 열지 않습니다. 내부 에이전트가 밖으로만 연결합니다.' },
];

const ready = [
  '사내 Linux 서버에 내부 에이전트 설치, 전용 장비 없음',
  '방화벽에 들어오는 포트를 열지 않음',
  'PC에 사용자 에이전트 (Windows · macOS)',
  `휴대폰에 ${appName} 앱 (iOS · Android)`,
  '접속 대상은 웹 업무 시스템 (HTTP · HTTPS)',
  '관찰 모드로 결과를 먼저 보고 실제 적용',
];
const enroll = [
  { t: '휴대폰 등록', d: `회사 이메일로 받은 일회용 코드로 가입하면, ${appName} 앱이 휴대폰 보안 칩 안에서 키를 만들고 인증서를 받습니다.` },
  { t: 'PC 등록', d: 'PC 화면의 QR을 휴대폰으로 찍고 Face ID로 승인하면, 회사 PC 인증서가 발급됩니다. 키는 PC 보안 칩 안에 남습니다.' },
  { t: '업무 시작', d: '업무를 시작할 때 다시 QR과 생체 인증으로 본인을 확인하면, 지금 이 PC를 쓰는 사람이 확인됩니다. 이후 요청은 자동으로 확인됩니다.' },
];

const airrane = [
  { i: 'key', t: '한 번 확인으로 여러 업무 시스템 이용', d: '게이트웨이가 확인한 신원을 업무 시스템에 넘겨, 시스템마다 다시 로그인하지 않게 합니다.' },
  { i: 'pin', t: '사외와 해외에서도 같은 기준', d: '출장지와 재택, 해외에서도 사무실과 같은 기준으로 사람과 기기를 확인합니다.' },
  { i: 'shield', t: '기술 자료는 허락된 사람에게만', d: '핵심 기술과 정보가 담긴 시스템에 허락된 사람과 기기만 접근하게 합니다.' },
];

const rollout = [
  { t: 'PoC/컨설팅', d: '평가용 환경에 업무 서비스 하나를 연결합니다.' },
  { t: '파일럿', d: '부서 단위로 넓히고, 관찰 모드로 결과를 비교한 뒤 제한적으로 적용합니다.' },
  { t: '전사 적용', d: '서비스 목록을 확정하고 전체 사용자를 Trust Gateway로 전환합니다. 감사, 기록 보존, 장애 복구 절차를 함께 운영합니다.' },
];
const pocChecks = ['등록된 직원은 평소처럼 바로 접속되는지', '등록되지 않은 기기는 게이트웨이에서 막히는지', '정책을 바꾸면 다음 요청부터 반영되는지', '판단 근거와 감사 기록이 남는지', '직원이 쓰기에 번거롭지 않은지'];

const faq = [
  { q: '제로트러스트와 Trust Gateway는 같은 건가요?', a: '아니요. 제로트러스트는 「아무도 믿지 않고 매번 확인한다」는 보안 원칙이고, 미국 NIST·CISA와 한국 과학기술정보통신부가 기준을 공개했습니다. Trust Gateway는 그 원칙을 회사의 업무 접속에 적용한 신영이노베이션의 솔루션입니다.' },
  { q: 'VPN을 바로 꺼야 하나요?', a: '아니요. 서비스 하나부터 Trust Gateway로 옮기고, 결과를 보며 넓힙니다. 옮기는 동안 기존 접속 방식은 그대로 둘 수 있습니다.' },
  { q: '업무 시스템을 고쳐야 하나요?', a: '아니요. 기존 로그인은 그대로 둘 수 있습니다. 게이트웨이가 확인한 신원을 서명해 함께 보내므로, 원하면 업무 시스템이 이 신원을 받아 다시 로그인하지 않게 할 수 있습니다.' },
  { q: '휴대폰이 꼭 있어야 하나요?', a: `네. Trust Gateway는 휴대폰으로 사람을 확인합니다. ${appName} 앱을 등록한 휴대폰(iOS · Android)이 없는 직원은 Trust Gateway로 접속할 수 없습니다.` },
  { q: '어떤 시스템에 쓸 수 있나요?', a: '웹 업무 시스템(HTTP · HTTPS)에 씁니다. 사내 Linux 서버에 내부 에이전트를 설치하며, 전용 장비는 필요 없습니다.' },
  { q: 'Trust Gateway에 문제가 생기면 어떻게 되나요?', a: '판단에 필요한 정보를 확인할 수 없으면 열지 않는 것이 원칙입니다. 확인 없이 통과시키지 않습니다. 장애 복구 절차는 전사 적용 단계에서 함께 정해 운영합니다.' },
  { q: '기록은 어디에, 얼마나 남나요?', a: '판정 기록은 앞 기록과 해시로 이어져 중간을 바꾸면 드러납니다. 삭제와 덮어쓰기가 잠긴 저장소에 5년 동안 보관하고, 관리 콘솔에서 판단 근거를 문장으로 볼 수 있습니다.' },
];
---
<Base title="Trust Gateway" description="제로트러스트 원칙을 업무 접속에 적용한 신영이노베이션의 솔루션, Trust Gateway. PC는 기기를, 휴대폰은 사람을 증명하고 요청마다 다시 확인합니다.">
  <TgHero />

  <ZtBridge id="zt" tone="mist">
    <div class="map reveal">
      <h3 class="h3">공개된 기준대로 만들었습니다</h3>
      <p class="body">제로트러스트 아키텍처(NIST SP 800-207)는 접근 요청을 가로채는 PEP, 허용 여부를 정하는 PDP, 판단에 필요한 정보를 주는 PIP로 나뉩니다. Trust Gateway는 이 구조를 그대로 따릅니다.</p>
      <div class="cmp-wrap">
        <table class="nist">
          <thead><tr><th scope="col">구성 요소</th><th scope="col">하는 일</th><th scope="col">Trust Gateway</th></tr></thead>
          <tbody>
            <tr><th scope="row">PEP<span>정책 시행 지점 · Policy Enforcement Point</span></th><td>사용자의 접근 요청을 가로채고, PDP의 결정에 따라 접근을 허용하거나 차단·종료합니다</td><td>접속 관문<span>요청마다 인증서를 확인하고 허용된 요청만 전달합니다. 휴대폰 앱과 PC 에이전트는 추가 인증을 진행합니다</span></td></tr>
            <tr><th scope="row">PDP<span>정책 결정 지점 · Policy Decision Point</span></th><td>요청을 평가해 허용, 추가 인증, 거부를 결정합니다</td><td>정책 엔진: 금지 사항 확인 · 최종 결정<span>금지 사항 확인(Zen)이 의견을 내면 최종 결정(OPA)이 허용 여부를 정합니다. 결정은 통제 센터가 실행합니다</span></td></tr>
            <tr><th scope="row">PIP<span>정책 정보 지점 · Policy Information Point</span></th><td>PDP가 올바르게 판단하도록 필요한 데이터와 속성을 제공합니다</td><td>머신러닝 이상 탐지<span>평소 행동과 얼마나 달라졌는지 계산해, 위험 점수, 위치, 휴대폰과 PC 신호의 불일치, 기기 보안 상태, 알려진 악성 IP 목록, 회사 설정과 함께 넘깁니다</span></td></tr>
          </tbody>
        </table>
      </div>
      <p class="cap">결제 위험 평가에서는 고객사 결제 시스템이 PEP입니다. Trust Gateway는 거래 위험을 평가해 권고하고, 승인과 거절은 결제 시스템이 정합니다.</p>
    </div>
  </ZtBridge>

  <TgIncidents />
  <TgVpnSwitch />

  <section class="section mist" id="attacks">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">공격자가 이렇게 시도한다면</h2>
        <p class="lead">비밀번호 하나에 기대지 않고, 여러 증거를 동시에 요구합니다.</p>
      </div>
      <ul class="atk">
        {attacks.map((a, i) => (
          <li class="reveal" style={`--i:${i % 3}`}>
            <p class="a-try"><span class="a-k">시도</span>{a.k}</p>
            <p class="a-def"><span class="a-k">Trust Gateway</span>{a.v}</p>
            <span class="stamp" aria-hidden="true">막힘</span>
          </li>
        ))}
      </ul>
      <ul class="rules reveal">
        {rules.map((r) => (<li><b>{r.t}</b><span>{r.d}</span></li>))}
      </ul>
    </div>
  </section>

  <section class="section" id="uses">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">어디에 쓰나요</h2>
        <p class="lead">같은 판단 엔진이 세 자리에 들어갑니다. <br />직원의 업무 접속, 금융 앱의 본인 확인, 고객의 결제입니다.</p>
      </div>
      <div class="tabs reveal" id="use-cases">
        <div class="tablist" role="tablist" aria-label="쓰임">
          {uses.map((c, i) => (<button role="tab" type="button" id={`tab-${c.id}`} aria-controls={`panel-${c.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{c.t}</button>))}
        </div>
        {uses.map((c, i) => (
          <div class="panel" role="tabpanel" id={`panel-${c.id}`} aria-labelledby={`tab-${c.id}`} hidden={i !== 0}>
            <div><p class="pg">{c.g}</p><h3 class="h3">{c.h}</h3><p class="body">{c.d}</p></div>
            <ul>{c.pts.map((p) => <li><Icon name="check" size={18} />{p}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <TgConsole />

  <section class="section" id="install">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">설치는 가볍게</h2>
        <p class="lead">전용 장비 없이, 사내 서버에 에이전트 하나로 시작합니다. <br />세 구역은 서로를 믿지 않고, 경계를 넘을 때마다 다시 확인합니다.</p>
      </div>
      <div class="arch reveal" role="img" aria-label="사용자 기기 구역에서 mTLS로 Trust Gateway에 연결하고, 고객 사내망의 내부 에이전트는 Trust Gateway로 바깥 방향 연결만 맺습니다">
        <div class="az">
          <p class="az-t">사용자 기기</p>
          <div class="node">사용자 에이전트<span>Windows · macOS PC 앱, 보안 브라우저</span></div>
          <div class="node">{appName}<span>iOS · Android, 휴대폰 생체 확인</span></div>
        </div>
        <div class="link"><span>mTLS</span></div>
        <div class="az mid">
          <p class="az-t">Trust Gateway</p>
          <div class="node">접속 관문 (PEP)<span>요청마다 검사 · 전달</span></div>
          <div class="node">통제 센터 · 인증기관(CA)<span>위험 평가 · 인증서 발급과 폐기</span></div>
          <div class="node">판단 엔진<span>이상 탐지 (PIP) · 금지 사항 확인, 최종 결정 (PDP)</span></div>
        </div>
        <div class="link back"><span>밖으로만 연결</span></div>
        <div class="az in">
          <p class="az-t">고객 사내망</p>
          <div class="node">내부 에이전트<span>들어오는 포트 없음</span></div>
          <div class="node">업무 서비스<span>웹 업무 시스템 (HTTP · HTTPS)</span></div>
        </div>
      </div>
      <div class="setup">
        <div class="ready reveal">
          <h3 class="h4">준비할 것</h3>
          <ul>{ready.map((r) => <li><Icon name="check" size={18} />{r}</li>)}</ul>
        </div>
        <div class="enroll reveal">
          <h3 class="h4">직원 등록은 세 단계</h3>
          <ol>{enroll.map((s, i) => (<li><span class="n">{i + 1}</span><div><b>{s.t}</b><p class="body">{s.d}</p></div></li>))}</ol>
        </div>
      </div>
    </div>
  </section>

  <section class="section night" id="customer">
    <div class="wrap cust">
      <figure class="cust-ph reveal">
        <img src="/images/consulting/airrane-case.webp" alt="가스 배관과 밸브가 이어진 산업 설비" width="1400" height="1050" loading="lazy" />
      </figure>
      <div class="reveal">
        <p class="cust-k">도입 고객</p>
        <h2 class="h2 sm">에어레인(AIRRANE)</h2>
        <p class="cust-s">코스닥 상장 기체분리막 전문기업</p>
        <ul class="cust-pts">
          {airrane.map((a) => (<li><span class="ci"><Icon name={a.i} size={18} /></span><div><b>{a.t}</b><p class="body">{a.d}</p></div></li>))}
        </ul>
        <a class="text-link" href="/consulting#airrane">에어레인 ERP 구축 사례도 함께 보기</a>
      </div>
    </div>
  </section>

  <section class="section" id="start">
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">작게 시작해서 넓힙니다</h2>
        <p class="lead">무료 PoC에서 시작해, 결과를 확인하며 단계적으로 적용합니다.</p>
      </div>
      <ol class="roll reveal">
        {rollout.map((r, i) => (<li style={`--i:${i}`}><span class="n">{i + 1}</span><h3 class="h4">{r.t}</h3><p class="body">{r.d}</p></li>))}
      </ol>
      <div class="poc reveal">
        <div>
          <h3 class="h4">PoC에서 직접 확인하는 것</h3>
          <ul>{pocChecks.map((c) => <li><Icon name="check" size={18} />{c}</li>)}</ul>
        </div>
        <a class="btn primary" href="/contact?type=poc">무료 PoC 신청</a>
      </div>
    </div>
  </section>

  <section class="section paper2" id="faq">
    <div class="wrap narrow">
      <div class="head-left reveal"><h2 class="h2 sm">자주 묻는 질문</h2></div>
      <div class="faq reveal">
        {faq.map((f) => (
          <details>
            <summary>{f.q}<Icon name="plus" size={20} class="faq-i" /></summary>
            <p class="body">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Trust Gateway, 무료 PoC로 먼저 써 보세요" lead="평가용 환경에 업무 서비스 하나를 연결해 시작합니다." />
</Base>

<style>
  /* attacks: each card gets a stamp when it comes into view */
  .atk { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .atk li { position: relative; display: grid; gap: 12px; align-content: start; padding: 24px 22px 26px; border-radius: var(--r-xl); background: #fff; }
  .a-try { display: grid; gap: 6px; font-size: 18px; font-weight: 700; line-height: 1.4; padding-right: 64px; }
  .a-def { display: grid; gap: 6px; padding-top: 12px; border-top: 1px dashed var(--line); color: var(--ink-2); font-size: 15px; line-height: 1.65; }
  .a-k { font-size: 12px; font-weight: 700; color: #b4443a; }
  .a-def .a-k { color: var(--blue); }
  .stamp { position: absolute; top: 20px; right: 18px; padding: 4px 10px; border: 2px solid #c94a3a; border-radius: 8px; color: #c94a3a; font-size: 14px; font-weight: 800; letter-spacing: .04em; transform: rotate(-8deg); }
  :global(.js) .atk li .stamp { opacity: 0; }
  :global(.js) .atk li.is-in .stamp { animation: stamp .45s var(--ease) calc(.5s + var(--i) * .15s) both; }
  @keyframes stamp { from { opacity: 0; transform: rotate(-8deg) scale(1.8); } to { opacity: 1; transform: rotate(-8deg) scale(1); } }
  .rules { list-style: none; margin: 24px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .rules li { display: grid; gap: 4px; padding: 16px 18px; border-radius: var(--r-lg); border: 1px solid var(--line); }
  .rules b { font-size: 15px; }
  .rules span { font-size: 14px; color: var(--ink-2); }

  /* uses: tabs */
  .tabs { background: var(--paper-2); border-radius: var(--r-xl); padding: 12px; }
  .tablist { display: flex; flex-wrap: wrap; gap: 6px; padding: 6px; background: #fff; border-radius: 999px; width: fit-content; max-width: 100%; margin: 0 auto 8px; }
  .tablist button { border: 0; background: transparent; padding: 10px 20px; border-radius: 999px; font: inherit; font-weight: 600; cursor: pointer; color: var(--ink-2); }
  .tablist button[aria-selected='true'] { background: var(--ink); color: #fff; }
  .tablist button:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  .panel { display: grid; grid-template-columns: 1.2fr 1fr; gap: 40px; padding: 36px clamp(20px, 4vw, 48px) 40px; align-items: start; }
  .panel[hidden] { display: none; }
  .pg { font-size: 14px; font-weight: 700; color: var(--blue); margin-bottom: 8px; }
  .panel .body { margin-top: 14px; }
  .panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .panel li { display: flex; gap: 10px; align-items: center; padding: 16px 18px; border-radius: var(--r-md); background: #fff; font-weight: 600; }
  .panel li :global(svg) { flex: none; color: var(--blue); }

  /* install */
  .arch { display: grid; grid-template-columns: 1fr 90px 1.15fr 110px 1fr; align-items: stretch; }
  .az { background: #fff; border: 1px solid var(--line); border-radius: var(--r-xl); padding: 24px; display: grid; gap: 12px; align-content: start; }
  .az.mid { border: 2px solid var(--blue); background: var(--mist); }
  .az.in { background: var(--night); border-color: var(--night); color: var(--on-night); }
  .az-t { font-weight: 800; font-size: 18px; margin-bottom: 4px; }
  .node { border: 1px solid var(--line); border-radius: var(--r-md); padding: 12px 14px; font-weight: 700; font-size: 15px; display: grid; gap: 2px; background: var(--paper-2); }
  .az.mid .node { background: #fff; }
  .node span { font-weight: 500; font-size: 13px; color: var(--ink-3); }
  .az.in .node { background: var(--night-2); border-color: var(--night-line); }
  .az.in .node span { color: var(--on-night-2); }
  .az.in .node:first-of-type span { color: var(--orange); font-weight: 700; }
  .link { position: relative; display: grid; place-items: center; }
  .link::before { content: ''; position: absolute; left: 6px; right: 6px; top: 50%; height: 2px; background: var(--blue); }
  .link span { position: relative; background: #fff; font-size: 13px; font-weight: 700; color: var(--blue); padding: 2px 6px; margin-top: -34px; text-align: center; }
  .link.back::after { content: ''; position: absolute; left: 4px; top: calc(50% - 5px); width: 8px; height: 12px; background: var(--blue); clip-path: polygon(100% 0, 0 50%, 100% 100%); }
  .setup { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: 20px; margin-top: 40px; }
  .ready, .enroll { border: 1px solid var(--line); border-radius: var(--r-xl); padding: 28px; }
  .ready ul { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 10px; }
  .ready li { display: flex; gap: 10px; align-items: flex-start; font-weight: 600; }
  .ready li :global(svg) { flex: none; margin-top: 3px; color: #2e9a7a; }
  .enroll ol { list-style: none; margin: 16px 0 0; padding: 0; display: grid; gap: 16px; }
  .enroll li { display: grid; grid-template-columns: 40px minmax(0, 1fr); gap: 14px; }
  .enroll .body { margin-top: 2px; font-size: 15px; }
  .n { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; font-weight: 800; color: var(--blue); border: 2px solid var(--blue); }

  /* the NIST mapping inside the zero trust band */
  .map { max-width: 1080px; margin: clamp(48px, 6vw, 72px) auto 0; padding: clamp(24px, 3vw, 36px); border-radius: var(--r-xl); background: #fff; display: grid; gap: 14px; }
  .map .body { max-width: 720px; }
  .nist { width: 100%; border-collapse: collapse; min-width: 560px; }
  .nist th, .nist td { text-align: left; padding: 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .nist thead th { font-size: 14px; color: var(--ink-3); font-weight: 600; }
  .nist thead th:last-child { color: var(--blue); }
  .nist tbody th { font-weight: 700; width: 30%; }
  .nist tbody th span, .nist td span { display: block; margin-top: 2px; font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .nist td { color: var(--ink-2); }
  .nist td:last-child { color: var(--ink); font-weight: 700; background: var(--mist); }
  .cap { margin-top: 10px; font-size: 13px; color: var(--ink-3); }
  .map { grid-template-columns: minmax(0, 1fr); }
  .map .cmp-wrap { overflow-x: auto; }
  @media (max-width: 640px) {
    .nist { min-width: 0; }
    .nist thead { display: none; }
    .nist tr, .nist th, .nist td { display: block; width: auto; }
    .nist tr { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .nist tbody th, .nist td { padding: 0; border-bottom: 0; }
    .nist tbody th { width: auto; margin-bottom: 6px; }
    .nist td:last-child { margin-top: 10px; padding: 12px 14px; border-radius: var(--r-md); }
  }

  /* customer */
  .cust { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .cust-ph { margin: 0; border-radius: var(--r-xl); overflow: hidden; }
  .cust-ph img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; display: block; }
  .cust-k { font-size: 15px; font-weight: 700; color: #9fb8de; margin-bottom: 10px; }
  .cust-s { margin-top: 8px; color: var(--on-night-2); }
  .cust-pts { list-style: none; margin: 28px 0; padding: 0; display: grid; gap: 18px; }
  .cust-pts li { display: grid; grid-template-columns: 36px minmax(0, 1fr); gap: 12px; }
  .ci { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; background: var(--night-2); color: #9fb8de; }
  .cust-pts b { font-size: 17px; }
  .cust-pts .body { margin-top: 4px; font-size: 15px; }
  .cust .text-link { color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }

  /* start: three steps on a line that fills in, then what the PoC shows */
  .roll { position: relative; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  /* the line runs centre to centre behind the circles (36px, so centred at 17px + 1px) and shows only between them */
  .roll::before { content: ''; position: absolute; left: 18px; right: calc((100% - 40px) / 3 - 18px); top: 17px; height: 2px; background: var(--line); }
  .roll::after { content: ''; position: absolute; left: 18px; right: calc((100% - 40px) / 3 - 18px); top: 17px; height: 2px; background: var(--orange); transform-origin: left; transform: scaleX(1); }
  :global(.js) .roll::after { transform: scaleX(0); transition: transform 1.6s var(--ease) .3s; }
  :global(.js) .roll.is-in::after { transform: scaleX(1); }
  .roll li { position: relative; display: grid; gap: 10px; align-content: start; }
  .roll .n { position: relative; z-index: 1; background: #fff; }
  .roll li:first-child .n { background: var(--orange); border-color: var(--orange); color: #1a1209; }
  .poc { margin-top: 40px; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px; align-items: end; padding: 28px; border-radius: var(--r-xl); background: var(--orange-soft); }
  .poc ul { list-style: none; margin: 14px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 24px; }
  .poc li { display: flex; gap: 8px; align-items: flex-start; font-weight: 600; }
  .poc li :global(svg) { flex: none; margin-top: 3px; color: var(--orange-ink); }

  /* questions */
  .faq { display: grid; gap: 10px; }
  .faq details { background: #fff; border-radius: var(--r-lg); border: 1px solid var(--line); }
  .faq summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 22px; font-weight: 700; font-size: 17px; cursor: pointer; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary :global(.faq-i) { flex: none; color: var(--ink-3); transition: rotate .25s var(--ease); }
  .faq details[open] summary :global(.faq-i) { rotate: 45deg; color: var(--blue); }
  .faq summary:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: var(--r-lg); }
  .faq details .body { padding: 0 22px 22px; }

  @media (max-width: 1023px) {
    .atk, .rules { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .arch { grid-template-columns: 1fr; }
    .link { height: 64px; }
    .link::before { left: 50%; right: auto; top: 8px; bottom: 8px; width: 2px; height: auto; }
    .link span { margin: 0; }
    .link.back::after { display: none; }
    .panel, .setup, .cust { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .atk, .rules { grid-template-columns: minmax(0, 1fr); }
    .tablist { border-radius: var(--r-md); }
    .roll { grid-template-columns: minmax(0, 1fr); }
    .roll::before, .roll::after { left: 17px; right: auto; top: 18px; bottom: 18px; width: 2px; height: auto; }
    .roll::after { transform-origin: top; }
    :global(.js) .roll::after { transform: scaleY(0); }
    :global(.js) .roll.is-in::after { transform: scaleY(1); }
    .roll li { padding-left: 56px; }
    .roll .n { position: absolute; left: 0; top: 0; }
    .poc { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .poc ul { grid-template-columns: minmax(0, 1fr); }
    .head-center .lead br { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .atk li .stamp { opacity: 1; animation: none; }
    :global(.js) .roll::after { transform: none; transition: none; }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('#uses [role="tab"]'));
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const p = document.getElementById(t.getAttribute('aria-controls')!);
      if (p) p.hidden = !on;
    }
  };
  tabs.forEach((t, i) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (!d) return;
      const next = tabs[(i + d + tabs.length) % tabs.length];
      select(next); next.focus();
    });
  });
</script>

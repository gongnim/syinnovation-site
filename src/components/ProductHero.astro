---
// Product page hero in the spirit of PacketGo's ZTNA page: a soft moving gradient in brand colours,
// centred copy, an animated flow card (slot "flow") and glass icon tiles floating around it.
import Icon from './Icon.astro';
interface Props { eyebrow: string; tiles: string[] }
const { eyebrow, tiles } = Astro.props;
---
<section class="ph">
  <div class="ph-bg" aria-hidden="true"><span class="b b1"></span><span class="b b2"></span><span class="b b3"></span><span class="b b4"></span></div>
  <ul class="ph-tiles" aria-hidden="true">
    {tiles.map((t, i) => <li class={`tile t${i}`}><Icon name={t} size={22} /></li>)}
  </ul>
  <div class="wrap ph-copy">
    <p class="ph-eyebrow">{eyebrow}</p>
    <h1 class="ph-title"><slot name="title" /></h1>
    <p class="ph-lead"><slot name="lead" /></p>
  </div>
  <div class="wrap ph-flow"><slot name="flow" /></div>
</section>

<style>
  .ph {
    position: relative; isolation: isolate; overflow: hidden; color: #fff; text-align: center;
    padding: calc(96px + clamp(48px, 5vw, 88px)) 0 clamp(80px, 8vw, 120px);
    background: linear-gradient(165deg, #1d3a6e 0%, #2f5ca8 48%, #5d86d8 100%);
  }
  .ph-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .b { position: absolute; border-radius: 50%; filter: blur(80px); will-change: transform; }
  .b1 { width: 52vw; height: 52vw; left: -14vw; top: -22vw; background: #8fb9ff; opacity: .55; animation: ph-d1 24s ease-in-out infinite alternate; }
  .b2 { width: 42vw; height: 42vw; right: -10vw; top: -4vw; background: #4f78d6; opacity: .7; animation: ph-d2 28s ease-in-out infinite alternate; }
  .b3 { width: 34vw; height: 34vw; right: 10vw; bottom: -20vw; background: #f6a35e; opacity: .42; animation: ph-d3 22s ease-in-out infinite alternate; }
  .b4 { width: 30vw; height: 30vw; left: 28vw; top: 34%; background: #cfe0ff; opacity: .28; animation: ph-d4 32s ease-in-out infinite alternate; }
  @keyframes ph-d1 { to { transform: translate3d(12vw, 8vw, 0) scale(1.08); } }
  @keyframes ph-d2 { to { transform: translate3d(-10vw, 10vw, 0) scale(0.92); } }
  @keyframes ph-d3 { to { transform: translate3d(-16vw, -6vw, 0) scale(1.12); } }
  @keyframes ph-d4 { to { transform: translate3d(8vw, -8vw, 0) scale(1.15); } }

  .ph-tiles { list-style: none; margin: 0; padding: 0; position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .tile {
    position: absolute; width: 56px; height: 56px; border-radius: 18px; display: grid; place-items: center; color: #fff;
    background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.38);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); box-shadow: 0 10px 30px rgba(12,30,70,.18);
    animation: ph-float 7s ease-in-out infinite;
  }
  .t0 { left: 19%; top: 27%; animation-duration: 7.5s; }
  .t1 { left: 8%; top: 52%; animation-duration: 8.5s; animation-delay: -2s; }
  .t2 { left: 19%; bottom: 12%; animation-duration: 6.8s; animation-delay: -4s; }
  .t3 { right: 19%; top: 30%; animation-duration: 8s; animation-delay: -1s; }
  .t4 { right: 8%; top: 58%; animation-duration: 7.2s; animation-delay: -3s; }
  .t5 { right: 32%; bottom: 8%; animation-duration: 9s; animation-delay: -5s; }
  @keyframes ph-float { 0%, 100% { transform: translateY(-8px); } 50% { transform: translateY(8px); } }

  .ph-copy { position: relative; z-index: 1; }
  .ph-eyebrow { font-size: clamp(16px, 0.5vw + 13px, 21px); font-weight: 700; letter-spacing: -0.02em; color: rgba(255,255,255,.92); }
  .ph-title { margin-top: 12px; font-size: clamp(36px, 3.4vw + 8px, 62px); font-weight: 700; line-height: 1.2; letter-spacing: -0.03em; }
  .ph-lead { margin: 22px auto 0; max-width: 640px; font-size: clamp(16px, 0.4vw + 13px, 19px); line-height: 1.65; font-weight: 500; color: rgba(255,255,255,.86); }
  .ph-flow { position: relative; z-index: 1; margin-top: clamp(40px, 4.5vw, 64px); }

  @media (max-width: 1023px) { .t1, .t4 { display: none; } }
  @media (max-width: 767px) { .tile { width: 44px; height: 44px; border-radius: 14px; } .t0 { left: 4%; top: 18%; } .t3 { right: 4%; top: 20%; } .t2, .t5 { display: none; } }
  @media (prefers-reduced-motion: reduce) { .b, .tile { animation: none; } }
</style>

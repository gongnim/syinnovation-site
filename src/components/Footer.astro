---
import { company, nav, cta } from '../data/site';
---
<footer class="ft">
  <div class="wrap ft-grid">
    <div>
      <img src="/images/brand/syinnovation-logo-web.svg" alt="SYINNOVATION RE:Think innovation" width="300" height="57" class="ft-logo" />
      <p class="ft-motto">{company.motto}</p>
    </div>
    <nav aria-label="사이트 메뉴" class="ft-links">
      {[nav.slice(0, 3), [...nav.slice(3), cta]].map((col) => <div>{col.map((n) => <a href={n.href}>{n.label}</a>)}</div>)}
    </nav>
    <address class="ft-info">
      <span>{company.legal}</span>
      <span>대표이사 {company.ceo}</span>
      <span>사업자등록번호 {company.bizNo}</span>
      <span>{company.address}</span>
      <a href={`mailto:${company.email}`}>{company.email}</a>
    </address>
  </div>
  <div class="wrap ft-bottom">
    <span>© 2026 SYINNOVATION. All rights reserved.</span>
    <!-- the privacy policy link is set apart in bold, as Korean privacy guidance asks -->
    <span class="ft-legal"><a href="/privacy" class="ft-privacy">개인정보처리방침</a><a href="/terms">이용약관</a></span>
  </div>
</footer>

<style>
  .ft { background: var(--paper-2); border-top: 1px solid var(--line); padding: 56px 0 32px; font-size: 15px; color: var(--ink-2); }
  .ft-grid { display: grid; grid-template-columns: 1.2fr 1fr 1.4fr; gap: 40px; }
  /* the same web logo as the header, with its "RE:Think innovation" tagline (user, 2026-11-16); the name stays the size it was */
  .ft-logo { height: 38px; width: auto; }
  .ft-motto { margin-top: 14px; font-weight: 600; color: var(--ink); }
  /* the menu in order down two columns (user, 2026-11-16): 홈 · Trust Gateway · IT 컨설팅·개발, then 소식 · 자료실 · 회사소개 · 문의하기 */
  .ft-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 24px; align-content: start; }
  .ft-links div { display: grid; gap: 8px; align-content: start; }
  .ft-links a:hover { color: var(--blue); }
  .ft-info { font-style: normal; display: grid; gap: 4px; align-content: start; }
  .ft-info a { color: var(--blue); }
  .ft-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-top: 48px; padding-top: 20px; border-top: 1px solid var(--line); font-size: 14px; color: var(--ink-3); }
  .ft-legal { display: flex; gap: 20px; }
  .ft-legal a:hover { color: var(--ink); }
  .ft-privacy { font-weight: 700; color: var(--ink-2); }
  @media (max-width: 767px) { .ft-grid { grid-template-columns: 1fr; gap: 28px; } }
</style>


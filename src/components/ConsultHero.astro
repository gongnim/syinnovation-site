---
// AI컨설팅 hero, in the same hand-drawn film as Trust Gateway: the way work is done today is traced and its
// problems circled (진단), redundant steps are struck out and a shorter flow is drawn (설계), the flow becomes
// screens built with AI tools and reviewed by people (개발), then an update log keeps growing (운영).
// Content follows the company's PI approach: process first, only the steps that are needed, built in stages.
import SketchHero from './SketchHero.astro';
import { rr, guide, tick, down } from '../lib/sketch';

// today's flow (zone A): six steps, three of them problems
const asis = [
  { t: '요청 접수' },
  { t: '엑셀에 정리' },
  { t: '메일로 전달', note: '어디까지 했지?', at: 1.8, strike: 7.4 },
  { t: '시스템에 다시 입력', note: '같은 내용 두 번', at: 2.8, strike: 7.9 },
  { t: '결재 받기' },
  { t: '보고서 따로 작성', note: '매번 손으로', at: 4.4, strike: 8.4 },
].map((s, i) => ({ ...s, y: 92 + i * 68 }));
// the redesigned flow (zone B)
const tobe = [
  { t: '요청 접수', at: 8.9 },
  { t: '한 번만 입력', at: 9.3 },
  { t: '휴대폰으로 결재', at: 9.7 },
  { t: '보고서 자동 작성', at: 10.1 },
].map((s, i) => ({ ...s, y: 104 + i * 84 }));
const END = 26;
const log = [
  { t: '오픈', at: 20.8 },
  { t: '입력 화면 개선', at: 21.8 },
  { t: '보고서 항목 추가', at: 22.8 },
];
const BOXES = [...asis.map((s) => [48, s.y, 200, 44]), ...tobe.map((s) => [490, s.y, 220, 48]), [820, 92, 330, 212], [1096, 292, 64, 112]];

const chapters = [
  { t: '진단', from: 0, to: 7, still: 6.6, d: '지금 일하는 방식을 함께 따라가 봅니다. 같은 내용을 두 번 입력하는 곳, 손으로 반복하는 곳을 찾습니다.' },
  { t: '설계', from: 7, to: 13, still: 12.6, d: '필요 없는 단계는 지우고 바꿀 흐름을 그립니다. 무엇을 만들지 개발 전에 정합니다.' },
  { t: '개발', from: 13, to: 20, still: 19.6, d: 'AI 개발 도구로 Web, iOS, Android, 백엔드를 빠르게 만듭니다. 코드 검토와 시험은 사람이 직접 챙깁니다.' },
  { t: '운영', from: 20, to: 26, still: 25.6, d: '오픈한 뒤에도 쓰는 모습을 보며 고치고, 업데이트와 장애 대응을 이어 갑니다.' },
];
const w = (a: number, b = END) => `${a}-${b}`;
---
<SketchHero eyebrow="AI컨설팅" chapters={chapters} loop={END} poster={19.6}
  cam={[[0, 210], [7, 230], [8.7, 600], [13, 820], [14, 990]]}>
  <Fragment slot="title">일하는 방식부터<br />함께 보고,<br />AI로 빠르게 만듭니다</Fragment>
  <Fragment slot="lead">업무 분석부터 AI 기반 개발, 운영과 유지보수까지.<br />금융 보안 현장에서 쌓은 기술로 회사에 맞는 시스템을 만듭니다.</Fragment>
  <a slot="actions" class="btn primary" href="/contact?type=ai">AI컨설팅 문의</a>

  <svg viewBox="0 0 1200 540" role="img" aria-labelledby="ch-title ch-desc">
    <title id="ch-title">AI컨설팅이 진행되는 흐름</title>
    <desc id="ch-desc">{chapters.map((c) => c.d).join(' ')}</desc>
    <defs>
      <filter id="sk-rough" x="-2%" y="-4%" width="104%" height="108%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="11" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>

    <g class="guides" aria-hidden="true">
      {BOXES.map((b) => <path d={guide(b)} />)}
    </g>

    <g class="sketch" filter="url(#sk-rough)" aria-hidden="true">
      <path class="zone" d={rr(24, 64, 380, 456, 18)} />
      <path class="zone core" d={rr(440, 64, 320, 456, 18)} />
      <path class="zone" d={rr(796, 64, 380, 456, 18)} />

      <!-- 진단: today's flow, drawn on load -->
      {asis.map((s, i) => <path class="ink st step" pathLength="1" style={`--d:${0.3 + i * 0.18}s`} data-warn={s.note ? w(s.at, s.strike) : undefined} d={rr(48, s.y, 200, 44, 10)} />)}
      {asis.slice(1).map((s, i) => <path class="ink thin" pathLength="1" style={`--d:${0.5 + i * 0.18}s`} d={down(148, s.y - 22, s.y - 4)} />)}
      <path id="cs-asis" class="ghost" d="M148 92 V476" />
      {asis.filter((s) => s.strike).map((s) => <path class="pen strike" pathLength="1" data-t={w(s.strike)} d={`M36 ${s.y + 26} L260 ${s.y + 18}`} />)}

      <!-- 설계: the shorter flow -->
      <path class="pen thin" pathLength="1" data-t={w(8.6)} d="M250 114 C330 114 400 128 490 128" />
      {tobe.map((s) => <path class="pen st newstep" pathLength="1" data-t={w(s.at)} d={rr(490, s.y, 220, 48, 12)} />)}
      {tobe.slice(1).map((s) => <path class="pen thin" pathLength="1" data-t={w(s.at + 0.2)} d={down(600, s.y - 34, s.y - 4)} />)}
      <path id="cs-tobe" class="ghost" d="M600 104 V404" />
      <path class="swash mint" pathLength="1" data-t={w(11.2)} d="M490 476 L676 470" />

      <!-- 개발: screens built from the flow -->
      <path id="cs-build" class="pen thin" pathLength="1" data-t={w(13.2)} d="M710 212 C760 212 770 196 820 196" />
      <path class="pen" pathLength="1" data-t={w(13.6)} d={rr(820, 92, 330, 212, 12)} />
      <path class="pen thin" pathLength="1" data-t={w(14.1)} d="M820 118 H1150 M832 105 h1 M844 105 h1 M856 105 h1 M884 118 V304" />
      <path class="pen thin" pathLength="1" data-t={w(14.4)} d="M836 142 H870 M836 162 H870 M836 182 H870 M900 146 H1134 M900 178 H1134 M900 210 H1134 M900 242 H1134 M990 132 V254 M1066 132 V254" />
      <path class="pen st row" pathLength="1" data-t={w(21.2)} d={rr(898, 182, 238, 26, 6)} />
      <path class="pen save" pathLength="1" data-t={w(14.8)} d={rr(1006, 266, 80, 28, 8)} />
      <path class="pen" pathLength="1" data-t={w(15)} d={rr(1096, 292, 64, 112, 12)} />
      <path class="pen thin" pathLength="1" data-t={w(15.4)} d="M1118 304 H1138 M1108 326 H1148 M1108 342 H1140" />
      <path class="pen okm" pathLength="1" data-t={w(15.8)} d={tick(1116, 370)} />
      <path class="cue spark" data-t={w(15.2, 20)} d="M826 368 l3 -8 l3 8 l8 3 l-8 3 l-3 8 l-3 -8 l-8 -3 z" />
      <path class="swash violet" pathLength="1" data-t={w(15.2, 20)} d="M850 380 L1046 374" />

      <!-- 운영: the log keeps growing -->
      {log.map((l, i) => <path class="pen okm" pathLength="1" data-t={w(l.at)} d={tick(824, 396 + i * 28)} />)}
    </g>

    <g class="words" aria-hidden="true">
      <text class="w-zone lbl" style="--d:.1s" x="24" y="48">지금 일하는 방식</text>
      <text class="w-zone lbl" style="--d:.1s" x="440" y="48">바꾼 흐름</text>
      <text class="w-zone lbl" style="--d:.1s" x="796" y="48">만든 시스템</text>

      {asis.map((s, i) => <text class="lbl w-e" style={`--d:${0.5 + i * 0.18}s`} x="148" y={s.y + 28} text-anchor="middle">{s.t}</text>)}
      {asis.filter((s) => s.note).map((s) => <text class="hw orange cue" data-t={w(s.at)} x="266" y={s.y + 30}>{s.note}</text>)}

      {tobe.map((s) => <text class="w-e cue" data-t={w(s.at + 0.3)} x="600" y={s.y + 30} text-anchor="middle">{s.t}</text>)}
      <text class="hw cue" data-t={w(11.2)} x="494" y="466">꼭 필요한 단계만</text>

      <text class="w-s cue" data-t={w(14.8)} x="1046" y="286" text-anchor="middle">저장</text>
      <text class="w-s cue" data-t={w(15.6)} x="820" y="336">Web · iOS · Android · 백엔드</text>
      <text class="hw violet cue" data-t={w(15.2, 20)} x="852" y="376">AI 개발 도구로 빠르게</text>
      <g class="cue" data-t={w(17, 20)}><path class="tk" d={tick(824, 396)} /><text class="hw" x="848" y="410">코드 검토와 시험은 사람이</text></g>

      {log.map((l, i) => <text class="w-e cue" data-t={w(l.at)} x="850" y={410 + i * 28}>{l.t}</text>)}
      <text class="w-s cue" data-t={w(20.2)} x="820" y="380">업데이트 기록</text>
      <text class="hw cue" data-t={w(23.6)} x="820" y="500">쓰면서 계속 고칩니다</text>
    </g>

    <g class="pkts" aria-hidden="true">
      <g class="pk orange" data-path="cs-asis" data-w="0.3-6.4"><circle r="11" /><circle r="5" /></g>
      <g class="pk mint" data-path="cs-tobe" data-w="10.8-12.4"><circle r="11" /><circle r="5" /></g>
      <g class="pk mint" data-path="cs-build" data-w="13.3-14.3"><circle r="11" /><circle r="5" /></g>
    </g>
  </svg>
</SketchHero>

<style>
  .sketch .step.warn { stroke: var(--or); fill: rgba(246, 136, 42, .14); }
  .sketch .strike { stroke: var(--coral); stroke-width: 3; }
  .sketch .newstep { stroke: var(--mint); }
  .sketch .newstep.on { fill: rgba(99, 214, 180, .1); }
  .sketch .row { stroke: var(--mint); stroke-width: 1.4; }
  .sketch .row.on { fill: rgba(99, 214, 180, .14); }
  .sketch .save { stroke: var(--mint); }
  .sketch .okm { stroke: var(--mint); stroke-width: 2.4; }
  .sketch .spark { stroke: var(--violet); fill: rgba(165, 148, 249, .3); stroke-width: 1.4; }
</style>

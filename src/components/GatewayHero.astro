---
// Trust Gateway hero: a blueprint sketch of our own architecture that draws itself, then plays one employee's day
// as a single story (user, 2026-11-13): sign in with the phone, work as usual, the IP suddenly changes, the
// decision steps notice it and ask for step-up, the employee approves on the phone, work goes on. Two closing
// scenes follow (an unregistered device, the hidden network). Engine names and roles follow the developer's charts.
// The film, player and timing engine are SketchHero's.
import SketchHero from './SketchHero.astro';
import { appName } from '../data/site';
import { rr, guide, tick } from '../lib/sketch';

const B: Record<string, [number, number, number, number, number]> = {
  pc: [60, 126, 168, 104, 8], phone: [60, 284, 72, 136, 14],
  gw: [450, 96, 320, 76, 12],
  x1: [450, 232, 320, 50, 10], e1: [450, 298, 100, 52, 10], e2: [560, 298, 100, 52, 10], e3: [670, 298, 100, 52, 10],
  agent: [912, 96, 176, 76, 12],
  s1: [950, 268, 200, 48, 10], s2: [950, 330, 200, 48, 10], s3: [950, 392, 200, 48, 10],
};
const box = (k: string) => rr(...B[k]);
const hatch = Array.from({ length: 28 }, (_, i) => `M868 ${80 + i * 16} L880 ${70 + i * 16}`).join(' ');

const LOOP = 48.9;
const engines = [
  { k: 'e1', t: '이상 탐지', on: '7-9,16.4-27.2,31.4-33,34.8-35.8', cls: 'violet' },
  { k: 'e2', t: '금지 사항', on: '7.3-9,19.8-27.2,31.6-33,35-35.8' },
  { k: 'e3', t: '최종 결정', on: '7.6-9,23.2-27.2,31.8-33,35.2-35.8' },
];
const services = [{ k: 's1', t: '그룹웨어' }, { k: 's2', t: '인사 시스템' }, { k: 's3', t: '업무 포털' }];

const chapters = [
  { t: '휴대폰으로 본인 확인', from: 0, to: 4, still: 3.4, d: '업무를 시작할 때 PC 화면의 QR을 휴대폰으로 찍고 Face ID로 승인합니다. 승인 결과가 휴대폰에서 Trust Gateway로 전달되어, 지금 이 PC를 쓰는 사람이 확인됩니다.' },
  { t: '평소처럼 업무', from: 4, to: 12, still: 11.4, d: '업무 요청이 올 때마다 기기 인증서와 본인 확인을 보고, 다중 신호 교차 검증과 판단 엔진을 거쳐 허용합니다. 허용된 요청은 내부 에이전트가 밖으로 열어 둔 연결로만 들어가고, 요청마다 새로 서명한 신원이 붙어 업무 시스템에 닿습니다.' },
  { t: '갑자기 IP가 바뀜', from: 12, to: 16.2, still: 15.6, d: '직원이 카페로 자리를 옮겨 다른 Wi-Fi로 접속합니다. 휴대폰 앱이 바뀐 상태를 알려 오고, 인증할 때와 IP가 달라져 위험 점수가 올라갑니다.' },
  { t: '단계별 위험 판정', from: 16.2, to: 27.2, still: 26.4, d: '이상 탐지 단계가 이 사람의 평소 행동과 비교해 이번 접속이 평소와 달라졌다는 것을 알아챕니다. 금지 사항 확인 단계는 절대 안 되는 상황은 아니라며 통과 의견을 내지만, 최종 결정 단계가 회사 기준에 따라 추가 인증을 정합니다.' },
  { t: '휴대폰으로 다시 인증', from: 27.2, to: 33, still: 30.8, d: '휴대폰으로 추가 인증을 요청하고, 마칠 때까지 접속을 잠시 멈춥니다. 직원이 Face ID로 승인하면 다시 판정해 허용합니다. PC가 아닌 휴대폰으로 따로 묻기 때문에, PC만 손에 넣은 사람은 답할 수 없습니다.' },
  { t: '다시 원래대로 업무', from: 33, to: 38, still: 37.4, d: '승인이 끝나면 직원은 하던 일을 그대로 이어 갑니다. 그 뒤의 요청도 지금까지처럼 하나하나 다시 확인합니다.' },
  { t: '미등록 기기 거부', from: 38, to: 42.9, still: 41.8, d: '등록된 인증서가 없는 기기의 요청은 게이트웨이에서 거부됩니다. 내부망에는 닿지 않습니다.' },
  { t: '보이지 않는 사내망', from: 42.9, to: LOOP, still: 48, d: '게이트웨이를 건너뛰고 고객사 내부망을 직접 두드려도, 열린 포트가 없어 아무 응답이 없습니다. 내부망은 안에서 밖으로만 연결하기 때문에 밖에서는 보이지도 않습니다.' },
];
---
<SketchHero eyebrow="Trust Gateway" chapters={chapters} loop={LOOP} poster={25.8}
  cam={[[0, 600], [0.6, 190], [4.2, 320], [5.8, 600], [8.4, 860], [9.8, 1010], [12, 320], [13.8, 600], [16.2, 610, 500, 400], [26.8, 600], [27.4, 300], [30.4, 420], [31.4, 600], [33, 320], [34.2, 600], [35.6, 860], [36.6, 1010], [38, 280], [39.4, 380], [43, 520], [44.8, 880]]}>
  <Fragment slot="title">Never Trust, <br />Always Verify</Fragment>
  <Fragment slot="sub">아무도 믿지 않고, 매번 확인합니다</Fragment>
  <Fragment slot="lead">다중 신호 교차 검증으로 여러분의 소중한 자산을 보호합니다.</Fragment>
  <a slot="actions" class="btn primary" href="/contact?type=poc">무료 PoC 신청</a>

  <svg viewBox="0 0 1200 540" role="img" aria-labelledby="gh-title gh-desc">
    <title id="gh-title">Trust Gateway가 직원의 접속을 확인하는 흐름</title>
    <desc id="gh-desc">{chapters.map((c) => c.d).join(' ')}</desc>
    <defs>
      <filter id="sk-rough" x="-2%" y="-4%" width="104%" height="108%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="n" />
        <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>

    <g class="guides" aria-hidden="true">
      {Object.values(B).map((b) => <path d={guide(b)} />)}
      <path class="tun-guide" d="M770 127 H912 M770 139 H912" />
    </g>

    <g class="sketch" filter="url(#sk-rough)" aria-hidden="true">
      <path class="zone" d={rr(24, 64, 306, 392, 18)} />
      <path class="zone core" d={rr(420, 64, 380, 456, 18)} />
      <path class="zone" d={rr(880, 64, 296, 456, 18)} />
      <path class="ink wall" pathLength="1" style="--d:1.1s" d="M880 64 V520" />
      <path class="ink thin" pathLength="1" style="--d:1.2s" d={hatch} />

      <!-- devices -->
      <path class="ink" pathLength="1" style="--d:.2s" d={box('pc')} />
      <path class="ink" pathLength="1" style="--d:.5s" d="M60 232 L40 248 H248 L228 232" />
      <path class="ink thin" pathLength="1" style="--d:.7s" d="M60 146 H228 M76 166 H156 M76 182 H196 M76 198 H140" />
      <path class="cue qr" data-t="0.2-3.6" d="M172 156 h12 v12 h-12 z M200 156 h12 v12 h-12 z M172 184 h12 v12 h-12 z M190 159 h4 M190 170 h6 M200 176 h4 M190 190 h10 M204 186 v8" />
      <path class="ink" pathLength="1" style="--d:.45s" d={box('phone')} />
      <path class="ink thin" pathLength="1" style="--d:.8s" d="M86 296 H106 M74 318 H118" />
      <path class="cue scan" data-t="0.6-1.6" d="M80 346 v-8 h8 M104 338 h8 v8 M112 366 v8 h-8 M88 374 h-8 v-8" />
      <path class="cue finger" data-t="28.8-30.2" d="M84 372 C84 346 108 346 108 372 M90 376 C90 356 102 356 102 374 M96 364 V380 M78 362 C80 340 112 340 114 362" />
      <path class="cue ok-mint" data-t="1.6-3.8,30.2-31.8" d={tick(82, 356)} />

      <!-- gateway and engines -->
      <path class="ink st gw" pathLength="1" style="--d:.7s" data-t="5.6-9,13.6-27.2,31-33,34-35.8" d={box('gw')} />
      <path class="ink" pathLength="1" style="--d:1.3s" d="M610 172 V232" />
      <path class="ink st eng" pathLength="1" style="--d:.95s" data-t="6.6-9,31.2-33,34.6-35.8" data-warn="14.6-27.2" d={box('x1')} />
      <path class="ink thin" pathLength="1" style="--d:1.1s" d="M500 282 V298 M610 282 V298 M720 282 V298" />
      {engines.map((e, i) => <path class={`ink st eng ${e.cls ?? ''}`} pathLength="1" style={`--d:${1.05 + i * 0.1}s`} data-t={e.on} d={box(e.k)} />)}
      <path class="ink st pill allow" pathLength="1" style="--d:1.5s" data-t="8-11.8,32.2-33,35.4-38" d={rr(450, 408, 100, 40, 20)} />
      <path class="ink st pill step" pathLength="1" style="--d:1.6s" data-t="26.4-32" d={rr(560, 408, 100, 40, 20)} />
      <path class="ink st pill deny" pathLength="1" style="--d:1.7s" data-t="39.8-42.9" d={rr(670, 408, 100, 40, 20)} />

      <!-- customer network -->
      <path class="ink" pathLength="1" style="--d:1.3s" d={box('agent')} />
      <path class="ink" pathLength="1" style="--d:1.6s" d="M930 172 V416 M930 292 H950 M930 354 H950 M930 416 H950" />
      {services.map((s, i) => <path class={`ink st svc`} pathLength="1" style={`--d:${1.7 + i * 0.1}s`} data-t={i === 0 ? '11-12,37-38' : undefined} d={box(s.k)} />)}
      <path class="tun st" pathLength="1" data-t={`0-${LOOP}`} d="M912 127 H770 M912 139 H770" />

      <!-- wires (packets travel along the ones with an id) -->
      <path id="gh-pc" class="ink wire" pathLength="1" style="--d:2s" d="M228 176 C330 176 350 134 450 134" />
      <path id="gh-ph" class="ink wire" pathLength="1" style="--d:2.1s" d="M134 372 C300 372 340 261 450 261" />
      <path id="gh-bind" class="st bind" data-t={`3.2-${LOOP}`} d="M214 254 C236 290 200 326 134 334" />
      <path id="gh-tun" class="ghost" d="M770 133 H912" />
      <path id="gh-svc" class="ghost" d="M930 172 V292 H950" />

      <!-- an unregistered device -->
      <g class="cue bad" data-t={`38-${LOOP}`}>
        <path d={rr(60, 474, 80, 44, 6)} /><path d="M52 524 H148" /><path d="M92 488 c0 -8 14 -8 14 0 c0 6 -7 6 -7 12 M99 508 v1" />
        <path id="gh-bad" class="wire" d="M150 498 C280 498 330 490 412 490" />
      </g>
      <path class="cue deny-x" data-t="39.8-42.9" d="M410 480 l20 20 M430 480 l-20 20" />

      <!-- highlighter swashes under the notes that matter -->
      <path class="swash mint" pathLength="1" data-t={`0-${LOOP}`} d="M910 220 L1066 214" />
      <path class="swash orange" pathLength="1" data-t="15-16.2,27.8-31" d="M446 400 L776 395" />
    </g>

    <g class="words" aria-hidden="true">
      <text class="w-zone lbl" style="--d:.1s" x="24" y="48">직원의 기기</text>
      <text class="w-zone lbl" style="--d:.1s" x="420" y="48">Trust Gateway</text>
      <text class="w-zone lbl" style="--d:.1s" x="880" y="48">고객사 내부망</text>

      <text class="lbl" style="--d:.5s" x="48" y="108"><tspan class="w-t">업무 PC</tspan><tspan class="w-s" dx="10">보안 브라우저</tspan></text>
      <text class="lbl" style="--d:.8s" x="60" y="446"><tspan class="w-t">휴대폰</tspan><tspan class="w-s" dx="10">{appName} 앱</tspan></text>
      <text class="hw mint cue" data-t="0.6-4.2" x="232" y="292">QR 승인</text>
      <text class="hw mint cue" data-t="2.4-4.2" x="232" y="318">본인 확인</text>
      <!-- the change, and the step-up on the phone -->
      <text class="hw orange cue" data-t="12.2-16.2" x="232" y="292">카페 Wi-Fi로 이동</text>
      <text class="hw orange cue" data-t="12.8-16.2" x="232" y="318">IP 바뀜</text>
      <text class="hw orange cue" data-t="27.8-30.2" x="232" y="292">다시 인증 요청</text>
      <text class="hw mint cue" data-t="30.2-32.4" x="232" y="292">Face ID로 승인</text>

      <text class="lbl w-t" style="--d:1s" x="472" y="130">접속 관문</text>
      <text class="lbl w-s" style="--d:1.1s" x="472" y="156">요청마다 확인</text>
      <g class="cue" data-t="5.9-9,13.9-27.2,34.1-35.8"><path class="tk" d={tick(650, 118)} /><text class="hw" x="676" y="131">인증서</text></g>
      <g class="cue" data-t="6.3-9,14.3-27.2,34.4-35.8"><path class="tk" d={tick(650, 146)} /><text class="hw" x="676" y="159">본인 확인</text></g>

      <text class="lbl w-s" style="--d:1.2s" x="450" y="222">판단 엔진</text>
      <text class="lbl w-e" style="--d:1.25s" x="610" y="263" text-anchor="middle">다중 신호 교차 검증</text>
      {engines.map((e, i) => <text class={`lbl w-e2 ${e.cls ?? ''}`} style={`--d:${1.35 + i * 0.1}s`} x={B[e.k][0] + 50} y={B[e.k][1] + 32} text-anchor="middle">{e.t}</text>)}
      <g class="cue" data-t="6.8-9,34.8-35.8"><path class="tk" d={tick(450, 380)} /><text class="hw" x="474" y="394">같은 Wi-Fi · 같은 시간대</text></g>
      <text class="hw orange cue" data-t="14.8-16.2" x="450" y="394">IP가 인증할 때와 다름, 위험 점수 올라감</text>
      <text class="hw orange cue" data-t="27.8-31" x="450" y="394">인증을 마칠 때까지 접속을 잠시 멈춤</text>
      <g class="cue" data-t="31.2-33"><path class="tk" d={tick(450, 380)} /><text class="hw" x="474" y="394">승인 후 다시 판정</text></g>
      <text class="lbl w-v st allow" style="--d:1.7s" data-t="8-11.8,32.2-33,35.4-38" x="500" y="434" text-anchor="middle">허용</text>
      <text class="lbl w-v st step" style="--d:1.8s" data-t="26.4-32" x="610" y="434" text-anchor="middle">추가 인증</text>
      <text class="lbl w-v st deny" style="--d:1.9s" data-t="39.8-42.9" x="720" y="434" text-anchor="middle">거부</text>
      <text class="hw coral cue" data-t={`38.2-${LOOP}`} x="156" y="476">등록되지 않은 기기</text>
      <text class="hw coral cue" data-t="40-42.9" x="446" y="500">인증서 없음 · 내부망에 닿지 않음</text>

      <text class="lbl w-s" style="--d:2.1s" x="318" y="142" text-anchor="middle">mTLS</text>
      <text class="lbl w-s" style="--d:2.2s" x="826" y="166" text-anchor="middle">mTLS</text>
      <text class="lbl w-s" style="--d:2.3s" x="826" y="188" text-anchor="middle">HTTP/2</text>
      <text class="hw cue" data-t="8.4-9.4" x="776" y="114">밖으로 연결</text>
      <text class="hw mint cue" data-t="9.4-11.8,35.6-37.4" x="776" y="114">서명된 신원</text>
      <text class="hw cue" data-t={`0-10.2,12-36.2,37.6-${LOOP}`} x="914" y="214">들어오는 포트 없음</text>
      <g class="cue" data-t="10.2-12,36.2-37.6"><path class="tk" d={tick(914, 200)} /><text class="hw mint" x="938" y="214">서명 확인</text></g>

      <text class="lbl w-t" style="--d:1.6s" x="932" y="130">내부 에이전트</text>
      <text class="lbl w-s" style="--d:1.7s" x="932" y="156">고객사 서버에 설치</text>
      <text class="lbl w-s" style="--d:1.8s" x="912" y="254">내부 업무 서비스</text>
      {services.map((s, i) => <text class="lbl w-e" style={`--d:${1.9 + i * 0.1}s`} x={B[s.k][0] + 20} y={B[s.k][1] + 30}>{s.t}</text>)}
      <text class="hw mint cue" data-t="11-12" x="950" y="476">검증된 신원만 도착</text>
      <text class="hw mint cue" data-t="37-38" x="950" y="476">다시 업무 시작</text>
    </g>

    <!-- the decision chapter: one card per step, over the lower part of the gateway zone -->
    <g class="cards" aria-hidden="true">
      <!-- 보이지 않는 사내망: the unregistered device probes the customer network directly -->
      <path id="gh-probe" class="probe cue" data-t={`43.2-${LOOP}`} d="M150 506 C420 536 720 536 868 474" />
      <g class="cue" data-t="44.8-46.6"><path class="ping" d="M862 474 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0" /><text class="hw coral" x="836" y="483" text-anchor="end">?</text></g>
      <g class="cue" data-t="45.3-47.1"><path class="ping" d="M862 362 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0" /><text class="hw coral" x="836" y="371" text-anchor="end">?</text></g>
      <g class="cue" data-t="45.8-47.6"><path class="ping" d="M862 250 a10 10 0 1 0 20 0 a10 10 0 1 0 -20 0" /><text class="hw coral" x="836" y="259" text-anchor="end">?</text></g>
      <text class="hw coral cue" data-t={`45.6-${LOOP}`} x="560" y="508">열린 포트 없음 · 응답 없음</text>
      <g class="cue" data-t={`46.2-${LOOP}`}>
        <path class="veil" d={rr(884, 66, 290, 452, 16)} />
        <path class="tun-hi" d="M770 127 H912 M770 139 H912" />
        <text class="hw veil-t" x="1030" y="296" text-anchor="middle">밖에서는 보이지 않음</text>
        <text class="hw mint" x="1030" y="334" text-anchor="middle">안에서 밖으로만 연결</text>
      </g>
      <!-- 1. 이상 탐지 (PIP): the IP change sits outside this person's normal band -->
      <g class="cue" data-t="16.4-19.6">
        <path class="card-bg violet" filter="url(#sk-rough)" d={rr(436, 362, 348, 144, 12)} />
        <path class="card-link violet" d="M500 350 V362" />
        <text class="card-t violet" x="456" y="390">이상 탐지</text>
        <text class="card-l" x="456" y="414">평소 행동(초록 띠)과 비교합니다</text>
      </g>
      <g class="cue" data-t="17-19.6"><text class="card-l" x="456" y="446">접속 시각</text><path class="track" d="M560 440 H760" /><path class="band" d={rr(610, 436, 90, 8, 4)} /><path class="mk" d="M648 432 V448" /></g>
      <g class="cue" data-t="17.4-19.6"><text class="card-l" x="456" y="470">요청 빈도</text><path class="track" d="M560 464 H760" /><path class="band" d={rr(610, 460, 90, 8, 4)} /><path class="mk" d="M662 456 V472" /></g>
      <g class="cue" data-t="17.8-19.6"><text class="card-l" x="456" y="494">IP 변화</text><path class="track" d="M560 488 H760" /><path class="band" d={rr(610, 484, 90, 8, 4)} /><path class="mk out" d="M742 480 V496" /></g>
      <text class="hw orange cue" data-t="18.6-19.6" x="766" y="392" text-anchor="end">평소와 다름</text>
      <!-- 2. 금지 사항 확인 (Zen): a checklist of forbidden situations; it gives an opinion, the last step decides -->
      <g class="cue" data-t="19.8-23">
        <path class="card-bg zen" filter="url(#sk-rough)" d={rr(436, 362, 348, 144, 12)} />
        <path class="card-link zen" d="M610 350 V362" />
        <text class="card-t zen" x="456" y="390">금지 사항 확인</text>
        <text class="card-l" x="456" y="414">의견만 내고, 결정은 다음 단계가 합니다</text>
      </g>

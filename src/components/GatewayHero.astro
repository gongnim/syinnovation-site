---
// Trust Gateway hero: a blueprint sketch of our own architecture that draws itself, then plays the real flow
// (developer tech doc v0.3, ch. 2.4, 4 and 5) as a loop of six chapters with a pause button.
// Timing lives in data-t / data-warn ("from-to" seconds, comma separated) and data-w on packets; the script below
// turns them into classes and packet positions. Reduced motion: no drawing or movement, chapters become still frames.
// On narrow screens the script pans a camera over the stage so no label drops under 11px.
import Icon from './Icon.astro';
import { appName } from '../data/site';

// a rounded box drawn the way a hand does: it starts on the top edge and runs a little past its own start
const rr = (x: number, y: number, w: number, h: number, r = 10) => {
  const o = Math.min(8, w / 6);
  return `M${x + r + o} ${y} H${x + w - r} Q${x + w} ${y} ${x + w} ${y + r} V${y + h - r} Q${x + w} ${y + h} ${x + w - r} ${y + h} H${x + r} Q${x} ${y + h} ${x} ${y + h - r} V${y + r} Q${x} ${y} ${x + r} ${y} L${x + r + o * 2.2} ${y + 1.2}`;
};
// construction lines: each edge extended past the corners, like a draughtsman's guides
const guide = ([x, y, w, h]: number[], e = 14) => `M${x - e} ${y} H${x + w + e} M${x - e} ${y + h} H${x + w + e} M${x} ${y - e} V${y + h + e} M${x + w} ${y - e} V${y + h + e}`;

const B: Record<string, [number, number, number, number, number]> = {
  pc: [60, 126, 168, 104, 8], phone: [60, 284, 72, 136, 14],
  gw: [450, 96, 320, 76, 12],
  e1: [450, 232, 152, 58, 10], e2: [618, 232, 152, 58, 10], e3: [450, 302, 152, 58, 10], e4: [618, 302, 152, 58, 10],
  agent: [912, 96, 176, 76, 12],
  s1: [950, 268, 200, 48, 10], s2: [950, 330, 200, 48, 10], s3: [950, 392, 200, 48, 10],
};
const box = (k: string) => rr(...B[k]);
const hatch = Array.from({ length: 28 }, (_, i) => `M868 ${80 + i * 16} L880 ${70 + i * 16}`).join(' ');

const engines = [
  { k: 'e1', t: '교차 검증', on: '10.6-14.4,24-25.6', warn: '19.6-23.4' },
  { k: 'e2', t: '규칙', on: '11-14.4,19.9-25.6' },
  { k: 'e3', t: '이상 탐지', on: '11.3-14.4,20.1-25.6', cls: 'violet' },
  { k: 'e4', t: '정책 (OPA)', on: '11.6-14.4,20.3-25.6' },
];
const services = [{ k: 's1', t: '그룹웨어' }, { k: 's2', t: '인사 시스템' }, { k: 's3', t: '업무 포털' }];

const chapters = [
  { t: '밖으로만 연결', from: 0, to: 4, still: 3.6, d: '고객사 서버의 Internal Agent가 게이트웨이로 먼저 연결을 엽니다. 내부망에는 들어오는 포트를 열지 않습니다.' },
  { t: '사람과 PC 묶기', from: 4, to: 8, still: 7.4, d: 'PC 화면의 QR을 휴대폰으로 찍고 생체 인증으로 승인해, 지금 이 PC를 쓰는 사람을 묶습니다.' },
  { t: '요청마다 확인', from: 8, to: 14, still: 13.6, d: '요청이 올 때마다 인증서와 바인딩을 확인하고, PC와 휴대폰 신호를 교차 검증한 뒤 정책으로 판정합니다.' },
  { t: '검증된 신원 전달', from: 14, to: 18, still: 17.4, d: '허용된 요청에만 서명된 신원을 붙여 내부 서비스로 보냅니다. 업무 시스템은 이 신원으로 사용자를 알아봅니다.' },
  { t: '수상하면 재확인', from: 18, to: 25.6, still: 22.2, d: '두 기기의 위치가 맞지 않는 등 모순이 보이면 휴대폰으로 추가 인증을 요청합니다. 승인하면 다시 판정합니다.' },
  { t: '미등록 기기 거부', from: 25.6, to: 30.5, still: 29.4, d: '등록된 인증서가 없는 기기의 요청은 게이트웨이에서 거부됩니다. 내부망에는 닿지 않습니다.' },
];
const tick = (x: number, y: number) => `M${x} ${y} l5 6 l11 -12`;
---
<section class="gh">
  <div class="wrap gh-top">
    <div>
      <p class="gh-eyebrow">제로트러스트 접근 제어</p>
      <h1 class="gh-title">VPN 없이,<br />휴대폰 확인 한&nbsp;번으로<br />여는 사내 업무</h1>
    </div>
    <div class="gh-side">
      <p class="gh-lead">PC와 휴대폰의 신호를 교차 검증하고,<br />로그인 이후에도 요청마다 다시 확인합니다.</p>
      <div class="btn-row"><a class="btn primary" href="/contact?type=poc">무료 PoC 신청</a></div>
    </div>
  </div>

  <div class="wrap">
    <div class="gh-film">
      <div class="gh-stage">
        <svg viewBox="0 0 1200 540" role="img" aria-labelledby="gh-title gh-desc">
          <title id="gh-title">Trust Gateway가 접속을 확인하는 흐름</title>
          <desc id="gh-desc">{chapters.map((c) => c.d).join(' ')}</desc>
          <defs>
            <filter id="gh-rough" x="-2%" y="-4%" width="104%" height="108%">
              <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="7" result="n" />
              <feDisplacementMap in="SourceGraphic" in2="n" scale="2.6" xChannelSelector="R" yChannelSelector="G" />
            </filter>
          </defs>

          <g class="guides" aria-hidden="true">
            {Object.values(B).map((b) => <path d={guide(b)} />)}
            <path class="tun-guide" d="M770 127 H912 M770 139 H912" />
          </g>

          <g class="sketch" filter="url(#gh-rough)" aria-hidden="true">
            <path class="zone" d={rr(24, 64, 306, 392, 18)} />
            <path class="zone core" d={rr(420, 64, 380, 456, 18)} />
            <path class="zone" d={rr(880, 64, 296, 456, 18)} />
            <path class="ink wall" pathLength="1" style="--d:1.1s" d="M880 64 V520" />
            <path class="ink thin" pathLength="1" style="--d:1.2s" d={hatch} />

            <!-- devices -->
            <path class="ink" pathLength="1" style="--d:.2s" d={box('pc')} />
            <path class="ink" pathLength="1" style="--d:.5s" d="M60 232 L40 248 H248 L228 232" />
            <path class="ink thin" pathLength="1" style="--d:.7s" d="M60 146 H228 M76 166 H156 M76 182 H196 M76 198 H140" />
            <path class="cue qr" data-t="4.2-7.6" d="M172 156 h12 v12 h-12 z M200 156 h12 v12 h-12 z M172 184 h12 v12 h-12 z M190 159 h4 M190 170 h6 M200 176 h4 M190 190 h10 M204 186 v8" />
            <path class="ink" pathLength="1" style="--d:.45s" d={box('phone')} />
            <path class="ink thin" pathLength="1" style="--d:.8s" d="M86 296 H106 M74 318 H118" />
            <path class="cue scan" data-t="4.8-6.2" d="M80 346 v-8 h8 M104 338 h8 v8 M112 366 v8 h-8 M88 374 h-8 v-8" />
            <path class="cue finger" data-t="21.4-22.8" d="M84 372 C84 346 108 346 108 372 M90 376 C90 356 102 356 102 374 M96 364 V380 M78 362 C80 340 112 340 114 362" />
            <path class="cue ok-mint" data-t="6.2-7.8,22.8-24.4" d={tick(82, 356)} />

            <!-- gateway and engines -->
            <path class="ink st gw" pathLength="1" style="--d:.7s" data-t="9.6-14.4,18.9-25.6" d={box('gw')} />
            <path class="ink" pathLength="1" style="--d:1.3s" d="M610 172 V232" />
            {engines.map((e, i) => <path class={`ink st eng ${e.cls ?? ''}`} pathLength="1" style={`--d:${0.95 + i * 0.1}s`} data-t={e.on} data-warn={e.warn} d={box(e.k)} />)}
            <path class="ink st pill allow" pathLength="1" style="--d:1.5s" data-t="12.6-16.2,24.4-25.6" d={rr(450, 408, 100, 40, 20)} />
            <path class="ink st pill step" pathLength="1" style="--d:1.6s" data-t="20.4-24.2" d={rr(560, 408, 100, 40, 20)} />
            <path class="ink st pill deny" pathLength="1" style="--d:1.7s" data-t="27.4-30.5" d={rr(670, 408, 100, 40, 20)} />

            <!-- customer network -->
            <path class="ink" pathLength="1" style="--d:1.3s" d={box('agent')} />
            <path class="ink" pathLength="1" style="--d:1.6s" d="M930 172 V416 M930 292 H950 M930 354 H950 M930 416 H950" />
            {services.map((s, i) => <path class={`ink st svc`} pathLength="1" style={`--d:${1.7 + i * 0.1}s`} data-t={i === 0 ? '16-18' : undefined} d={box(s.k)} />)}
            <path class="tun st" pathLength="1" data-t="0.8-30.5" d="M912 127 H770 M912 139 H770" />

            <!-- wires (packets travel along the ones with an id) -->
            <path id="gh-pc" class="ink wire" pathLength="1" style="--d:2s" d="M228 176 C330 176 350 134 450 134" />
            <path id="gh-ph" class="ink wire" pathLength="1" style="--d:2.1s" d="M134 372 C300 372 340 261 450 261" />
            <path id="gh-bind" class="st bind" data-t="6.4-30.5" d="M214 254 C236 290 200 326 134 334" />
            <path id="gh-tun" class="ghost" d="M770 133 H912" />
            <path id="gh-svc" class="ghost" d="M930 172 V292 H950" />

            <!-- an unregistered device -->
            <g class="cue bad" data-t="25.6-30.5">
              <path d={rr(60, 474, 80, 44, 6)} /><path d="M52 524 H148" /><path d="M92 488 c0 -8 14 -8 14 0 c0 6 -7 6 -7 12 M99 508 v1" />
              <path id="gh-bad" class="wire" d="M150 498 C280 498 330 490 412 490" />
            </g>
            <path class="cue deny-x" data-t="27.4-30.5" d="M410 480 l20 20 M430 480 l-20 20" />

            <!-- highlighter swashes under the notes that matter -->
            <path class="swash mint" pathLength="1" data-t="1.4-30.5" d="M910 220 L1066 214" />
            <path class="swash orange" pathLength="1" data-t="19.6-23" d="M446 400 L716 395" />
          </g>

          <g class="words" aria-hidden="true">
            <text class="w-zone lbl" style="--d:.1s" x="24" y="48">직원의 기기</text>
            <text class="w-zone lbl" style="--d:.1s" x="420" y="48">Trust Gateway</text>
            <text class="w-zone lbl" style="--d:.1s" x="880" y="48">고객사 내부망</text>

            <text class="lbl" style="--d:.5s" x="48" y="108"><tspan class="w-t">업무 PC</tspan><tspan class="w-s" dx="10">보안 브라우저</tspan></text>
            <text class="lbl" style="--d:.8s" x="60" y="446"><tspan class="w-t">휴대폰</tspan><tspan class="w-s" dx="10">{appName} 앱</tspan></text>
            <text class="hw mint cue" data-t="4.6-8.2" x="232" y="292">QR 승인</text>
            <text class="hw mint cue" data-t="5.2-8.2" x="232" y="318">사람과 PC 묶기</text>

            <text class="lbl w-t" style="--d:1s" x="472" y="130">ZT 게이트웨이</text>
            <text class="lbl w-s" style="--d:1.1s" x="472" y="156">요청마다 확인</text>
            <g class="cue" data-t="9.9-14.4,19.1-25.6"><path class="tk" d={tick(650, 118)} /><text class="hw" x="676" y="131">인증서</text></g>
            <g class="cue" data-t="10.3-14.4,19.4-25.6"><path class="tk" d={tick(650, 146)} /><text class="hw" x="676" y="159">바인딩</text></g>

            <text class="lbl w-s" style="--d:1.2s" x="450" y="222">판단 엔진</text>
            {engines.map((e, i) => <text class={`lbl w-e ${e.cls ?? ''}`} style={`--d:${1.3 + i * 0.1}s`} x={B[e.k][0] + 76} y={B[e.k][1] + 35} text-anchor="middle">{e.t}</text>)}
            <g class="cue" data-t="10.8-14.4"><path class="tk" d={tick(450, 380)} /><text class="hw" x="474" y="394">같은 Wi-Fi · 같은 시간대</text></g>
            <text class="hw cue" data-t="19.6-23" x="450" y="394">PC와 휴대폰 위치가 맞지 않음</text>
            <g class="cue" data-t="23.4-25.6"><path class="tk" d={tick(450, 380)} /><text class="hw" x="474" y="394">승인 후 다시 판정</text></g>
            <text class="lbl w-v st allow" style="--d:1.7s" data-t="12.6-16.2,24.4-25.6" x="500" y="434" text-anchor="middle">허용</text>
            <text class="lbl w-v st step" style="--d:1.8s" data-t="20.4-24.2" x="610" y="434" text-anchor="middle">추가 인증</text>
            <text class="lbl w-v st deny" style="--d:1.9s" data-t="27.4-30.5" x="720" y="434" text-anchor="middle">거부</text>
            <text class="hw coral cue" data-t="25.8-30.5" x="156" y="476">등록되지 않은 기기</text>
            <text class="hw coral cue" data-t="27.6-30.5" x="446" y="500">인증서 없음 · 내부망에 닿지 않음</text>

            <text class="lbl w-s" style="--d:2.2s" x="826" y="166" text-anchor="middle">mTLS</text>
            <text class="lbl w-s" style="--d:2.3s" x="826" y="188" text-anchor="middle">HTTP/2</text>
            <text class="hw cue" data-t="0.4-4.2" x="776" y="114">밖으로 연결</text>
            <text class="hw mint cue" data-t="14-16.4" x="776" y="114">서명된 신원</text>
            <text class="hw cue" data-t="1.4-30.5" x="914" y="214">들어오는 포트 0</text>

            <text class="lbl w-t" style="--d:1.6s" x="932" y="130">Internal Agent</text>
            <text class="lbl w-s" style="--d:1.7s" x="932" y="156">고객사 서버에 설치</text>
            <text class="lbl w-s" style="--d:1.8s" x="912" y="254">내부 업무 서비스</text>
            {services.map((s, i) => <text class="lbl w-e" style={`--d:${1.9 + i * 0.1}s`} x={B[s.k][0] + 20} y={B[s.k][1] + 30}>{s.t}</text>)}
            <text class="hw mint cue" data-t="16.2-18" x="950" y="476">검증된 신원만 도착</text>
          </g>

          <g class="pkts" aria-hidden="true">
            <g class="pk" data-path="gh-tun" data-w="0.2-1.6" data-rev><circle r="11" /><circle r="5" /></g>
            <g class="pk mint" data-path="gh-bind" data-w="5.4-6.4" data-rev><circle r="11" /><circle r="5" /></g>
            <g class="pk" data-path="gh-ph" data-w="8.2-9.4"><circle r="11" /><circle r="5" /></g>
            <g class="pk" data-path="gh-pc" data-w="8.6-9.8"><circle r="11" /><circle r="5" /></g>
            <g class="pk mint" data-path="gh-tun" data-w="14-15.2"><circle r="11" /><circle r="5" /></g>
            <g class="pk mint" data-path="gh-svc" data-w="15.2-16.1"><circle r="11" /><circle r="5" /></g>
            <g class="pk" data-path="gh-pc" data-w="18.2-19.2"><circle r="11" /><circle r="5" /></g>
            <g class="pk orange" data-path="gh-ph" data-w="20.2-21.4" data-rev><circle r="11" /><circle r="5" /></g>
            <g class="pk mint" data-path="gh-ph" data-w="23-24"><circle r="11" /><circle r="5" /></g>
            <g class="pk coral" data-path="gh-bad" data-w="26-27.5"><circle r="11" /><circle r="5" /></g>
          </g>
        </svg>
      </div>

      <div class="gh-player">
        <ol class="chs">
          {chapters.map((c, i) => (
            <li><button class="ch" type="button" data-from={c.from} data-to={c.to} data-still={c.still} aria-current={i === 0 ? 'step' : undefined}>
              <span class="bar" aria-hidden="true"><i></i></span><span class="ch-t">{c.t}</span>
            </button></li>
          ))}
        </ol>
        <div class="now">
          {chapters.map((c, i) => <p class="now-d" hidden={i !== 0}><b class="now-k">{c.t}</b>{c.d}</p>)}
          <button class="pause" type="button" aria-pressed="false">
            <span class="i-pause"><Icon name="pause" size={18} /></span><span class="i-play"><Icon name="play" size={18} /></span>
            <span class="pause-t">일시정지</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gh {
    --sk: #9fb8de; --hi: #e6eefc; --mint: #63d6b4; --or: #f6882a; --violet: #a594f9; --coral: #ff6f61;
    background: var(--night); color: var(--on-night); padding: calc(96px + clamp(40px, 4vw, 72px)) 0 clamp(64px, 7vw, 104px);
  }
  .gh-top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 32px 64px; align-items: end; }
  .gh-eyebrow { font-size: clamp(16px, .3vw + 14px, 18px); font-weight: 600; color: var(--sk); }
  .gh-title { margin-top: 14px; font-size: clamp(32px, 3.2vw + 10px, 58px); line-height: 1.2; letter-spacing: -0.03em; font-weight: 700; }
  .gh-lead { font-size: clamp(16px, .4vw + 13px, 19px); line-height: 1.7; color: var(--on-night-2); }
  .gh-side .btn-row { margin-top: 28px; }

  /* the film: a blueprint sheet with a player bar */
  .gh-film {
    margin-top: clamp(40px, 4.5vw, 64px); border: 1px solid var(--night-line); border-radius: 20px; overflow: hidden;
    background-color: #0b1626;
    background-image: linear-gradient(rgba(159, 184, 222, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(159, 184, 222, .06) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .gh-stage { padding: 16px 20px 4px; overflow-x: auto; }
  .gh-stage svg { width: 100%; height: auto; overflow: visible; }
  html:not(.js) .gh-stage svg { min-width: 830px; }

  .guides path { fill: none; stroke: var(--sk); stroke-width: 1; opacity: .14; }
  .guides .tun-guide { stroke-dasharray: 4 6; opacity: .35; }
  .sketch path { fill: none; stroke: var(--sk); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sketch .thin { stroke-width: 1.3; opacity: .55; }
  .sketch .zone { stroke-width: 1.4; stroke-dasharray: 2 8; opacity: .45; }
  .sketch .zone.core { fill: rgba(54, 99, 153, .16); opacity: .8; }
  .sketch .wall { stroke-width: 3; stroke: var(--hi); }
  .sketch .wire { stroke-width: 1.6; opacity: .7; }
  .sketch .ghost { stroke: none; }

  /* states switched by the script */
  .sketch .st { transition: stroke .35s, fill .35s, opacity .35s, stroke-dashoffset 1.2s var(--ease); }
  .sketch .gw.on, .sketch .eng.on, .sketch .svc.on { stroke: var(--hi); stroke-width: 2.4; fill: rgba(230, 238, 252, .12); }
  .sketch .eng.violet.on { stroke: var(--violet); fill: rgba(165, 148, 249, .14); }
  .sketch .eng.warn { stroke: var(--or); fill: rgba(246, 136, 42, .14); }
  .sketch .pill.allow.on { stroke: var(--hi); fill: rgba(230, 238, 252, .14); }
  .sketch .pill.step.on { stroke: var(--or); fill: rgba(246, 136, 42, .16); }
  .sketch .pill.deny.on { stroke: var(--coral); fill: rgba(255, 111, 97, .16); }
  .sketch .tun { stroke: var(--hi); stroke-width: 2; stroke-dasharray: 1 1; stroke-dashoffset: 1; opacity: 0; }
  .sketch .tun.on { stroke-dashoffset: 0; opacity: 1; }
  .sketch .bind { stroke-width: 1.6; stroke-dasharray: 3 7; opacity: .5; }
  .sketch .bind.on { stroke: var(--mint); stroke-width: 2.2; stroke-dasharray: none; opacity: 1; }
  .sketch .qr, .sketch .scan { stroke: var(--hi); stroke-width: 1.8; }
  .sketch .scan, .sketch .ok-mint { stroke: var(--mint); stroke-width: 2.4; }
  .sketch .finger { stroke: var(--or); stroke-width: 1.8; }
  .sketch .bad path { stroke: var(--coral); stroke-dasharray: 4 5; }
  .sketch .bad .wire { opacity: 1; }
  .sketch .deny-x { stroke: var(--coral); stroke-width: 3; }
  .sketch .swash { stroke-width: 16; stroke-dasharray: 1 1; stroke-dashoffset: 1; opacity: 0; transition: stroke-dashoffset .7s var(--ease), opacity .3s; }
  .sketch .swash.on { stroke-dashoffset: 0; opacity: .28; }
  .sketch .swash.mint { stroke: var(--mint); }
  .sketch .swash.orange { stroke: var(--or); }
  .cue { opacity: 0; transition: opacity .35s; }
  .cue.on { opacity: 1; }

  .words text { fill: var(--hi); }
  .w-zone { font-size: 16px; font-weight: 600; fill: #8094b4 !important; }
  .w-t { font-size: 19px; font-weight: 600; }
  .w-s { font-size: 16px; fill: #8fa3c2 !important; }
  .w-e { font-size: 18px; font-weight: 600; }
  .w-e.violet { fill: #c9bffc; }
  .w-v { font-size: 17px; font-weight: 600; fill: #8fa3c2; transition: fill .35s; }
  .w-v.allow.on { fill: var(--hi); }
  .w-v.step.on { fill: var(--or); }
  .w-v.deny.on { fill: var(--coral); }
  .hw { font-family: 'Nanum Pen Script', 'Pretendard Variable', cursive; font-size: 27px; }
  .words .mint { fill: var(--mint); }
  .words .orange { fill: var(--or); }
  .words .coral { fill: var(--coral); }
  .tk { fill: none; stroke: var(--mint); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .pk { opacity: 0; color: #cfe3ff; }
  .pk.mint { color: var(--mint); }
  .pk.orange { color: var(--or); }
  .pk.coral { color: var(--coral); }
  .pk circle { fill: currentColor; }
  .pk circle:first-child { opacity: .22; }

  /* drawing in, once, on load */
  .js .gh-film:not(.still):not(.drawn) .ink { stroke-dasharray: 1 1; animation: gh-draw .9s var(--ease) var(--d, 0s) both; }
  .js .gh-film:not(.still):not(.drawn) .lbl { animation: gh-fade .6s var(--ease) calc(var(--d, 0s) + .35s) both; }
  .js .gh-film:not(.still):not(.drawn) .zone { animation: gh-fade .8s var(--ease) both; }
  .gh-film.paused .ink, .gh-film.paused .lbl, .gh-film.paused .zone { animation-play-state: paused; }
  @keyframes gh-draw { 0% { stroke-dashoffset: 1; opacity: 0; } 1% { opacity: 1; } 100% { stroke-dashoffset: 0; opacity: 1; } }
  @keyframes gh-fade { from { opacity: 0; } to { opacity: 1; } }

  /* player */
  .gh-player { border-top: 1px solid var(--night-line); padding: 16px 20px 18px; background: rgba(11, 22, 38, .86); }
  .chs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; }
  .ch { all: unset; box-sizing: border-box; display: grid; gap: 8px; width: 100%; padding: 6px 0; cursor: pointer; }
  .ch:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: 4px; }
  .bar { display: block; height: 3px; border-radius: 2px; background: rgba(159, 184, 222, .22); overflow: hidden; }
  .bar i { display: block; height: 100%; width: 100%; background: var(--hi); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .ch-t { font-size: 14px; font-weight: 600; color: #8fa3c2; transition: color .3s; }
  .ch[aria-current] .ch-t, .ch:hover .ch-t { color: var(--hi); }
  .now { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 10px; }
  .now-d { font-size: 15px; line-height: 1.6; color: var(--on-night-2); }
  .now-k { display: none; }
  .pause {
    flex: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px 0 10px; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--hi); border: 1px solid rgba(255, 255, 255, .24); font-size: 14px; font-weight: 600;
  }
  .pause:hover { border-color: #fff; }
  .pause:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  .i-pause, .i-play { display: inline-grid; }
  .i-play, .gh-film.paused .i-pause { display: none; }
  .gh-film.paused .i-play { display: inline-grid; }
  .gh-film.still .pause { display: none; }

  @media (max-width: 1023px) {
    .gh-top { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .gh-stage { padding: 12px 8px 0; }
    .gh-player { padding: 12px 16px 16px; }
    .ch { padding: 10px 0; }
    .ch-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .now { flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 4px; }
    .now-k { display: block; color: var(--hi); font-size: 15px; }
  }
</style>

<script>
  const film = document.querySelector<HTMLElement>('.gh-film');
  if (film) {
    const svg = film.querySelector('svg')!;
    const stage = film.querySelector<HTMLElement>('.gh-stage')!;
    const LOOP = 30.5, DRAW = 2.9, VW = 1200, VH = 540;
    // where the camera looks (stage x) from each moment on, used only when the stage is too narrow to show everything
    const CAM: [number, number][] = [[0, 860], [4, 190], [8.2, 320], [9.8, 600], [14, 850], [15.2, 1010], [18, 340], [19.4, 600], [20.4, 300], [23, 420], [24.2, 600], [25.6, 280], [27, 380]];
    const wins = (s?: string) => (s ? s.split(',').map((w) => w.split('-').map(Number)) : []);
    const within = (ws: number[][], t: number) => ws.some(([a, b]) => t >= a && t < b);
    const states = [...svg.querySelectorAll<SVGElement>('[data-t],[data-warn]')].map((el) => ({ el, on: wins(el.dataset.t), warn: wins(el.dataset.warn) }));
    const packets = [...svg.querySelectorAll<SVGGElement>('[data-path]')].map((el) => {
      const path = document.getElementById(el.dataset.path!) as unknown as SVGPathElement;
      const [a, b] = wins(el.dataset.w)[0];
      return { el, path, len: path.getTotalLength(), a, b, rev: el.hasAttribute('data-rev') };
    });
    const chapters = [...film.querySelectorAll<HTMLButtonElement>('.ch')].map((el) => ({ el, from: +el.dataset.from!, to: +el.dataset.to!, still: +el.dataset.still! }));
    const descs = [...film.querySelectorAll<HTMLElement>('.now-d')];
    const pauseBtn = film.querySelector<HTMLButtonElement>('.pause')!;
    const pauseT = film.querySelector<HTMLElement>('.pause-t')!;

    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let t = still ? 13.6 : -DRAW, playing = !still, onScreen = true, drawn = still, last = 0, raf = 0, viewW = VW, cx = 600;
    if (still) film.classList.add('still');

    const ease = (k: number) => (k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2);
    const camAt = () => CAM.reduce((x, [a, v]) => (t >= a ? v : x), CAM[0][1]);
    const fit = () => {
      const w = stage.clientWidth || VW;
      viewW = w < 830 ? Math.min(VW, Math.max(420, w / 0.72)) : VW; // 16-unit labels stay at 11px or more
    };

    function render(dt: number) {
      for (const s of states) { s.el.classList.toggle('on', within(s.on, t)); s.el.classList.toggle('warn', within(s.warn, t)); }
      for (const p of packets) {
        const k = (t - p.a) / (p.b - p.a);
        const show = k >= 0 && k <= 1;
        p.el.style.opacity = show ? '1' : '0';
        if (show) {
          const pt = p.path.getPointAtLength((p.rev ? 1 - ease(k) : ease(k)) * p.len);
          p.el.setAttribute('transform', `translate(${pt.x.toFixed(1)} ${pt.y.toFixed(1)})`);
        }
      }
      let cur = 0;
      chapters.forEach((c, i) => {
        c.el.style.setProperty('--p', String(Math.min(1, Math.max(0, (t - c.from) / (c.to - c.from)))));
        if (t >= c.from && t < c.to) cur = i;
      });
      chapters.forEach((c, i) => (i === cur ? c.el.setAttribute('aria-current', 'step') : c.el.removeAttribute('aria-current')));
      descs.forEach((d, i) => (d.hidden = i !== cur));
      if (viewW < VW) {
        const target = camAt();
        cx = dt < 0 ? target : cx + (target - cx) * (1 - Math.exp(-dt * 2.5));
        const x = Math.max(0, Math.min(VW - viewW, cx - viewW / 2));
        svg.setAttribute('viewBox', `${x.toFixed(1)} 0 ${viewW.toFixed(1)} ${VH}`);
      } else svg.setAttribute('viewBox', `0 0 ${VW} ${VH}`);
    }

    function frame(now: number) {
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      if (playing) { t += dt; if (t >= LOOP) t -= LOOP; }
      if (!drawn && t >= 0) { drawn = true; film!.classList.add('drawn'); }
      render(dt);
      raf = playing && onScreen ? requestAnimationFrame(frame) : 0;
    }
    const kick = () => { if (!raf && playing && onScreen) { last = 0; raf = requestAnimationFrame(frame); } };

    chapters.forEach((c) => c.el.addEventListener('click', () => {
      t = playing ? c.from : c.still;
      if (!drawn) { drawn = true; film.classList.add('drawn'); }
      render(-1);
    }));
    pauseBtn.addEventListener('click', () => {
      playing = !playing;
      film.classList.toggle('paused', !playing);
      pauseBtn.setAttribute('aria-pressed', String(!playing));
      pauseT.textContent = playing ? '일시정지' : '재생';
      kick();
    });
    new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; kick(); }).observe(film);
    new ResizeObserver(() => { fit(); render(-1); }).observe(stage);
    fit();
    render(-1);
    kick();
  }
</script>

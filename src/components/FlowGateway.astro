---
// Trust Gateway flow, looped every 6 s:
// device 1 + device 2 check each other -> a request travels into the gateway -> certificate, policy and context checks
// light up in turn -> the request continues through the secure tunnel to the business system.
import Icon from './Icon.astro';
---
<div class="fg" role="img" aria-label="PC와 휴대폰이 서로 확인한 요청만 Trust Gateway가 인증서, 정책, 상황을 차례로 확인한 뒤 보안 터널로 업무 시스템에 연결합니다.">
  <div class="pill">
    <div class="end">
      <span class="ico duo"><Icon name="laptop" size={22} /><Icon name="phone" size={18} class="ph2" /></span>
      <span class="txt"><b>1단말 · 2단말</b><small>PC와 휴대폰 교차 확인</small></span>
    </div>
    <div class="track">
      <span class="line"></span>
      <span class="pkt"></span>
      <span class="hub"><span class="ring"></span><Icon name="shield" size={26} /></span>
    </div>
    <div class="end right">
      <span class="txt"><b>업무 시스템</b><small>보안 터널로 연결</small></span>
      <span class="ico solid"><Icon name="server" size={22} /></span>
    </div>
  </div>
  <ul class="caps" aria-hidden="true"><li>1단말 · 2단말</li><li>Trust Gateway</li><li>업무 시스템</li></ul>
  <ul class="checks" aria-hidden="true">
    <li class="c1"><Icon name="check" size={14} />인증서 확인</li>
    <li class="c2"><Icon name="check" size={14} />정책 확인</li>
    <li class="c3"><Icon name="check" size={14} />상황 확인</li>
  </ul>
</div>

<style>
  .fg { --loop: 6s; max-width: 920px; margin: 0 auto; }
  .pill {
    display: flex; align-items: center; gap: 18px; padding: 18px 20px; border-radius: 999px; color: var(--ink);
    background: rgba(255,255,255,.95); box-shadow: 0 24px 60px rgba(12,30,70,.28), inset 0 0 0 1px rgba(255,255,255,.7);
  }
  .end { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; text-align: left; }
  .end.right { text-align: right; }
  .txt { display: grid; gap: 2px; }
  .txt b { font-size: 17px; font-weight: 700; letter-spacing: -0.02em; }
  .txt small { font-size: 13px; color: var(--ink-3); }
  .ico { position: relative; width: 52px; height: 52px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; }
  .ico.duo { background: #edf2fc; color: var(--blue); animation: fg-pair var(--loop) ease-in-out infinite; }
  .ico.duo :global(.ph2) { position: absolute; right: 6px; bottom: 7px; color: var(--orange); background: #edf2fc; border-radius: 4px; }
  .ico.solid { background: linear-gradient(145deg, #3d6fc6, #284f94); color: #fff; animation: fg-arrive var(--loop) ease-in-out infinite; }

  .track { position: relative; flex: 1; height: 64px; min-width: 120px; }
  .line { position: absolute; left: 0; right: 0; top: 50%; height: 2px; transform: translateY(-50%); border-radius: 2px;
    background: linear-gradient(90deg, rgba(54,99,153,.12), rgba(54,99,153,.45) 50%, rgba(54,99,153,.12)); }
  .pkt {
    position: absolute; top: 50%; left: 0; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%;
    background: var(--orange); box-shadow: 0 0 0 4px rgba(246,136,42,.18), 0 0 16px rgba(246,136,42,.8);
    animation: fg-pkt var(--loop) cubic-bezier(.45, 0, .25, 1) infinite;
  }
  .hub {
    position: absolute; left: 50%; top: 50%; width: 64px; height: 64px; margin: -32px 0 0 -32px; border-radius: 50%;
    display: grid; place-items: center; color: #fff; background: linear-gradient(145deg, #4b7fd6, #2a5197);
    box-shadow: 0 0 0 5px #fff, 0 10px 24px rgba(42,81,151,.35); animation: fg-hub var(--loop) ease-in-out infinite;
  }
  .ring { position: absolute; inset: -5px; border-radius: 50%; border: 2px solid rgba(75,127,214,.55); animation: fg-ring var(--loop) ease-out infinite; }

  .caps { display: none; }
  .checks { list-style: none; margin: 22px 0 0; padding: 0; display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; }
  .checks li {
    display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 999px; font-size: 14px; font-weight: 600;
    color: rgba(255,255,255,.75); background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.3);
    animation: fg-check var(--loop) ease-in-out infinite;
  }
  .checks li :global(svg) { color: rgba(255,255,255,.6); }
  .checks .c2 { animation-name: fg-check2; }
  .checks .c3 { animation-name: fg-check3; }

  /* one shared 6 s timeline: travel in (0-36%), checks (40-60%), travel out (62-90%), rest */
  @keyframes fg-pkt {
    0% { left: 0%; opacity: 0; } 6% { opacity: 1; } 36% { left: 50%; } 62% { left: 50%; } 90% { left: 100%; opacity: 1; } 96%, 100% { left: 100%; opacity: 0; }
  }
  @keyframes fg-pair { 0%, 100% { box-shadow: 0 0 0 0 rgba(54,99,153,0); } 4% { box-shadow: 0 0 0 6px rgba(54,99,153,.14); } 12% { box-shadow: 0 0 0 0 rgba(54,99,153,0); } }
  @keyframes fg-hub { 0%, 34%, 66%, 100% { transform: scale(1); } 42%, 58% { transform: scale(1.08); } }
  @keyframes fg-ring { 0%, 36% { transform: scale(1); opacity: 0; } 38% { opacity: .9; } 60% { transform: scale(1.7); opacity: 0; } 100% { opacity: 0; } }
  @keyframes fg-arrive { 0%, 86% { box-shadow: 0 0 0 0 rgba(61,111,198,0); } 92% { box-shadow: 0 0 0 8px rgba(61,111,198,.2); } 100% { box-shadow: 0 0 0 0 rgba(61,111,198,0); } }
  @keyframes fg-check { 0%, 40% { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); } 44%, 92% { background: #fff; color: var(--blue); } 100% { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); } }
  @keyframes fg-check2 { 0%, 47% { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); } 51%, 92% { background: #fff; color: var(--blue); } 100% { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); } }
  @keyframes fg-check3 { 0%, 54% { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); } 58%, 92% { background: #fff; color: var(--blue); } 100% { background: rgba(255,255,255,.12); color: rgba(255,255,255,.75); } }

  @media (max-width: 767px) {
    .pill { padding: 12px 14px; gap: 10px; }
    .txt { display: none; }
    .ico { width: 44px; height: 44px; }
    .hub { width: 52px; height: 52px; margin: -26px 0 0 -26px; }
    .caps { list-style: none; margin: 10px 0 0; padding: 0 6px; display: flex; justify-content: space-between; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.9); }
  }
  @media (prefers-reduced-motion: reduce) {
    .pkt, .ico, .hub, .ring, .checks li { animation: none !important; }
    .pkt { left: 50%; opacity: 0; }
    .checks li { background: #fff; color: var(--blue); }
  }
</style>

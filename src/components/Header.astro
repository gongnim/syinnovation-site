---
import { nav as navAll, cta as ctaAll, menu } from '../data/site';
import { langOf, twin, href, pagePath } from '../lib/i18n';
interface Props { tone?: 'night' | 'light' }
const { tone = 'night' } = Astro.props;
const lang = langOf(Astro.url);
const en = lang === 'en';
const nav = menu(navAll, lang);
const [cta] = menu([ctaAll], lang);
const home = href('/', lang);
const other = twin(Astro.url); // this page in the other language
const path = pagePath(Astro.url);
const bare = (h: string) => h.replace(/\/$/, '') || '/';
const isOn = (h: string) => { const x = bare(h); return path === x || (x !== '/' && x !== '/en' && path.startsWith(x + '/')); };
const KEY = href('/trust-gateway', lang); // the main product turns brand orange only while you are on its page (user, 2026-11-13)
---
<header class="hdr" data-tone={tone} data-scrolled="false" data-hidden="false">
  <div class="hdr-row">
    <div class="hdr-bar">
      <a href={home} class="brand" aria-label={en ? 'SYINNOVATION home' : '신영이노베이션 홈'}>
        <img src="/images/brand/syinnovation-logo-web.svg" alt="SYINNOVATION RE:Think innovation" width="300" height="57" />
      </a>
      <nav class="menu" aria-label={en ? 'Main menu' : '주요 메뉴'}>
        {nav.map((n) => n.children
          ? <div class="sub" data-open="false">
              <button type="button" class="sub-top" aria-expanded="false" aria-controls={`sub-${n.en.toLowerCase()}`} data-on={isOn(n.href) ? 'true' : undefined}>
                {n.label}<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </button>
              <div class="sub-panel" id={`sub-${n.en.toLowerCase()}`}>
                {n.children.map((c) => <a href={c.href} aria-current={path === bare(c.href) ? 'page' : undefined}>{c.label}</a>)}
              </div>
            </div>
          : <a href={n.href} class:list={{ key: n.href === KEY && isOn(n.href) }} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>)}
      </nav>
      <!-- Korean and English versions only. The current language is a mark, not a link (clicking it did nothing useful,
           user 2026-11-16); the other one links to this page's twin. -->
      <div class="lang" role="group" aria-label={en ? 'Language' : '언어'}>
        {en
          ? <><a lang="ko" href={other} hreflang="ko" title="한국어로 보기">KO</a><span lang="en" aria-current="true" title="Current language: English">EN</span></>
          : <><span lang="ko" aria-current="true" title="현재 언어: 한국어">KO</span><a lang="en" href={other} hreflang="en" title="View in English">EN</a></>}
      </div>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={en ? 'Open menu' : '메뉴 열기'} data-open-label={en ? 'Open menu' : '메뉴 열기'} data-close-label={en ? 'Close menu' : '메뉴 닫기'}>
        <span></span><span></span>
      </button>
    </div>
    <a class="hdr-cta" href={cta.href} aria-current={isOn(cta.href) ? 'page' : undefined}>{cta.label}</a>
  </div>
  <div class="mobile" id="mobile-menu" hidden>
    {nav.map((n) => n.children
      ? <div class="mobile-group">
          <span class="mobile-head">{n.label}</span>
          {n.children.map((c) => <a href={c.href} class="mobile-sub" aria-current={path === bare(c.href) ? 'page' : undefined}>{c.label}</a>)}
        </div>
      : <a href={n.href} class:list={{ key: n.href === KEY && isOn(n.href) }} aria-current={isOn(n.href) ? 'page' : undefined}>{n.label}</a>)}
    <div class="mobile-lang">{en
      ? <><a lang="ko" href={other} hreflang="ko">한국어</a><span lang="en" aria-current="true">English</span></>
      : <><span lang="ko" aria-current="true">한국어</span><a lang="en" href={other} hreflang="en">English</a></>}</div>
  </div>
</header>

<style>
  /* measurements follow packetgo.com's header: 24px from the top, max 1236px wide, 60-72px tall pill.
     The contact button sits outside the bar, on its right. */
  .hdr {
    /* the web logo (smaller symbol, larger text than the CI lockup) with its "RE:Think innovation" tagline */
    --logo-w: clamp(132px, 1.2vw + 122px, 150px);
    --bar-h: clamp(60px, 0.78vw + 57px, 72px);
    position: fixed; top: 24px; left: 50%; z-index: 50; width: min(100% - 40px, 1236px);
    transform: translate3d(-50%, 0, 0); transition: transform 520ms cubic-bezier(0.22, 0.65, 0.3, 1); will-change: transform;
  }
  .hdr[data-hidden='true'] { transform: translate3d(-50%, calc(-100% - 60px), 0); }
  .hdr-row { display: flex; align-items: center; gap: 12px; }
  .hdr-bar {
    flex: 1; min-width: 0; height: var(--bar-h);
    display: grid; grid-template-columns: var(--logo-w) minmax(0, 1fr) auto; align-items: center; column-gap: 24px;
    padding: 0 clamp(16px, 0.52vw + 14px, 24px); border-radius: 999px; border: 1px solid transparent;
    transition: background-color .5s var(--ease), border-color .5s var(--ease), color .5s var(--ease), box-shadow .5s var(--ease);
  }
  .hdr[data-tone='night'][data-scrolled='false'] .hdr-bar,
  :global(html.hero-dark) .hdr[data-tone='night'] .hdr-bar {
    background: rgba(22, 38, 60, 0.55); border-color: rgba(255,255,255,.08); color: var(--on-night);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 4px 8px rgba(0,0,0,.08);
  }
  .hdr[data-tone='light'] .hdr-bar, .hdr[data-scrolled='true'] .hdr-bar { background: #fff; border-color: var(--line); color: var(--ink); box-shadow: 0 4px 8px rgba(0,0,0,.06); }

  .brand { display: inline-flex; align-items: center; justify-self: start; width: var(--logo-w); }
  .brand img { display: block; width: 100%; height: auto; transition: filter .5s var(--ease); }
  /* the logo SVG is blue; on the dark bar it is shown white */
  .hdr[data-tone='night'][data-scrolled='false'] .brand img, :global(html.hero-dark) .hdr[data-tone='night'] .brand img { filter: brightness(0) invert(1); }

  .menu { display: flex; justify-content: center; align-items: center; gap: clamp(8px, 1vw + 4px, 28px); min-width: 0; }
  .menu a { font-size: 16px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.41; white-space: nowrap; padding: 6px clamp(10px, 0.2vw + 8px, 14px); border-radius: 999px; transition: opacity .2s, color .2s var(--ease), background-color .2s var(--ease); }
  .menu a:hover { opacity: .72; }
  /* the page you are on: a soft pill behind its name (Trust Gateway keeps its orange, so color alone never means "here") */
  .menu a[aria-current='page'], .sub-top[data-on='true'] { opacity: 1; background: rgba(255, 255, 255, .14); }
  .hdr[data-tone='light'] .menu a:hover, .hdr[data-scrolled='true'] .menu a:hover,
  .hdr[data-tone='light'] .menu a[aria-current='page'], .hdr[data-scrolled='true'] .menu a[aria-current='page'] { opacity: 1; color: var(--blue); background: var(--mist); }
  :global(html.hero-dark) .hdr .menu a:hover { color: inherit; opacity: .72; }

  /* 자료실: a menu button with a small white panel of its pages (opens on hover, on click or tap, and on focus) */
  .sub { position: relative; }
  .sub-top {
    display: inline-flex; align-items: center; gap: 4px; padding: 6px clamp(10px, 0.2vw + 8px, 14px); border: 0; border-radius: 999px; background: none;
    font: inherit; font-size: 16px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.41; color: inherit; white-space: nowrap; cursor: pointer;
    transition: opacity .2s, color .2s var(--ease), background-color .2s var(--ease);
  }
  .sub-top svg { transition: rotate .25s var(--ease); }
  .sub[data-open='true'] .sub-top svg { rotate: 180deg; }
  .sub-top:hover { opacity: .72; }
  .hdr[data-tone='light'] .sub-top:hover, .hdr[data-scrolled='true'] .sub-top:hover,
  .hdr[data-tone='light'] .sub-top[data-on='true'], .hdr[data-scrolled='true'] .sub-top[data-on='true'] { opacity: 1; color: var(--blue); background: var(--mist); }
  :global(html.hero-dark) .hdr .sub-top:hover { color: inherit; opacity: .72; }
  .sub-panel {
    position: absolute; top: calc(100% + 22px); left: 50%; min-width: 148px; padding: 8px; display: grid; gap: 2px;
    background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 16px; box-shadow: 0 16px 40px rgba(25,31,40,.12);
    opacity: 0; visibility: hidden; transform: translate(-50%, -6px); transition: opacity .2s var(--ease), transform .2s var(--ease), visibility .2s;
  }
  /* an invisible bridge over the gap, so moving the mouse down to the panel keeps it open */
  .sub-panel::before { content: ''; position: absolute; left: 0; right: 0; top: -24px; height: 24px; }
  .sub[data-open='true'] .sub-panel, .sub:focus-within .sub-panel { opacity: 1; visibility: visible; transform: translate(-50%, 0); }
  @media (hover: hover) { .sub:hover .sub-panel { opacity: 1; visibility: visible; transform: translate(-50%, 0); } }
  .sub-panel a { display: block; padding: 10px 14px; border-radius: 10px; font-size: 15px; font-weight: 500; white-space: nowrap; color: var(--ink); opacity: 1; }
  .hdr .sub-panel a:hover { background: var(--mist); color: var(--ink); opacity: 1; }
  .hdr .sub-panel a[aria-current='page'] { color: var(--blue); font-weight: 600; opacity: 1; }
  /* Trust Gateway, the main product, in brand orange (a deeper orange on white for legibility) */
  .menu a.key, .mobile a.key { color: var(--orange); font-weight: 600; }
  .hdr[data-tone='light'] .menu a.key, .hdr[data-scrolled='true'] .menu a.key, .mobile a.key { color: #e06c12; }
  :global(html.hero-dark) .hdr .menu a.key { color: var(--orange); }

  .lang { display: flex; align-items: center; gap: 2px; font-size: 13px; font-weight: 600; letter-spacing: 0.02em; }
  .lang > * { padding: 6px 8px; border-radius: 999px; }
  /* the language you are reading is marked like the current menu item; the other one is dimmed until pointed at (user, 2026-11-16) */
  .lang [aria-current='true'] { opacity: 1; cursor: default; background: rgba(255, 255, 255, .14); }
  .lang a { opacity: .5; transition: opacity .2s; }
  .lang a:hover, .lang a:focus-visible { opacity: 1; }
  .hdr[data-tone='light'] .lang [aria-current='true'], .hdr[data-scrolled='true'] .lang [aria-current='true'] { color: var(--blue); background: var(--mist); }
  .lang [aria-disabled='true'] { opacity: .42; cursor: default; }

  /* same size as PacketGo's 접속하기 (136 x 46) */
  .hdr-cta {
    flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; height: 46px; min-width: 136px; padding: 0 24px; border-radius: 999px;
    background: var(--orange); color: #fff; font-size: 15px; font-weight: 600; letter-spacing: -0.02em; white-space: nowrap;
    box-shadow: 0 4px 12px rgba(246,136,42,.28); transition: background-color .2s var(--ease);
  }
  .hdr-cta:hover, .hdr-cta[aria-current='page'] { background: #e5761c; }

  .burger { display: none; justify-self: end; width: 44px; height: 44px; border: 0; background: transparent; color: inherit; cursor: pointer; position: relative; }
  .burger span { position: absolute; left: 12px; right: 12px; height: 2px; background: currentColor; border-radius: 2px; transition: transform .3s var(--ease); }
  .burger span:first-child { top: 18px; } .burger span:last-child { top: 24px; }
  .burger[aria-expanded='true'] span:first-child { transform: translateY(3px) rotate(45deg); }
  .burger[aria-expanded='true'] span:last-child { transform: translateY(-3px) rotate(-45deg); }
  .mobile { margin-top: 12px; background: #fff; color: var(--ink); border: 1px solid var(--line); border-radius: 24px; padding: 8px; box-shadow: 0 16px 40px rgba(25,31,40,.12); }
  .mobile a { display: block; padding: 14px 16px; border-radius: 14px; font-weight: 600; }
  .mobile a[aria-current='page'] { background: var(--mist); }
  .mobile-head { display: block; padding: 14px 16px 6px; font-weight: 600; }
  .mobile a.mobile-sub { padding: 10px 16px 10px 32px; font-weight: 500; color: var(--ink-2); }
  .mobile a.mobile-sub[aria-current='page'] { color: var(--ink); }
  .mobile-lang { display: flex; gap: 8px; padding: 10px 16px 6px; border-top: 1px solid var(--line); margin-top: 6px; font-size: 14px; font-weight: 600; }
  .mobile-lang > * { padding: 4px 10px; border-radius: 999px; }
  .mobile-lang [aria-current='true'] { color: var(--blue); background: var(--mist); }
  .mobile-lang a { color: var(--ink-3); }
  .mobile-lang [aria-disabled='true'] { color: var(--ink-3); }
  /* the English menu is longer than the Korean one: just above the burger width it ran into the logo and the
     language switch (user, 2026-11-17), so it sits tighter there */
  @media (min-width: 1024px) and (max-width: 1199px) {
    :global(html[lang='en']) .menu { gap: 2px; }
    :global(html[lang='en']) .menu a, :global(html[lang='en']) .sub-top { padding-inline: 8px; font-size: 15px; }
  }
  @media (max-width: 1023px) {
    .hdr { --logo-w: 124px; }
    .hdr-bar { grid-template-columns: var(--logo-w) 1fr auto; column-gap: 8px; }
    .menu, .lang { display: none; }
    .burger { display: block; grid-column: 3; }
    .hdr-cta { height: 42px; min-width: 0; padding: 0 16px; font-size: 14px; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('.hdr');
  const burger = document.querySelector<HTMLButtonElement>('.burger');
  const panel = document.getElementById('mobile-menu');
  if (hdr) {
    // like PacketGo: hide while scrolling down, show again on any scroll up or near the top
    let anchor = Math.max(0, scrollY), frame = 0;
    const sync = () => {
      frame = 0;
      const y = Math.max(0, scrollY), d = y - anchor;
      hdr.dataset.scrolled = y > 40 ? 'true' : 'false';
      if (y <= 4 || burger?.getAttribute('aria-expanded') === 'true') { hdr.dataset.hidden = 'false'; anchor = y; }
      else if (d >= 4) { hdr.dataset.hidden = 'true'; anchor = y; }
      else if (d <= -4) { hdr.dataset.hidden = 'false'; anchor = y; }
    };
    sync();
    addEventListener('scroll', () => { if (!frame) frame = requestAnimationFrame(sync); }, { passive: true });
    hdr.addEventListener('focusin', () => { hdr.dataset.hidden = 'false'; });
  }
  // 자료실 sub-menu: the button opens and closes it; a click elsewhere or Esc closes it
  // (only the header's own sub-menus: other parts of a page may use a class named sub too)
  document.querySelectorAll<HTMLElement>('.hdr .sub').forEach((sub) => {
    const top = sub.querySelector<HTMLButtonElement>('.sub-top');
    if (!top) return;
    const set = (open: boolean) => { sub.dataset.open = String(open); top.setAttribute('aria-expanded', String(open)); };
    top.addEventListener('click', () => set(sub.dataset.open !== 'true'));
    document.addEventListener('click', (e) => { if (!sub.contains(e.target as Node)) set(false); });
    sub.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); top.focus(); } });
  });
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', (open ? burger.dataset.openLabel : burger.dataset.closeLabel) ?? '');
    if (panel) panel.hidden = open;
    if (hdr) hdr.dataset.hidden = 'false';
  });
</script>

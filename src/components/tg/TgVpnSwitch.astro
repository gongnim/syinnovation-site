---
// Trust Gateway page: what one leaked account opens, with a switch between a classic VPN and Trust Gateway.
// On first view the VPN case plays (the servers open one by one), then it switches to Trust Gateway once, unless the
// visitor already picked a side. The table under it says the same thing in words.
import Icon from '../Icon.astro';
import { langOf } from '../../lib/i18n';
const en = langOf(Astro.url) === 'en';

const servers = en ? ['Groupware', 'HR system', 'Accounting', 'Customer DB', 'Dev server', 'File server'] : ['그룹웨어', '인사 시스템', '회계', '고객 DB', '개발 서버', '파일 서버'];
const compare = en ? [
  { k: 'When it checks', vpn: 'Once, at first connection', tg: 'At every moment (each time a work screen opens)' },
  { k: 'What opens', vpn: 'The whole internal network', tg: 'Only allowed apps and paths' },
  { k: 'Identity verification', vpn: 'ID and password', tg: 'Device certificate + biometric check on the phone' },
  { k: 'Location check', vpn: 'None', tg: 'Multi-Signal Cross Check of PC · phone · network' },
  { k: 'External exposure', vpn: 'The VPN appliance is open to the internet', tg: 'No inbound ports to the internal network are visible' },
] : [
  { k: '확인 시점', vpn: '처음 접속할 때 한 번', tg: '매 순간 (업무 화면을 열 때마다)' },
  { k: '열리는 범위', vpn: '사내망 전체', tg: '허락된 앱과 경로만' },
  { k: '본인 확인', vpn: '아이디와 비밀번호', tg: '기기 인증서 + 휴대폰 생체 확인' },
  { k: '위치 확인', vpn: '없음', tg: 'PC · 휴대폰 · 네트워크 다중 신호 교차 검증' },
  { k: '외부 노출', vpn: 'VPN 장비가 인터넷에 열려 있음', tg: '사내망으로 들어오는 포트가 보이지 않음' },
];
---
<section class="section mist" id="vpn">
  <div class="wrap">
    <div class="head-center reveal">
      <h2 class="h2">{en ? <>If one account leaks, <br />how much opens up?</> : <>계정 하나가 유출되면, <br />어디까지 열릴까요?</>}</h2>
      <p class="lead">{en ? <>Say someone gets in with a stolen employee account. <br />Switch between a classic VPN and Trust Gateway.</> : <>도용된 직원 계정으로 들어온다고 해 봅시다. <br />기존 VPN과 Trust Gateway를 바꿔 가며 보세요.</>}</p>
    </div>

    <div class="vs reveal" data-mode="vpn">
      <div class="vs-tabs" role="group" aria-label={en ? 'Compare' : '비교 대상'}>
        <button type="button" data-m="vpn" aria-pressed="true">{en ? <>Classic VPN</> : <>기존 VPN</>}</button>
        <button type="button" data-m="tg" aria-pressed="false">Trust Gateway</button>
      </div>

      <div class="stage">
        <div class="who">
          <span class="ico"><Icon name="user" size={22} /></span>
          <b>{en ? <>Stolen employee account</> : <>도용된 직원 계정</>}</b>
          <ul>
            <li class="ok"><Icon name="check" size={16} />{en ? <>ID · password</> : <>아이디 · 비밀번호</>}</li>
            <li class="no only-tg">{en ? <>No device certificate</> : <>기기 인증서 없음</>}</li>
            <li class="no only-tg">{en ? <>No biometric check on phone</> : <>휴대폰 생체 확인 없음</>}</li>
          </ul>
        </div>
        <div class="pipe in"><i></i><span class="blk only-tg" aria-hidden="true"></span></div>
        <div class="gate">
          <span class="ico"><Icon name="shield" size={22} /></span>
          <b><span class="only-vpn">{en ? <>VPN appliance</> : <>VPN 장비</>}</span><span class="only-tg">Trust Gateway</span></b>
          <span class="g-s only-vpn">{en ? <>One login gets you through</> : <>로그인 한 번이면 통과</>}</span>
          <span class="g-s only-tg">{en ? <>Blocked here if not verified</> : <>확인 안 되면 여기서 차단</>}</span>
        </div>
        <div class="pipe out"><i></i></div>
        <div class="net">
          <p class="net-t">{en ? <>Internal network</> : <>사내망</>}</p>
          <ul class="srv">
            {servers.map((s, i) => (
              <li style={`--i:${i}`}><Icon name="server" size={18} /><span>{s}</span><em class="only-vpn">{en ? <>Open</> : <>열림</>}</em><em class="only-tg">{en ? <>Not visible</> : <>보이지 않음</>}</em></li>
            ))}
          </ul>
        </div>
        <!-- going around Trust Gateway straight to 사내망 finds nothing (user, 2026-11-16): the script draws the detour from
             the account's box to the network's edge; on narrow screens a one-line note stands in -->
        <div class="bp only-tg" aria-hidden="true">
          <svg class="bp-svg"><path d="" /></svg>
          <i class="bp-dot"></i>
          <span class="bp-x"></span>
          <span class="bp-t1">{en ? <>Going around Trust Gateway to the internal network</> : <>Trust Gateway를 건너뛰고 사내망으로 바로 가 보면</>}</span>
          <span class="bp-t2">{en ? <>No ports visible from outside</> : <>바깥에서 포트가 보이지 않음</>}</span>
        </div>
        <p class="bp-m only-tg" aria-hidden="true"><span class="bp-mx"></span>{en ? <>Even if you skip Trust Gateway and go straight in, no ports are visible from outside</> : <>Trust Gateway를 건너뛰고 바로 가 봐도 바깥에서 포트가 보이지 않습니다</>}</p>
      </div>

      <p class="cap">
        <span class="only-vpn">{en ? <>With a VPN, once you are in, the whole internal network is visible. One account can move on to neighboring servers.</> : <>VPN은 한 번 들어오면 사내망 전체가 보입니다. 계정 하나로 옆 서버까지 넘어갈 수 있습니다.</>}</span>
        <span class="only-tg">{en ? <>Without a device certificate and a phone check, the stolen account stops at the gateway. Even if you skip the gateway and go straight to the internal network, no ports are visible from outside. Even when the real employee connects, only allowed apps open.</> : <>기기 인증서와 휴대폰 확인이 없으면 게이트웨이에서 멈춥니다. 게이트웨이를 건너뛰고 사내망으로 바로 가 봐도 바깥에서 포트가 보이지 않습니다. 직원 본인이 접속해도 허락된 앱만 열립니다.</>}</span>
      </p>

      <div class="cmp-wrap">
        <table class="cmp">
          <thead><tr><th scope="col">{en ? <>Item</> : <>항목</>}</th><th scope="col" class="c-vpn">{en ? <>Classic VPN</> : <>기존 VPN</>}</th><th scope="col" class="c-tg">Trust Gateway</th></tr></thead>
          <tbody>{compare.map((c) => (<tr><th scope="row">{c.k}</th><td class="c-vpn">{c.vpn}</td><td class="c-tg">{c.tg}</td></tr>))}</tbody>
        </table>
      </div>
    </div>
  </div>
</section>

<style>
  .vs { --coral: #d4553f; max-width: 1040px; margin: 0 auto; background: #fff; border-radius: var(--r-xl); padding: clamp(20px, 3vw, 36px); }
  .vs-tabs { display: flex; gap: 6px; padding: 6px; margin: 0 auto 28px; width: fit-content; background: var(--paper-2); border-radius: 999px; }
  .vs-tabs button { border: 0; background: transparent; padding: 10px 22px; border-radius: 999px; font: inherit; font-weight: 600; color: var(--ink-2); white-space: nowrap; cursor: pointer; transition: background-color .3s var(--ease), color .3s var(--ease); }
  /* on a phone "Classic VPN" broke onto two lines inside its pill */
  @media (max-width: 400px) { .vs-tabs button { padding: 10px 16px; } }
  .vs-tabs button[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .vs-tabs button:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }

  /* only-vpn / only-tg pieces follow the mode */
  .vs[data-mode='vpn'] .only-tg, .vs[data-mode='tg'] .only-vpn { display: none; }

  /* the bottom padding is room for the detour drawn in Trust Gateway mode (kept in both modes so switching does not move the page) */
  .stage { position: relative; padding-bottom: 64px; display: grid; grid-template-columns: minmax(0, 200px) minmax(32px, 1fr) minmax(0, 190px) minmax(32px, 1fr) minmax(0, 330px); align-items: center; }
  .who, .gate { position: relative; display: grid; gap: 8px; justify-items: start; padding: 18px; border-radius: var(--r-lg); border: 1px solid var(--line); background: var(--paper-2); }
  .ico { width: 40px; height: 40px; border-radius: 12px; display: grid; place-items: center; background: #fff; color: var(--ink-2); border: 1px solid var(--line); }
  .who b, .gate b { font-size: 16px; }
  .who ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: 14px; }
  .who li { display: flex; align-items: center; gap: 6px; color: var(--ink-2); }
  .who .ok :global(svg) { color: #2e9a7a; }
  .who .no { color: var(--coral); }
  .who .no::before { content: '✕'; width: 16px; text-align: center; font-size: 12px; font-weight: 800; }
  .g-s { font-size: 14px; color: var(--ink-2); }
  .vs[data-mode='tg'] .gate { border: 2px solid var(--blue); background: var(--mist); }
  .vs[data-mode='tg'] .gate .ico { color: var(--blue); }
  /* the stolen account's path ends at a red X in front of the gate (CEO, 2026-11-16: an X on Trust Gateway itself read as
     "Trust Gateway fails"); the dot runs into it */
  .blk { position: absolute; z-index: 1; right: 0; top: 50%; width: 24px; height: 24px; margin-top: -12px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 4px #fff; }
  .blk::before, .blk::after { content: ''; position: absolute; left: 6px; top: 11px; width: 12px; height: 2px; background: #fff; transform: rotate(45deg); }
  .blk::after { transform: rotate(-45deg); }

  /* a pipe with a dot travelling along it; the second pipe is cut in Trust Gateway mode */
  .pipe { position: relative; height: 2px; margin: 0 8px; background: #e7c3bd; }
  .pipe i { position: absolute; top: -4px; left: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--coral); opacity: 0; }
  .vs.play .pipe.in i, .vs.play[data-mode='vpn'] .pipe.out i { animation: travel 1.6s linear infinite; }
  .vs.play[data-mode='vpn'] .pipe.out i { animation-delay: .8s; }
  .vs[data-mode='tg'] .pipe.out { background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 12px); }
  @keyframes travel { 0% { left: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { left: calc(100% - 10px); opacity: 0; } }

  /* the detour: --path, --gx, --nx, --nb, --y come from the script */
  .bp { position: absolute; inset: 0; pointer-events: none; }
  .bp-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .bp-svg path { fill: none; stroke: #e7c3bd; stroke-width: 2; stroke-dasharray: 6 6; }
  .bp-dot { position: absolute; left: 0; top: 0; width: 10px; height: 10px; border-radius: 50%; background: var(--coral); opacity: 0; offset-path: var(--path); offset-anchor: 50% 50%; offset-rotate: 0deg; }
  .vs.play[data-mode='tg'] .bp-dot { animation: bp-run 2.6s linear infinite; }
  @keyframes bp-run { 0% { offset-distance: 0%; opacity: 0; } 8% { opacity: 1; } 90% { opacity: 1; } 100% { offset-distance: 100%; opacity: 0; } }
  .bp-x, .bp-mx { width: 24px; height: 24px; border-radius: 50%; background: var(--coral); box-shadow: 0 0 0 4px #fff; }
  .bp-x { position: absolute; z-index: 1; left: var(--nx); top: var(--nb); transform: translate(-50%, -50%); }
  .bp-x::before, .bp-x::after, .bp-mx::before, .bp-mx::after { content: ''; position: absolute; left: 6px; top: 11px; width: 12px; height: 2px; background: #fff; transform: rotate(45deg); }
  .bp-x::after, .bp-mx::after { transform: rotate(-45deg); }
  .bp-t1, .bp-t2 { position: absolute; white-space: nowrap; font-size: 13px; font-weight: 600; color: #b5473a; }
  .bp-t1 { left: var(--gx); top: var(--y); transform: translate(-50%, calc(-100% - 6px)); }
  .bp-t2 { left: var(--nx); top: var(--y); transform: translate(-50%, 6px); }
  .bp-m { display: none; }
  .net { border: 1px dashed var(--ink-3); border-radius: var(--r-lg); padding: 14px; }
  .net-t { font-size: 14px; font-weight: 700; color: var(--ink-3); margin-bottom: 10px; }
  .srv { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .srv li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 2px 8px; align-items: center; padding: 10px 12px; border-radius: var(--r-md); border: 1px solid var(--line); background: #fff; font-size: 14px; font-weight: 600; transition: background-color .4s var(--ease), border-color .4s var(--ease), color .4s var(--ease), opacity .4s var(--ease); }
  .srv li :global(svg) { grid-row: span 2; color: var(--ink-3); }
  .srv em { font-style: normal; font-size: 12px; font-weight: 600; color: var(--ink-3); }
  .vs[data-mode='vpn'] .srv li { background: #fdf0ee; border-color: #efb9b0; color: #8e2f22; transition-delay: calc(var(--i) * .22s); }
  .vs[data-mode='vpn'] .srv em, .vs[data-mode='vpn'] .srv li :global(svg) { color: var(--coral); }
  .vs[data-mode='tg'] .srv li { opacity: .45; border-style: dashed; }
  /* with scripts, the servers wait until the section comes into view before opening */
  :global(html.js) .vs:not(.play) .srv li { background: #fff; border-color: var(--line); color: var(--ink); }
  :global(html.js) .vs:not(.play) .srv em { visibility: hidden; }

  .cap { margin: 22px auto 0; max-width: 640px; text-align: center; font-weight: 600; line-height: 1.6; }
  .vs[data-mode='vpn'] .cap { color: #8e2f22; }
  .vs[data-mode='tg'] .cap { color: var(--blue-deep); }

  .cmp-wrap { overflow-x: auto; margin-top: 28px; }
  .cmp { width: 100%; border-collapse: collapse; min-width: 560px; }
  .cmp th, .cmp td { text-align: left; padding: 16px; border-bottom: 1px solid var(--line); vertical-align: top; transition: background-color .4s var(--ease), color .4s var(--ease); }
  .cmp thead th { font-size: 14px; color: var(--ink-3); font-weight: 600; }
  .cmp tbody th { font-weight: 700; width: 22%; }
  .cmp td { color: var(--ink-3); }
  .vs[data-mode='vpn'] td.c-vpn { color: #8e2f22; font-weight: 600; background: #fdf0ee; }
  .vs[data-mode='vpn'] th.c-vpn { color: #8e2f22; }
  .vs[data-mode='tg'] td.c-tg { color: var(--ink); font-weight: 600; background: var(--orange-soft); }
  .vs[data-mode='tg'] th.c-tg { color: var(--blue); }

  @media (max-width: 860px) {
    .stage { grid-template-columns: minmax(0, 1fr); justify-items: stretch; padding-bottom: 0; }
    .bp { display: none; }
    .bp-m { display: flex; align-items: center; gap: 10px; margin: 14px 0 0; font-size: 14px; font-weight: 600; color: #b5473a; }
    .bp-mx { position: relative; flex: none; }
    .pipe { width: 2px; height: 36px; margin: 8px auto; }
    .pipe i { top: 0; left: -4px; }
    .blk { right: auto; top: auto; bottom: 0; left: -11px; margin-top: 0; }
    .vs.play .pipe.in i, .vs.play[data-mode='vpn'] .pipe.out i { animation-name: travel-down; }
    .vs[data-mode='tg'] .pipe.out { background: repeating-linear-gradient(180deg, var(--line) 0 6px, transparent 6px 12px); }
    @keyframes travel-down { 0% { top: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { top: calc(100% - 10px); opacity: 0; } }
  }
  @media (max-width: 767px) {
    .head-center .lead br { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pipe i, .bp-dot { display: none; }
    .srv li, .cmp th, .cmp td { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.vs').forEach((vs) => {
    const btns = [...vs.querySelectorAll<HTMLButtonElement>('[data-m]')];
    let touched = false;
    // the detour from the account's box, under the gate, to the bottom edge of 사내망 (wide layout only)
    const stage = vs.querySelector<HTMLElement>('.stage')!;
    const bp = stage.querySelector<HTMLElement>('.bp')!;
    const draw = () => {
      const s = stage.getBoundingClientRect();
      const box = (sel: string) => { const b = stage.querySelector(sel)!.getBoundingClientRect(); return { cx: (b.left + b.right) / 2 - s.left, b: b.bottom - s.top }; };
      const who = box('.who'), gate = box('.gate'), net = box('.net');
      if (!s.width || Math.abs(who.cx - net.cx) < 40) return; // stacked: the note stands in
      const y = Math.round(Math.max(who.b, net.b) + 30);
      const d = `M${Math.round(who.cx)} ${Math.round(who.b + 6)} V${y} H${Math.round(net.cx)} V${Math.round(net.b)}`;
      bp.querySelector('path')!.setAttribute('d', d);
      Object.entries({ '--path': `path('${d}')`, '--gx': `${gate.cx}px`, '--nx': `${net.cx}px`, '--nb': `${net.b}px`, '--y': `${y}px` }).forEach(([k, v]) => bp.style.setProperty(k, v));
    };
    draw();
    new ResizeObserver(draw).observe(stage);
    const set = (m: string) => { vs.dataset.mode = m; btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.m === m))); draw(); };
    btns.forEach((b) => b.addEventListener('click', () => { touched = true; vs.classList.add('play'); set(b.dataset.m!); }));
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      vs.classList.add('play');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) setTimeout(() => { if (!touched) set('tg'); }, 4600);
    }, { threshold: 0.25 }).observe(vs);
  });
</script>

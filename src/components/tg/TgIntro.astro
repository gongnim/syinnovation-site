<script>
  // one clock for the whole story: every element with data-tl gets a Web Animation of the same length, so they all stay
  // in step. The chapters follow the clock and a click jumps there; the pointer on the box or scrolling away pauses it.
  type Step = [number, Record<string, string | number>];
  const hero = document.querySelector<HTMLElement>('.tg-hero');
  if (hero) {
    const T = Number(hero.dataset.t);
    const areas = Number(hero.dataset.areas);
    const chapters = JSON.parse(hero.dataset.chapters!) as { area: number; hold: [number, number] }[];
    const lis = [...hero.querySelectorAll<HTMLLIElement>('.flow li')];
    const caps = [...hero.querySelectorAll<HTMLElement>('.cap')];
    const panes = [...hero.querySelectorAll<HTMLElement>('.pane')];
    const world = hero.querySelector<HTMLElement>('.world')!;
    const mark = (cur: number) => lis.forEach((li, i) => {
      li.classList.toggle('on', i === cur); li.classList.toggle('done', i < cur);
      li.querySelector('button')!.setAttribute('aria-pressed', String(i === cur));
    });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // without motion: each chapter at once, its place on the street, its panel and its caption
      lis.forEach((li, n) => li.querySelector('button')!.addEventListener('click', () => {
        world.style.transform = `translateX(${(-(chapters[n].area * 100) / areas).toFixed(4)}%)`;
        caps.forEach((c, i) => c.classList.toggle('still', i === n));
        panes[0].classList.toggle('still', n === 3); panes[1].classList.toggle('still', n === 5);
        mark(n);
      }));
    } else {
      const anims = [...hero.querySelectorAll<HTMLElement>('[data-tl]')].map((el) => {
        const steps = JSON.parse(el.dataset.tl!) as Step[];
        const kf: Keyframe[] = steps.map(([t, p]) => ({ ...p, offset: Math.min(1, Math.max(0, t / T)) }));
        if (kf[0].offset! > 0) kf.unshift({ ...steps[0][1], offset: 0 });
        if (kf[kf.length - 1].offset! < 1) kf.push({ ...steps[steps.length - 1][1], offset: 1 });
        return el.animate(kf, { duration: T * 1000, iterations: Infinity, fill: 'both' });
      });
      caps.forEach((c) => c.classList.remove('still'));
      panes.forEach((p) => p.classList.remove('still'));
      const clock = anims[0];
      let raf = 0, shown = -1;
      const follow = () => {
        const t = (((Number(clock.currentTime) || 0) / 1000) % T + T) % T;
        let cur = 0;
        chapters.forEach((c, i) => { if (t >= (i === 0 ? 0 : chapters[i - 1].hold[1])) cur = i; });
        lis.forEach((li, i) => { const [a, b] = chapters[i].hold; li.style.setProperty('--p', String(Math.min(1, Math.max(0, (t - a) / (b - a))))); });
        if (cur !== shown) { mark(cur); shown = cur; }
        raf = requestAnimationFrame(follow);
      };
      const jump = (i: number) => anims.forEach((a) => { a.currentTime = Math.max(0, chapters[i].hold[0] - 0.2) * 1000; });
      lis.forEach((li, i) => li.querySelector('button')!.addEventListener('click', () => jump(i)));
      let hover = false, seen = true;
      const sync = () => {
        const run = !hover && seen;
        anims.forEach((a) => (run ? a.play() : a.pause()));
        hero.classList.toggle('paused', !run);
        cancelAnimationFrame(raf);
        if (run) raf = requestAnimationFrame(follow);
      };
      hero.querySelectorAll('.show, .flow').forEach((el) => {
        el.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { hover = true; sync(); } });
        el.addEventListener('pointerleave', () => { hover = false; sync(); });
      });
      new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }).observe(hero);
    }
  }
</script>

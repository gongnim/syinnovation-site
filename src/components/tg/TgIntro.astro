<script is:inline>
  (() => {
    const h = document.querySelector('.tg-hero');
    if (!h || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    h.querySelector('.world').style.transform = 'none';
    h.querySelectorAll('.still').forEach((e) => e.classList.remove('still'));
    h.querySelector('.cap').classList.add('still');
    h.querySelectorAll('.flow li').forEach((li, i) => {
      li.classList.toggle('on', i === 0); li.classList.remove('done');
      li.querySelector('button').setAttribute('aria-pressed', String(i === 0));
    });
  })();
</script>


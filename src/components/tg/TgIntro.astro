---
// /trust-gateway hero (user, 2026-11-16): in the brand's night colours like /consulting. The title stays as the user set
// it; the lead says in plain words what it does. The box on the right is ONE continuous animated story, A to Z, drawn in
// code (user chose "A안": people type, a finger taps the phone, cars drive, barriers lift, and it holds still while a
// panel explains). One long night street the camera flies along, nine chapters and an ending (user: the steps gather
// into a shield, "이것이 Trust Gateway입니다"):
//   출발 (office: registered PC, phone fingerprint, then the two check each other) · 밖에서도 (cafe: PC and phone send Wi-Fi, location, time zone) ·
//   연결 (road: requests drive to the gate over a mutually authenticated encrypted link, a suspicious one weaves) ·
//   신호 대조 (panel: 다중 신호 교차 검증, PC and phone signals compared) · 판정 (three lanes; each car hands in its ticket,
//   the device certificate, and the one without gets 거부: 허용, 추가 인증, 거부) ·
//   평소와 다를 때 (panel: PC and phone point to different countries) · 회사 안으로 (no door on the outside, drones bounce;
//   the request comes in by the way the company's agent opened from inside) · 도착 (only permitted rooms open) ·
//   기록 (the decision is stored with its reasons; the admin sees it in the console).
// Facts follow tech doc v0.4.3 (5.1 signals, 5.2 contradictions, 5.3 engines, 5.4 response: a refused step-up denies
// that request only; revocation only in the highest risk band). No risk scores or thresholds. One clock: every element
// with data-tl gets a Web Animation of length T; small loops (typing, wheels, drones, Wi-Fi) are CSS. The steps under the
// hero follow the clock and a click jumps there; the pointer on the box or scrolling away pauses it. Reduced motion or no
// JavaScript: the 신호 대조 chapter, still. Earlier versions: TgLanes.astro (live lanes map); the AI island stills in
// public/images/trust-gateway/world are not used.
import Icon from '../Icon.astro';
import ConsultBtn from '../ConsultBtn.astro';
import Person from './intro/Person.astro';
import Car from './intro/Car.astro';
import { langOf } from '../../lib/i18n';
const en = langOf(Astro.url) === 'en';

const T = 93; // seconds, one round
const W = 4800, H = 400, AREAS = 8; // the street: eight 600 x 400 areas, the last one is the ending
const at = (x: number, y: number) => ({ left: `${((x / W) * 100).toFixed(3)}%`, top: `${((y / H) * 100).toFixed(3)}%` });
const pos = (x: number, y: number) => { const p = at(x, y); return `left:${p.left};top:${p.top}`; };
type Step = [number, Record<string, string | number>];
const tl = (steps: Step[]) => JSON.stringify(steps);
const tr = (x: number, y: number) => `translate(${x}px, ${y}px)`;
const path = (pts: [number, number, number, number?][]): Step[] => pts.map(([t, x, y, o = 1]) => [t, { ...at(x, y), opacity: o }]);
const move = (pts: [number, number, number, number?][]): Step[] => pts.map(([t, x, y, o = 1]) => [t, { transform: tr(x, y), opacity: o }]);
const pop = (t0: number, t1: number): Step[] => [
  [t0, { opacity: 0, transform: 'translate(-50%, -80%) scale(.8)' }], [t0 + 0.3, { opacity: 1, transform: 'translate(-50%, -110%) scale(1)' }],
  [t1, { opacity: 1, transform: 'translate(-50%, -110%) scale(1)' }], [t1 + 0.3, { opacity: 0, transform: 'translate(-50%, -110%) scale(.9)' }],
];
const rise = (t0: number, t1: number, x0: number, y0: number, x1: number, y1: number): Step[] => [
  [t0, { ...at(x0, y0), opacity: 0 }], [t0 + 0.3, { ...at(x0, y0), opacity: 1 }], [t1, { ...at(x1, y1), opacity: 1 }], [t1 + 0.4, { ...at(x1, y1), opacity: 0 }],
];
const ring = (t0: number, len = 1): Step[] => [
  [t0, { opacity: 0, transform: 'translate(-50%, -50%) scale(.4)' }], [t0 + 0.15, { opacity: 0.95, transform: 'translate(-50%, -50%) scale(.7)' }],
  [t0 + len, { opacity: 0, transform: 'translate(-50%, -50%) scale(2.4)' }],
];
const fill = (base: string, on: string, t0: number, t1: number): Step[] => [[t0, { fill: base }], [t0 + 0.2, { fill: on }], [t1, { fill: on }], [t1 + 0.3, { fill: base }]];
const show = (t0: number, t1: number): Step[] => [[t0, { opacity: 0 }], [t0 + 0.25, { opacity: 1 }], [t1, { opacity: 1 }], [t1 + 0.3, { opacity: 0 }]];
const enter = (t0: number, t1: number, dx = 0): Step[] => [
  [t0, { opacity: 0, transform: `translateX(${dx}px)` }], [t0 + 0.35, { opacity: 1, transform: 'translateX(0)' }],
  [t1, { opacity: 1, transform: 'translateX(0)' }], [t1 + 0.3, { opacity: 0, transform: 'translateX(0)' }],
];
const fade = (t0: number, t1: number): Step[] => [[t0, { opacity: 0 }], [t0 + 0.5, { opacity: 1 }], [t1, { opacity: 1 }], [t1 + 0.5, { opacity: 0 }]];

const chapters = [
  { n: en ? 'Start' : '출발', area: 0, hold: [0, 7], t: en ? "Work starts on a registered PC in the office. After a biometric check on the user's own phone, the PC and phone check each other, so you can tell who is using this PC now." : '사무실에서 등록된 PC로 일을 시작합니다. 본인 휴대폰으로 생체 확인을 하면 PC와 휴대폰이 서로 확인해, 이 PC를 지금 누가 쓰는지 알 수 있습니다.' },
  { n: en ? 'Outside too' : '밖에서도', area: 1, hold: [8.2, 15], t: en ? 'At a cafe or on a business trip, the same checks apply. The PC and phone both send signals such as Wi-Fi, location and time zone.' : '카페나 출장지에서도 같은 기준으로 확인합니다. PC와 휴대폰은 Wi-Fi, 위치, 시간대 같은 신호를 함께 보냅니다.' },
  { n: en ? 'Connection' : '연결', area: 2, hold: [16.2, 22], t: en ? 'Requests reach Trust Gateway over an encrypted, mutually authenticated link. Suspicious ones are mixed in too.' : '요청은 암호화된 상호 인증 연결로 Trust Gateway에 갑니다. 그 사이에 수상한 요청도 섞여 있습니다.' },
  { n: en ? 'Cross check' : '신호 대조', area: 3, hold: [23.2, 35], t: en ? "It matches the PC's signals against the phone's. It checks for the same place, the same Wi-Fi and the same time zone, and for anything unusual." : 'PC와 휴대폰의 신호를 서로 맞춰 봅니다. 같은 장소인지, 같은 Wi-Fi인지, 같은 시간대인지, 평소와 다른지 확인합니다.' },
  { n: en ? 'Decision' : '판정', area: 3, hold: [35, 43], t: en ? 'A request needs a certificate to pass the gate. Each time, the check results sort it into Allow, Step-up or Deny.' : '인증서가 있어야 게이트를 지날 수 있고, 확인 결과에 따라 매번 허용, 추가 인증, 거부로 나눕니다.' },
  { n: en ? 'When unusual' : '평소와 다를 때', area: 3, hold: [43, 54], t: en ? 'When the PC and the phone point to different places, it asks again on the phone. If the user does not approve, that request is denied.' : 'PC와 휴대폰이 서로 다른 곳을 가리키면 휴대폰으로 다시 묻습니다. 본인이 승인하지 않으면 그 요청은 거부됩니다.' },
  { n: en ? 'Into the company' : '회사 안으로', area: 4, hold: [55.2, 62], t: en ? 'Company servers open no door to the internet. The Internal Agent connects to Trust Gateway from inside first, and requests come in only over that connection.' : '회사 서버는 인터넷에 문을 열지 않습니다. 회사 안의 에이전트가 Trust Gateway에 먼저 연결해 두고, 요청은 그 연결로만 들어갑니다.' },
  { n: en ? 'Arrival' : '도착', area: 5, hold: [63.2, 70], t: en ? 'Only the permitted business systems open, and the verified identity is passed along. The rest stay closed.' : '허락된 업무 시스템만 열리고, 확인된 신원이 함께 전달됩니다. 나머지는 닫혀 있습니다.' },
  { n: en ? 'Record' : '기록', area: 6, hold: [71.2, 79], t: en ? 'Every decision is logged with its reasons, and admins see it in the Admin Console.' : '모든 판정은 근거와 함께 남고, 관리자는 관리 콘솔에서 봅니다.' },
  { n: 'Trust Gateway', area: 7, hold: [80.2, 92], t: en ? 'From start to record, every request is checked with signals from the PC and the phone. Even if a password leaks, company systems do not open.' : '출발부터 기록까지, 모든 요청을 PC와 휴대폰의 신호로 확인합니다. 비밀번호가 새어 나가도 회사 시스템은 열리지 않습니다.' },
];
const still = 3; // 신호 대조: shown still with reduced motion or no JavaScript
const shift = (a: number) => `translateX(${(-(a * 100) / AREAS).toFixed(4)}%)`;
const ease = 'cubic-bezier(.45, 0, .25, 1)';
const camera: Step[] = chapters.flatMap((c) => [[c.hold[0], { transform: shift(c.area), easing: 'linear' }], [c.hold[1], { transform: shift(c.area), easing: ease }]] as Step[]);
camera.push([T, { transform: shift(AREAS - 1) }]);
const zoom: Step[] = ([
  [0, 1], [7, 1.05], [7.6, 0.9], [8.2, 1], [15, 1.05], [15.6, 0.9], [16.2, 1], [22, 1.05], [22.6, 0.9], [23.2, 1], [24, 1.2], [34.4, 1.2],
  [35.2, 1], [43, 1], [43.8, 1.2], [53.6, 1.2], [54.2, 1], [54.6, 0.9], [55.2, 1], [62, 1.05], [62.6, 0.9], [63.2, 1], [70, 1.05], [70.6, 0.9],
  [71.2, 1], [79, 1.05], [79.6, 0.9], [80.2, 1], [86.4, 1], [T, 1.08],
] as [number, number][]).map(([t, s]) => [t, { transform: `scale(${s})` }]);
const dim: Step[] = [[23.7, { opacity: 0 }], [24.2, { opacity: 0.62 }], [34.1, { opacity: 0.62 }], [34.6, { opacity: 0 }], [43.2, { opacity: 0 }], [43.7, { opacity: 0.62 }], [53.4, { opacity: 0.62 }], [53.9, { opacity: 0 }]];
const veil: Step[] = [[0, { opacity: 1 }], [0.6, { opacity: 0 }], [92.2, { opacity: 0 }], [T, { opacity: 1 }]];

// the request of light: from the office PC, from the cafe laptop, through the tunnel, into the room, into the record
const hero = path([
  [4.4, 342, 190, 0], [4.6, 342, 190], [5.4, 460, 150], [6.6, 590, 160], [6.8, 600, 160, 0],
  [12.4, 923, 248, 0], [12.6, 923, 248], [13.6, 1040, 230], [15.2, 1180, 312], [15.6, 1192, 316, 0],
  [58.6, 2405, 372, 0], [58.8, 2412, 372], [60, 2730, 372], [60.6, 2730, 334], [60.8, 2730, 330, 0],
  [63.4, 3062, 330, 0], [63.6, 3070, 330], [64.4, 3200, 330], [64.9, 3290, 300], [65.1, 3290, 300, 0],
  [70, 3290, 300, 0], [70.2, 3290, 300], [72, 3895, 125], [72.3, 3895, 125, 0],
  [79.1, 3900, 125, 0], [79.3, 3920, 125], [80.6, 4500, 170], [80.8, 4500, 170, 0],
]);
// the ending: the story's steps gather into the shield
const SX = 4500, SY = 170;
const gather = [
  { t: en ? 'Registered PC' : '등록된 PC', x: 4310, y: 100 }, { t: en ? 'Own phone' : '본인 휴대폰', x: 4310, y: 180 }, { t: en ? 'Multi-Signal Cross Check' : '다중 신호 교차 검증', x: 4310, y: 260 },
  { t: en ? 'Continuous decisions' : '매 순간 판정', x: 4690, y: 100 }, { t: en ? 'No open ports' : '열린 포트 없음', x: 4690, y: 180 }, { t: en ? 'Decision + reasons logged' : '판정과 근거 기록', x: 4690, y: 260 },
];
const draw = (t0: number, t1: number, fillTo?: number): Step[] => [
  [t0, { strokeDashoffset: 1, fillOpacity: 0 }], [t1, { strokeDashoffset: 0, fillOpacity: 0 }], [t1 + 0.6, { strokeDashoffset: 0, fillOpacity: fillTo ?? 0 }],
];
// cars, relative to where each is drawn
const heroCar = move([[15.6, 40, 0, 0], [15.8, 50, 0], [21.8, 640, 0], [23, 888, -82], [36.9, 888, -82], [38.6, 1300, -82], [38.8, 1310, -82, 0]]);
const redCar = move([[16.8, 0, 0, 0], [17, 10, 0], [18, 140, -6], [18.8, 250, 6], [19.6, 360, -6], [20.4, 470, 4], [21.8, 640, 0], [23.2, 878, 8],
  [37.6, 878, 8], [37.7, 866, 8], [37.8, 890, 8], [37.9, 870, 8], [38, 878, 8], [53.8, 878, 8], [54.1, 878, 8, 0]]);
const car2 = move([[22.4, -240, 0, 0], [22.6, -200, 0], [23, 0, 0], [39.6, 0, 0], [41.2, 420, 0], [41.4, 430, 0, 0]]);
const arm = (t0: number, t1: number): Step[] => [[t0, { transform: 'rotate(0deg)' }], [t0 + 0.35, { transform: 'rotate(-78deg)' }], [t1, { transform: 'rotate(-78deg)' }], [t1 + 0.4, { transform: 'rotate(0deg)' }]];
const light1: Step[] = [[36.4, { fill: '#3a4d6b' }], [36.6, { fill: '#63d6b4' }], [41.6, { fill: '#63d6b4' }], [41.8, { fill: '#3a4d6b' }]];
const light2: Step[] = [[37, { fill: '#3a4d6b' }], [37.2, { fill: '#f6a25a' }], [38.9, { fill: '#f6a25a' }], [39, { fill: '#63d6b4' }], [41.6, { fill: '#63d6b4' }], [41.8, { fill: '#3a4d6b' }]];
const light3: Step[] = [[37.2, { fill: '#3a4d6b' }], [37.4, { fill: '#ff7a6b' }], [53.8, { fill: '#ff7a6b' }], [54, { fill: '#3a4d6b' }]];
// 판정 (user, 2026-11-16): to pass the gate a car hands in its ticket, the device certificate. It rises from the car, then
// slides into the tower; the red car has none, so an empty ticket bounces off the tower and its barrier stays down
const ticket = (t0: number, dx: number, dy: number): Step[] => move([[t0, 0, 8, 0], [t0 + 0.3, 0, 0], [t0 + 0.5, 0, 0], [t0 + 1, dx, dy], [t0 + 1.2, dx, dy, 0]]);
const tickets: [number, number, Step[]][] = [[2059, 196, ticket(35.2, 59, 24)], [2059, 258, ticket(35.5, 59, 24)]];
const noTicket = move([[35.8, 0, 8, 0], [36.1, 0, 0], [36.3, 0, 0], [36.8, 32, 6], [37, 24, 6], [37.9, 24, 6], [38.2, 24, 6, 0]]);
// drones dash at the walls and bounce off
const drones = [
  { x: 2480, y: 80, dx: 120, dy: 80, t: 55.6 }, { x: 2960, y: 90, dx: -100, dy: 60, t: 56.2 }, { x: 2950, y: 200, dx: -90, dy: 45, t: 56.8 },
];
const droneTl = (d: (typeof drones)[number]) => move([[d.t, 0, 0], [d.t + 0.5, d.dx, d.dy], [d.t + 0.9, 0, 0]]);

type Mark = { k: 'chip' | 'ring' | 'float'; tone: string; t?: string; x?: number; y?: number; tl: Step[] };
const marks: Mark[] = [
  // 출발
  { k: 'chip', tone: 'ok', t: en ? 'Registered PC' : '등록된 PC', x: 342, y: 145, tl: pop(1, 6.6) },
  { k: 'ring', tone: 'ok', x: 415, y: 232, tl: ring(2.5) },
  { k: 'chip', tone: 'ok', t: en ? 'Own phone · biometrics' : '본인 휴대폰 · 생체 확인', x: 500, y: 266, tl: pop(2.6, 6.6) },
  // then the PC and the phone check each other (CEO, 2026-11-16): two dots swap ends along the arc drawn in the office
  { k: 'ring', tone: 'ok', x: 398, y: 170, tl: ring(4.3, 0.8) },
  { k: 'ring', tone: 'ok', x: 426, y: 222, tl: ring(4.3, 0.8) },
  { k: 'chip', tone: 'ok', t: en ? 'PC-phone mutual check' : 'PC와 휴대폰이 서로 확인', x: 525, y: 186, tl: pop(4.2, 6.6) },
  // 밖에서도: the signals go up from the laptop and the phone
  { k: 'chip', tone: 'info', t: en ? 'Same checks apply' : '같은 기준으로 확인', x: 890, y: 74, tl: pop(9, 14.6) },
  { k: 'float', tone: 'sig', t: 'Wi-Fi', tl: rise(9.2, 11.4, 918, 232, 870, 175) },
  { k: 'float', tone: 'sig', t: en ? 'Location' : '위치', tl: rise(9.6, 11.8, 938, 232, 950, 165) },
  { k: 'float', tone: 'sig', t: en ? 'Time zone' : '시간대', tl: rise(10, 12.2, 989, 262, 1030, 185) },
  // 연결: the labels ride above their cars
  { k: 'float', tone: 'info', t: en ? 'Encrypted mutual-auth link' : '암호화된 상호 인증 연결', tl: path([[17.2, 1359, 290, 0], [17.5, 1388, 290], [21.4, 1772, 290], [21.6, 1791, 290, 0]]) },
  { k: 'float', tone: 'no', t: en ? 'Suspicious request' : '수상한 요청', tl: path([[18.6, 1410, 326, 0], [18.8, 1421, 328], [19.6, 1531, 322], [20.4, 1641, 332], [21.4, 1762, 328], [21.6, 1780, 328, 0]]) },
  // 판정
  { k: 'ring', tone: 'ok', x: 2100, y: 222, tl: ring(36.2, 0.8) },
  { k: 'ring', tone: 'ok', x: 2100, y: 282, tl: ring(36.5, 0.8) },
  { k: 'chip', tone: 'ok', t: en ? 'Allow' : '허용', x: 2262, y: 222, tl: pop(36.6, 42.6) },
  { k: 'chip', tone: 'more', t: en ? 'Step-up · check on phone' : '추가 인증 · 휴대폰으로 확인', x: 2262, y: 282, tl: pop(37.2, 38.9) },
  { k: 'ring', tone: 'more', x: 2262, y: 300, tl: ring(38, 0.9) },
  { k: 'chip', tone: 'ok', t: en ? 'Phone approved · Allow' : '휴대폰 승인 후 허용', x: 2262, y: 282, tl: pop(39, 42.6) },
  { k: 'chip', tone: 'no', t: en ? 'No certificate · Deny' : '인증서 없음 · 거부', x: 2262, y: 342, tl: pop(37.4, 42.6) },
  // 회사 안으로
  { k: 'chip', tone: 'no', t: en ? 'No open ports' : '열린 포트 없음', x: 2730, y: 98, tl: pop(56.2, 61.6) },
  ...drones.map((d) => ({ k: 'chip', tone: 'no', t: '✕', x: d.x + d.dx, y: d.y + d.dy, tl: pop(d.t + 0.5, 61.6) }) as Mark),
  { k: 'chip', tone: 'info', t: en ? 'Path the agent opened first' : '에이전트가 먼저 연결해 둔 길', x: 2560, y: 352, tl: pop(58.4, 61.6) },
  // 도착
  { k: 'chip', tone: 'ok', t: en ? 'Open' : '열림', x: 3140, y: 124, tl: pop(65, 69.6) },
  { k: 'chip', tone: 'ok', t: en ? 'Open' : '열림', x: 3300, y: 250, tl: pop(65.2, 69.6) },
  { k: 'chip', tone: 'ok', t: en ? 'Open' : '열림', x: 3460, y: 124, tl: pop(65.4, 69.6) },
  { k: 'chip', tone: 'lock', t: en ? 'Closed' : '닫힘', x: 3300, y: 138, tl: pop(65.6, 69.6) },
  { k: 'chip', tone: 'lock', t: en ? 'Closed' : '닫힘', x: 3140, y: 262, tl: pop(65.8, 69.6) },
  { k: 'chip', tone: 'lock', t: en ? 'Closed' : '닫힘', x: 3460, y: 262, tl: pop(66, 69.6) },
  { k: 'chip', tone: 'info', t: en ? 'Verified identity passed on' : '확인된 신원 전달', x: 3300, y: 382, tl: pop(65.6, 69.6) },
  // 기록
  { k: 'ring', tone: 'ok', x: 3895, y: 125, tl: ring(72.4, 1.2) },
  { k: 'chip', tone: 'info', t: en ? 'Decision + reasons logged' : '판정과 근거 기록', x: 3785, y: 104, tl: pop(72.4, 78.6) },
  { k: 'chip', tone: 'info', t: en ? 'Admin Console' : '관리 콘솔', x: 4044, y: 178, tl: pop(74, 78.6) },
  // the ending
  ...gather.map((g, k) => ({ k: 'float', tone: 'info', t: g.t, tl: path([[81.8 + k * 0.5, g.x, g.y, 0], [82.1 + k * 0.5, g.x, g.y], [85.6, g.x, g.y], [86.3, SX, SY + 20, 0]]) }) as Mark),
  { k: 'ring', tone: 'ok', x: SX, y: SY, tl: ring(86.4, 1.2) },
];

// panel A, 신호 대조 (tech doc 5.1, 5.2, 5.3)
const pcSig = en ? ['Public IP · location', 'Wi-Fi', 'Time zone', 'Device fingerprint · security state'] : ['공인 IP · 위치', 'Wi-Fi', '시간대', '기기 지문 · 보안 상태'];
const phSig = en ? ['GPS location', 'Wi-Fi', 'Cell tower · country', 'Time zone'] : ['GPS 위치', 'Wi-Fi', '기지국 · 국가', '시간대'];
const checks = en ? ['Same place?', 'Same Wi-Fi?', 'Same time zone?', 'Country matches?', 'Usual behavior?'] : ['같은 장소인가', '같은 Wi-Fi인가', '같은 시간대인가', '접속 국가가 맞는가', '평소 행동과 같은가'];
// panel B, 평소와 다를 때 (tech doc 5.2 모순 유형, 5.4)
const odd = [
  { k: en ? 'Location' : '위치', pc: en ? 'Manila (public IP)' : '마닐라 (공인 IP)', ph: en ? 'Seoul (GPS)' : '서울 (GPS)' },

const capTl = (i: number): Step[] => {
  const [a, b] = chapters[i].hold;
  return [[Math.max(0, a - 0.1), { opacity: 0 }], [a + 0.3, { opacity: 1 }], [b - 0.2, { opacity: 1 }], [Math.min(T, b + 0.2), { opacity: 0 }]];
};
const pad = (i: number) => String(i + 1).padStart(2, '0');
const meta = JSON.stringify(chapters.map((c) => ({ area: c.area, hold: c.hold })));

// scenery

---
// /trust-gateway hero (user, 2026-11-16): in the brand's night colours like /consulting, copy on the left and on the
// right a box that plays five short scenes: what zero trust is, its three principles as Trust Gateway carries them
// out, and the NIST SP 800-207 structure it follows. The steps under it take turns like the consulting hero's: the
// current bar fills over --dur, a click picks a step, the pointer resting on the box or scrolling away pauses it.
// It replaces the zero trust band and the NIST table that opened the page. Each scene is drawn in HTML and plays
// once when it comes up; without JavaScript or with reduced motion every scene shows its finished state.
import Icon from '../Icon.astro';

const scenes = [
  { n: '제로트러스트란', en: 'Zero Trust', t: '한 번 들어오면 다 열리는 대신, 요청마다 확인합니다', items: ['미국 NIST·CISA, 한국 과기정통부가 기준 공개', '사내망 안에 있어도 믿지 않음'] },
  { n: '아무도 믿지 않는다', en: 'Never Trust', t: '비밀번호만으로는 열리지 않습니다', items: ['PC는 기기 인증서로 기기를 증명', '휴대폰은 생체 확인으로 사람을 증명'] },
  { n: '매번 확인한다', en: 'Always Verify', t: '로그인 뒤에도 요청마다 다시 판단합니다', items: ['다중 신호 교차 검증', '평소와 다르면 휴대폰으로 다시 확인', '모든 판정을 근거와 함께 기록'] },
  { n: '필요한 만큼만 연다', en: 'Least Privilege', t: '허락된 앱과 경로만 엽니다', items: ['사내망 전체가 아니라 정책에 지정한 곳만', '업무 시스템은 인터넷에 문을 열지 않음'] },
  { n: '공개된 기준대로', en: 'NIST SP 800-207', t: '공개된 제로트러스트 구조를 그대로 따릅니다', items: ['PEP 접속 관문: 요청을 가로채 결정대로 실행', 'PDP 정책 엔진: 허용, 추가 인증, 거부 결정', 'PIP 이상 탐지: 판단에 쓸 신호 제공'] },
];
const apps4 = ['그룹웨어', 'ERP', '인사', '파일'];
const apps9 = [
  { t: '그룹웨어', ok: true }, { t: '메일', ok: true }, { t: '영업 관리', ok: true },
  { t: 'ERP 회계' }, { t: '인사' }, { t: '급여' }, { t: '개발 서버' }, { t: '파일 서버' }, { t: '관리 콘솔' },
];
const log = [
  { at: '09:02', t: '그룹웨어 열기', r: '허용', d: 0.5 },
  { at: '09:15', t: 'ERP 조회', r: '허용', d: 1.1 },
  { at: '09:31', t: '파일 내려받기', r: '허용', d: 1.7 },
  { at: '10:04', t: '새 위치에서 접속', r: '추가 인증', d: 2.5, alt: true },
  { at: '10:05', t: '휴대폰 승인 후 다시 판단', r: '허용', d: 3.7 },
];
---
<section class="tg-hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Trust Gateway</p>
      <h1 class="title">Trust Gateway는 제로트러스트 <br />설계 원칙 기반 솔루션입니다</h1>
      <p class="lead-d">신영이노베이션이 제로트러스트 원칙을 적용하여 개발했습니다. <br />PC는 기기를, 휴대폰은 사람을 증명하고, 로그인 뒤에도 요청마다 다시 확인합니다.</p>
      <div class="btn-row">
        <a class="btn primary" href="/contact?type=poc">무료 PoC/컨설팅 신청</a>
        <a class="btn ghost" href="#demo">제품 화면 보기</a>
      </div>
    </div>

    <div class="show">
      <div class="stage" aria-hidden="true">
        <!-- 1. zero trust: the old wall opens everything; zero trust checks and opens one place -->
        <div class="scene s1 on">
          <div class="row">
            <p class="r-t">기존 방식</p>
            <span class="who"><Icon name="user" size={16} /></span>
            <i class="ln a-draw" style="--d:.4s"></i>
            <div class="wall">
              <span class="gate">VPN</span>
              <div class="apps">{apps4.map((a, k) => <b class="tile warm a-lit" style={`--d:${1.1 + k * 0.12}s`}>{a}</b>)}</div>
            </div>
            <p class="r-r warn a-fade" style="--d:1.8s">한 번 들어오면 모두 열림</p>
          </div>
          <div class="row a-fade" style="--d:2.3s">
            <p class="r-t">제로트러스트</p>
            <span class="who"><Icon name="user" size={16} /></span>
            <i class="ln a-draw" style="--d:2.7s"></i>
            <div class="apps solo">
              {apps4.map((a, k) => k === 0
                ? <b class="tile blue a-lit" style="--d:3.4s">{a}<span class="ic a-fade" style="--d:3.4s"><Icon name="check" size={14} /></span></b>
                : <b class="tile">{a}<Icon name="lock" size={13} /></b>)}
            </div>
            <p class="r-r ok a-fade" style="--d:3.9s">확인한 곳 하나만 열림</p>
          </div>
        </div>

        <!-- 2. never trust: a password alone is refused; the PC certificate and the phone's biometric check open it -->
        <div class="scene s2">
          <div class="login a-fade" style="--d:.2s">
            <p>업무 시스템 로그인</p>
            <span>아이디<em>kim.sy</em></span>
            <span>비밀번호<em>••••••••</em></span>
          </div>
          <i class="ln a-draw" style="--d:.7s"></i>
          <div class="gbox a-lit" style="--d:3.6s">
            <Icon name="shield" size={22} />
            <b>Trust Gateway</b>
            <span class="st deny a-blink" style="--d:1.1s; --len:1.5s">비밀번호만으로는 거부</span>
            <span class="st ok a-fade" style="--d:3.6s">확인 완료</span>
          </div>
          <i class="ln a-draw" style="--d:4s"></i>
          <div class="target blue a-lit" style="--d:4.5s">
            <Icon name="server" size={20} />
            <b>업무 시스템</b>
            <span class="state shut a-hold" style="--len:4.5s"><Icon name="lock" size={13} />잠김</span>
            <span class="state open a-fade" style="--d:4.5s"><Icon name="check" size={13} />열림</span>
          </div>
          <div class="proofs">
            <span class="pf a-fade" style="--d:2.5s"><Icon name="laptop" size={16} />PC 기기 인증서<Icon name="check" size={15} /></span>
            <span class="pf a-fade" style="--d:3.05s"><Icon name="phone" size={16} />휴대폰 생체 확인<Icon name="check" size={15} /></span>
          </div>
        </div>

        <!-- 3. always verify: every request is judged again from several signals; a new place asks the phone -->
        <div class="scene s3">
          <div class="sig">
            <p>판단에 쓰는 신호</p>
            <span>기기</span><span class="loc">위치</span><span>네트워크</span><span>평소 행동</span>
          </div>
          <ol class="log">
            {log.map((l) => (
              <li class:list={['a-fade', { alt: l.alt }]} style={`--d:${l.d}s`}>
                <time>{l.at}</time><span>{l.t}</span><b class={l.alt ? 'more' : 'ok'}>{l.r}</b>
              </li>
            ))}
          </ol>
        </div>

        <!-- 4. least privilege: of everything in the company, only what the policy names opens -->
        <div class="scene s4">
          <div class="who-card a-fade" style="--d:.2s">
            <Icon name="user" size={20} />
            <b>영업팀 직원</b>
            <span>정책: 영업 업무</span>
          </div>
          <i class="ln a-draw" style="--d:.6s"></i>
          <div class="grid9">
            {apps9.map((a, k) => a.ok
              ? <b class="tile blue a-lit" style={`--d:${1.1 + k * 0.3}s`}>{a.t}<span class="ic"><span class="a-hold" style={`--len:${1.1 + k * 0.3}s`}><Icon name="lock" size={13} /></span><span class="a-fade" style={`--d:${1.1 + k * 0.3}s`}><Icon name="check" size={14} /></span></span></b>
              : <b class="tile">{a.t}<Icon name="lock" size={13} /></b>)}
          </div>
          <p class="note a-fade" style="--d:2.4s">정책에 지정한 3곳만 열림</p>
        </div>

        <!-- 5. NIST SP 800-207: the request stops at the PEP, the PDP decides with the PIP's signals, the PEP carries it out -->
        <div class="scene s5">
          <div class="node pdp a-lit" style="--d:2.4s">
            <b>PDP</b><span>정책 엔진</span>
            <span class="dec"><em class="a-lit" style="--d:2.8s">허용</em><em>추가 인증</em><em>거부</em></span>
          </div>
          <i class="ln rev a-draw" style="--d:1.9s"></i>
          <div class="node pip a-lit" style="--d:1.6s">
            <b>PIP</b><span>이상 탐지</span>
            <small class="a-fade" style="--d:1.7s">위험 점수 · 기기 · 위치</small>
          </div>
          <i class="lnv a-drawy" style="--d:1.2s"></i>
          <div class="node user a-fade" style="--d:.2s"><Icon name="user" size={18} /><span>사용자 요청</span></div>
          <i class="ln a-draw" style="--d:.5s"></i>
          <div class="node pep a-lit" style="--d:.9s"><b>PEP</b><span>접속 관문</span></div>
          <i class="ln a-draw" style="--d:3.4s"></i>
          <div class="node sys blue a-lit" style="--d:3.9s"><Icon name="server" size={18} /><span>업무 시스템</span></div>
        </div>
      </div>

      {scenes.map((s, i) => (
        <div class={`cap${i === 0 ? ' on' : ''}`} hidden={i !== 0}>
          <p class="cap-k"><span>{String(i + 1).padStart(2, '0')}</span>{s.n}<em>{s.en}</em></p>
          <p class="cap-t">{s.t}</p>
          <ul>{s.items.map((x, k) => <li style={`--k:${k}`}><Icon name="check" size={15} />{x}</li>)}</ul>
        </div>
      ))}
    </div>
  </div>

  <div class="wrap">
    <ol class="flow" aria-label="Trust Gateway 소개">
      {scenes.map((s, i) => (
        <li class={i === 0 ? 'on' : ''}>
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'}><span class="flow-n">{String(i + 1).padStart(2, '0')}</span>{s.n}</button>
          <i class="bar" aria-hidden="true"></i>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .tg-hero { --dur: 7s; background: var(--night); color: var(--on-night); padding: calc(96px + clamp(40px, 4vw, 72px)) 0 clamp(56px, 6vw, 88px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .eyebrow { font-size: clamp(16px, .3vw + 14px, 18px); font-weight: 600; color: #9fb8de; }
  .title { margin-top: 14px; font-size: clamp(30px, 2.4vw + 10px, 48px); line-height: 1.24; letter-spacing: -0.03em; font-weight: 700; word-break: keep-all; }
  .lead-d { margin-top: 22px; font-size: clamp(16px, .4vw + 13px, 19px); line-height: 1.7; color: var(--on-night-2); }
  .btn-row { margin-top: 32px; }
  .tg-hero .btn.ghost { background: transparent; color: var(--on-night); border-color: rgba(255, 255, 255, .32); }
  .tg-hero .btn.ghost:hover { border-color: #fff; }

  /* the box: the scene on top, its caption under it */
  .show { border-radius: 20px; overflow: hidden; background: var(--night-2); border: 1px solid var(--night-line); }
  .stage {
    position: relative; aspect-ratio: 16 / 10; container-type: inline-size;
    background:
      radial-gradient(110% 80% at 50% 0%, rgba(77, 132, 204, .2), transparent 62%),
      linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px) 0 0 / 24px 24px,
      #0f1d31;
  }
  .cap { padding: 18px 22px 20px; border-top: 1px solid var(--night-line); min-height: 132px; }
  .cap-k { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 8px; font-size: 17px; font-weight: 700; color: #fff; }
  .cap-k span { font-size: 13px; color: var(--orange); font-variant-numeric: tabular-nums; }
  .cap-k em { font-style: normal; font-size: 13px; font-weight: 600; color: #9fb8de; }
  .cap-t { margin-top: 6px; font-size: 15px; color: var(--on-night); }
  .cap ul { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .cap li { display: flex; align-items: center; gap: 6px; font-size: 14px; color: var(--on-night-2); }
  .cap li :global(svg) { flex: none; color: #63d6b4; }

  /* a scene and its parts; sizes follow the box (container units), so it reads the same on a phone */
  .scene {
    position: absolute; inset: 0; display: grid; align-content: center; gap: 3cqw; padding: 5cqw 5.5cqw;
    font-size: clamp(10px, 2.15cqw, 14px); line-height: 1.45; color: var(--on-night-2);
    opacity: 0; visibility: hidden; transition: opacity .5s var(--ease), visibility 0s .5s;
  }
  .scene.on { opacity: 1; visibility: visible; transition: opacity .5s var(--ease); }
  .scene b { font-weight: 700; }
  .tile { display: flex; align-items: center; justify-content: center; gap: .4em; min-width: 0; padding: .7em .5em; border-radius: .7em; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); color: var(--on-night-2); font-weight: 600; white-space: nowrap; }
  .tile :global(svg) { flex: none; opacity: .7; }
  .tile.blue, .target.blue, .node.blue { background: rgba(77, 132, 204, .3); border-color: #6f9ee0; color: #fff; }
  .tile.blue :global(svg) { color: #7fe0c2; opacity: 1; }
  .tile.warm { background: rgba(246, 136, 42, .2); border-color: rgba(246, 136, 42, .8); color: #fff; }
  .ic { display: inline-grid; } .ic > * { grid-area: 1 / 1; display: grid; }
  .ln { position: relative; display: block; height: 2px; align-self: center; background: rgba(159, 184, 222, .55); transform-origin: left; }
  .ln::after { content: ''; position: absolute; right: 0; top: 50%; width: .5em; height: .5em; border-top: 2px solid #9fb8de; border-right: 2px solid #9fb8de; transform: translateY(-50%) rotate(45deg); }
  .ln.rev { transform-origin: right; }
  .ln.rev::after { right: auto; left: 0; transform: translateY(-50%) rotate(225deg); }
  .lnv { position: relative; display: block; width: 2px; height: 100%; justify-self: center; background: rgba(159, 184, 222, .55); transform-origin: bottom; }
  .lnv::before, .lnv::after { content: ''; position: absolute; left: 50%; width: .5em; height: .5em; border-top: 2px solid #9fb8de; border-right: 2px solid #9fb8de; }
  .lnv::before { top: 0; transform: translateX(-50%) rotate(-45deg); }
  .lnv::after { bottom: 0; transform: translateX(-50%) rotate(135deg); }

  /* 1 */
  .s1 { gap: 4.5cqw; }
  .s1 .row { display: grid; grid-template-columns: auto 6cqw minmax(0, 1fr); align-items: center; column-gap: 1.4cqw; row-gap: 1.2cqw; }
  .r-t { grid-column: 1 / -1; font-size: 1.05em; font-weight: 700; color: #fff; }
  .who { display: grid; place-items: center; width: 2.6em; height: 2.6em; border-radius: 50%; background: rgba(255, 255, 255, .1); color: #fff; }
  .wall { position: relative; padding: .8em .8em .8em 1.6em; border: 1.5px dashed rgba(159, 184, 222, .55); border-radius: .9em; }
  .gate { position: absolute; left: 0; top: 50%; transform: translate(-50%, -50%); padding: .2em .45em; border-radius: .4em; background: var(--orange); color: #1a1209; font-size: .85em; font-weight: 800; }
  .apps { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .45em; }
  .r-r { grid-column: 3; font-weight: 700; }
  .r-r.warn { color: #ffb37a; }
  .r-r.ok, .s4 .note { color: #7fe0c2; }

  /* 2 */
  .s2 { grid-template-columns: minmax(0, 1.15fr) 5cqw minmax(0, 1fr) 5cqw minmax(0, .85fr); align-items: center; column-gap: 1.2cqw; }
  .login { display: grid; gap: .45em; padding: .9em; border-radius: .9em; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); }
  .login p { font-weight: 700; color: #fff; }
  .login span { display: flex; justify-content: space-between; gap: .6em; padding: .4em .6em; border-radius: .5em; background: rgba(0, 0, 0, .25); }
  .login em { font-style: normal; color: #fff; letter-spacing: .04em; }
  .gbox, .target { position: relative; display: grid; justify-items: center; gap: .35em; padding: 1em .5em; border-radius: .9em; text-align: center; color: #fff; }
  .gbox { border: 1.5px solid #6f9ee0; background: rgba(77, 132, 204, .18); }
  .gbox :global(svg) { color: #9fb8de; }
  .target { border: 1px solid rgba(255, 255, 255, .12); background: rgba(255, 255, 255, .06); }
  .st { position: absolute; left: 50%; top: 100%; transform: translate(-50%, .7em); white-space: nowrap; padding: .25em .7em; border-radius: 999px; font-size: .85em; font-weight: 700; }
  .st.deny { background: rgba(255, 122, 107, .16); color: #ff9a8e; border: 1px solid rgba(255, 122, 107, .6); }
  .st.ok { background: rgba(99, 214, 180, .14); color: #7fe0c2; border: 1px solid rgba(99, 214, 180, .6); }
  .state { grid-area: 3 / 1; display: flex; align-items: center; gap: .3em; font-size: .85em; font-weight: 700; }
  .state.shut { color: var(--on-night-2); }
  .state.open { color: #7fe0c2; }
  .proofs { grid-column: 1 / -1; display: flex; justify-content: center; flex-wrap: wrap; gap: .8em 1.2em; margin-top: 3.2em; }
  .pf { display: flex; align-items: center; gap: .45em; padding: .5em .9em; border-radius: 999px; background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .14); color: #fff; font-weight: 600; }
  .pf :global(svg:last-child) { color: #7fe0c2; }

  /* 3 */
  .s3 { gap: 2.6cqw; }
  .sig { display: flex; flex-wrap: wrap; align-items: center; gap: .45em; }
  .sig p { margin-right: .3em; font-weight: 700; color: #fff; }
  .sig span { padding: .3em .8em; border-radius: 999px; border: 1px solid rgba(111, 158, 224, .6); background: rgba(77, 132, 204, .16); color: #fff; font-weight: 600; }
  .log { list-style: none; margin: 0; padding: 0; display: grid; gap: .45em; }
  .log li { display: grid; grid-template-columns: 3.4em minmax(0, 1fr) auto; align-items: center; gap: .8em; padding: .5em .9em; border-radius: .6em; background: rgba(255, 255, 255, .05); border: 1px solid rgba(255, 255, 255, .08); color: var(--on-night); }
  .log li.alt { border-color: rgba(246, 136, 42, .55); }
  .log time { color: #9fb8de; font-variant-numeric: tabular-nums; }
  .log b { padding: .15em .65em; border-radius: 999px; font-size: .85em; }
  .log b.ok { background: rgba(99, 214, 180, .15); color: #7fe0c2; }
  .log b.more { background: rgba(246, 136, 42, .2); color: #ffb37a; }

  /* 4 */
  .s4 { grid-template-columns: auto 6cqw minmax(0, 1fr); align-items: center; column-gap: 1.6cqw; row-gap: 2.2cqw; }
  .who-card { display: grid; justify-items: center; gap: .3em; padding: .9em .8em; border-radius: .9em; background: rgba(255, 255, 255, .07); border: 1px solid rgba(255, 255, 255, .14); color: #fff; text-align: center; }
  .who-card span { font-size: .85em; color: #9fb8de; }
  .grid9 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .45em; }
  .s4 .note { grid-column: 3; font-weight: 700; }

  /* 5 */
  .s5 { grid-template-columns: minmax(0, 1fr) 5cqw minmax(0, 1.15fr) 5cqw minmax(0, 1fr); grid-template-rows: auto 7cqw auto; align-items: center; column-gap: 1.2cqw; }
  .node { display: grid; justify-items: center; gap: .2em; padding: .8em .5em; border-radius: .8em; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .14); text-align: center; color: #fff; }
  .node b { font-size: 1.1em; letter-spacing: .03em; }
  .node span { font-size: .9em; color: #9fb8de; }
  .node small { font-size: .8em; color: var(--on-night-2); }
  .node.pep, .node.pdp, .node.pip { border-color: #6f9ee0; background: rgba(77, 132, 204, .18); }
  .pdp { grid-area: 1 / 3; } .s5 .ln.rev { grid-area: 1 / 4; } .pip { grid-area: 1 / 5; }
  .lnv { grid-area: 2 / 3; }
  .user { grid-area: 3 / 1; } .pep { grid-area: 3 / 3; } .sys { grid-area: 3 / 5; }
  .dec { display: flex; flex-wrap: wrap; justify-content: center; gap: .3em; margin-top: .3em; }
  .dec em { font-style: normal; padding: .1em .5em; border-radius: 999px; font-size: .85em; font-weight: 700; background: rgba(255, 255, 255, .06); color: var(--on-night-2); }
  .dec em:first-child { background: rgba(99, 214, 180, .2); color: #7fe0c2; }

  /* the scene plays once when it comes up; base styles are the finished state (what blinks or holds ends hidden) */
  .a-blink, .a-hold { opacity: 0; }
  .tg-hero.auto .scene.on .a-fade { animation: a-fade .5s var(--ease) var(--d, 0s) both; }
  .tg-hero.auto .scene.on .a-draw { animation: a-draw .5s var(--ease) var(--d, 0s) both; }
  .tg-hero.auto .scene.on .a-drawy { animation: a-drawy .5s var(--ease) var(--d, 0s) both; }
  .tg-hero.auto .scene.on .a-lit { animation: a-lit .55s var(--ease) var(--d, 0s) both; }
  .tg-hero.auto .scene.on .a-blink { animation: a-blink var(--len, 1.2s) var(--ease) var(--d, 0s) both; }
  .tg-hero.auto .scene.on .a-hold { animation: a-hold var(--len, 1s) linear both; }
  .tg-hero.auto .scene.on .sig .loc { animation: a-flash 1.6s var(--ease) 2.5s both; }
  @keyframes a-fade { from { opacity: 0; transform: translateY(.4em); } }
  @keyframes a-draw { from { transform: scaleX(0); } }
  @keyframes a-drawy { from { transform: scaleY(0); } }
  @keyframes a-lit { from { background: rgba(255, 255, 255, .06); border-color: rgba(255, 255, 255, .12); color: var(--on-night-2); } }
  @keyframes a-blink { 0% { opacity: 0; } 15%, 80% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes a-hold { 0%, 92% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes a-flash { 20%, 70% { background: rgba(246, 136, 42, .3); border-color: var(--orange); } }
  :global(html.js) .tg-hero.auto .cap.on li { animation: a-fade .5s var(--ease) both; animation-delay: calc(.25s + var(--k) * .18s); }

  /* the steps under the box, as on /consulting */
  .flow { list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border: 1px solid var(--night-line); border-radius: 16px; overflow: hidden; }
  .flow li { position: relative; background: rgba(255, 255, 255, .03); transition: background-color .4s var(--ease); }
  .flow li + li { border-left: 1px solid var(--night-line); }
  .flow button { width: 100%; display: grid; gap: 4px; justify-items: center; padding: 18px 12px 20px; border: 0; background: none; font: inherit; font-size: 16px; font-weight: 600; text-align: center; color: var(--on-night-2); cursor: pointer; word-break: keep-all; transition: color .4s var(--ease); }
  .flow button:focus-visible { outline: 2px solid var(--orange); outline-offset: -4px; border-radius: 12px; }
  .flow-n { font-size: 13px; font-weight: 600; color: #9fb8de; font-variant-numeric: tabular-nums; transition: color .4s var(--ease); }
  .bar { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: #9fb8de; transform: scaleX(0); transform-origin: left; opacity: .45; }
  .flow li.done .bar { transform: none; }
  .flow li.on { background: rgba(255, 255, 255, .08); }
  .flow li.on button { color: #fff; }
  .flow li.on .flow-n { color: var(--orange); }
  .flow li.on .bar { background: var(--orange); opacity: 1; transform: none; }
  :global(html.js) .tg-hero.auto .flow li.on .bar { animation: fill var(--dur) linear both; }
  @keyframes fill { from { transform: scaleX(0); } to { transform: none; } }
  .tg-hero.paused .scene.on *, .tg-hero.paused .flow li.on .bar, .tg-hero.paused .cap.on li { animation-play-state: paused; }

  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .flow { grid-template-columns: minmax(0, 1fr); }
    .flow button { grid-template-columns: 32px minmax(0, 1fr); justify-items: start; text-align: left; padding: 12px 16px; }
    .flow li + li { border-left: 0; border-top: 1px solid var(--night-line); }
  }
  @media (max-width: 767px) {
    .lead-d :global(br:not(.sb)) { display: none; }
    .title :global(br) { display: none; }
  }
  @media (max-width: 640px) {
    .stage { aspect-ratio: 4 / 3; }
    .cap { min-height: 0; }
  }
</style>

<script>
  // the five scenes take turns: the current step's bar fills over --dur, and when it ends the next scene comes up and
  // plays. A click picks a scene; the pointer resting on the box or the steps, or scrolling away, pauses it.
  const hero = document.querySelector<HTMLElement>('.tg-hero');
  if (hero) {
    const lis = [...hero.querySelectorAll<HTMLLIElement>('.flow li')];
    const scenes = [...hero.querySelectorAll<HTMLElement>('.scene')];
    const caps = [...hero.querySelectorAll<HTMLElement>('.cap')];
    let cur = 0;
    const show = (n: number) => {
      cur = n;
      lis.forEach((li, i) => { li.classList.remove('on'); li.classList.toggle('done', i < n); li.querySelector('button')!.setAttribute('aria-pressed', String(i === n)); });
      scenes.forEach((s) => s.classList.remove('on'));
      caps.forEach((c, i) => { c.classList.remove('on'); c.hidden = i !== n; });
      void hero.offsetWidth; // so a scene shown again plays from the start
      lis[n].classList.add('on'); scenes[n].classList.add('on'); caps[n].classList.add('on');
    };
    lis.forEach((li, i) => li.querySelector('button')!.addEventListener('click', () => show(i)));
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.classList.add('auto');
      show(0); // replay the first scene now that it animates
      hero.querySelector('.flow')!.addEventListener('animationend', (e) => { if ((e.target as HTMLElement).classList.contains('bar')) show((cur + 1) % lis.length); });
      let hover = false, seen = true;
      const sync = () => hero.classList.toggle('paused', hover || !seen);
      hero.querySelectorAll('.show, .flow').forEach((el) => {
        el.addEventListener('pointerenter', (e) => { if ((e as PointerEvent).pointerType === 'mouse') { hover = true; sync(); } });
        el.addEventListener('pointerleave', () => { hover = false; sync(); });
      });
      new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }).observe(hero);
    }
  }
</script>

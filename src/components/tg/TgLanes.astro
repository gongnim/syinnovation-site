---
// ARCHIVED (2026-11-16), not used on any page. The user liked it ("이 내용도 참 좋긴하다") but the /trust-gateway hero
// became the six-scene journey (TgIntro). It is a whole hero: night section, the left copy and, on the right, a live
// map where four kinds of access (본사 직원, 재택 근무자, 협력사 직원, 처음 보는 기기) pass through one Trust Gateway band
// to business systems: 허용, 추가 확인 then 허용, 권한 없음 차단, 미등록 기기 차단. It does not repeat the product demo.
// To bring it back as the hero: in src/pages/trust-gateway.astro import TgLanes instead of TgIntro and put <TgLanes />
// first. It uses the same .tg-hero class as TgIntro, so never put both on one page.
import Icon from '../Icon.astro';
import ConsultBtn from '../ConsultBtn.astro';
const lanes = [
  { who: '본사 직원', dev: '회사 PC', to: '그룹웨어', v: 'ok', l: '허용', why: '기기 · 본인 확인', d: 0 },
  { who: '재택 근무자', dev: '노트북', to: 'ERP', v: 'more', l: '추가 확인', l2: '허용', why: '평소와 다른 접속', d: 1.6 },
  { who: '협력사 직원', dev: '협력사 PC', to: '인사 시스템', v: 'no', l: '차단', why: '허락되지 않은 시스템', d: 3.2 },
  { who: '누군가', dev: '처음 보는 기기', to: '메일', v: 'no', l: '차단', why: '등록되지 않은 기기', d: 4.8 },
];
---
<section class="tg-hero">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">Trust Gateway</p>
      <h1 class="title">Trust Gateway는 제로트러스트 <br />설계 원칙 기반 솔루션입니다</h1>
      <p class="lead-d">비밀번호가 새어 나가도 회사 시스템은 열리지 않습니다. <br />등록된 PC와 본인 휴대폰이 함께 확인돼야 열리고, 로그인한 뒤에도 평소와 다르면 다시 확인합니다.</p>
      <div class="btn-row">
        <ConsultBtn />
        <a class="btn ghost" href="#demo">제품 화면 보기</a>
      </div>
    </div>

    <div class="show">
      <div class="stage">
        <p class="sr-only">회사의 모든 업무 접속이 Trust Gateway를 거칩니다. 회사 PC로 접속한 본사 직원은 기기와 본인 확인을 거쳐 그룹웨어에 들어갑니다. 평소와 다르게 접속한 재택 근무자는 추가 확인을 거친 뒤 ERP에 들어갑니다. 허락되지 않은 인사 시스템에 접속하려는 협력사 직원과, 등록되지 않은 기기의 접속은 차단됩니다.</p>
        <div class="scene" aria-hidden="true">
          <p class="cols"><span>접속</span><span class="g"><Icon name="shield" size={15} />Trust Gateway</span><span>업무 시스템</span></p>
          {lanes.map((l) => (
            <div class={`lane ${l.v}`} style={`--d:${l.d}s`}>
              <span class="src"><b>{l.who}</b><small><Icon name={l.dev === '처음 보는 기기' ? 'phone' : 'laptop'} size={12} />{l.dev}</small></span>
              <span class="track">
                <i class="line"></i>
                <i class="pkt"></i>
                <span class="verdict"><em>{l.l}</em>{l.l2 && <em class="then">{l.l2}</em>}<small>{l.why}</small></span>
              </span>
              <span class="dst"><Icon name={l.v === 'no' ? 'lock' : 'server'} size={13} />{l.to}</span>
            </div>
          ))}
        </div>
      </div>
      <p class="legend">
        <span><i class="ok"></i>허용</span><span><i class="more"></i>추가 확인</span><span><i class="no"></i>차단</span>
        <span class="note">요청마다 기기 · 사람 · 상황 · 권한을 확인합니다</span>
      </p>
    </div>
  </div>
</section>

<style>
  .tg-hero { background: var(--night); color: var(--on-night); padding: calc(96px + clamp(40px, 4vw, 72px)) 0 clamp(64px, 7vw, 104px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: clamp(32px, 5vw, 72px); align-items: center; }
  .eyebrow { font-size: clamp(16px, .3vw + 14px, 18px); font-weight: 600; color: #9fb8de; }
  .title { margin-top: 14px; font-size: clamp(30px, 2.4vw + 10px, 48px); line-height: 1.24; letter-spacing: -0.03em; font-weight: 700; word-break: keep-all; }
  .lead-d { margin-top: 22px; font-size: clamp(16px, .4vw + 13px, 19px); line-height: 1.7; color: var(--on-night-2); }
  .btn-row { margin-top: 32px; }
  .tg-hero .btn.ghost { background: transparent; color: var(--on-night); border-color: rgba(255, 255, 255, .32); }
  .tg-hero .btn.ghost:hover { border-color: #fff; }

  /* the box: the live picture, then a legend */
  .show { border-radius: 20px; overflow: hidden; background: var(--night-2); border: 1px solid var(--night-line); }
  .stage {
    position: relative; container-type: inline-size;
    background:
      radial-gradient(60% 90% at 50% 50%, rgba(77, 132, 204, .18), transparent 70%),
      linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px) 0 0 / 24px 24px,
      linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px) 0 0 / 24px 24px,
      #0f1d31;
  }
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 18px; padding: 16px 20px 18px; border-top: 1px solid var(--night-line); font-size: 14px; font-weight: 600; color: var(--on-night); }
  .legend span { display: flex; align-items: center; gap: 6px; }
  .legend i { width: 9px; height: 9px; border-radius: 50%; }
  .legend .note { margin-left: auto; font-weight: 500; color: var(--on-night-2); }

  /* lanes: who comes in (left), the track through the gate (middle), the system (right); sizes follow the box */
  .scene { position: relative; display: grid; gap: 2.4cqw; padding: 4.5cqw 4cqw 5cqw; font-size: clamp(10.5px, 2.4cqw, 15px); line-height: 1.35; color: var(--on-night-2); }
  .cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr) minmax(0, .9fr); gap: 1.6cqw; text-align: center; font-size: .82em; font-weight: 700; letter-spacing: .02em; color: #9fb8de; }
  .cols .g { display: flex; justify-content: center; align-items: center; gap: .35em; color: #fff; }
  .cols .g :global(svg) { color: #9fb8de; }
  .lane { --c: #63d6b4; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr) minmax(0, .9fr); align-items: center; gap: 1.6cqw; }
  .lane.more { --c: #f6a25a; } .lane.no { --c: #ff7a6b; }
  .src, .dst { display: grid; justify-items: center; gap: .15em; padding: .65em .4em; border-radius: .8em; text-align: center; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .12); color: #fff; word-break: keep-all; }
  .src small { display: flex; align-items: center; gap: .25em; font-size: .8em; color: #9fb8de; }
  .dst { display: flex; justify-content: center; align-items: center; gap: .35em; font-weight: 700; }
  .dst :global(svg) { color: #9fb8de; flex: none; }
  .lane.no .dst { opacity: .45; }
  .track { position: relative; align-self: stretch; min-height: 3.6em; }
  .line { position: absolute; left: 0; right: 0; top: 50%; height: 2px; background: linear-gradient(90deg, rgba(159, 184, 222, .5) 50%, rgba(159, 184, 222, .2) 50%); }
  .lane.no .line { background: linear-gradient(90deg, rgba(159, 184, 222, .5) 50%, transparent 50%); }
  .pkt { position: absolute; top: 50%; left: 50%; width: .8em; height: .8em; margin: -.4em 0 0 -.4em; border-radius: 50%; background: var(--c); box-shadow: 0 0 .8em var(--c); opacity: 0; }
  .verdict { position: absolute; left: 50%; bottom: calc(50% + .7em); transform: translateX(-50%); display: grid; justify-items: center; gap: .1em; white-space: nowrap; }
  .verdict em { grid-area: 1 / 1; font-style: normal; padding: .1em .6em; border-radius: 999px; font-size: .85em; font-weight: 800; background: color-mix(in srgb, var(--c) 22%, transparent); color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 60%, transparent); }
  .verdict em.then { --c: #63d6b4; opacity: 0; }
  .verdict small { font-size: .8em; color: #c9d6ea; }
  .lane.more .verdict em:first-child { opacity: 0; } /* still: the final answer shows */
  .lane.more .verdict em.then { opacity: 1; }

  /* the gate: a band down the middle of every track, joined across the gaps so it reads as one wall */
  .track::before { content: ''; position: absolute; left: 50%; top: -1.2cqw; bottom: -1.2cqw; width: 18cqw; transform: translateX(-50%); background: rgba(77, 132, 204, .16); border-left: 1.5px solid #6f9ee0; border-right: 1.5px solid #6f9ee0; }
  .lane:first-of-type .track::before { top: -.6em; border-top: 1.5px solid #6f9ee0; border-radius: .9em .9em 0 0; }
  .lane:last-of-type .track::before { bottom: -.6em; border-bottom: 1.5px solid #6f9ee0; border-radius: 0 0 .9em .9em; }

  /* the loop: each lane on its own clock, 6.4s a round. The packet goes to the gate, a verdict shows, then it goes on or stops */
  .tg-hero.live .pkt { animation: var(--run) 6.4s linear infinite; animation-delay: var(--d); }
  .tg-hero.live .lane.ok { --run: run-ok; } .tg-hero.live .lane.more { --run: run-more; } .tg-hero.live .lane.no { --run: run-no; }
  .tg-hero.live .verdict { animation: verdict 6.4s linear infinite; animation-delay: var(--d); }
  .tg-hero.live .lane.more .verdict em:first-child { animation: first 6.4s linear infinite; animation-delay: var(--d); }
  .tg-hero.live .lane.more .verdict em.then { animation: then 6.4s linear infinite; animation-delay: var(--d); }
  .tg-hero.live .dst { animation: arrive 6.4s linear infinite; animation-delay: var(--d); }
  .tg-hero.live .lane.no .dst { animation: none; }
  @keyframes run-ok { 0% { left: 0; opacity: 0; } 6% { opacity: 1; } 34% { left: 50%; } 48% { left: 50%; } 72% { left: 100%; opacity: 1; } 76%, 100% { left: 100%; opacity: 0; } }
  @keyframes run-more { 0% { left: 0; opacity: 0; background: #63d6b4; } 6% { opacity: 1; } 34% { left: 50%; background: #f6a25a; } 62% { left: 50%; background: #f6a25a; } 64% { background: #63d6b4; } 86% { left: 100%; opacity: 1; background: #63d6b4; } 90%, 100% { left: 100%; opacity: 0; } }
  @keyframes run-no { 0% { left: 0; opacity: 0; transform: none; } 6% { opacity: 1; } 34% { left: 50%; transform: none; } 40% { left: 50%; transform: scale(1.4); opacity: 1; } 52%, 100% { left: 50%; transform: scale(.2); opacity: 0; } }
  @keyframes verdict { 0%, 33% { opacity: 0; transform: translate(-50%, .4em); } 37%, 84% { opacity: 1; transform: translate(-50%, 0); } 90%, 100% { opacity: 0; transform: translate(-50%, 0); } }
  @keyframes first { 0%, 62% { opacity: 1; } 64%, 100% { opacity: 0; } }
  @keyframes then { 0%, 62% { opacity: 0; } 64%, 100% { opacity: 1; } }
  @keyframes arrive { 0%, 70% { border-color: rgba(255, 255, 255, .12); } 74%, 86% { border-color: #63d6b4; box-shadow: 0 0 0 .25em rgba(99, 214, 180, .15); } 92%, 100% { border-color: rgba(255, 255, 255, .12); } }
  .legend .ok { background: #63d6b4; } .legend .more { background: #f6a25a; } .legend .no { background: #ff7a6b; }

  @media (max-width: 1023px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 767px) {
    .lead-d :global(br:not(.sb)) { display: none; }
    .title :global(br) { display: none; }
    .legend { font-size: 13px; }
    .legend .note { margin-left: 0; width: 100%; }
  }
</style>

<script>
  // the lanes loop while the box is on screen (CSS does the rest); reduced motion keeps each lane's outcome, still
  const hero = document.querySelector<HTMLElement>('.tg-hero');
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    new IntersectionObserver(([e]) => hero.classList.toggle('live', e.isIntersecting)).observe(hero.querySelector('.stage')!);
  }
</script>

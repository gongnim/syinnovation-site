---
// Trust Gateway hero (user, 2026-11-13): the product-screen demo (GatewayDemo) is the hero on its own, with the free
// PoC/consulting button under it. The page title stays for search and screen readers only.
// The blueprint film this replaced (GatewayHero + SketchHero) is kept unused in src/components; to bring it back, put
// <GatewayHero /> here again and re-add the Nanum Pen Script font link in trust-gateway.astro's head slot.
import GatewayDemo from '../GatewayDemo.astro';
---
<section class="th">
  <div class="wrap">
    <h1 class="sr-only">Trust Gateway: Never Trust, Always Verify. 아무도 믿지 않고, 매번 확인합니다</h1>
    <GatewayDemo />
    <div class="th-cta"><a class="btn primary" href="/contact?type=poc">무료 PoC/컨설팅 신청</a></div>
  </div>
</section>

<style>
  .th { background: var(--night); color: var(--on-night); padding: calc(96px + clamp(32px, 4vw, 56px)) 0 clamp(56px, 6vw, 88px); }
  .th-cta { margin-top: clamp(24px, 3vw, 32px); display: flex; justify-content: center; }
</style>

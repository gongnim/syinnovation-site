---
// "Zero Trust is the principle, Trust Gateway is the solution (솔루션)." Many visitors take 제로트러스트 for our product name;
// this band says the difference once, plainly, and draws each principle across to the Trust Gateway feature that
// carries it out. On /trust-gateway right under the hero (TgIntro, whose title already says Trust Gateway is built on
// zero trust), so its own heading asks what zero trust is (2026-11-16). It was getting long, so it is three pages
// that turn every 7 seconds like the team slider on /company (user, 2026-11-16): the principles, then the slots
// "nist" (NIST SP 800-207 mapping) and "cisa" (CISA maturity model), both filled by the page, then a summary page
// that builds itself and stays 13 seconds.
// first: it opens the page, so its heading is the page's h1 and it clears the fixed header
interface Props { id?: string; tone?: 'white' | 'mist'; first?: boolean }
const { id, tone = 'white', first = false } = Astro.props;
const H = first ? 'h1' : 'h2';
const rows = [
  { p: '아무도 믿지 않는다', pe: 'Never Trust', t: '비밀번호만으로는 열리지 않습니다', td: '기기 인증서와 휴대폰 생체 확인을 함께 요구합니다' },
  { p: '매번 확인한다', pe: 'Always Verify', t: '로그인 뒤에도 요청마다 다시 판단합니다', td: '다중 신호 교차 검증 결과를 판단 엔진이 단계별로 평가합니다' },
  { p: '필요한 만큼만 연다', pe: 'Least Privilege', t: '허락된 앱과 경로만 엽니다', td: '사내망 전체가 아니라 정책에 지정한 곳만 열립니다' },
];
const N = 4; // pages: the principles, the NIST slot, the CISA slot, the summary
// page 4 (user, 2026-11-16): pages 1-3 on one sheet that builds itself column by column: the principles, the public
// standard (NIST SP 800-207), how Trust Gateway carries each part out, the CISA areas it maps to, then what it does
const sum = {
  p: [['아무도 믿지 않는다', 'Never Trust'], ['매번 확인한다', 'Always Verify'], ['필요한 만큼만 연다', 'Least Privilege']],
  n: [['PEP · 정책 시행', '접근 요청을 가로채 허용하거나 막습니다'], ['PDP · 정책 결정', '허용, 추가 인증, 거부를 정합니다'], ['PIP · 정책 정보', '판단에 필요한 정보를 줍니다']],
  t: [['접속 관문', '요청마다 인증서를 확인하고 허용된 요청만 전달합니다'], ['정책 엔진', '금지 사항을 확인하고 최종 결정합니다'], ['이상 탐지', '평소와 다른 정도와 PC·휴대폰 신호의 불일치를 넘깁니다']],
  c: ['신원', '기기', '네트워크', '애플리케이션', '데이터', '가시성 · 분석', '자동화', '거버넌스'],
};
const at = (s: number) => `--at:${s}`;
---
<section class:list={['section', { mist: tone === 'mist', first }]} id={id}>
  <div class="wrap">
    <div class="head-center reveal">
      <H class="h2">제로트러스트는 무엇인가요?</H>
      <p class="lead">아무도 믿지 않고, 매번 확인하고, 필요한 만큼만 여는 보안 원칙입니다. <br />Trust Gateway는 원칙마다 이렇게 지킵니다.</p>
    </div>

    <div class="pages reveal" aria-roledescription="carousel" aria-label="제로트러스트와 Trust Gateway">
      <div class="track" tabindex="0" aria-label="제로트러스트와 Trust Gateway, 좌우 화살표로 넘기기">
        <div class="pg" role="group" aria-roledescription="slide" aria-label={`1 / ${N}, 원칙마다 이렇게 지킵니다`}>
    <div class="zt">
      <div class="zt-h p">
        <b>제로트러스트</b>
        <span>보안 원칙 · 미국 NIST·CISA와 한국 과학기술정보통신부가 기준을 공개했습니다</span>
      </div>
      <i class="zt-gap" aria-hidden="true"></i>
      <div class="zt-h t">
        <b>Trust Gateway</b>
        <span>신영이노베이션의 솔루션 · 그 원칙을 적용하여 개발했습니다</span>
      </div>
      {rows.map((r, k) => (
        <>
          <div class="zt-p" style={`--k:${k}`}><b>{r.p}</b><span>{r.pe}</span></div>
          <i class="zt-link" style={`--k:${k}`} aria-hidden="true"></i>
          <div class="zt-t" style={`--k:${k}`}><b>{r.t}</b><span>{r.td}</span></div>
        </>
      ))}
    </div>
        </div>
        <div class="pg" role="group" aria-roledescription="slide" aria-label={`2 / ${N}, NIST 제로트러스트 아키텍처`}><slot name="nist" /></div>
        <div class="pg" role="group" aria-roledescription="slide" aria-label={`3 / ${N}, CISA 성숙도 모델`}><slot name="cisa" /></div>
        <div class="pg" role="group" aria-roledescription="slide" aria-label={`4 / ${N}, 한눈에 보기`} data-dur="13000">
          <div class="sum">
            <h3 class="h3 in" style={at(0)}>원칙부터 성숙도 대응까지 한눈에</h3>
            <div class="fm">
              <div class="fc c1">
                <p class="fh in" style={at(0.2)}><small>01 원칙</small><b>제로트러스트</b></p>
                {sum.p.map(([k, e], i) => <p class="it in" style={at(0.5 + i * 0.3)}><b>{k}</b><span>{e}</span></p>)}
              </div>
              <div class="fa a1"><i class="ar" style={at(1.5)}></i></div>
              <div class="fc c2">
                <p class="fh in" style={at(1.9)}><small>02 공개된 기준</small><b>NIST SP 800-207</b></p>
                {sum.n.map(([k, e], i) => <p class="it in" style={at(2.2 + i * 0.3)}><b>{k}</b><span>{e}</span></p>)}
              </div>
              <div class="fa a2">{sum.n.map((_, i) => <i class="ar" style={at(3.2 + i * 0.25)}></i>)}</div>
              <div class="fc c3">
                <p class="fh in" style={at(3.2)}><small>03 Trust Gateway에 적용</small><b>Trust Gateway</b></p>
                {sum.t.map(([k, e], i) => <p class="it in" style={at(3.5 + i * 0.25)}><b>{k}</b><span>{e}</span></p>)}
              </div>
              <div class="fa a3"><i class="ar" style={at(4.4)}></i></div>
              <div class="fc c4">
                <p class="fh in" style={at(4.7)}><small>04 성숙도 모델 대응</small><b>CISA 2.0</b></p>
                <ul class="chips">{sum.c.map((c, i) => <li class="in" style={at(5 + i * 0.15)}>{c}</li>)}</ul>
              </div>
            </div>
            <p class="line in" style={at(6.6)}>그래서 Trust Gateway는 요청마다 사람과 기기, 네트워크를 다시 확인하고, 허락된 곳만 열고, 모든 판정을 근거와 함께 남깁니다.</p>
          </div>
        </div>
      </div>
      <div class="ctl">
        <p class="count"><b>1</b> / {N}</p>
        <div class="bar" aria-hidden="true"><i></i></div>
        <button type="button" class="nav auto" aria-pressed="false" aria-label="자동 넘김 멈추기">
          <svg class="i-pause" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6v12M15 6v12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
          <svg class="i-play" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M8.5 5.5v13l10-6.5z" fill="currentColor" /></svg>
        </button>
        <button type="button" class="nav prev" aria-label="이전 페이지"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        <button type="button" class="nav next" aria-label="다음 페이지"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
      </div>
    </div>
  </div>
</section>

<style>
  .section.first { padding-top: calc(var(--header-h) + clamp(88px, 9vw, 120px)); }
  /* the pages: one at a time, side by side in a snapping row; each page is a white card */
  .pages { --n: 4; max-width: 1080px; margin: 0 auto; }
  .track { display: flex; align-items: center; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .track::-webkit-scrollbar { display: none; }
  .track:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: var(--r-xl); }
  .pg { flex: 0 0 100%; min-width: 0; scroll-snap-align: start; }
  .pg > .zt, .pg > :global(*) { box-sizing: border-box; padding: clamp(24px, 3vw, 36px); border-radius: var(--r-xl); background: #fff; border: 1px solid var(--line); }
  .ctl { display: flex; align-items: center; gap: 16px; margin-top: 20px; }
  .count { min-width: 44px; font-size: 14px; font-weight: 600; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .count b { color: var(--ink); }
  .bar { flex: 1; height: 2px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .bar i { display: block; height: 100%; width: calc(100% / var(--n)); background: var(--blue); transform: translateX(calc(var(--i, 0) * 100%)); transition: transform .5s var(--ease); }
  .nav { flex: 0 0 auto; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .nav:hover { background: var(--ink); border-color: var(--ink); color: #fff; }
  .nav:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .auto .i-play, .auto[aria-pressed='true'] .i-pause { display: none; }
  .auto[aria-pressed='true'] .i-play { display: block; }

  /* page 4: four columns joined by arrows; the NIST and Trust Gateway rows line up, one arrow each */
  .sum { display: grid; gap: 18px; }
  .fm { display: grid; grid-template-columns: minmax(0, 1fr) 36px minmax(0, 1fr) 36px minmax(0, 1.05fr) 36px minmax(0, 1.1fr); grid-template-rows: auto repeat(3, auto); row-gap: 10px; }
  .fc, .fa { grid-row: 1 / span 4; display: grid; grid-template-rows: subgrid; }
  .c1 { grid-column: 1; } .a1 { grid-column: 2; } .c2 { grid-column: 3; } .a2 { grid-column: 4; } .c3 { grid-column: 5; } .a3 { grid-column: 6; } .c4 { grid-column: 7; }
  .a1 .ar, .a3 .ar { grid-row: 2 / span 3; }
  .a2 .ar:nth-child(1) { grid-row: 2; } .a2 .ar:nth-child(2) { grid-row: 3; } .a2 .ar:nth-child(3) { grid-row: 4; }
  .fh { display: grid; gap: 2px; align-content: end; padding: 0 2px 4px; }
  .fh small { font-size: 12px; font-weight: 700; color: var(--blue); }
  .fh b { font-size: 17px; letter-spacing: -0.01em; }
  .it { display: grid; gap: 3px; align-content: center; padding: 12px 14px; border-radius: var(--r-md); background: var(--paper-2); border: 1px dashed var(--line); }
  .it b { font-size: 15px; }
  .it span { font-size: 13px; line-height: 1.5; color: var(--ink-3); }
  .c2 .it { background: var(--mist); border-style: solid; border-color: transparent; }
  .c3 .it { background: #fff; border: 1px solid var(--blue); }
  .c3 .fh b { color: var(--blue); }
  .chips { grid-row: 2 / span 3; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; align-content: center; }
  .chips li { padding: 10px 8px; border-radius: var(--r-md); background: var(--mist); font-size: 14px; font-weight: 700; text-align: center; word-break: keep-all; }
  .ar { position: relative; align-self: center; height: 2px; margin: 0 6px; background: var(--blue); transform-origin: left; }
  .ar::after { content: ''; position: absolute; right: -2px; top: -5px; width: 10px; height: 12px; background: var(--blue); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .line { padding: 14px 18px; border-radius: var(--r-md); background: var(--blue); color: #fff; font-size: 16px; font-weight: 700; line-height: 1.6; text-align: center; }
  /* it builds itself each time the page comes up (.run, set by the script); without it the finished sheet shows */
  .pg.run .in { animation: s-in .45s var(--ease) calc(var(--at) * 1s) both; }
  .pg.run .ar { animation: s-draw .5s var(--ease) calc(var(--at) * 1s) both; }
  @keyframes s-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes s-draw { from { transform: scaleX(0); } to { transform: none; } }
  /* three columns: the principle, a line drawn across, the product feature that carries it out */
  .zt { display: grid; grid-template-columns: minmax(0, 1fr) clamp(56px, 9vw, 120px) minmax(0, 1.15fr); align-items: stretch; row-gap: 12px; }
  .zt-h { display: grid; gap: 6px; padding: 0 4px 8px; }
  .zt-h b { font-size: clamp(20px, 1.6vw, 24px); letter-spacing: -0.02em; }
  .zt-h span { font-size: 14px; color: var(--ink-3); line-height: 1.55; }
  .zt-h.t b { color: var(--blue); }
  .zt-p, .zt-t { display: grid; gap: 4px; align-content: center; padding: 18px 22px; border-radius: var(--r-lg); }
  .zt-p { background: var(--paper-2); border: 1px dashed var(--line); }
  .zt-p b { font-size: 18px; }
  .zt-p span { font-size: 13px; color: var(--ink-3); font-weight: 600; }
  .zt-t { background: #fff; border: 1px solid var(--blue); box-shadow: 0 10px 28px -20px rgba(29, 58, 95, .5); }
  .zt-t b { font-size: 17px; color: var(--ink); }
  .zt-t span { font-size: 14px; color: var(--ink-2); }
  .section.mist .zt-p { background: #fff; }
  .zt-link { position: relative; align-self: center; height: 2px; margin: 0 6px; background: var(--blue); transform-origin: left; }
  .zt-link::after { content: ''; position: absolute; right: -2px; top: -5px; width: 10px; height: 12px; background: var(--blue); clip-path: polygon(0 0, 100% 50%, 0 100%); }

  /* in view: each line draws across, then its product feature settles in */
  :global(html.js) .zt:not(.play) .zt-link { transform: scaleX(0); }
  :global(html.js) .zt:not(.play) .zt-link::after, :global(html.js) .zt:not(.play) .zt-t { opacity: 0; }
  .zt.play .zt-link { animation: zt-draw .6s var(--ease) calc(.3s + var(--k) * .45s) both; }
  .zt.play .zt-link::after { animation: zt-in .3s var(--ease) calc(.8s + var(--k) * .45s) both; }
  .zt.play .zt-t { animation: zt-in .5s var(--ease) calc(.8s + var(--k) * .45s) both; }
  @keyframes zt-draw { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes zt-in { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }

  @media (max-width: 767px) {
    .head-center .h2 br { display: none; }
    .zt { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .zt-h { padding: 0 0 10px; }
    .zt-gap { display: none; }
    .zt-h.t { padding-top: 4px; }
    .zt-p { margin-top: 16px; }
    .zt-link { justify-self: center; width: 2px; height: 22px; margin: 4px 0; transform-origin: top; }
    .zt-link::after { right: auto; left: -5px; top: auto; bottom: -2px; width: 12px; height: 10px; clip-path: polygon(0 0, 100% 0, 50% 100%); }
    :global(html.js) .zt:not(.play) .zt-link { transform: scaleY(0); }
    @keyframes zt-draw { from { transform: scaleY(0); } to { transform: none; } }
    /* page 4 stacks: each column under the one before, a short down arrow between them */
    .fm { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .fm > * { grid-column: auto; grid-row: auto; }
    .fc { grid-template-rows: none; gap: 8px; }
    .fa { grid-template-rows: none; justify-items: center; }
    .fa .ar { grid-row: auto; width: 2px; height: 22px; margin: 4px 0; transform-origin: top; }
    .a2 .ar:not(:first-child) { display: none; }
    .ar::after { right: auto; left: -5px; top: auto; bottom: -2px; width: 12px; height: 10px; clip-path: polygon(0 0, 100% 0, 50% 100%); }
    .chips { grid-row: auto; }
    @keyframes s-draw { from { transform: scaleY(0); } to { transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .zt .zt-link, :global(html.js) .zt .zt-link::after, :global(html.js) .zt .zt-t { transform: none; opacity: 1; animation: none; }
  }
</style>

<script>
  // the pages turn every 7s, like the team slider on /company: they hold while pointed at or keyboard-focused, off
  // screen or in a background tab, after the pause button, and never turn by themselves with reduced motion
  document.querySelectorAll<HTMLElement>('.pages').forEach((box) => {
    const track = box.querySelector<HTMLElement>('.track')!;
    const n = track.children.length;
    const smooth: ScrollBehavior = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
    const autoBtn = box.querySelector<HTMLButtonElement>('.auto')!;
    const pages = [...track.children] as HTMLElement[];
    const dur = pages.map((p) => Number(p.dataset.dur) || 7000); // the summary page stays longer
    let cur = 0, stopped = smooth === 'auto', hold = false, focus = false, seen = false, timer = 0;
    const show = (i: number) => {
      if (i === cur) return;
      cur = i;
      box.style.setProperty('--i', String(i));
      box.querySelector('.count b')!.textContent = String(i + 1);
      // a page that animates (page 4) builds itself again each time it comes up; reduced motion keeps it finished
      pages.forEach((p, k) => {
        p.classList.remove('run');
        if (k === i && smooth === 'smooth') { void p.offsetWidth; p.classList.add('run'); }
      });
      arm();
    };
    const arm = () => {
      clearTimeout(timer);
      if (stopped || hold || focus || !seen || document.hidden) return;
      timer = window.setTimeout(() => go(cur + 1, cur === n - 1 ? 'auto' : smooth), dur[cur]);
    };
    const go = (i: number, behavior = smooth) => { track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior }); arm(); };
    const syncAuto = () => {
      autoBtn.setAttribute('aria-pressed', String(stopped));
      autoBtn.setAttribute('aria-label', stopped ? '자동 넘김 켜기' : '자동 넘김 멈추기');
    };
    autoBtn.addEventListener('click', () => { stopped = !stopped; syncAuto(); arm(); });
    box.addEventListener('mouseenter', () => { hold = true; arm(); });
    box.addEventListener('mouseleave', () => { hold = false; arm(); });
    box.addEventListener('focusin', (e) => { focus = (e.target as HTMLElement).matches(':focus-visible') && e.target !== autoBtn; arm(); });
    box.addEventListener('focusout', () => { focus = false; arm(); });
    box.addEventListener('pointerdown', arm);
    document.addEventListener('visibilitychange', arm);
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; arm(); }, { threshold: 0.4 }).observe(box);
    track.addEventListener('scroll', () => show(Math.round(track.scrollLeft / track.clientWidth)), { passive: true });
    box.querySelector('.prev')!.addEventListener('click', () => go(cur - 1));
    box.querySelector('.next')!.addEventListener('click', () => go(cur + 1));
    track.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      if (d) { e.preventDefault(); go(cur + d); }
    });
    syncAuto();
  });

  // play once each visit: start when a quarter is on screen, reset when it has left
  document.querySelectorAll<HTMLElement>('.zt').forEach((el) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.classList.add('play'); return; }
    new IntersectionObserver(([e]) => {
      if (e.intersectionRatio >= 0.25) el.classList.add('play');
      else if (!e.isIntersecting) el.classList.remove('play');
    }, { threshold: [0, 0.25] }).observe(el);
  });
</script>

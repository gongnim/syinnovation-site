---
// "Zero Trust is the principle, Trust Gateway is the solution (솔루션)." Many visitors take 제로트러스트 for our product name;
// this band says the difference once, plainly. On /trust-gateway right under the hero (TgIntro, whose title already says
// Trust Gateway is built on zero trust), so its own heading asks what zero trust is (2026-11-16). One sheet (user,
// 2026-11-16: the summary alone is enough; the principles, NIST and CISA pages of the old carousel went): the
// principles, the public standard (NIST SP 800-207), how Trust Gateway carries each part out, the CISA areas it maps to,
// then what it does. It shows all at once (user, 2026-11-16: no build-up needed).
// first: it opens the page, so its heading is the page's h1 and it clears the fixed header
interface Props { id?: string; tone?: 'white' | 'mist'; first?: boolean }
import { langOf } from '../../lib/i18n';
const en = langOf(Astro.url) === 'en';
const { id, tone = 'white', first = false } = Astro.props;
const H = first ? 'h1' : 'h2';
const sum = en ? {
  p: [['Trust no one', 'Never Trust'], ['Verify each time', 'Always Verify'], ['Open only what is needed', 'Least Privilege']],
  n: [['PEP · Policy Enforcement Point', 'Intercepts access requests and allows or blocks them'], ['PDP · Policy Decision Point', 'Decides Allow, Step-up or Deny'], ['PIP · Policy Information Point', 'Supplies the information the decision needs']],
  t: [['Access Gateway', 'Checks the certificate each time and passes on only allowed connections'], ['Policy Engine', 'Combines the Cross Check, Rule Engine and Anomaly Detection results with policy and makes the Final Decision'], ['Cross Check · Anomaly Detection', 'Pass on contradictions between PC and phone signals and how far things differ from usual']],
  c: ['Identity', 'Devices', 'Networks', 'Applications', 'Data', 'Visibility & Analytics', 'Automation', 'Governance'],
} : {
  p: [['아무도 믿지 않는다', 'Never Trust'], ['매번 확인한다', 'Always Verify'], ['필요한 만큼만 연다', 'Least Privilege']],
  n: [['PEP · 정책 시행', '접근 요청을 가로채 허용하거나 막습니다'], ['PDP · 정책 결정', '허용, 추가 인증, 거부를 정합니다'], ['PIP · 정책 정보', '판단에 필요한 정보를 줍니다']],
  t: [['접속 관문', '매번 인증서를 확인하고 허용된 접속만 전달합니다'], ['정책 엔진', '교차 검증, 규칙 엔진, 이상 탐지 결과와 정책을 종합해 최종 결정합니다'], ['교차 검증 · 이상 탐지', 'PC·휴대폰 신호의 모순과 평소와 다른 정도를 넘깁니다']],
  c: ['신원', '기기', '네트워크', '애플리케이션', '데이터', '가시성 · 분석', '자동화', '거버넌스'],
};
---
<section class:list={['section', { mist: tone === 'mist', first }]} id={id}>
  <div class="wrap">
    <div class="head-center reveal">
      <H class="h2">{en ? <>What is Zero Trust?</> : <>제로트러스트는 무엇인가요?</>}</H>
      <p class="lead">{en ? <>A security principle: trust no one, verify each time, and open only what is needed. <br />Here is how Trust Gateway keeps each principle.</> : <>아무도 믿지 않고, 매번 확인하고, 필요한 만큼만 여는 보안 원칙입니다. <br />Trust Gateway는 원칙마다 이렇게 지킵니다.</>}</p>
    </div>

    <div class="sum reveal">
      <h3 class="h3">{en ? <>From principles to maturity mapping, at a glance</> : <>원칙부터 성숙도 대응까지 한눈에</>}</h3>
      <div class="fm">
        <div class="fc c1">
          <p class="fh"><small>{en ? <>01 Principle</> : <>01 원칙</>}</small><b>{en ? <>Zero Trust</> : <>제로트러스트</>}</b></p>
          {sum.p.map(([k, e], i) => <p class="it"><b>{k}</b><span>{e}</span></p>)}
        </div>
        <div class="fa a1"><i class="ar"></i></div>
        <div class="fc c2">
          <p class="fh"><small>{en ? <>02 Public standard</> : <>02 공개된 기준</>}</small><b>NIST SP 800-207</b></p>
          {sum.n.map(([k, e], i) => <p class="it"><b>{k}</b><span>{e}</span></p>)}
        </div>
        <div class="fa a2">{sum.n.map((_, i) => <i class="ar"></i>)}</div>
        <div class="fc c3">
          <p class="fh"><small>{en ? <>03 Applied in Trust Gateway</> : <>03 Trust Gateway에 적용</>}</small><b>Trust Gateway</b></p>
          {sum.t.map(([k, e], i) => <p class="it"><b>{k}</b><span>{e}</span></p>)}
        </div>
        <div class="fa a3"><i class="ar"></i></div>
        <div class="fc c4">
          <p class="fh"><small>{en ? <>04 Maturity model mapping</> : <>04 성숙도 모델 대응</>}</small><b>CISA 2.0</b></p>
          <ul class="chips">{sum.c.map((c, i) => <li>{c}</li>)}</ul>
        </div>
      </div>
      <p class="line">{en ? <>So Trust Gateway checks the person, the device and the network again at every moment, opens only what is allowed, and logs every decision with its reasons.</> : <>그래서 Trust Gateway는 매 순간 사람과 기기, 네트워크를 다시 확인하고, 허락된 곳만 열고, 모든 판정을 근거와 함께 남깁니다.</>}</p>
    </div>
  </div>
</section>

<style>
  .section.first { padding-top: calc(var(--header-h) + clamp(88px, 9vw, 120px)); }
  /* one white card: four columns joined by arrows; the NIST and Trust Gateway rows line up, one arrow each */
  .sum { display: grid; gap: 18px; max-width: 1080px; margin: 0 auto; padding: clamp(24px, 3vw, 36px); border-radius: var(--r-xl); background: #fff; border: 1px solid var(--line); }
  .fm { display: grid; grid-template-columns: minmax(0, 1fr) 36px minmax(0, 1fr) 36px minmax(0, 1.05fr) 36px minmax(0, 1.1fr); grid-template-rows: auto repeat(3, auto); row-gap: 10px; }
  .fc, .fa { grid-row: 1 / span 4; display: grid; grid-template-rows: subgrid; }
  .c1 { grid-column: 1; } .a1 { grid-column: 2; } .c2 { grid-column: 3; } .a2 { grid-column: 4; } .c3 { grid-column: 5; } .a3 { grid-column: 6; } .c4 { grid-column: 7; }
  .a1 .ar, .a3 .ar { grid-row: 2 / span 3; }
  .a2 .ar:nth-child(1) { grid-row: 2; } .a2 .ar:nth-child(2) { grid-row: 3; } .a2 .ar:nth-child(3) { grid-row: 4; }
  .fh { display: grid; gap: 2px; align-content: end; padding: 0 2px 4px; }
  .fh small { font-size: 12px; font-weight: 700; color: var(--blue); }
  .fh b { font-size: 17px; letter-spacing: -0.01em; }
  .it { display: grid; gap: 3px; align-content: center; padding: 12px 14px; border-radius: var(--r-md); background: var(--paper-2); border: 1px dashed var(--line); }
  .it b { font-size: 15px; }
  .it span { font-size: 13px; line-height: 1.5; color: var(--ink-3); }
  .c2 .it { background: var(--mist); border-style: solid; border-color: transparent; }
  .c3 .it { background: #fff; border: 1px solid var(--blue); }
  .c3 .fh b { color: var(--blue); }
  .chips { grid-row: 2 / span 3; list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; align-content: center; }
  .chips li { padding: 10px 8px; border-radius: var(--r-md); background: var(--mist); font-size: 14px; font-weight: 700; text-align: center; word-break: keep-all; }
  .ar { position: relative; align-self: center; height: 2px; margin: 0 6px; background: var(--blue); }
  .ar::after { content: ''; position: absolute; right: -2px; top: -5px; width: 10px; height: 12px; background: var(--blue); clip-path: polygon(0 0, 100% 50%, 0 100%); }
  .line { padding: 14px 18px; border-radius: var(--r-md); background: var(--blue); color: #fff; font-size: 16px; font-weight: 700; line-height: 1.6; text-align: center; }

  @media (max-width: 767px) {
    .head-center .h2 br { display: none; }
    /* it stacks: each column under the one before, a short down arrow between them */
    .fm { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .fm > * { grid-column: auto; grid-row: auto; }
    .fc { grid-template-rows: none; gap: 8px; }
    .fa { grid-template-rows: none; justify-items: center; }
    .fa .ar { grid-row: auto; width: 2px; height: 22px; margin: 4px 0; }
    .a2 .ar:not(:first-child) { display: none; }
    .ar::after { right: auto; left: -5px; top: auto; bottom: -2px; width: 12px; height: 10px; clip-path: polygon(0 0, 100% 0, 50% 100%); }
    .chips { grid-row: auto; }
  }
</style>


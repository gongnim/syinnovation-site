---
// "Zero Trust is the principle, Trust Gateway is the solution (솔루션)." Many visitors take 제로트러스트 for our product name;
// this band says the difference once, plainly, and draws each principle across to the Trust Gateway feature that
// carries it out. Used on /trust-gateway, where the NIST mapping goes in the slot (it left home on 2026-11-13).
interface Props { id?: string; tone?: 'white' | 'mist' }
const { id, tone = 'white' } = Astro.props;
const rows = [
  { p: '아무도 믿지 않는다', pe: 'Never Trust', t: '비밀번호만으로는 열리지 않습니다', td: '기기 인증서와 휴대폰 생체 확인을 함께 요구합니다' },
  { p: '매번 확인한다', pe: 'Always Verify', t: '로그인 뒤에도 요청마다 다시 판단합니다', td: '다중 신호 교차 검증 결과를 판단 엔진이 단계별로 평가합니다' },
  { p: '필요한 만큼만 연다', pe: 'Least Privilege', t: '허락된 앱과 경로만 엽니다', td: '사내망 전체가 아니라 정책에 지정한 곳만 열립니다' },
];
---
<section class:list={['section', { mist: tone === 'mist' }]} id={id}>
  <div class="wrap">
    <div class="head-center reveal">
      <h2 class="h2">Trust Gateway는 제로트러스트 <br />설계 원칙 기반 솔루션입니다</h2>
    </div>

    <div class="zt reveal">
      <div class="zt-h p">
        <b>제로트러스트</b>
        <span>보안 원칙 · 미국 NIST·CISA와 한국 과학기술정보통신부가 기준을 공개했습니다</span>
      </div>
      <i class="zt-gap" aria-hidden="true"></i>
      <div class="zt-h t">
        <b>Trust Gateway</b>
        <span>신영이노베이션의 솔루션 · 그 원칙을 회사의 업무 접속에 적용합니다</span>
      </div>
      {rows.map((r, k) => (
        <>
          <div class="zt-p" style={`--k:${k}`}><b>{r.p}</b><span>{r.pe}</span></div>
          <i class="zt-link" style={`--k:${k}`} aria-hidden="true"></i>
          <div class="zt-t" style={`--k:${k}`}><b>{r.t}</b><span>{r.td}</span></div>
        </>
      ))}
    </div>

    <slot />
  </div>
</section>

<style>
  /* three columns: the principle, a line drawn across, the product feature that carries it out */
  .zt { display: grid; grid-template-columns: minmax(0, 1fr) clamp(56px, 9vw, 120px) minmax(0, 1.15fr); align-items: stretch; row-gap: 12px; max-width: 1080px; margin: 0 auto; }
  .zt-h { display: grid; gap: 6px; padding: 0 4px 8px; }
  .zt-h b { font-size: clamp(20px, 1.6vw, 24px); letter-spacing: -0.02em; }
  .zt-h span { font-size: 14px; color: var(--ink-3); line-height: 1.55; }
  .zt-h.t b { color: var(--blue); }
  .zt-p, .zt-t { display: grid; gap: 4px; align-content: center; padding: 18px 22px; border-radius: var(--r-lg); }
  .zt-p { background: var(--paper-2); border: 1px dashed var(--line); }
  .zt-p b { font-size: 18px; }
  .zt-p span { font-size: 13px; color: var(--ink-3); font-weight: 600; }
  .zt-t { background: #fff; border: 1px solid var(--blue); box-shadow: 0 10px 28px -20px rgba(29, 58, 95, .5); }
  .zt-t b { font-size: 17px; color: var(--ink); }
  .zt-t span { font-size: 14px; color: var(--ink-2); }
  .section.mist .zt-p { background: #fff; }
  .zt-link { position: relative; align-self: center; height: 2px; margin: 0 6px; background: var(--blue); transform-origin: left; }
  .zt-link::after { content: ''; position: absolute; right: -2px; top: -5px; width: 10px; height: 12px; background: var(--blue); clip-path: polygon(0 0, 100% 50%, 0 100%); }

  /* in view: each line draws across, then its product feature settles in */
  :global(html.js) .zt:not(.play) .zt-link { transform: scaleX(0); }
  :global(html.js) .zt:not(.play) .zt-link::after, :global(html.js) .zt:not(.play) .zt-t { opacity: 0; }
  .zt.play .zt-link { animation: zt-draw .6s var(--ease) calc(.3s + var(--k) * .45s) both; }
  .zt.play .zt-link::after { animation: zt-in .3s var(--ease) calc(.8s + var(--k) * .45s) both; }
  .zt.play .zt-t { animation: zt-in .5s var(--ease) calc(.8s + var(--k) * .45s) both; }
  @keyframes zt-draw { from { transform: scaleX(0); } to { transform: none; } }
  @keyframes zt-in { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: none; } }

  @media (max-width: 767px) {
    .head-center .h2 br { display: none; }
    .zt { grid-template-columns: minmax(0, 1fr); row-gap: 0; }
    .zt-h { padding: 0 0 10px; }
    .zt-gap { display: none; }
    .zt-h.t { padding-top: 4px; }
    .zt-p { margin-top: 16px; }
    .zt-link { justify-self: center; width: 2px; height: 22px; margin: 4px 0; transform-origin: top; }
    .zt-link::after { right: auto; left: -5px; top: auto; bottom: -2px; width: 12px; height: 10px; clip-path: polygon(0 0, 100% 0, 50% 100%); }
    :global(html.js) .zt:not(.play) .zt-link { transform: scaleY(0); }
    @keyframes zt-draw { from { transform: scaleY(0); } to { transform: none; } }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .zt .zt-link, :global(html.js) .zt .zt-link::after, :global(html.js) .zt .zt-t { transform: none; opacity: 1; animation: none; }
  }
</style>

<script>
  // play once each visit: start when a quarter is on screen, reset when it has left
  document.querySelectorAll<HTMLElement>('.zt').forEach((el) => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) { el.classList.add('play'); return; }
    new IntersectionObserver(([e]) => {
      if (e.intersectionRatio >= 0.25) el.classList.add('play');
      else if (!e.isIntersecting) el.classList.remove('play');
    }, { threshold: [0, 0.25] }).observe(el);
  });
</script>

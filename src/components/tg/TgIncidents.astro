---
// Home, right under the hero (only there since 2026-11-13; it left /trust-gateway as a duplicate): recent incidents as a slowly moving photo strip. Each card pairs where
// the incident came in (from the reports, attributed) with the point Trust Gateway checks. It never says Trust Gateway
// would have prevented the incident. The cards keep themselves current (user, 2026-11-16): the newest domestic
// stories that have a write-up on 언론보도 (src/data/security-stories.json), so a story written up today shows here
// on the next build. Its two lines come from `lines` when written for it, else the first sentence of its cause and
// the line for its kind. 쿠팡 stays last and links to the government findings (과기정통부 민관합동조사단, 2026-02-10).
// Pictures: the small inc- copy when there is one, else the story's own picture; Pexels (Daniil Komov 34803994) for 쿠팡.
import { existsSync } from 'node:fs';
import { security } from '../../data/news';
import storiesJson from '../../data/security-stories.json';

const SHOW = 8;
// written for the card: how it came in (attributed, from the story's cause) and the point Trust Gateway checks
const lines: Record<string, { path: string; tg: string }> = {
  'coinone-2026-11': { path: '고객상담을 맡은 위탁업체 서버에 외부 공격자가 침입했습니다. 침입 방법은 조사 중입니다.', tg: '위탁업체가 업무 시스템에 접속할 때도 등록된 기기와 휴대폰 확인을 거치고, 요청마다 다시 평가합니다.' },
  'lazarus-targets-2026-11': { path: '패치하지 않은 PHP 웹 서버의 취약점을 노려 웹셸을 심고, 관리자 계정을 빼내 내부로 옮겨 갔다고 보도됐습니다.', tg: '업무 시스템은 인터넷에 들어오는 포트를 열지 않습니다. 관리자 계정을 빼내도 등록된 기기와 본인 휴대폰이 없으면 열리지 않습니다.' },
  'chak-2026-11': { path: '외부 비인가자가 접근해 이용자 정보 일부를 조회했습니다. 침입 경로는 조사 중입니다.', tg: '운영자 화면과 내부 조회는 등록된 기기와 본인 휴대폰을 함께 확인한 요청에만 열립니다.' },
  'inje-univ-2026-11': { path: '수업 운영 사이트와 관련된 서버가 외부 공격으로 침해됐습니다. 침입 방법은 공개되지 않았습니다.', tg: '서버의 관리 화면은 인터넷에 문을 열지 않고, 등록된 기기와 본인 휴대폰을 함께 확인한 요청만 받습니다.' },
  'yellow-umbrella-2026-11': { path: '외부 비인가자가 홈페이지에 비정상적으로 접근한 정황이 확인됐습니다. 접근 방법은 공개되지 않았습니다.', tg: '내부 조회 시스템은 요청마다 사람과 기기를 다시 확인하고, 모든 판정을 근거와 함께 남깁니다.' },
  'kakaowork-2026-11': { path: '업무용 메신저 시스템에 외부 공격자가 무단으로 접근했습니다. 침입 경로는 조사 중입니다.', tg: '웹으로 쓰는 메일, 메신저 같은 업무 시스템도 등록된 PC와 본인 휴대폰을 함께 확인한 요청에만 열립니다.' },
  'modu-startup-2026-11': { path: '관리자 페이지를 통한 SQL 인젝션으로 정보를 빼내려는 시도가 확인됐습니다(업체 신고서 기준).', tg: '관리자 페이지는 인터넷에 열리지 않습니다. 등록된 기기와 본인 휴대폰을 함께 확인한 요청만 닿습니다.' },
  'kb-capital-2026-11': { path: '직원과 협력사가 쓰는 내부 시스템에 국내 IP에서 조회가 들어왔다고 회사가 설명했습니다.', tg: '협력사 계정도 등록된 기기와 휴대폰 확인을 거칩니다. 국내 IP라도 평소와 다르면 다시 묻습니다.' },
  'fsec-2026-11': { path: '시스템 약점을 이용해 높은 열람 권한을 얻었고, 여러 IP에서 접근했습니다.', tg: '권한이 있어도 요청마다 기기와 사람, 네트워크를 다시 확인합니다. 평소와 다르면 휴대폰으로 다시 묻습니다.' },
  'mirae-asset-2026-11': { path: '로그인 서비스와 그룹웨어를 거쳐, 권한 없는 외부인이 내부 데이터를 조회했습니다.', tg: '그룹웨어 같은 업무 앱은 등록된 PC와 본인 휴대폰 확인을 함께 통과한 요청에만 열립니다.' },
  'ai-hacking-ring-2026-10': { path: 'AI 침투 도구가 인터넷에 열린 시스템의 약점을 스스로 찾아 들어갔습니다.', tg: '업무 시스템은 인터넷에 문을 열지 않습니다. 들어오는 포트가 없고, 등록된 기기의 요청만 받습니다.' },
  'korean-air-asiana-2026-10': { path: '예약 시스템 운영사 계정의 로그인 정보로 비인가 접근이 일어났습니다.', tg: '아이디와 비밀번호만으로는 열리지 않습니다. 기기 인증서와 휴대폰 생체 확인이 함께 필요합니다.' },
  'kepco-2026-10': { path: '원인은 조사 중입니다. 직원 계정을 공유받아 접속한 사례가 지적됐고, 접속 기록이 남아 있지 않았습니다.', tg: '계정을 빌려도 그 사람의 휴대폰과 기기가 없으면 열리지 않습니다. 모든 판정은 근거와 함께 기록됩니다.' },
  'shinhan-bank-2026-10': { path: '대출모집인 전용 조회 서비스의 본인 확인 절차가 우회됐습니다.', tg: '외부 인력의 업무 접속도 등록된 기기와 휴대폰 확인을 거치고, 요청마다 다시 평가합니다.' },
};
// for a story without its own lines: what Trust Gateway checks for that kind of incident (tech doc v0.4.3)
const byKind: Record<string, string> = {
  해킹: '업무 시스템은 인터넷에 문을 열지 않습니다. 등록된 기기와 본인 휴대폰을 함께 확인한 요청만 받습니다.',
  '개인정보 유출': '내부 조회는 요청마다 사람과 기기, 네트워크 신호를 다시 확인하고, 평소와 다르면 휴대폰으로 다시 묻습니다.',
  '공급망 공격': '협력사와 위탁업체의 접속도 등록된 기기와 휴대폰 확인을 거치고, 요청마다 다시 평가합니다.',
  '계정 탈취': '아이디와 비밀번호만으로는 열리지 않습니다. 등록된 기기와 본인 휴대폰 확인이 함께 필요합니다.',
};
const stories = storiesJson as Record<string, { cause?: string[] }>;
const first = (s: string) => s.match(/^.*?다\.(?=\s|$)/)?.[0] ?? s;
// labelledBy: the heading lives elsewhere (on home it sits inside the hero's sphere) and labels this section
const { labelledBy } = Astro.props as { labelledBy?: string };
const dot = (d: string) => d.slice(0, 10).replaceAll('-', '.');
const cards = [
  ...security
    .filter((n) => n.slug && !n.youtube && n.region === '국내' && (lines[n.slug] || stories[n.slug]?.cause?.length))
    .slice(0, SHOW)
    .map((n) => {
      const slug = n.slug!;
      const small = `/images/trust-gateway/inc-${slug}.webp`;
      return {
        slug, href: `/news/press/${slug}`, ext: false, title: n.title, meta: `${dot(n.date)} · ${n.source} 보도`,
        img: existsSync(`public${small}`) ? small : n.image,
        path: lines[slug]?.path ?? first(stories[slug].cause![0]),
        tg: lines[slug]?.tg ?? byKind[n.type] ?? byKind['해킹'],
      };
    }),
  {
    slug: 'coupang', href: 'https://v.daum.net/v/20260210170044700', ext: true, img: '/images/trust-gateway/inc-coupang.webp',
    meta: '2026.02.10 · 과기정통부 조사 결과', title: '쿠팡, 고객 정보 3,367만여 건 유출',
    path: '퇴사한 개발자가 재직 중 빼낸 인증 서명 키로 토큰을 위조해 접속했습니다. 키는 퇴사 뒤에도 바뀌지 않았습니다.',
    tg: 'Trust Gateway의 기기 인증 키는 각 기기의 보안 칩 밖으로 나오지 않습니다. 퇴사가 반영되면 인증서가 폐기돼 다음 요청부터 거부됩니다.',
  },
];
---
<section class="section inc-sec" id="incidents" aria-labelledby={labelledBy}>
  {!labelledBy && (
    <div class="wrap">
      <div class="head-center reveal">
        <h2 class="h2">최근 심각한 보안 사고, 어디가 뚫렸을까요?</h2>
      </div>
    </div>
  )}
  <div class="strip reveal">
    <ul class="track">
      {[0, 1].map((copy) => cards.map((c) => (
        <li aria-hidden={copy ? 'true' : undefined} class={copy ? 'dup' : undefined}>
          <a class="inc" href={c.href} tabindex={copy ? -1 : undefined} target={c.ext ? '_blank' : undefined} rel={c.ext ? 'noopener' : undefined}>
            <img src={c.img} alt="" width="720" height="480" loading="lazy" decoding="async" draggable="false" />
            <span class="inc-b">
              <span class="inc-m">{c.meta}</span>
              <b class="inc-t">{c.title}</b>
              <span class="row in"><span class="k">들어온 길</span>{c.path}</span>
              <span class="row tg"><span class="k">Trust Gateway가 확인하는 지점</span>{c.tg}</span>
            </span>
          </a>
        </li>
      )))}
    </ul>
  </div>
  <div class="wrap">
    <p class="note">사고 원인은 보도와 발표 기준이며, 조사 결과에 따라 달라질 수 있습니다. 카드를 누르면 사고 정리나 출처를 볼 수 있습니다.</p>
  </div>
</section>

<style>
  .inc-sec { overflow: hidden; }
  .strip { --gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding: 4px var(--gutter) 12px; scrollbar-width: thin; }
  .track { list-style: none; margin: 0 auto; padding: 0; display: flex; gap: var(--gap); width: max-content; }
  .track li { scroll-snap-align: center; }
  .track .dup { display: none; }
  .inc { display: flex; flex-direction: column; width: 340px; height: 100%; border-radius: var(--r-xl); overflow: hidden; background: #fff; border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: border-color .3s var(--ease), translate .3s var(--ease); }
  .inc:hover { border-color: var(--ink-3); translate: 0 -4px; }
  .inc:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  .inc img { width: 100%; height: auto; aspect-ratio: 3 / 2; object-fit: cover; display: block; }
  .inc-b { display: grid; gap: 10px; padding: 18px 20px 22px; align-content: start; }
  .inc-m { font-size: 13px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .inc-t { font-size: 17px; line-height: 1.45; letter-spacing: -0.01em; }
  .row { display: grid; gap: 4px; font-size: 14px; line-height: 1.6; color: var(--ink-2); padding: 10px 12px; border-radius: var(--r-md); }
  .row .k { font-size: 12px; font-weight: 700; }
  .row.in { background: #fdf0ee; }
  .row.in .k { color: #b4443a; }
  .row.tg { background: var(--mist); }
  .row.tg .k { color: var(--blue); }
  .note { margin-top: 20px; text-align: center; font-size: 14px; color: var(--ink-3); }

  /* with scripts the strip drifts on its own and can be dragged sideways by mouse or touch (see the script);
     without them it is a plain scrolling row */
  :global(html.js) .strip { overflow: hidden; padding-inline: 0; touch-action: pan-y; cursor: grab; user-select: none; -webkit-user-select: none; }
  :global(html.js) .strip.dragging { cursor: grabbing; }
  :global(html.js) .strip.dragging .inc { pointer-events: none; }
  :global(html.js) .track { margin: 0; will-change: transform; }
  :global(html.js) .track .dup { display: block; }
  @media (min-width: 768px) {
    :global(html.js) .strip { mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  }
  @media (max-width: 767px) {
    .inc { width: 284px; }
    .head-center .lead br { display: none; }
  }
</style>

<script>
  // Drift slowly to the left; a mouse or finger drags it either way and lets go with a little glide. The second copy
  // of the cards makes the row endless. A drag never opens a card; a plain click or tap does.
  const strip = document.querySelector<HTMLElement>('#incidents .strip');
  const track = strip?.querySelector<HTMLElement>('.track');
  if (strip && track) {
    const speed = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 26; // px per second
    let x = 0, v = 0, loop = 1, prev = 0, raf = 0, seen = false, hover = false, idleUntil = 0;
    let down = false, dragging = false, startX = 0, startPos = 0, lastX = 0, lastT = 0, moved = 0;
    const measure = () => {
      const first = track.firstElementChild as HTMLElement, dup = track.querySelector<HTMLElement>('.dup');
      loop = dup ? dup.offsetLeft - first.offsetLeft : track.scrollWidth;
    };
    const paint = () => { x = ((x % loop) + loop) % loop; track.style.transform = `translate3d(${-x}px, 0, 0)`; };
    const frame = (t: number) => {
      const dt = prev ? Math.min(0.05, (t - prev) / 1000) : 0;
      prev = t;
      if (!dragging) {
        if (Math.abs(v) > 8) { x += v * dt; v *= Math.exp(-dt * 3.2); }
        else { v = 0; if (!hover && t > idleUntil) x += speed * dt; }
      }
      paint();
      raf = seen ? requestAnimationFrame(frame) : 0;
    };
    const run = () => { if (!raf && seen) { prev = 0; raf = requestAnimationFrame(frame); } };

    strip.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      down = true; dragging = false; moved = 0; v = 0;
      startX = lastX = e.clientX; startPos = x; lastT = e.timeStamp;
    });
    strip.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      moved = Math.max(moved, Math.abs(dx));
      if (!dragging && moved > 6) { dragging = true; strip.classList.add('dragging'); strip.setPointerCapture(e.pointerId); }
      if (!dragging) return;
      x = startPos - dx;
      const dt = (e.timeStamp - lastT) / 1000;
      if (dt > 0) v = v * 0.4 + (-(e.clientX - lastX) / dt) * 0.6;
      lastX = e.clientX; lastT = e.timeStamp;
      paint();
    });
    const release = () => {
      if (!down) return;
      down = false;
      if (dragging) { v = Math.max(-2400, Math.min(2400, v)); idleUntil = performance.now() + 1800; }
      dragging = false; strip.classList.remove('dragging');
    };
    strip.addEventListener('pointerup', release);
    strip.addEventListener('pointercancel', release);
    // a drag that ends over a card must not open it
    strip.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); moved = 0; } }, true);
    strip.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hover = true; });
    strip.addEventListener('pointerleave', () => { hover = false; });
    // keyboard: a focused card is brought into view and the drift waits
    strip.addEventListener('focusin', (e) => {
      const card = (e.target as HTMLElement).closest('li');
      if (!card) return;
      strip.scrollLeft = 0;
      x = card.offsetLeft - (track.firstElementChild as HTMLElement).offsetLeft - (strip.clientWidth - card.offsetWidth) / 2;
      v = 0; hover = true; paint();
    });
    strip.addEventListener('focusout', () => { hover = false; });

    new ResizeObserver(() => { measure(); paint(); }).observe(track);
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; run(); }).observe(strip);
    measure();
  }
</script>

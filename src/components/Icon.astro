interface Props { name: keyof typeof paths | string; size?: number; label?: string; class?: string }
const { name, size = 24, label, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
  stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}
  set:html={paths[name] ?? ''} />

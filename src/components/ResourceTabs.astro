---
// Tabs under a page title for a section split into pages: 자료실 (문서, 영상, 용어집) by default, or 소식
// (사내소식, 보안사고, 보안뉴스). The 자료실 list is also the header's sub-menu.
// items are menu items (site.ts); on English pages they show their English labels and /en/ links.
import { libraryNav, menu, type MenuItem } from '../data/site';
import { newMark } from '../data/news';
import { langOf, pagePath } from '../lib/i18n';
const lang = langOf(Astro.url);
const en = lang === 'en';
interface Props { items?: MenuItem[]; label?: string }
const { items = libraryNav, label = en ? 'Resources menu' : '자료실 메뉴' } = Astro.props;
const path = pagePath(Astro.url);
const tabs = menu(items, lang);
// the tab whose address is the longest start of this page's: /news/press/page/2 → 보안사고, not 사내소식 (/news)
const on = tabs.filter((t) => path === t.href || path.startsWith(t.href + '/')).sort((a, b) => b.href.length - a.href.length)[0];
---
<nav class="rtabs" aria-label={label}>
  {tabs.map((t) => <a href={t.href} aria-current={t === on ? 'page' : undefined} {...newMark(t.href)}>{t.label}</a>)}
</nav>

<style>
  .rtabs { display: inline-flex; gap: 4px; margin-top: 32px; padding: 4px; border-radius: 999px; background: var(--mist); }
  .rtabs a { display: grid; place-items: center; min-width: 88px; height: 42px; padding: 0 20px; border-radius: 999px; font-size: 15px; font-weight: 700; color: var(--ink-2); }
  .rtabs a:hover { color: var(--ink); }
  .rtabs a[aria-current='page'] { background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--line); }
  /* a 소식 tab with something new the visitor hasn't opened yet (src/layouts/Base.astro sets .has-new) */
  .rtabs a { position: relative; }
  .rtabs a.has-new::after { content: ''; position: absolute; top: 8px; right: 10px; width: 7px; height: 7px; border-radius: 50%; background: var(--orange); }
  /* 소식 has three tabs: keep them inside a 320px phone */
  @media (max-width: 359px) { .rtabs a { min-width: 0; padding: 0 14px; } }
</style>

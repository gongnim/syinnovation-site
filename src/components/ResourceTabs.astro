---
// Tabs under a page title for a section split into pages: 자료실 (문서, 영상, 용어집) by default, or 소식
// (사내소식, 언론보도). The 자료실 list is also the header's sub-menu.
import { libraryNav } from '../data/site';
interface Props { items?: { href: string; label: string }[]; label?: string }
const { items = libraryNav, label = '자료실 메뉴' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<nav class="rtabs" aria-label={label}>
  {items.map((t) => <a href={t.href} aria-current={path === t.href ? 'page' : undefined}>{t.label}</a>)}
</nav>

<style>
  .rtabs { display: inline-flex; gap: 4px; margin-top: 32px; padding: 4px; border-radius: 999px; background: var(--mist); }
  .rtabs a { display: grid; place-items: center; min-width: 88px; height: 42px; padding: 0 20px; border-radius: 999px; font-size: 15px; font-weight: 700; color: var(--ink-2); }
  .rtabs a:hover { color: var(--ink); }
  .rtabs a[aria-current='page'] { background: #fff; color: var(--ink); box-shadow: 0 0 0 1px var(--line); }
</style>

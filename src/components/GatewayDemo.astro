const fdsTips = ['해외 결제 규칙은 기준을 조정', '겹치는 규칙은 하나로 정리', '소액 반복 결제 규칙 추가'];

const tracks = [
  { id: 'access', t: '직원 업무 접속', shots: [
    { k: 'scan', t: '숨은 사내망', dur: 8.5, q: '인터넷에서 우리 업무 서버가 보일까요?', d: '인터넷에서 보이던 업무 서버의 포트가, Trust Gateway를 붙인 뒤에는 보이지 않습니다. 남는 입구는 인증서가 있어야 열리는 게이트웨이뿐입니다.' },
    { k: 'bind', t: '휴대폰으로 본인 확인', dur: 7.5, q: '이 PC를 지금 누가 쓰는지 어떻게 알까요?', d: `PC 화면의 QR을 ${appName} 앱으로 찍고 생체 인증으로 승인합니다. 지금 이 PC를 쓰는 사람이 누구인지 확인합니다.` },
    { k: 'portal', t: '업무 시스템 열림', dur: 6, q: '확인이 끝나면 무엇이 열릴까요?', d: '다시 로그인하지 않고 허락된 업무 시스템만 열립니다. 이후 요청도 계속 확인합니다.' },
    { k: 'xcheck', t: '다중 신호 교차 검증', dur: 12, q: '계정과 PC를 훔치면 들어올 수 있을까요?', d: 'PC와 휴대폰, 네트워크의 신호를 요청마다 대조합니다. 훔친 PC로 다른 곳에서 접속하면 신호가 서로 맞지 않아 휴대폰으로 다시 확인하고, 주인이 승인하지 않으면 그 요청은 거부됩니다.' },
    { k: 'block', t: '인증서 없으면 차단', dur: 7, q: '등록되지 않은 기기가 접속하면요?', d: '인증서가 없는 접속은 연결 단계에서 끊깁니다. 사내망에는 닿지 않습니다.' },
    { k: 'lost', t: '분실 기기 차단', dur: 7.5, q: 'PC를 잃어버렸다면요?', d: '관리 콘솔에서 그 기기의 인증서를 폐기하면, 폐기 정보가 게이트웨이에 바로 전달되어 다음 요청부터 거부됩니다.' },
    { k: 'audit', t: '감사 기록', dur: 7.5, q: '누가 언제 무엇을 했는지 남을까요?', d: '허용, 추가 인증, 거부마다 누가 어디에 접속했고 왜 그렇게 판단했는지 남습니다. 기록은 앞 기록과 이어져 있어 중간을 바꾸면 드러납니다.' },
  ] },
  { id: 'payment', t: '결제 이상거래', shots: [
    { k: 'payflow', t: '누가 쓰나요', dur: 8.5, q: '결제 이상거래 판정은 누가, 언제 쓰나요?', d: '고객이 결제하면 결제대행사나 가맹점이 거래 정보와 기기 신호를 Trust Gateway에 보냅니다. Trust Gateway는 위험을 평가해 권고와 이유를 돌려주고, 최종 결정은 결제대행사나 가맹점이 합니다.' },
    { k: 'paysig', t: '무엇을 보나요', dur: 7.5, q: '무엇을 보고 수상하다고 판단하나요?', d: '금액, 기기, 가맹점, 실패와 재시도처럼 여러 신호를 함께 봅니다. 이 고객의 평소 결제에서 얼마나 벗어났는지를 통계와 기계학습으로 계산합니다.' },
    { k: 'payok', t: '평범한 결제', dur: 6.5, q: '평소와 같은 결제라면요?', d: '모든 신호가 평소와 같으면 승인을 권고하고, 결제는 그대로 진행됩니다.' },
    { k: 'paybig', t: '평소보다 큰 금액', dur: 6.5, q: '평소보다 훨씬 큰 결제라면요?', d: '금액과 가맹점이 평소와 다르면 추가 확인을 권고합니다. 본인 확인만 거치면 정상 결제는 그대로 진행됩니다.' },
    { k: 'payrep', t: '반복 시도', dur: 7, q: '카드 도용이 의심된다면요?', d: '처음 보는 기기에서 짧은 시간에 실패와 재시도가 몰리면 보류를 권고합니다. 결제대행사는 거래를 멈추고 본인 확인을 진행할 수 있습니다.' },
    { k: 'fds', t: '기존 FDS 점검', dur: 8, q: '이미 쓰고 있는 이상거래 규칙은요?', d: '고객사가 운영하는 FDS 규칙의 효과, 놓치고 있는 유형, 시간에 따른 변화를 분석해 고칠 점을 추천합니다.' },
  ] },
];
const at = (n: number) => `--at:${n}`;
const win = (a: number, b: number) => `--at:${a};--out:${b}`;
---
<div class="demo">
  <div class="tabs" role="tablist" aria-label="제품 화면">
    {tracks.map((tr, ti) => <button type="button" role="tab" id={`demo-tab-${tr.id}`} aria-controls={`demo-${tr.id}`} aria-selected={ti === 0 ? 'true' : 'false'} tabindex={ti === 0 ? 0 : -1}>{tr.t}</button>)}
  </div>
  {tracks.map((tr, ti) => (
    <div class="reel" id={`demo-${tr.id}`} role="tabpanel" aria-labelledby={`demo-tab-${tr.id}`} hidden={ti !== 0}>
      <div class="screen">
        {tr.shots.map((s, i) => (
          <div class={`shot s-${s.k}`} data-dur={s.dur} hidden={i !== 0} role="img" aria-label={s.d}>
            {(s.k === 'scan' || s.k === 'block') && (
              <div class="win-frame term">
                <div class="bar-top"><i></i><i></i><i></i><span>터미널</span></div>
                <ol>{(s.k === 'scan' ? scan : block).map((l) => <li class={`in ${l.k} ${l.c ?? ''}`} style={at(l.at)}>{l.k === 'cmd' ? <><b>$</b>{l.t}</> : <><span>{l.t}</span><em>{l.s}</em></>}</li>)}</ol>
              </div>
            )}

            {s.k === 'bind' && (
              <div class="bind-stage">
                <div class="win-frame pc">
                  <div class="bar-top"><i></i><i></i><i></i><span>업무 PC · Trust Gateway</span></div>
                  <div class="pc-body">
                    <div class="layer win" style={win(0, 5.6)}>
                      <p class="h">사용자 인증</p>
                      <p class="sub">휴대폰으로 QR을 찍고 승인하세요</p>
                      <svg class="qr" viewBox="-1.5 -1.5 24 24" aria-hidden="true"><rect x="-1.5" y="-1.5" width="24" height="24" rx="1.5" fill="#fff" /><path d={qr} fill="#0f141c" /></svg>
                      <p class="wait">승인 대기 중</p>
                    </div>
                    <div class="layer in final" style={at(5.6)}>
                      <span class="big-ok"><Icon name="check" size={28} /></span>
                      <p class="h">업무 접속 준비 완료</p>
                      <p class="sub">이 PC를 쓰는 사람이 확인됐습니다</p>
                    </div>
                  </div>
                </div>
                <div class="phone">
                  <span class="notch"></span>
                  <div class="layer win" style={win(0, 1.8)}>
                    <p class="ph-t">QR 스캔</p>
                    <div class="cam"><svg class="qr" viewBox="-1.5 -1.5 24 24" aria-hidden="true"><rect x="-1.5" y="-1.5" width="24" height="24" rx="1.5" fill="#fff" /><path d={qr} fill="#0f141c" /></svg><i class="scanline"></i></div>
                  </div>
                  <div class="layer win" style={win(1.8, 4.4)}>
                    <p class="ph-t">기기 바인딩</p>
                    <p class="ph-m">이 PC를 내 계정으로 사용합니다</p>
                    <span class="ph-opt">생체 인증 (권장)</span>
                    <span class="ph-btn in" style={at(3.4)}>승인</span>
                  </div>
                  <div class="layer win" style={win(4.4, 5.4)}>
                    <span class="ring"><Icon name="user" size={30} /></span>
                    <p class="ph-m">생체 인증</p>
                  </div>
                  <div class="layer in final" style={at(5.4)}>
                    <span class="big-ok"><Icon name="check" size={30} /></span>
                    <p class="ph-m">승인 완료</p>
                  </div>
                </div>
              </div>
            )}

            {s.k === 'portal' && (
              <div class="win-frame browser">
                <div class="bar-top"><i></i><i></i><i></i><span class="addr"><Icon name="lock" size={12} />업무 포털</span></div>
                <div class="portal">
                  <aside class="side"><b></b><b></b><b></b><b></b></aside>
                  <div class="p-main">
                    <div class="layer win" style={win(0, 1.1)}><div class="skel"><b></b><b></b><b></b><b></b></div></div>
                    <div class="layer in final" style={at(1.1)}>
                      <p class="p-h">오늘의 업무</p>
                      <ul class="cards">
                        <li><span>결재 대기</span><b>3</b></li><li><span>새 메일</span><b>12</b></li><li><span>오늘 일정</span><b>2</b></li><li><span>공지</span><b>1</b></li>
                      </ul>
                      <p class="chip ok in" style={at(1.9)}><Icon name="check" size={14} />다시 로그인 없이 연결됨</p>
                      <p class="signals in" style={at(2.8)}>요청마다 확인 <i class="sig" style={at(3.2)}>PC</i><i class="sig" style={at(3.5)}>휴대폰</i><i class="sig" style={at(3.8)}>네트워크</i></p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {s.k === 'xcheck' && (
              <div class="win-frame xc">
                <div class="bar-top"><i></i><i></i><i></i><span>요청 판정 · 다중 신호 교차 검증</span></div>
                <div class="xc-body">
                  {[0, 1].map((ph) => (
                    <div class={`layer ${ph ? 'in final' : 'win'}`} style={ph ? at(5.8) : win(0, 5.8)}>
                      <p class={`case ${ph ? 'stop' : 'ok'}`}>{ph ? '훔친 PC로 다른 곳에서 접속' : '평소 접속'}</p>
                      <div class="xc-row head"><span>신호</span><span>업무 PC</span><span>휴대폰</span><span></span></div>
                      {sigs.map((g, j) => {
                        const v = ph ? g.b : g.a, good = ph ? g.ok : true, t0 = (ph ? 6.2 : 0.4) + j * 0.3;
                        return <div class="xc-row in" style={at(t0)}><span>{g.n}</span><span class={good ? '' : 'odd'}>{v[0]}</span><span>{v[1]}</span><em class={`mark in ${good ? 'ok' : 'stop'}`} style={at(t0 + 0.9)}>{good ? '일치' : '불일치'}</em></div>;
                      })}
                      {ph
                        ? <><p class="verdict warn in" style={at(8.4)}>불일치 발견, 휴대폰으로 추가 인증 요청</p><p class="verdict stop in" style={at(10)}>주인이 승인하지 않아 이 요청은 거부</p></>
                        : <p class="verdict ok in" style={at(3.6)}>모든 신호가 맞아 허용</p>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {s.k === 'lost' && (
              <div class="win-frame log lost">
                <div class="bar-top"><i></i><i></i><i></i><span>관리 콘솔 · 기기와 인증서</span></div>
                <div class="log-body">
                  <div class="log-row dev head"><span>기기</span><span>사용자</span><span>인증서</span><span></span></div>
                  {devices.map((d, j) => (
                    <div class={`log-row dev ${j === 0 ? 'pick' : ''}`}>
                      <span>{d.n}</span><span>{d.who}</span>
                      <span class="stack">{j === 0 ? <><em class="tag ok win" style={win(0, 2.2)}>유효</em><em class="tag stop in" style={at(2.2)}>폐기됨</em></> : <em class="tag ok">유효</em>}</span>
                      <span>{j === 0 && <b class="revoke in" style={at(0.8)}>인증서 폐기</b>}</span>
                    </div>
                  ))}
                  <p class="sub-h in" style={at(3.2)}>다음 요청</p>
                  <div class="log-row req in" style={at(3.6)}><span class="c-t">09:20:11</span><span>업무 PC · 직원 A → 그룹웨어</span><span><em class="tag stop">거부</em></span><span class="why">인증서 폐기됨</span></div>
                  <p class="chain in" style={at(4.6)}><Icon name="shield" size={14} />폐기 정보는 게이트웨이에 바로 전달됩니다</p>
                </div>
              </div>
            )}

            {s.k === 'audit' && (
              <div class="win-frame log">
                <div class="bar-top"><i></i><i></i><i></i><span>감사 기록</span></div>
                <div class="log-body">
                  <div class="log-row head"><span class="c-t">시각</span><span>사용자</span><span class="c-to">대상</span><span>판정</span><span>근거</span></div>
                  {audit.map((r) => <div class="log-row in" style={at(r.at)}><span class="c-t">{r.t}</span><span>{r.who}</span><span class="c-to">{r.to}</span><span><em class={`tag ${r.v}`}>{r.l}</em></span><span class="why">{r.why}</span></div>)}
                  <p class="chain in" style={at(5.2)}><Icon name="lock" size={14} />각 기록은 앞 기록과 이어져 저장됩니다</p>
                </div>
              </div>
            )}

            {s.k === 'payflow' && (
              <div class="flow">
                <div class="node in" style={at(0.2)}><span class="ico"><Icon name="phone" size={24} /></span><b>결제하는 고객</b><small>카드 · 간편결제</small></div>
                <div class="link">
                  <em class="in" style={at(0.6)}>결제 요청</em>
                  <span class="lane fwd"><i class="dot" style={at(0.6)}></i></span>
                  <span class="lane back"><i class="dot" style={at(6.2)}></i></span>
                  <em class="in" style={at(6.6)}>승인 또는 본인 확인</em>
                </div>
                <div class="node in" style={at(0.4)}><span class="ico"><Icon name="server" size={24} /></span><b>결제대행사 · 가맹점</b><small>결제를 처리하는 곳</small><span class="decide in" style={at(5.2)}>최종 결정</span></div>
                <div class="link">
                  <em class="in" style={at(1.8)}>거래 정보 + 기기 신호</em>
                  <span class="lane fwd"><i class="dot" style={at(1.8)}></i></span>
                  <span class="lane back"><i class="dot" style={at(4)}></i></span>
                  <em class="in" style={at(4.4)}>권고 + 이유</em>
                </div>
                <div class="node tg in" style={at(0.6)}><span class="ico"><Icon name="shield" size={24} /></span><b>Trust Gateway</b><small>위험 평가</small><span class="eval win" style={win(2.6, 4)}>평가 중</span><span class="recs in" style={at(4)}><i class="ok">승인</i><i class="warn">추가 확인</i><i class="stop">보류</i></span></div>
              </div>
            )}

            {s.k === 'paysig' && (
              <div class="sig-board">
                <p class="sb-h in" style={at(0.2)}>이 고객의 평소 결제와 비교해 봅니다</p>
                <ul class="sig-grid">{paySignals.map((g, j) => <li class="in" style={at(0.6 + j * 0.25)}><Icon name={g.i} size={18} /><span>{g.t}</span></li>)}</ul>
                <p class="sb-m in" style={at(3.4)}>신호를 하나씩 따로 보지 않고 함께 봅니다. 이 고객의 평소 결제에서 얼마나 벗어났는지 계산하고, 금지 사항에 걸리는지 함께 봐서 권고를 정합니다.</p>
                <p class="sb-r in" style={at(5)}><span class="badge ok">승인</span><span class="badge warn">추가 확인</span><span class="badge stop">보류</span><span>중 하나를 이유와 함께 권고합니다</span></p>
              </div>
            )}

            {Object.entries(cases).filter(([k]) => k === s.k).map(([, c]) => (
              <div class="case-stage">
                <div class="card in" style={at(0.2)}>
                  <p class="card-h">결제 상황</p>
                  <ul class="sit">{c.rows.map(([k, v, same], j) => <li class="in" style={at(0.5 + j * 0.35)}><span class="rk">{k}</span><span class="rv">{v}</span><em class={`tag ${same ? 'ok' : c.tone}`}>{same ? '평소와 같음' : '평소와 다름'}</em></li>)}</ul>
                </div>
                <span class="arrow in" style={at(2.2)} aria-hidden="true"></span>
                <div class="card in" style={at(2.4)}>
                  <p class="card-h">Trust Gateway 권고</p>
                  <span class={`badge big ${c.tone}`}>{c.label}</span>
                  <p class="k">위험도</p>
                  <div class="level">{['낮음', '보통', '높음'].map((l, j) => <span class={j === c.level ? `on ${c.tone}` : ''}>{l}</span>)}</div>
                  <p class="k">이유</p>
                  <ul class="why-list">{c.why.map((w, j) => <li class="in" style={at(3.2 + j * 0.3)}>{w}</li>)}</ul>
                  <p class="act in" style={at(4.4)}><b>결제대행사</b>{c.act}</p>
                </div>
              </div>
            ))}

            {s.k === 'fds' && (
              <div class="win-frame log fds">
                <div class="bar-top"><i></i><i></i><i></i><span>FDS 규칙 점검</span></div>
                <div class="log-body">
                  <div class="log-row rule head"><span>고객사 규칙</span><span>점검 결과</span></div>
                  {fdsRules.map((x, j) => <div class="log-row rule in" style={at(0.4 + j * 0.6)}><span>{x.r}</span><span><em class={`tag ${x.v}`}>{x.l}</em></span></div>)}
                  <div class="log-row rule miss in" style={at(3.2)}><span>규칙이 없는 유형</span><span><em class="tag stop">소액 결제를 여러 번 나누는 수법</em></span></div>
                  <p class="sub-h in" style={at(4.4)}>고칠 점 추천</p>
                  <ul class="tips">{fdsTips.map((t, j) => <li class="in" style={at(4.8 + j * 0.4)}><Icon name="check" size={14} />{t}</li>)}</ul>
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="player">
        <ol class="chs" style={`--n:${tr.shots.length}`}>
          {tr.shots.map((s, i) => <li><button class="ch" type="button" aria-current={i === 0 ? 'step' : undefined}><span class="pbar" aria-hidden="true"><i></i></span><span class="ch-t">{s.t}</span></button></li>)}
        </ol>
        <div class="now">
          {tr.shots.map((s, i) => <p class="now-d" hidden={i !== 0}><b class="q">{s.q}</b>{s.d}</p>)}
          <button class="pause" type="button" aria-pressed="false">
            <span class="i-pause"><Icon name="pause" size={18} /></span><span class="i-play"><Icon name="play" size={18} /></span>
            <span class="pause-t">일시정지</span>
          </button>
        </div>
      </div>
    </div>
  ))}
  <p class="note">시연 환경의 제품 화면을 알아보기 쉽게 다시 그렸습니다. 화면 속 이름과 숫자는 예시입니다.</p>
</div>

<style>
  .demo { --hi: #e6eefc; --mu: #8fa3c2; --mint: #63d6b4; --or: #f6882a; --coral: #ff6f61; --line: #2a3a55; --panel: #0f141c; }
  .tabs { display: flex; justify-content: center; gap: 8px; margin-bottom: 20px; }
  .tabs button {
    height: 44px; padding: 0 20px; border-radius: 999px; border: 1px solid #d6dbe4; background: #fff; cursor: pointer;
    font-size: 15px; font-weight: 600; color: var(--ink-2); transition: background-color .2s var(--ease), color .2s var(--ease), border-color .2s var(--ease);
  }
  .tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  .tabs button:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }

  .reel { border-radius: 20px; overflow: hidden; background: #0b1626; box-shadow: 0 24px 48px rgba(16, 24, 40, .12); color: var(--hi); }
  .screen {
    position: relative; aspect-ratio: 16 / 9; container-type: inline-size;
    background-color: #0b1626;
    background-image: linear-gradient(rgba(159, 184, 222, .05) 1px, transparent 1px), linear-gradient(90deg, rgba(159, 184, 222, .05) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  .shot { position: absolute; inset: 0; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center; padding: 4cqi; font-size: max(12px, 1.35cqi); line-height: 1.5; }

  /* timeline */
  .layer { position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; text-align: center; }
  .win { opacity: 0; }
  .win.final, .in { opacity: 1; }
  .shot.run .in { animation: d-in .35s var(--ease) calc(var(--at) * 1s) both; }
  .shot.run .win { animation: d-win calc((var(--out) - var(--at)) * 1s) linear calc(var(--at) * 1s) both; }
  .shot.run .grow { animation: d-grow .8s var(--ease) calc(var(--at) * 1s) both; }
  .shot.run .lit { animation: d-lit .3s var(--ease) calc(var(--at) * 1s) both; }
  .demo.paused .shot * { animation-play-state: paused !important; }
  @keyframes d-in { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }
  @keyframes d-win { 0% { opacity: 0; } 4% { opacity: 1; } 96% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes d-grow { from { transform: scaleX(0); } to { transform: scaleX(var(--v)); } }
  @keyframes d-lit { from { opacity: .35; } to { opacity: 1; } }

  /* window chrome */
  .win-frame { position: relative; width: 100%; height: 100%; border-radius: 12px; background: var(--panel); border: 1px solid var(--line); overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .bar-top { display: flex; align-items: center; gap: 6px; padding: 1cqi 1.4cqi; background: #151c27; border-bottom: 1px solid #22304a; min-height: 30px; }
  .bar-top i { width: 9px; height: 9px; border-radius: 50%; background: #34425a; }
  .bar-top span { margin-left: 8px; font-size: max(11px, 1.1cqi); color: #7f93b3; display: inline-flex; align-items: center; gap: 6px; }
  .big-ok { display: grid; place-items: center; width: 4.6em; height: 4.6em; border-radius: 50%; background: rgba(99, 214, 180, .14); color: var(--mint); margin-bottom: .6em; }
  .h { font-size: 1.35em; font-weight: 700; }
  .sub { color: var(--mu); margin-top: .2em; }

  /* terminal */
  .term { width: 84%; height: auto; max-height: 100%; font-family: ui-monospace, 'SFMono-Regular', Consolas, 'Pretendard Variable', monospace; }
  .term ol { list-style: none; margin: 0; padding: 2.6cqi 3cqi; display: grid; gap: .55em; font-size: max(12px, 1.7cqi); }
  .term li { display: grid; grid-template-columns: minmax(0, 15em) minmax(0, 1fr); gap: 1em; color: #c9d6ea; }
  .term li.cmd { display: block; margin-top: .4em; color: var(--hi); }
  .term li.cmd:first-child { margin-top: 0; }
  .term li.cmd b { color: var(--mint); margin-right: .6em; font-weight: 600; }
  .term li span { padding-left: 1.6em; color: #9fb0c8; }
  .term li em { font-style: normal; font-weight: 600; }
  .term li.bad em { color: var(--coral); }
  .term li.ok em { color: var(--mint); }
  .term li.lock em { color: #f6b26b; }
  .term li.dim em { color: #7f93b3; }

  /* bind: PC window and phone side by side */
  .bind-stage { position: relative; width: 100%; height: 100%; display: grid; grid-template-columns: minmax(0, 1fr) 24%; gap: 5%; align-items: center; }
  .pc { height: 92%; }
  .pc-body { position: relative; }
  .qr { width: 9.5em; height: 9.5em; margin: .9em 0 .7em; }
  .wait { color: var(--mu); font-size: .92em; }
  .phone { position: relative; height: 100%; aspect-ratio: 9 / 18.5; max-width: 100%; justify-self: center; border-radius: 2.2em; background: #0b0f15; border: 2px solid var(--line); overflow: hidden; }
  .notch { position: absolute; top: .7em; left: 50%; width: 32%; height: .9em; margin-left: -16%; border-radius: 1em; background: #1b2230; z-index: 1; }
  .phone .layer { padding: 2.4em .8em 1em; gap: .6em; }
  .ph-t { font-weight: 700; }
  .ph-m { color: var(--mu); font-size: .92em; }
  .ph-opt { padding: .45em .8em; border-radius: .6em; border: 1px solid var(--mint); color: var(--mint); font-size: .88em; }
  .ph-btn { margin-top: .4em; padding: .55em 1.6em; border-radius: .7em; background: var(--mint); color: #08241c; font-weight: 700; }
  .cam { position: relative; padding: .8em; border-radius: .8em; border: 2px dashed rgba(99, 214, 180, .7); }
  .cam .qr { width: 5.6em; height: 5.6em; margin: 0; }
  .scanline { position: absolute; left: .4em; right: .4em; top: 20%; height: 2px; background: var(--mint); box-shadow: 0 0 0 1px rgba(99, 214, 180, .25); }
  .shot.run .scanline { animation: d-scan 1.2s ease-in-out infinite alternate; }
  @keyframes d-scan { to { top: 80%; } }
  .ring { display: grid; place-items: center; width: 4.6em; height: 4.6em; border-radius: 50%; border: 2px solid var(--mint); color: var(--mint); }
  .shot.run .ring { animation: d-pulse 1s ease-in-out infinite; }
  @keyframes d-pulse { 50% { transform: scale(1.08); } }

  /* portal */
  .browser { width: 88%; height: 96%; }
  .addr { padding: .2em .9em; border-radius: 999px; background: #0f141c; border: 1px solid #22304a; margin-left: auto !important; margin-right: auto; }
  .portal { display: grid; grid-template-columns: 18% 1fr; min-height: 0; }
  .side { padding: 1.4em 1em; display: grid; align-content: start; gap: .9em; border-right: 1px solid #1e2a3d; }
  .side b { display: block; height: .7em; border-radius: .4em; background: #1e2a3d; }
  .side b:first-child { background: #2b3d5a; width: 70%; }
  .p-main { position: relative; }
  .p-main .layer { place-content: start stretch; justify-items: start; text-align: left; padding: 1.6em 2em; gap: 1em; }
  .skel { display: grid; gap: .8em; width: 100%; }
  .skel b { display: block; height: 2.4em; border-radius: .6em; background: #172131; }
  .skel b:first-child { width: 40%; height: 1.2em; }
  .p-h { font-size: 1.3em; font-weight: 700; }
  .cards { list-style: none; margin: 0; padding: 0; width: 100%; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .8em; }
  .cards li { padding: .9em 1em; border-radius: .8em; background: #151d2b; border: 1px solid #22304a; display: grid; gap: .2em; }
  .cards span { color: var(--mu); font-size: .9em; }
  .cards b { font-size: 1.5em; }
  .chip { display: inline-flex; align-items: center; gap: .4em; padding: .35em .9em; border-radius: 999px; font-weight: 600; }
  .chip.ok { background: rgba(99, 214, 180, .14); color: var(--mint); }
  .signals { color: var(--mu); display: flex; align-items: center; gap: .5em; flex-wrap: wrap; }
  .sig { font-style: normal; padding: .15em .7em; border-radius: 999px; border: 1px solid var(--mint); color: var(--mint); }
  .shot.run .sig { animation: d-in .35s var(--ease) calc(var(--at) * 1s) both; }

  /* audit log */
  .log { width: 92%; height: auto; }
  .log-body { padding: 1.2em 1.6em 1.4em; display: grid; gap: .1em; }
  .log-row { display: grid; grid-template-columns: 6em 6em 7em 6.5em minmax(0, 1fr); gap: 1em; align-items: center; padding: .55em 0; border-bottom: 1px solid #1c2738; }
  .log-row.head { color: #7f93b3; font-size: .9em; }
  .log-row .c-t { font-family: ui-monospace, Consolas, monospace; color: var(--mu); }
  .why { color: #c9d6ea; }
  .tag { font-style: normal; font-weight: 600; padding: .15em .7em; border-radius: 999px; font-size: .9em; }
  .tag.ok { background: rgba(99, 214, 180, .14); color: var(--mint); }
  .tag.warn { background: rgba(246, 136, 42, .16); color: var(--or); }
  .tag.stop { background: rgba(255, 111, 97, .16); color: var(--coral); }
  .chain { margin-top: .9em; display: inline-flex; align-items: center; gap: .5em; color: var(--mu); }

  /* cross-check */
  .xc { width: 92%; height: 94%; }
  .xc-body { position: relative; }
  .xc-body .layer { place-content: center stretch; justify-items: stretch; text-align: left; padding: 1.2em 2em; gap: .15em; }
  .case { justify-self: start; font-weight: 700; padding: .3em .9em; border-radius: 999px; margin-bottom: .5em; }
  .case.ok { background: rgba(99, 214, 180, .14); color: var(--mint); }
  .case.stop { background: rgba(255, 111, 97, .16); color: var(--coral); }
  .xc-row { display: grid; grid-template-columns: 7em minmax(0, 1fr) minmax(0, 1fr) 4.2em; gap: 1em; align-items: center; padding: .45em 0; border-bottom: 1px solid #1c2738; }
  .xc-row.head { color: #7f93b3; font-size: .9em; }
  .xc-row span:first-child { color: var(--mu); }
  .xc-row .odd { color: var(--coral); font-weight: 600; }
  .mark { font-style: normal; font-weight: 700; font-size: .9em; text-align: center; padding: .1em .5em; border-radius: 999px; }
  .mark.ok { color: var(--mint); background: rgba(99, 214, 180, .12); }
  .mark.stop { color: var(--coral); background: rgba(255, 111, 97, .14); }
  .verdict { margin-top: .6em; font-weight: 700; }
  .verdict.ok { color: var(--mint); } .verdict.warn { color: var(--or); } .verdict.stop { color: var(--coral); }
  .verdict + .verdict { margin-top: .2em; }

  /* lost device */
  .log-row.dev { grid-template-columns: 7em 6em 6em minmax(0, 1fr); }
  .log-row.dev.pick { background: rgba(127, 178, 255, .06); }
  .stack { display: grid; }
  .stack > * { grid-area: 1 / 1; justify-self: start; }
  .revoke { justify-self: start; padding: .3em .9em; border-radius: .6em; border: 1px solid var(--coral); color: var(--coral); font-size: .9em; }
  .shot.run .revoke { animation: d-in .35s var(--ease) calc(var(--at) * 1s) both, d-press .3s ease calc((var(--at) + 1) * 1s) 1; }
  @keyframes d-press { 50% { background: rgba(255, 111, 97, .25); transform: scale(.95); } }
  .sub-h { margin-top: .9em; color: #7f93b3; font-size: .9em; }
  .log-row.req { grid-template-columns: 6em minmax(0, 1fr) 4.5em minmax(0, 12em); }

  /* payment: who uses it */
  .flow { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr) minmax(0, 1fr) minmax(0, .9fr) minmax(0, 1fr); align-items: center; gap: .6em; }
  .node { position: relative; display: grid; justify-items: center; gap: .3em; padding: 1.4em .8em; border-radius: 1em; background: var(--panel); border: 1px solid var(--line); text-align: center; }
  .node.tg { border-color: #4a6fa5; background: #101a2a; }
  .node .ico { display: grid; place-items: center; width: 2.6em; height: 2.6em; border-radius: 50%; background: #18243a; color: #9fc2ff; }
  .node small { color: var(--mu); font-size: .88em; }
  .decide, .eval { margin-top: .4em; padding: .2em .8em; border-radius: 999px; font-size: .88em; font-weight: 700; }
  .decide { background: rgba(127, 178, 255, .16); color: #9fc2ff; }
  .eval { color: var(--mu); }
  .recs { display: flex; flex-wrap: wrap; justify-content: center; gap: .3em; margin-top: .4em; }
  .recs i { font-style: normal; font-size: .88em; font-weight: 700; padding: .15em .6em; border-radius: 999px; }
  .recs .ok { background: rgba(99, 214, 180, .14); color: var(--mint); } .recs .warn { background: rgba(246, 136, 42, .16); color: var(--or); } .recs .stop { background: rgba(255, 111, 97, .16); color: var(--coral); }
  .link { display: grid; gap: .45em; text-align: center; }
  .link em { font-style: normal; color: var(--mu); font-size: .88em; }
  .lane { position: relative; height: 2px; background: #2a3a55; }
  .lane.fwd::after, .lane.back::after { content: ''; position: absolute; top: -4px; border: 5px solid transparent; }
  .lane.fwd::after { right: -2px; border-left-color: #2a3a55; border-right: 0; }

  .shot.run .lane.back .dot { animation: d-back .9s ease-in-out calc(var(--at) * 1s) both; }
  @keyframes d-fwd { 0% { left: 0; opacity: 1; } 85% { opacity: 1; } 100% { left: calc(100% - 10px); opacity: 0; } }
  @keyframes d-back { 0% { left: calc(100% - 10px); opacity: 1; } 85% { opacity: 1; } 100% { left: 0; opacity: 0; } }

  /* payment: what it looks at */
  .sig-board { width: 90%; display: grid; gap: 1em; justify-items: center; text-align: center; }
  .sb-h { font-size: 1.25em; font-weight: 700; }

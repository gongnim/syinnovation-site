                      </div>
                      <ol class="pipe">{pipe.map((st, j) => <li class="lit" style={at(p.at + 0.4 + j * 0.32)}>{st}</li>)}</ol>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </div>
      <div class="player">

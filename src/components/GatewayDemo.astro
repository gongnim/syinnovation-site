// payment fraud advice (tech doc v0.3, 10.4): who calls it, what it looks at, three cases, and the FDS rule check.
// Amounts, counts and rule names are examples.
const paySignals = [
  { i: 'chart', t: '결제 금액' }, { i: 'cycle', t: '짧은 시간 결제 횟수' }, { i: 'lock', t: '결제 실패 횟수' }, { i: 'phone', t: '처음 보는 기기' },
  { i: 'pin', t: '처음 거래하는 가맹점' }, { i: 'shield', t: '가맹점 위험 등급' }, { i: 'plan', t: '결제 시간대' }, { i: 'search', t: '위치와 신원의 불일치' },
];

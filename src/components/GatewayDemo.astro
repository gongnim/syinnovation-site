---
// "실제 화면으로 보기": the demo-environment screens of Trust Gateway, redrawn in code so they stay sharp at any size,
// carry no real host, account or id, and use the tech doc's terms. Seven short scenes in two tabs (employee access,
// payment fraud advice) play in a loop once the section is on screen, with a chapter bar and a pause button.
// Timing: elements with .in appear at --at (seconds); .win layers show from --at to --out. The scene's class "run"
// starts its timeline; without it (reduced motion) every scene shows its finished state.
import Icon from './Icon.astro';
import { appName } from '../data/site';

type Line = { k: 'cmd' | 'row'; t: string; s?: string; c?: 'bad' | 'ok' | 'lock' | 'dim'; at: number };
const scan: Line[] = [
  { k: 'cmd', t: '인터넷에서 업무 서버 스캔', at: 0.2 },
  { k: 'row', t: '웹 서비스', s: '열림', c: 'bad', at: 1 },
  { k: 'row', t: '업무 API', s: '열림', c: 'bad', at: 1.3 },
  { k: 'row', t: '관리 화면', s: '열림', c: 'bad', at: 1.6 },
  { k: 'cmd', t: 'Trust Gateway 적용 뒤 같은 스캔', at: 3.2 },
  { k: 'row', t: '웹 서비스', s: '안 보임', c: 'ok', at: 4 },
  { k: 'row', t: '업무 API', s: '안 보임', c: 'ok', at: 4.3 },
  { k: 'row', t: '관리 화면', s: '안 보임', c: 'ok', at: 4.6 },
  { k: 'row', t: '게이트웨이 입구', s: '인증서가 있어야 열림', c: 'lock', at: 5.4 },
];
const block: Line[] = [
  { k: 'cmd', t: '인증서 없이 게이트웨이에 접속', at: 0.2 },
  { k: 'row', t: '연결 시도', s: '...', c: 'dim', at: 0.9 },
  { k: 'row', t: '상호 인증(mTLS)', s: '실패, 연결 끊김', c: 'bad', at: 1.6 },
  { k: 'cmd', t: '다른 입구로 다시 시도', at: 2.8 },
  { k: 'row', t: '응답', s: '403 거부', c: 'bad', at: 3.6 },
  { k: 'row', t: '사내망', s: '닿지 않음', c: 'ok', at: 4.4 },
];

// a QR-like 21x21 pattern (finder squares plus fixed pseudo-random modules; it encodes nothing)
const qr = (() => {
  const cells: [number, number][] = [];
  let seed = 7;
  const rnd = () => ((seed = (seed * 1103515245 + 12345) % 2147483648) / 2147483648);
  const finder = (x: number, y: number) => x < 7 && y < 7 || x > 13 && y < 7 || x < 7 && y > 13;
  for (let y = 0; y < 21; y++) for (let x = 0; x < 21; x++) {
    if (finder(x, y)) {
      const fx = x > 13 ? x - 14 : x, fy = y > 13 ? y - 14 : y;
      const ring = fx === 0 || fx === 6 || fy === 0 || fy === 6, core = fx > 1 && fx < 5 && fy > 1 && fy < 5;
      if (ring || core) cells.push([x, y]);
    } else if (rnd() > 0.52) cells.push([x, y]);
  }
  return cells.map(([x, y]) => `M${x} ${y}h1v1h-1z`).join('');
})();

const audit = [
  { at: 0.4, t: '09:12:03', who: '직원 A', to: '그룹웨어', v: 'ok', l: '허용', why: '인증서 · 바인딩 · 같은 Wi-Fi' },
  { at: 1.3, t: '09:12:41', who: '직원 B', to: '인사 시스템', v: 'ok', l: '허용', why: '정책 일치' },
  { at: 2.2, t: '09:13:05', who: '직원 A', to: '업무 포털', v: 'warn', l: '추가 인증', why: 'PC와 휴대폰 위치 불일치' },
  { at: 3.1, t: '09:13:22', who: '직원 A', to: '업무 포털', v: 'ok', l: '허용', why: '휴대폰 승인 뒤 다시 판정' },
  { at: 4.0, t: '09:14:10', who: '확인 안 됨', to: '그룹웨어', v: 'stop', l: '거부', why: '인증서 없음' },
];

// cross-check: a normal request, then a stolen PC used somewhere else (values are examples)
const sigs = [
  { n: '위치', a: ['서울', '서울'], b: ['해외', '서울'], ok: false },
  { n: 'Wi-Fi', a: ['사무실 AP', '사무실 AP'], b: ['처음 보는 AP', '사무실 AP'], ok: false },
  { n: '시간대', a: ['UTC+9', 'UTC+9'], b: ['UTC+1', 'UTC+9'], ok: false },
  { n: '기기 상태', a: ['정상', '정상'], b: ['정상', '정상'], ok: true },
  { n: '네트워크', a: ['회사 IP 대역', '통신사망'], b: ['해외 데이터센터', '통신사망'], ok: false },
];
const devices = [{ n: '업무 PC', who: '직원 A' }, { n: '휴대폰', who: '직원 A' }, { n: '업무 PC', who: '직원 B' }];

const pipe = ['요청 수신', '이상 탐지', '규칙 평가', '교차 검증', '정책', '권고'];
const payItems = ['정상 결제', '큰 금액', '짧은 시간 반복 시도'];
type Pay = { at: number; out: number; final?: boolean; pick: number; tone: 'ok' | 'warn' | 'stop'; label: string; risk: number; factors: [string, number][]; advice: string };
const payOk: Pay[] = [
  { at: 0, out: 99, final: true, pick: 0, tone: 'ok', label: '승인 권고', risk: 0.08, factors: [['거래 속도', 0.39], ['실패율', 0.36], ['가맹점 위험 등급', 0.13]], advice: '추가 조치 없이 승인해도 됩니다' },
];
const paySus: Pay[] = [
  { at: 0, out: 5.4, pick: 1, tone: 'warn', label: '추가 확인 권고', risk: 0.18, factors: [['거래 금액', 0.69], ['거래 속도', 0.16], ['실패율', 0.13]], advice: '추가 인증을 거친 뒤 진행하세요' },
  { at: 5.4, out: 99, final: true, pick: 2, tone: 'stop', label: '보류 권고', risk: 0.62, factors: [['실패율', 0.28], ['신규 기기', 0.24], ['거래 속도', 0.19]], advice: '자동 승인을 멈추고 본인 확인 뒤 진행하세요' },
];

const tracks = [
  { id: 'access', t: '직원 업무 접속', shots: [
    { k: 'scan', t: '숨은 사내망', dur: 8.5, q: '인터넷에서 우리 업무 서버가 보일까요?', d: '인터넷에서 보이던 업무 서버의 포트가, Trust Gateway를 붙인 뒤에는 보이지 않습니다. 남는 입구는 인증서가 있어야 열리는 게이트웨이뿐입니다.' },
    { k: 'bind', t: '사람과 PC 묶기', dur: 7.5, q: '이 PC를 지금 누가 쓰는지 어떻게 알까요?', d: `PC 화면의 QR을 ${appName} 앱으로 찍고 생체 인증으로 승인합니다. 지금 이 PC를 쓰는 사람이 묶입니다.` },
    { k: 'portal', t: '업무 시스템 열림', dur: 6, q: '확인이 끝나면 무엇이 열릴까요?', d: '다시 로그인하지 않고 허락된 업무 시스템만 열립니다. 이후 요청도 계속 확인합니다.' },
    { k: 'xcheck', t: '다중 신호 교차 검증', dur: 12, q: '계정과 PC를 훔치면 들어올 수 있을까요?', d: 'PC와 휴대폰, 네트워크의 신호를 요청마다 대조합니다. 훔친 PC로 다른 곳에서 접속하면 신호가 서로 맞지 않아 휴대폰으로 다시 확인하고, 주인이 승인하지 않으면 그 요청은 거부됩니다.' },
    { k: 'block', t: '인증서 없으면 차단', dur: 7, q: '등록되지 않은 기기가 접속하면요?', d: '인증서가 없는 접속은 연결 단계에서 끊깁니다. 사내망에는 닿지 않습니다.' },
    { k: 'lost', t: '분실 기기 차단', dur: 7.5, q: 'PC를 잃어버렸다면요?', d: '관리 콘솔에서 그 기기의 인증서를 폐기하면, 폐기 정보가 게이트웨이에 바로 전달되어 다음 요청부터 거부됩니다.' },
    { k: 'audit', t: '감사 기록', dur: 7.5, q: '누가 언제 무엇을 했는지 남을까요?', d: '허용, 추가 인증, 거부마다 누가 어디에 접속했고 왜 그렇게 판단했는지 남습니다. 기록은 앞 기록과 이어져 있어 중간을 바꾸면 드러납니다.' },
  ] },
  { id: 'payment', t: '결제 이상거래', shots: [
    { k: 'payok', t: '정상 결제', dur: 6, q: '평범한 결제는 어떻게 처리될까요?', d: '여러 엔진을 거쳐 위험이 낮다고 판단되면 승인을 권고합니다.' },
    { k: 'paysus', t: '수상한 결제', dur: 11, q: '수상한 결제는 어떻게 알려 줄까요?', d: '큰 금액에는 추가 확인을, 짧은 시간에 반복되는 시도에는 보류와 본인 확인을 권고합니다. 어떤 요인이 판단에 작용했는지 함께 보여 주고, 최종 결정은 결제사가 합니다.' },
  ] },
];
const at = (n: number) => `--at:${n}`;
const win = (a: number, b: number) => `--at:${a};--out:${b}`;
---
<div class="demo">
  <div class="tabs" role="tablist" aria-label="제품 화면">
    {tracks.map((tr, ti) => <button type="button" role="tab" id={`demo-tab-${tr.id}`} aria-controls={`demo-${tr.id}`} aria-selected={ti === 0 ? 'true' : 'false'} tabindex={ti === 0 ? 0 : -1}>{tr.t}</button>)}
  </div>
  {tracks.map((tr, ti) => (
    <div class="reel" id={`demo-${tr.id}`} role="tabpanel" aria-labelledby={`demo-tab-${tr.id}`} hidden={ti !== 0}>
      <div class="screen">
        {tr.shots.map((s, i) => (
          <div class={`shot s-${s.k}`} data-dur={s.dur} hidden={i !== 0} role="img" aria-label={s.d}>
            {(s.k === 'scan' || s.k === 'block') && (
              <div class="win-frame term">
                <div class="bar-top"><i></i><i></i><i></i><span>터미널</span></div>
                <ol>{(s.k === 'scan' ? scan : block).map((l) => <li class={`in ${l.k} ${l.c ?? ''}`} style={at(l.at)}>{l.k === 'cmd' ? <><b>$</b>{l.t}</> : <><span>{l.t}</span><em>{l.s}</em></>}</li>)}</ol>
              </div>
            )}

            {s.k === 'bind' && (
              <div class="bind-stage">
                <div class="win-frame pc">
                  <div class="bar-top"><i></i><i></i><i></i><span>업무 PC · Trust Gateway</span></div>
                  <div class="pc-body">
                    <div class="layer win" style={win(0, 5.6)}>
                      <p class="h">사용자 인증</p>
                      <p class="sub">휴대폰으로 QR을 찍고 승인하세요</p>
                      <svg class="qr" viewBox="-1.5 -1.5 24 24" aria-hidden="true"><rect x="-1.5" y="-1.5" width="24" height="24" rx="1.5" fill="#fff" /><path d={qr} fill="#0f141c" /></svg>
                      <p class="wait">승인 대기 중</p>
                    </div>
                    <div class="layer in final" style={at(5.6)}>
                      <span class="big-ok"><Icon name="check" size={28} /></span>
                      <p class="h">업무 접속 준비 완료</p>
                      <p class="sub">이 PC는 지금 승인한 사람과 묶였습니다</p>
                    </div>
                  </div>
                </div>
                <div class="phone">
                  <span class="notch"></span>
                  <div class="layer win" style={win(0, 1.8)}>
                    <p class="ph-t">QR 스캔</p>
                    <div class="cam"><svg class="qr" viewBox="-1.5 -1.5 24 24" aria-hidden="true"><rect x="-1.5" y="-1.5" width="24" height="24" rx="1.5" fill="#fff" /><path d={qr} fill="#0f141c" /></svg><i class="scanline"></i></div>
                  </div>
                  <div class="layer win" style={win(1.8, 4.4)}>
                    <p class="ph-t">기기 바인딩</p>
                    <p class="ph-m">이 PC를 내 계정으로 사용합니다</p>
                    <span class="ph-opt">생체 인증 (권장)</span>
                    <span class="ph-btn in" style={at(3.4)}>승인</span>
                  </div>
                  <div class="layer win" style={win(4.4, 5.4)}>
                    <span class="ring"><Icon name="user" size={30} /></span>
                    <p class="ph-m">생체 인증</p>
                  </div>
                  <div class="layer in final" style={at(5.4)}>
                    <span class="big-ok"><Icon name="check" size={30} /></span>
                    <p class="ph-m">승인 완료</p>
                  </div>
                </div>
              </div>
            )}

            {s.k === 'portal' && (
              <div class="win-frame browser">
                <div class="bar-top"><i></i><i></i><i></i><span class="addr"><Icon name="lock" size={12} />업무 포털</span></div>
                <div class="portal">
                  <aside class="side"><b></b><b></b><b></b><b></b></aside>
                  <div class="p-main">
                    <div class="layer win" style={win(0, 1.1)}><div class="skel"><b></b><b></b><b></b><b></b></div></div>
                    <div class="layer in final" style={at(1.1)}>
                      <p class="p-h">오늘의 업무</p>
                      <ul class="cards">
                        <li><span>결재 대기</span><b>3</b></li><li><span>새 메일</span><b>12</b></li><li><span>오늘 일정</span><b>2</b></li><li><span>공지</span><b>1</b></li>
                      </ul>
                      <p class="chip ok in" style={at(1.9)}><Icon name="check" size={14} />다시 로그인 없이 연결됨</p>
                      <p class="signals in" style={at(2.8)}>요청마다 확인 <i class="sig" style={at(3.2)}>PC</i><i class="sig" style={at(3.5)}>휴대폰</i><i class="sig" style={at(3.8)}>네트워크</i></p>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {s.k === 'xcheck' && (
              <div class="win-frame xc">
                <div class="bar-top"><i></i><i></i><i></i><span>요청 판정 · 다중 신호 교차 검증</span></div>
                <div class="xc-body">
                  {[0, 1].map((ph) => (
                    <div class={`layer ${ph ? 'in final' : 'win'}`} style={ph ? at(5.8) : win(0, 5.8)}>
                      <p class={`case ${ph ? 'stop' : 'ok'}`}>{ph ? '훔친 PC로 다른 곳에서 접속' : '평소 접속'}</p>
                      <div class="xc-row head"><span>신호</span><span>업무 PC</span><span>휴대폰</span><span></span></div>
                      {sigs.map((g, j) => {
                        const v = ph ? g.b : g.a, good = ph ? g.ok : true, t0 = (ph ? 6.2 : 0.4) + j * 0.3;
                        return <div class="xc-row in" style={at(t0)}><span>{g.n}</span><span class={good ? '' : 'odd'}>{v[0]}</span><span>{v[1]}</span><em class={`mark in ${good ? 'ok' : 'stop'}`} style={at(t0 + 0.9)}>{good ? '일치' : '모순'}</em></div>;
                      })}
                      {ph
                        ? <><p class="verdict warn in" style={at(8.4)}>모순 발견, 휴대폰으로 추가 인증 요청</p><p class="verdict stop in" style={at(10)}>주인이 승인하지 않아 이 요청은 거부</p></>
                        : <p class="verdict ok in" style={at(3.6)}>모든 신호가 맞아 허용</p>}
                    </div>
                  ))}
                </div>
              </div>
            )}

            {s.k === 'lost' && (
              <div class="win-frame log lost">
                <div class="bar-top"><i></i><i></i><i></i><span>관리 콘솔 · 기기와 인증서</span></div>
                <div class="log-body">
                  <div class="log-row dev head"><span>기기</span><span>사용자</span><span>인증서</span><span></span></div>
                  {devices.map((d, j) => (
                    <div class={`log-row dev ${j === 0 ? 'pick' : ''}`}>
                      <span>{d.n}</span><span>{d.who}</span>
                      <span class="stack">{j === 0 ? <><em class="tag ok win" style={win(0, 2.2)}>유효</em><em class="tag stop in" style={at(2.2)}>폐기됨</em></> : <em class="tag ok">유효</em>}</span>
                      <span>{j === 0 && <b class="revoke in" style={at(0.8)}>인증서 폐기</b>}</span>
                    </div>
                  ))}
                  <p class="sub-h in" style={at(3.2)}>다음 요청</p>
                  <div class="log-row req in" style={at(3.6)}><span class="c-t">09:20:11</span><span>업무 PC · 직원 A → 그룹웨어</span><span><em class="tag stop">거부</em></span><span class="why">인증서 폐기됨</span></div>
                  <p class="chain in" style={at(4.6)}><Icon name="shield" size={14} />폐기 정보는 게이트웨이에 바로 전달됩니다</p>
                </div>
              </div>
            )}

            {s.k === 'audit' && (
              <div class="win-frame log">
                <div class="bar-top"><i></i><i></i><i></i><span>감사 기록</span></div>
                <div class="log-body">
                  <div class="log-row head"><span class="c-t">시각</span><span>사용자</span><span class="c-to">대상</span><span>판정</span><span>근거</span></div>
                  {audit.map((r) => <div class="log-row in" style={at(r.at)}><span class="c-t">{r.t}</span><span>{r.who}</span><span class="c-to">{r.to}</span><span><em class={`tag ${r.v}`}>{r.l}</em></span><span class="why">{r.why}</span></div>)}
                  <p class="chain in" style={at(5.2)}><Icon name="lock" size={14} />각 기록은 앞 기록과 이어져 저장됩니다</p>
                </div>
              </div>
            )}

            {(s.k === 'payok' || s.k === 'paysus') && (
              <div class="win-frame pay">
                <div class="bar-top"><i></i><i></i><i></i><span>결제 이상거래 판정 (권고)</span></div>
                <div class="pay-body">
                  {(s.k === 'payok' ? payOk : paySus).map((p) => (
                    <div class={`layer ${p.final ? 'in final' : 'win'}`} style={p.final ? at(p.at) : win(p.at, p.out)}>
                      <ul class="pay-list">{payItems.map((it, k) => <li class={k === p.pick ? 'on' : ''}>{it}</li>)}</ul>
                      <div class="pay-main">
                        <p class="pending win" style={win(p.at, p.at + 2.3)}>판정 중</p>
                        <div class="res in" style={at(p.at + 2.3)}>
                          <span class={`badge ${p.tone}`}>{p.label}</span>
                          <p class="k">위험 점수 <b class={p.tone}>{p.risk.toFixed(2)}</b></p>
                          <span class={`meter ${p.tone}`}><i class="grow" style={`--v:${p.risk};${at(p.at + 2.4)}`}></i></span>
                          <p class="k">판단에 작용한 요인</p>
                          <ul class="factors">{p.factors.map(([n, v], j) => <li><span>{n}</span><span class="fbar"><i class="grow" style={`--v:${v};${at(p.at + 2.5 + j * 0.12)}`}></i></span><em>{v.toFixed(2)}</em></li>)}</ul>
                          <p class="advice">{p.advice}</p>
                          <p class="who">최종 결정은 결제사가 합니다</p>

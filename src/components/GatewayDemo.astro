  .sit { list-style: none; margin: 0; padding: 0; display: grid; gap: .55em; }
  .sit li { display: grid; grid-template-columns: 3.4em minmax(0, 1fr) auto; gap: .6em; align-items: center; }
  .rk { color: var(--mu); }
  .arrow { justify-self: center; width: 1.2em; height: 1.2em; border-top: 3px solid #4a6fa5; border-right: 3px solid #4a6fa5; transform: rotate(45deg); }
  .badge { justify-self: start; font-weight: 700; padding: .3em .8em; border-radius: .6em; font-size: .92em; }
  .badge.big { font-size: 1.1em; }
  .badge.ok { background: rgba(99, 214, 180, .14); color: var(--mint); }
  .badge.warn { background: rgba(246, 136, 42, .16); color: var(--or); }
  .badge.stop { background: rgba(255, 111, 97, .16); color: var(--coral); }
  .k { color: var(--mu); font-size: .9em; }
  .level { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .3em; }
  .level span { text-align: center; padding: .3em 0; border-radius: .5em; background: #172131; color: #5d6f8c; font-size: .9em; font-weight: 600; }
  .level .on.ok { background: rgba(99, 214, 180, .2); color: var(--mint); }
  .level .on.warn { background: rgba(246, 136, 42, .22); color: var(--or); }
  .level .on.stop { background: rgba(255, 111, 97, .22); color: var(--coral); }
  .why-list { list-style: disc; margin: 0; padding-left: 1.2em; display: grid; gap: .2em; color: #c9d6ea; }
  .act { margin-top: .3em; padding: .6em .8em; border-radius: .7em; background: #151d2b; display: grid; gap: .1em; }
  .act b { color: #9fc2ff; font-size: .88em; }

  /* payment: FDS rule check */
  .fds { width: 90%; }
  .log-row.rule { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .log-row.miss { border-bottom: 0; }
  .tag.dim { background: rgba(127, 178, 255, .14); color: #9fc2ff; }
  .tips { list-style: none; margin: .2em 0 0; padding: 0; display: grid; gap: .35em; }
  .tips li { display: flex; align-items: center; gap: .5em; color: #c9d6ea; }
  .tips li :global(svg) { color: var(--mint); flex: none; }

  /* narrow screens: fewer columns, same story */
  @container (max-width: 640px) {
    .shot { padding: 3cqi; font-size: 12.5px; } /* .88em notes stay at 11px */
    .term { width: 100%; }
    .term ol { font-size: 12px; padding: 14px; }
    .term li { grid-template-columns: minmax(0, 1fr) auto; }
    .bind-stage { grid-template-columns: minmax(0, 1fr) 36%; gap: 4%; }
    .qr { width: 7em; height: 7em; }
    .pc .sub { display: none; }
    .browser { width: 100%; }
    .portal { grid-template-columns: 1fr; }
    .side { display: none; }
    .p-main .layer { padding: 1em; gap: .7em; }
    .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .log { width: 100%; }
    .log-body { padding: .8em 1em; }
    .log-row { grid-template-columns: 4.8em 5.4em minmax(0, 1fr); }
    .log-row .c-t, .log-row .c-to { display: none; }
    .xc-body .layer { padding: .8em 1em; }
    .xc-row { grid-template-columns: 4.6em minmax(0, 1fr) minmax(0, 1fr) 3em; gap: .5em; }
    .log-row.dev { grid-template-columns: 4.6em 4.4em minmax(0, 1fr) auto; }
    .log-row.req { grid-template-columns: minmax(0, 1fr) auto; }
    .log-row.req .why { grid-column: 1 / -1; color: var(--mu); }
    .flow { grid-template-columns: 1fr; gap: .3em; }
    .node { grid-template-columns: auto 1fr; justify-items: start; text-align: left; padding: .6em .8em; column-gap: .7em; row-gap: 0; }
    .node .ico { grid-row: span 2; width: 2.2em; height: 2.2em; }
    .node .decide, .node .eval, .node .recs { grid-column: 2; justify-self: start; margin-top: .2em; }
    .link { grid-template-columns: 1fr 1fr; gap: .2em .6em; }
    .link .lane { display: none; }
    .link em:first-child::before { content: '↓ '; }
    .link em:last-child::before { content: '↑ '; }
    .sig-board { width: 100%; gap: .7em; }
    .sig-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .4em; }
    .sig-grid li { padding: .45em .6em; }
    .case-stage { grid-template-columns: 1fr; gap: .4em; }
    .arrow { transform: rotate(135deg); width: .8em; height: .8em; }
    .card { padding: .8em 1em; gap: .35em; }
    .sit li { grid-template-columns: 3em minmax(0, 1fr) auto; }
    .fds { width: 100%; }
  }

  .player { border-top: 1px solid rgba(255, 255, 255, .12); padding: 16px 20px 18px; }
  .chs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 8px; }
  .ch { all: unset; box-sizing: border-box; display: grid; gap: 8px; width: 100%; padding: 6px 0; cursor: pointer; }
  .ch:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; border-radius: 4px; }
  .pbar { display: block; height: 3px; border-radius: 2px; background: rgba(159, 184, 222, .22); overflow: hidden; }
  .pbar i { display: block; height: 100%; width: 100%; background: var(--hi); transform-origin: left; transform: scaleX(var(--p, 0)); }
  .ch-t { font-size: 14px; font-weight: 600; color: var(--mu); transition: color .3s; }
  .ch[aria-current] .ch-t, .ch:hover .ch-t { color: var(--hi); }
  .now { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-top: 10px; }
  .now-d { font-size: 15px; line-height: 1.6; color: var(--on-night-2); }
  .q { display: block; color: var(--hi); font-weight: 700; margin-bottom: 2px; }
  .pause {
    flex: none; display: inline-flex; align-items: center; gap: 6px; height: 36px; padding: 0 14px 0 10px; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--hi); border: 1px solid rgba(255, 255, 255, .24); font-size: 14px; font-weight: 600;
  }
  .pause:hover { border-color: #fff; }
  .pause:focus-visible { outline: 2px solid var(--orange); outline-offset: 2px; }
  .i-pause, .i-play { display: inline-grid; }
  .i-play, .demo.paused .i-pause { display: none; }
  .demo.paused .i-play { display: inline-grid; }
  .note { margin-top: 14px; text-align: center; font-size: 13px; color: var(--ink-3); }

  @media (max-width: 767px) {
    .screen { aspect-ratio: 4 / 5; }
    .player { padding: 12px 16px 16px; }
    .ch { padding: 10px 0; }
    .ch-t { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .now { flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 4px; }
  }
</style>

<script>
  const demo = document.querySelector<HTMLElement>('.demo');
  if (demo) {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const reels = [...demo.querySelectorAll<HTMLElement>('.reel')].map((el) => ({
      el,
      shots: [...el.querySelectorAll<HTMLElement>('.shot')].map((s) => ({ el: s, dur: +s.dataset.dur! })),
      chs: [...el.querySelectorAll<HTMLButtonElement>('.ch')],
      descs: [...el.querySelectorAll<HTMLElement>('.now-d')],
      pauseBtn: el.querySelector<HTMLButtonElement>('.pause')!,
      pauseT: el.querySelector<HTMLElement>('.pause-t')!,
    }));
    let r = 0, i = 0, elapsed = 0, playing = false, wanted = !still, last = 0, raf = 0;

    const reel = () => reels[r];
    const setPaused = (p: boolean) => {
      demo.classList.toggle('paused', p);
      for (const x of reels) { x.pauseBtn.setAttribute('aria-pressed', String(p)); x.pauseT.textContent = p ? '재생' : '일시정지'; }
    };
    const progress = () => reel().chs.forEach((c, k) => c.style.setProperty('--p', String(k < i ? 1 : k === i ? Math.min(1, elapsed / reel().shots[i].dur) : 0)));
    const loop = (now: number) => {
      const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
      last = now;
      elapsed += dt;
      if (elapsed >= reel().shots[i].dur) { go(i + 1); return; }
      progress();
      raf = requestAnimationFrame(loop);
    };
    const run = () => { playing = true; setPaused(false); cancelAnimationFrame(raf); last = 0; raf = requestAnimationFrame(loop); };
    const halt = () => { playing = false; setPaused(true); cancelAnimationFrame(raf); raf = 0; };
    function go(n: number) {
      const x = reel();
      x.shots[i].el.classList.remove('run');
      i = (n + x.shots.length) % x.shots.length;
      elapsed = 0;
      x.shots.forEach((s, k) => (s.el.hidden = k !== i));
      x.chs.forEach((c, k) => (k === i ? c.setAttribute('aria-current', 'step') : c.removeAttribute('aria-current')));
      x.descs.forEach((d, k) => (d.hidden = k !== i));
      // restart the scene's timeline; with reduced motion and nothing playing, show its finished state instead
      if (!still || playing) { void x.shots[i].el.offsetWidth; x.shots[i].el.classList.add('run'); }
      progress();
      if (playing) run();
    }
    for (const x of reels) {
      x.chs.forEach((c, k) => c.addEventListener('click', () => go(k)));
      x.pauseBtn.addEventListener('click', () => {
        wanted = !playing;
        if (playing) halt();
        else if (still) { playing = true; go(i); } // reduced motion: play from the scene's start
        else run();
      });
    }
    const select = (n: number) => {
      tabs.forEach((t, k) => { t.setAttribute('aria-selected', String(k === n)); t.tabIndex = k === n ? 0 : -1; });
      reel().shots[i].el.classList.remove('run');
      reels.forEach((x, k) => (x.el.hidden = k !== n));
      r = n; i = 0;
      go(0);
    };
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => select(k));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const n = (k + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[n].focus(); select(n);
      });
    });
    // play only while the reel is on screen; scrolling away pauses without changing the visitor's choice
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { if (wanted && !playing) run(); }
      else if (playing) { halt(); wanted = true; }
    }, { threshold: 0.4 }).observe(demo);
    setPaused(true);
    go(0);
  }
</script>

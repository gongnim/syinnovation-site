  .sig-grid li { display: flex; align-items: center; gap: .5em; padding: .7em .8em; border-radius: .8em; background: var(--panel); border: 1px solid var(--line); color: #c9d6ea; text-align: left; }
  .sig-grid li :global(svg) { flex: none; color: #9fc2ff; }
  .sb-m { color: var(--mu); max-width: 40em; }
  .sb-r { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: .5em; color: var(--mu); }

  /* payment: three cases */
  .case-stage { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) 2.4em minmax(0, 1fr); align-items: center; gap: .8em; }
  .card { padding: 1.2em 1.4em; border-radius: 1em; background: var(--panel); border: 1px solid var(--line); display: grid; gap: .5em; align-content: start; }

    tone: 'ok', label: '승인 권고', level: 0, why: ['모든 신호가 평소와 같습니다'], act: '결제는 그대로 진행됩니다' },
  paybig: { rows: [['기기', '평소 쓰는 휴대폰', true], ['금액', '250만 원, 평소보다 훨씬 큼', false], ['가맹점', '처음 거래하는 전자제품 매장', false], ['시도', '한 번에 결제', true]],
    tone: 'warn', label: '추가 확인 권고', level: 1, why: ['금액이 평소보다 크게 벗어남', '처음 거래하는 가맹점'], act: '휴대폰으로 본인 확인을 거친 뒤 진행합니다' },
  payrep: { rows: [['기기', '처음 보는 기기', false], ['금액', '5만 원씩', true], ['가맹점', '처음 거래하는 온라인몰', false], ['시도', '1분 사이 실패 6번 뒤 다시 시도', false]],
    tone: 'stop', label: '보류 권고', level: 2, why: ['짧은 시간에 실패와 재시도가 몰림', '처음 보는 기기와 가맹점'], act: '거래를 멈추고 ARS나 앱 알림으로 본인 확인을 합니다' },

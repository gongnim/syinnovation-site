---
// One vertical player for every ShortThumb on the page: a 9:16 YouTube player over a dark backdrop, the same pattern as
// the 16:9 player in library/videos.astro. YouTube (privacy-enhanced domain) loads only on click; closing it (button,
// backdrop or Esc) removes the player so the sound stops.
interface Props { en: boolean }
const { en } = Astro.props;
---
<dialog class="sp" aria-label={en ? 'Video player' : '영상 재생'}>
  <button type="button" class="sp-close" aria-label={en ? 'Close' : '닫기'}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
  </button>
  <div class="sp-box"></div>
</dialog>

<style>
  .sp { width: min(92vw, calc(min(84vh, 780px) * 9 / 16)); max-width: none; max-height: none; padding: 52px 0 0; border: 0; background: transparent; overflow: visible; }
  .sp::backdrop { background: rgb(8 14 26 / .86); }
  .sp-box { position: relative; aspect-ratio: 9 / 16; border-radius: 16px; overflow: hidden; background: #000; }
  .sp-box :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .sp-close { position: absolute; top: 0; right: 0; display: grid; place-items: center; width: 42px; height: 42px; border: 0; border-radius: 50%; background: rgb(255 255 255 / .14); color: #fff; cursor: pointer; }
  .sp-close:hover { background: rgb(255 255 255 / .26); }
  :global(html:has(.sp[open])) { overflow: hidden; }
</style>

<script>
  const player = document.querySelector<HTMLDialogElement>('dialog.sp')!;
  const box = player.querySelector<HTMLElement>('.sp-box')!;
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-short]');
    if (!b) return;
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.short}?autoplay=1&rel=0&playsinline=1`;
    f.title = b.dataset.title ?? '영상';
    f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
    f.allowFullscreen = true;
    box.replaceChildren(f);
    player.showModal();
  });
  player.querySelector('.sp-close')!.addEventListener('click', () => player.close());
  player.addEventListener('click', (e) => { if (e.target === player) player.close(); });
  player.addEventListener('close', () => box.replaceChildren());
</script>

{
  "_about": "Settings for scripts/collect-security-news.mjs (runs once a day). Edit the word lists here; the collector reads them on every run.",
  "queries": [
    {
      "region": "국내",
      "lang": "ko",
      "q": "해킹 OR 개인정보 유출 OR 정보 유출 OR 랜섬웨어 OR 디도스 OR 사이버 공격"
    },
    {
      "region": "해외",
      "lang": "en",
      "q": "\"data breach\" OR ransomware OR cyberattack OR hacked OR \"data leak\""
    }
  ],
  "minOutlets": {
    "국내": 2,
    "해외": 3
  },
  "maxNewPerRun": 6,
  "maxVideosPerRun": 2,
  "keepDays": 120,
  "videoChannels": [
    "뉴스",
